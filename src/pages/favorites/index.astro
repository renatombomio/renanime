---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/layout/Navbar.astro";
import Footer from "../../components/layout/Footer.astro";
import Container from "../../components/ui/Container.astro";
import SectionHeader from "../../components/ui/SectionHeader.astro";
import FavoritesView from "../../components/favorites/FavoritesView";
import { getFavoritesLibrary, getRecommendedLibrary } from "../../data/library";

const entries = getFavoritesLibrary();
const recommendations = getRecommendedLibrary().filter((entry) => !entry.state.favorite);
---

<Layout title="Favoritos de Ren — Renanime's Gallery">
  <Navbar />
  <main id="main-content" class="favorites-page">
    <Container>
      <SectionHeader
        eyebrow="Archivo de Ren"
        index="02"
        variant="ren"
        title="Favoritos de Ren"
        description="No son simplemente los que más me gustan. Son los que dejaron algo detrás: una escena, un personaje, una idea o una sensación a la que siempre termino volviendo."
      />
      <div class="favorites-page-content">
        <FavoritesView entries={entries} recommendations={recommendations} client:load />
      </div>
    </Container>
  </main>
  <Footer />
</Layout>

<style>
  .favorites-page {
    min-height: 70vh;
    padding-block: clamp(6rem, 11vw, 10rem) var(--section-space);
  }

  .favorites-page-content {
    margin-top: clamp(5rem, 10vw, 9rem);
  }

  :global(.favorites-track) {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2rem, 4vw, 4.5rem) clamp(1rem, 2.4vw, 2.5rem);
    overflow: visible;
    padding: 0;
  }

  :global(.favorite-card) {
    width: 100%;
    position: relative;
    overflow: visible;
    border: 0;
    border-radius: 0;
    background: transparent;
  }

  :global(.favorite-card:nth-child(even)) {
    margin-top: clamp(2rem, 5vw, 5rem);
  }

  :global(.favorite-card a) {
    display: block;
    width: 100%;
    position: relative;
    overflow: hidden;
    border: 0;
    border-radius: 0;
    background: #111;
    color: inherit;
    text-decoration: none;
    box-shadow: none;
  }

  :global(.favorite-media) {
    position: relative;
    width: 100%;
    aspect-ratio: 2 / 3;
    overflow: hidden;
    background: #171717;
  }

  :global(.favorite-media img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform .7s cubic-bezier(.22,1,.36,1), filter .5s ease;
  }

  :global(.favorite-card:hover .favorite-media img) {
    transform: scale(1.025);
    filter: saturate(1.04);
  }

  :global(.favorite-caption) {
    position: absolute;
    z-index: 2;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 5rem 1.15rem 1.1rem;
    pointer-events: none;
    background: linear-gradient(180deg, transparent 0%, rgba(0,0,0,.2) 30%, rgba(0,0,0,.88) 100%);
  }

  :global(.favorite-caption h3) {
    margin: 0;
    color: #fff;
    font-size: clamp(.95rem, 1.8vw, 1.25rem);
    line-height: 1.05;
    letter-spacing: -.035em;
    text-shadow: 0 1px 10px rgba(0,0,0,.35);
  }

  :global(.favorite-caption span) {
    display: block;
    margin-top: .38rem;
    color: rgba(255,255,255,.62);
    font-family: var(--font-meta);
    font-size: .48rem;
    letter-spacing: .1em;
    text-transform: uppercase;
  }

  :global(.favorite-placeholder) {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 1rem;
    text-align: center;
    background: linear-gradient(145deg, #242424, #101010);
    color: #fff;
  }

  :global(.favorite-placeholder span) {
    position: absolute;
    top: 1rem;
    left: 1rem;
    font-family: var(--font-meta);
    font-size: .45rem;
    opacity: .45;
  }

  :global(.favorite-placeholder strong) {
    max-width: 80%;
    font-size: .8rem;
    font-weight: 500;
  }

  :global(.favorites-controls) { display: none; }

  :global(.favorites-intro) {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: end;
    gap: 1rem;
    padding: 0 0 1rem;
    border-bottom: 1px solid var(--line);
  }

  :global(.favorites-intro h2) {
    margin: .45rem 0 0;
    font-size: clamp(2rem, 4vw, 3.75rem);
    font-weight: 400;
    letter-spacing: -.055em;
    line-height: .95;
  }

  :global(.favorites-note) {
    color: var(--color-accent-soft);
    letter-spacing: .12em;
  }

  :global(.favorites-recommendation-copy) {
    max-width: 32rem;
    margin: 1.2rem 0 2.5rem;
    color: var(--muted);
    font-size: .9rem;
    line-height: 1.65;
  }

  :global(.favorites-section + .favorites-section) {
    margin-top: clamp(7rem, 14vw, 13rem);
  }

  @media (max-width: 700px) {
    .favorites-page-content { margin-top: 4.5rem; }
    :global(.favorites-track) { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2.5rem .75rem; }
    :global(.favorite-card:nth-child(even)) { margin-top: 2rem; }
    :global(.favorite-caption) { padding: 3rem .65rem .65rem; }
    :global(.favorite-caption h3) { font-size: .72rem; line-height: 1.05; }
    :global(.favorite-caption span) { font-size: .38rem; }
  }
</style>