---
import Layout from "../../layouts/Layout.astro";
---

<Layout
  title="Crear perfil — Renanime's Gallery"
  description="Crea tu perfil en Renanime's Gallery."
>
  <main class="access-page">
    <section class="access-card" aria-labelledby="register-title">
      <div class="brand" aria-label="Renanime">
        <span class="brand-ren">Ren</span><span class="brand-anime">anime</span>
      </div>

      <p class="eyebrow">RENANIME'S GALLERY</p>
      <h1 id="register-title">Crear perfil</h1>
      <p class="subtitle">Tu nombre y AKA identificarán tu espacio personal.</p>

      <form id="register-form">
        <label for="access-password">Contraseña de acceso</label>
        <input
          id="access-password"
          name="accessPassword"
          type="password"
          autocomplete="current-password"
          required
        />

        <label for="name">Nombre</label>
        <input
          id="name"
          name="name"
          type="text"
          autocomplete="name"
          maxlength="80"
          required
        />

        <label for="aka">AKA</label>
        <input
          id="aka"
          name="aka"
          type="text"
          maxlength="40"
          required
        />

        <button type="submit">Crear perfil</button>
        <p id="message" class="message" aria-live="polite"></p>
      </form>

      <p class="register-link">
        ¿Ya tienes perfil? <a href="/login">Volver al acceso</a>
      </p>
    </section>
  </main>
</Layout>

<script>
  const form = document.querySelector<HTMLFormElement>("#register-form");
  const message = document.querySelector<HTMLParagraphElement>("#message");

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();

    if (!message) return;

    const formData = new FormData(form);
    const accessPassword = String(formData.get("accessPassword") ?? "");
    const name = String(formData.get("name") ?? "").trim();
    const aka = String(formData.get("aka") ?? "").trim();

    message.textContent = "";

    try {
      const response = await fetch("/api/auth/register", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ accessPassword, name, aka }),
      });

      const data = await response.json();

      if (!response.ok) {
        message.textContent =
          data.error === "INVALID_ACCESS_PASSWORD"
            ? "Contraseña de acceso incorrecta."
            : data.error === "INVALID_PROFILE"
              ? "Revisa el nombre y el AKA."
              : "No se ha podido crear el perfil.";
        return;
      }

      if (data.recoveryCode) {
        window.alert(
          "Guarda tu código de recuperación en un lugar seguro: " +
            data.recoveryCode
        );
      }

      window.location.href = "/";
    } catch {
      message.textContent = "No se ha podido conectar con Renanime.";
    }
  });
</script>

<style>
  .access-page {
    min-height: 100vh;
    display: grid;
    place-items: center;
    padding: 2rem 1.25rem;
  }

  .access-card {
    width: min(100%, 430px);
  }

  .brand {
    margin-bottom: 3rem;
    font-size: 2rem;
    font-weight: 700;
    letter-spacing: -0.05em;
  }

  .brand-ren {
    color: var(--accent, #ff4f8b);
  }

  .brand-anime {
    color: white;
  }

  .eyebrow {
    margin: 0 0 0.65rem;
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    opacity: 0.5;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.4rem, 9vw, 4rem);
    line-height: 0.95;
  }

  .subtitle {
    max-width: 360px;
    margin: 1rem 0 2rem;
    line-height: 1.6;
    opacity: 0.62;
  }

  form {
    display: grid;
    gap: 0.75rem;
  }

  label {
    font-size: 0.85rem;
    opacity: 0.75;
  }

  input {
    width: 100%;
    min-height: 52px;
    padding: 0 1rem;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.05);
    color: inherit;
    font: inherit;
  }

  input:focus {
    outline: 2px solid var(--accent, #ff4f8b);
    outline-offset: 2px;
  }

  button {
    min-height: 52px;
    margin-top: 0.5rem;
    border: 0;
    border-radius: 12px;
    background: var(--accent, #ff4f8b);
    color: white;
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }

  .message {
    min-height: 1.25rem;
    margin: 0.25rem 0 0;
    font-size: 0.85rem;
    color: #ff7b9f;
  }

  .register-link {
    margin-top: 2rem;
    text-align: center;
    font-size: 0.9rem;
    opacity: 0.7;
  }

  .register-link a {
    color: inherit;
    font-weight: 600;
  }
</style>
