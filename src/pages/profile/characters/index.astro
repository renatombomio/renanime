---
export const prerender = false;
import Layout from "../../../layouts/Layout.astro";
import Navbar from "../../../components/layout/Navbar.astro";
import { createSupabaseSsrClient } from "../../../lib/supabase-ssr";
import { localizedPath } from "../../../i18n";

const lang = Astro.locals.lang;
const isEnglish = lang === "en";
const user = Astro.locals.renanimeUser;
if (!user) return Astro.redirect(localizedPath(lang, "/login/"));
const supabase = createSupabaseSsrClient(Astro.request, Astro.cookies);
const { data, error } = await supabase
  .from("character_likes")
  .select("character_id, created_at, characters(id, name, image_url, anime_characters(anime_id, role, sort_order))", { count: "exact" })
  .eq("user_id", user.id)
  .order("created_at", { ascending: false })
  .range(0, 11);
if (error) console.error("Renanime all character favorites error:", error.message);
const totalCharacters = (await supabase.from("character_likes").select("id", { count: "exact", head: true }).eq("user_id", user.id)).count ?? 0;
const characters = (data ?? []).map((row: any) => ({
  ...(Array.isArray(row.characters) ? row.characters[0] : row.characters),
  character_id: row.character_id,
  anime_id: ((Array.isArray(row.characters) ? row.characters[0] : row.characters)?.anime_characters ?? [])
    .slice()
    .sort((a: any, b: any) => (a.role === "MAIN" ? 0 : 1) - (b.role === "MAIN" ? 0 : 1) || a.sort_order - b.sort_order)[0]?.anime_id ?? null,
})).filter((item: any) => item?.id && item?.name);
const characterAnimeIds = [...new Set(characters.map((item: any) => item.anime_id).filter((id: any) => Number.isInteger(id)))];
let characterAnimeTitles: Record<number, string> = {};
if (characterAnimeIds.length) {
  const variables: Record<string, number> = {};
  const fields = characterAnimeIds.map((id, index) => {
    variables["id" + index] = id;
    return "a" + index + ": Media(id: $id" + index + ", type: ANIME) { id title { romaji english } }";
  }).join("\n");
  const definitions = characterAnimeIds.map((_, index) => "$id" + index + ": Int!").join(", ");
  try {
    const response = await fetch("https://graphql.anilist.co", {
      method: "POST",
      headers: { "Content-Type": "application/json", "Accept": "application/json" },
      body: JSON.stringify({ query: "query CharacterAnimeTitles(" + definitions + ") { " + fields + " }", variables }),
    });
    if (response.ok) {
      const payload = await response.json();
      characterAnimeTitles = Object.fromEntries(characterAnimeIds.map((id, index) => {
        const anime = payload.data?.["a" + index];
        return [id, anime?.title?.english || anime?.title?.romaji || ""];
      }).filter((entry: any) => entry[1]));
    }
  } catch (error) {
    console.error("Renanime character anime titles error:", error);
  }
}
for (const character of characters) {
  character.anime_title = character.anime_id ? characterAnimeTitles[character.anime_id] ?? "" : "";
}
---
<Layout title={isEnglish ? "Favourite characters — Renanime" : "Personajes favoritos — Renanime"}>
  <Navbar />
  <main class="liked-characters-page">
    <a class="back-link" href={localizedPath(lang, "/profile/")}>← {isEnglish ? "Back to profile" : "Volver al perfil"}</a>
    <header class="page-heading">
      <div><p>{isEnglish ? "YOUR COLLECTION" : "TU COLECCIÓN"}</p><h1>{isEnglish ? "Favourite characters" : "Personajes favoritos"}</h1></div>
      <span id="liked-character-count">{totalCharacters}</span>
    </header>
    {error ? <p class="empty-state">{isEnglish ? "Your favourites could not be loaded." : "No se han podido cargar tus favoritos."}</p> :
      characters.length ? <><div class="character-grid" id="liked-character-grid">
        {characters.map((character: any) => <article class="character-card" data-character-card={character.id}>
          {character.image_url && <img src={character.image_url} alt="" loading="lazy" />}
          <div class="character-copy"><strong>{character.name}</strong><span>{character.anime_title || (isEnglish ? "Anime unavailable" : "Anime no disponible")}</span></div>
          <button type="button" class="remove-like" data-character-like={character.id} aria-label={isEnglish ? "Remove from favourites" : "Quitar de favoritos"} title={isEnglish ? "Remove from favourites" : "Quitar de favoritos"}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.8 8.8c0 5.2-8.8 11-8.8 11S3.2 14 3.2 8.8a4.5 4.5 0 0 1 8.8-1.1 4.5 4.5 0 0 1 8.8 1.1Z"/></svg>
          </button>
        </article>)}
      </div><button type="button" class="load-more" id="load-more-characters" data-offset={characters.length} hidden={characters.length >= totalCharacters}>{isEnglish ? "Show more" : "Mostrar más"}</button></> : <p class="empty-state" id="liked-character-empty">{isEnglish ? "You haven't liked any characters yet. Explore an anime and tap the heart on a character card." : "Todavía no has marcado personajes como favoritos. Explora un anime y pulsa el corazón de una de sus tarjetas."}</p>}
    <p class="feedback" id="liked-character-feedback" role="status" aria-live="polite"></p>
  </main>
  <script>
    const english = document.documentElement.lang === "en";
    const copy = (es: string, en: string) => english ? en : es;
    const grid = document.querySelector<HTMLElement>("#liked-character-grid");
    const loadMore = document.querySelector<HTMLButtonElement>("#load-more-characters");
    const total = Number(document.querySelector("#liked-character-count")?.textContent || 0);
    let loadingMore = false;
    loadMore?.addEventListener("click", async () => {
      if (loadingMore || !grid || !loadMore) return;
      loadingMore = true;
      loadMore.disabled = true;
      loadMore.textContent = copy("Cargando…", "Loading…");
      try {
        const offset = Number(loadMore.dataset.offset || 0);
        const response = await fetch("/api/profile/character-favorites?offset=" + offset + "&limit=12", { credentials: "same-origin" });
        const payload = await response.json();
        if (!response.ok || !payload.ok || !Array.isArray(payload.characters)) throw new Error("LOAD_FAILED");
        for (const character of payload.characters) {
          const card = document.createElement("article");
          card.className = "character-card";
          card.dataset.characterCard = String(character.id);
          if (character.image_url) {
            const image = document.createElement("img");
            image.src = character.image_url;
            image.alt = "";
            image.loading = "lazy";
            card.append(image);
          }
          const copyNode = document.createElement("div");
          copyNode.className = "character-copy";
          const name = document.createElement("strong");
          name.textContent = character.name;
          const anime = document.createElement("span");
          anime.textContent = character.anime_title || copy("Anime no disponible", "Anime unavailable");
          copyNode.append(name, anime);
          const button = document.createElement("button");
          button.type = "button";
          button.className = "remove-like";
          button.dataset.characterLike = String(character.id);
          button.setAttribute("aria-label", copy("Quitar de favoritos", "Remove from favourites"));
          button.title = copy("Quitar de favoritos", "Remove from favourites");
          button.innerHTML = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.8 8.8c0 5.2-8.8 11-8.8 11S3.2 14 3.2 8.8a4.5 4.5 0 0 1 8.8-1.1 4.5 4.5 0 0 1 8.8 1.1Z"/></svg>';
          card.append(copyNode, button);
          grid.append(card);
        }
        const nextOffset = offset + payload.characters.length;
        loadMore.dataset.offset = String(nextOffset);
        loadMore.hidden = nextOffset >= total || payload.characters.length === 0;
        loadMore.textContent = copy("Mostrar más", "Show more");
      } catch {
        const feedback = document.querySelector<HTMLElement>("#liked-character-feedback");
        if (feedback) feedback.textContent = copy("No se pudieron cargar más personajes. Inténtalo de nuevo.", "Could not load more characters. Try again.");
        loadMore.textContent = copy("Reintentar", "Retry");
      } finally {
        loadingMore = false;
        loadMore.disabled = false;
      }
    });
    document.addEventListener("click", async (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      const button = target.closest<HTMLButtonElement>("[data-character-like]");
      if (!button || button.disabled) return;
      const id = button.dataset.characterLike;
      if (!id) return;
      button.disabled = true;
      try {
        const response = await fetch("/api/characters/" + id + "/like", { method: "POST", credentials: "same-origin" });
        const result = await response.json().catch(() => ({}));
        if (!response.ok || !result.ok || result.liked) throw new Error("UNLIKE_FAILED");
        button.closest("[data-character-card]")?.remove();
        const count = document.querySelector<HTMLElement>("#liked-character-count");
        const remaining = Math.max(0, Number(count?.textContent || 0) - 1);
        if (count) count.textContent = String(remaining);
        if (loadMore && grid) loadMore.dataset.offset = String(grid.querySelectorAll("[data-character-card]").length);
        if (remaining === 0) {
          grid?.remove();
          loadMore?.remove();
          const empty = document.createElement("p");
          empty.className = "empty-state";
          empty.textContent = copy("Todavía no has marcado personajes como favoritos. Explora un anime y pulsa el corazón de una de sus tarjetas.", "You haven't liked any characters yet. Explore an anime and tap the heart on a character card.");
          document.querySelector(".page-heading")?.insertAdjacentElement("afterend", empty);
        }
      } catch {
        const feedback = document.querySelector<HTMLElement>("#liked-character-feedback");
        if (feedback) feedback.textContent = copy("No se pudo actualizar el favorito. Inténtalo de nuevo.", "Could not update favourite. Try again.");
      } finally {
        button.disabled = false;
      }
    });
  </script>
</Layout>

<style>
  .liked-characters-page{width:min(100% - 32px,1040px);margin:0 auto;padding:28px 0 64px;color:#f5f2ec}
  .back-link{display:inline-block;margin-bottom:28px;color:#aaa4b0;text-decoration:none;font-size:.82rem}
  .page-heading{display:flex;align-items:end;justify-content:space-between;gap:16px;margin-bottom:20px}
  .page-heading p{margin:0 0 7px;color:#ec4899;font-size:.66rem;font-weight:800;letter-spacing:.16em}
  .page-heading h1{margin:0;font-size:clamp(1.55rem,4vw,2.2rem);letter-spacing:-.04em}
  .page-heading>span{color:#aaa4b0;font-size:.9rem;font-variant-numeric:tabular-nums}
  main.liked-characters-page .character-grid{display:grid!important;grid-template-columns:repeat(3,minmax(0,1fr))!important;gap:10px}
  .character-card{position:relative;display:grid;grid-template-rows:auto 1fr;gap:8px;min-width:0;padding:8px;border:1px solid rgba(255,255,255,.12);border-radius:14px;background:#101012}
  .character-card>img{display:block;width:100%;aspect-ratio:3/4;object-fit:cover;object-position:center 20%;border-radius:9px;background:#222}
  .character-copy{display:grid;gap:5px;min-width:0;padding:0 3px 3px}
  .character-copy strong{font-size:.82rem;line-height:1.25;overflow-wrap:anywhere}
  .character-copy span{color:#99939f;font-size:.7rem}
  .remove-like{position:absolute;right:9px;top:9px;display:grid;place-items:center;width:32px;height:32px;border:1px solid rgba(236,72,153,.45);border-radius:50%;background:#090909;color:#ec4899;cursor:pointer}
  .remove-like svg{width:17px;height:17px;fill:currentColor;stroke:currentColor;stroke-width:1.2}
  .remove-like:disabled{opacity:.5;cursor:wait}
  .load-more{display:block;width:100%;margin:18px 0 0;padding:12px;border:1px solid rgba(236,72,153,.45);border-radius:10px;background:#101012;color:#ec4899;font:inherit;font-size:.82rem;cursor:pointer}
  .load-more:disabled{opacity:.55;cursor:wait}
  .empty-state{color:#aaa4b0;font-size:.86rem;line-height:1.6}
  .feedback{min-height:1.2em;color:#ff8ab9;font-size:.75rem}
  @media(max-width:680px){main.liked-characters-page .character-grid{grid-template-columns:repeat(3,minmax(0,1fr))!important;gap:7px}.character-card{gap:6px;padding:5px;border-radius:11px}.character-card>img{aspect-ratio:3/4}.character-copy{gap:3px;padding:0 1px 2px}.character-copy strong{font-size:.68rem}.character-copy span{font-size:.61rem}.remove-like{right:6px;top:6px;width:25px;height:25px}.remove-like svg{width:14px;height:14px}}
</style>
