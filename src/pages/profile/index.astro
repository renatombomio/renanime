---
export const prerender = false;
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/layout/Navbar.astro";
import Footer from "../../components/layout/Footer.astro";
import { createSupabaseSsrClient } from "../../lib/supabase-ssr";
import { localizedPath } from "../../i18n";

const lang = Astro.locals.lang;
const isEnglish = lang === "en";
const user = Astro.locals.renanimeUser;
if (!user) return Astro.redirect(localizedPath(Astro.locals.lang, "/login/"));
const supabase = createSupabaseSsrClient(Astro.request, Astro.cookies);
const { data: libraryData, error: libraryError } = await supabase
  .from("user_anime")
  .select("status")
  .eq("user_id", user.id);

if (libraryError) {
  console.error("Renanime profile library error:", libraryError.message);
}

const { data: profileData } = await supabase
  .from("profiles")
  .select("id, name, aka, bio, location, avatar_url, cover_url, interests, created_at")
  .eq("id", user.id)
  .maybeSingle();
const profile = { ...user, ...profileData };
const library = Array.isArray(libraryData) ? libraryData : [];
const watched = library.filter((entry: any) => entry?.status === "seen");
const pending = library.filter((entry: any) => entry?.status === "pending");

const joinedDate = profile.created_at
  ? new Intl.DateTimeFormat(isEnglish ? "en-GB" : "es-ES", {
      day: "numeric",
      month: "long",
      year: "numeric",
    }).format(new Date(profile.created_at))
  : "—";
---

<Layout
  title={`${isEnglish ? "My Profile" : "Mi perfil"} — Renanime's Gallery`}
  description={isEnglish ? "Your personal profile on Renanime." : "Tu perfil personal en Renanime."}
>
  <Navbar />

  <main class="profile-page">
    <section class="profile-card">
      <header class="profile-header">
        <p class="eyebrow">{isEnglish ? "MY PROFILE" : "MI PERFIL"}</p>
        <h1>{profile.name}</h1>
        <p class="community-line">
          {isEnglish ? "Part of the otaku community since" : "Miembro de la comunidad otaku desde"} <strong>{joinedDate}</strong>.
        </p>
      </header>

      <section class="profile-editor" aria-labelledby="profile-editor-title">
        <div class="cover-preview" id="cover-preview" style={profile.cover_url ? `background-image: linear-gradient(0deg, rgba(5,5,5,.94), rgba(5,5,5,.08)), url("${profile.cover_url}")` : undefined}>
          <button class="media-edit cover-edit" type="button" data-pick="cover">{isEnglish ? "Change cover" : "Cambiar banner"}</button>
          <input class="file-input" id="cover-input" type="file" accept="image/jpeg,image/png,image/webp,image/avif" />
        </div>
        <div class="identity-editor">
          <div class="avatar-wrap">
            <img id="avatar-preview" class="avatar-preview" src={profile.avatar_url || "/images/profile-avatar-placeholder.svg"} alt={isEnglish ? "Profile picture" : "Foto de perfil"} />
            <button class="avatar-edit" type="button" data-pick="avatar" aria-label={isEnglish ? "Change profile picture" : "Cambiar foto de perfil"}>+</button>
            <input class="file-input" id="avatar-input" type="file" accept="image/jpeg,image/png,image/webp,image/avif" />
          </div>
          <div class="identity-copy">
            <p class="eyebrow">{isEnglish ? "YOUR SPACE" : "TU ESPACIO"}</p>
            <h2>{profile.name}</h2>
            <p class="handle">@{profile.aka}</p>
          </div>
        </div>
        <div class="editor-fields">
          <h2 id="profile-editor-title">{isEnglish ? "Personalize your profile" : "Personaliza tu perfil"}</h2>
          <label>{isEnglish ? "Biography" : "Biografía"}
            <textarea id="profile-bio" maxlength="280" placeholder={isEnglish ? "Tell the community about yourself…" : "Cuéntale a la comunidad quién eres…"}>{profile.bio || ""}</textarea>
          </label>
          <label>{isEnglish ? "Location (optional)" : "Ubicación (opcional)"}
            <input id="profile-location" maxlength="80" value={profile.location || ""} placeholder={isEnglish ? "City, country" : "Ciudad, país"} />
          </label>
          <div class="editor-actions">
            <button class="save-profile" id="save-profile" type="button">{isEnglish ? "Save changes" : "Guardar cambios"}</button>
            <p id="profile-feedback" role="status" aria-live="polite"></p>
          </div>
          <p class="upload-note">{isEnglish ? "JPG, PNG, WebP or AVIF · Max. 5 MB per image." : "JPG, PNG, WebP o AVIF · Máximo 5 MB por imagen."}</p>
        </div>
      </section>

      <section class="library-section">
        <p class="section-label">{isEnglish ? "MY RENANIME" : "MI RENANIME"}</p>

        <div class="stats">
          <article class="stat-card">
            <span class="stat-number" data-personal-count="PENDING">{pending.length}</span>
            <span class="stat-label">{isEnglish ? "ANIME ON MY LIST" : "ANIMES EN MI LISTA"}</span>
          </article>

          <article class="stat-card">
            <span class="stat-number" data-personal-count="WATCHED">{watched.length}</span>
            <span class="stat-label">{isEnglish ? "ANIME IN MY COLLECTION" : "ANIMES EN MI COLECCIÓN"}</span>
          </article>
        </div>
      </section>

      <div class="profile-actions">
        <a href={localizedPath(Astro.locals.lang, "/collection/")}>{isEnglish ? "View my collection" : "Ver mi colección"}</a>
        <a href={localizedPath(Astro.locals.lang, "/pending/")}>{isEnglish ? "View my list" : "Ver mi lista"}</a>
        <button id="logout-button" type="button">{isEnglish ? "Log out" : "Cerrar sesión"}</button>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .profile-editor { margin-top: 1.5rem; overflow: hidden; border: 1px solid rgba(255,255,255,.1); border-radius: 22px; background: rgba(255,255,255,.025); }
  .cover-preview { position: relative; height: clamp(180px, 32vw, 320px); background: linear-gradient(135deg,#24202a,#111); background-size: cover; background-position: center; }
  .media-edit { border: 1px solid rgba(255,255,255,.35); border-radius: 999px; padding: .65rem .9rem; color: white; background: rgba(0,0,0,.45); backdrop-filter: blur(10px); cursor: pointer; font: inherit; font-size: .78rem; }
  .cover-edit { position: absolute; right: 1rem; bottom: 1rem; }
  .file-input { display: none; }
  .identity-editor { display: flex; align-items: end; gap: 1rem; padding: 0 1.5rem; margin-top: -3.4rem; position: relative; }
  .avatar-wrap { position: relative; flex: 0 0 auto; }
  .avatar-preview { width: 112px; height: 112px; border-radius: 50%; object-fit: cover; border: 4px solid #090909; background: #242424; }
  .avatar-edit { position: absolute; right: 2px; bottom: 8px; width: 30px; height: 30px; border: 1px solid rgba(255,255,255,.5); border-radius: 50%; background: #ec4899; color: white; font-size: 1.2rem; cursor: pointer; }
  .identity-copy { padding-bottom: .45rem; min-width: 0; }
  .identity-copy h2 { margin: .2rem 0; font-size: clamp(1.4rem,3vw,2rem); }
  .handle { margin: 0; color: #aaa; font-size: .85rem; }
  .editor-fields { display: grid; gap: 1rem; padding: 1.5rem; }
  .editor-fields h2 { margin: 0; font-size: 1.15rem; }
  .editor-fields label { display: grid; gap: .45rem; color: #aaa; font-size: .78rem; }
  .editor-fields textarea,.editor-fields input { width: 100%; border: 1px solid rgba(255,255,255,.13); border-radius: 12px; padding: .85rem 1rem; background: rgba(255,255,255,.04); color: white; font: inherit; font-size: .9rem; }
  .editor-fields textarea { min-height: 96px; resize: vertical; }
  .editor-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 1rem; }
  .save-profile { border: 0; border-radius: 999px; padding: .8rem 1.2rem; background: #ec4899; color: white; font: inherit; font-size: .82rem; font-weight: 650; cursor: pointer; }
  .save-profile:disabled { opacity: .55; cursor: wait; }
  #profile-feedback { margin: 0; color: #9ed9b0; font-size: .8rem; }
  .upload-note { margin: 0; color: #777; font-size: .72rem; }
  .profile-page {
    min-height: 100vh;
    padding: 108px 1.25rem 2.5rem;
  }

  .profile-card {
    width: min(100%, 860px);
    margin: 0 auto;
  }

  .profile-header {
    padding-bottom: 1.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.09);
  }

  .eyebrow,
  .section-label,
  .info-label,
  .stat-label {
    font-size: 0.68rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    opacity: 0.48;
  }

  .eyebrow {
    margin: 0 0 0.8rem;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.75rem, 7vw, 5.5rem);
    line-height: 0.9;
    letter-spacing: -0.045em;
  }

  .community-line {
    margin: .65rem 0 0;
    max-width: 620px;
    font-size: 0.95rem;
    line-height: 1.6;
    opacity: 0.62;
  }

  .community-line strong {
    color: #ff4f8b;
    font-weight: 600;
  }

  .stat-card {
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.025);
  }

  .stat-label {
    display: block;
    margin-bottom: 0.65rem;
  }

  .library-section {
    margin-top: 2rem;
  }

  .section-label {
    margin: 0 0 1rem;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  .stat-card {
    padding: 1.15rem 1.35rem;
  }

  .stat-number {
    display: block;
    font-size: clamp(2.6rem, 6vw, 4rem);
    line-height: 0.9;
    letter-spacing: -0.04em;
  }

  .stat-label {
    margin: 1rem 0 0;
  }

  .profile-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .profile-actions a {
    padding: 0.65rem .85rem;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 12px;
    color: inherit;
    text-decoration: none;
    transition: border-color 0.2s ease, background 0.2s ease;
  }

  .profile-actions a:hover {
    border-color: rgba(255, 79, 139, 0.45);
    background: rgba(255, 79, 139, 0.06);
  }

  .profile-actions button {
    padding: 0.85rem 1rem;
    border: 1px solid rgba(255, 79, 139, 0.28);
    border-radius: 12px;
    background: transparent;
    color: inherit;
    font: inherit;
    cursor: pointer;
    transition: border-color 0.2s ease, background 0.2s ease;
  }

  .profile-actions button:hover:not(:disabled) {
    border-color: rgba(255, 79, 139, 0.55);
    background: rgba(255, 79, 139, 0.06);
  }

  .profile-actions button:disabled {
    cursor: wait;
    opacity: 0.55;
  }

  @media (max-width: 520px) {
    .profile-page {
      padding: 88px .9rem 1.5rem;
    }
    .identity-editor { padding: 0 1rem; margin-top: -2.8rem; gap: .75rem; }
    .avatar-preview { width: 88px; height: 88px; }
    .editor-fields { padding: 1rem; }
    .cover-preview { height: 190px; }

    .profile-card {
      width: min(100%, 560px);
    }

    .stats {
      grid-template-columns: 1fr 1fr;
      gap: .65rem;
    }

    .stat-card {
      padding: 1rem;
      border-radius: 15px;
    }

    .stat-number {
      font-size: 2.5rem;
    }

    .stat-label {
      font-size: .58rem;
      line-height: 1.25;
    }

    .profile-header {
      padding-bottom: 1.15rem;
    }

    .eyebrow,
    .section-label {
      font-size: .58rem;
    }

    .community-line {
      font-size: .78rem;
      line-height: 1.45;
    }

    .profile-actions {
      margin-top: .75rem;
    }

    .profile-actions a,
    .profile-actions button {
      padding: .6rem .75rem;
      font-size: .8rem;
    }
  }
</style>


<script>
  const isEnglish = document.documentElement.lang === "en";
  const logoutButton = document.querySelector<HTMLButtonElement>("#logout-button");
  const feedback = document.querySelector<HTMLElement>("#profile-feedback");
  const copy = (es: string, en: string) => isEnglish ? en : es;

  document.querySelectorAll<HTMLButtonElement>("[data-pick]").forEach((button) => {
    button.addEventListener("click", () => {
      const kind = button.dataset.pick;
      document.querySelector<HTMLInputElement>(kind === "avatar" ? "#avatar-input" : "#cover-input")?.click();
    });
  });

  async function uploadImage(kind: "avatar" | "cover", file: File) {
    if (file.size > 5 * 1024 * 1024) throw new Error(copy("La imagen supera el límite de 5 MB.", "Image exceeds the 5 MB limit."));
    const form = new FormData();
    form.set("kind", kind);
    form.set("file", file);
    const response = await fetch("/api/auth/profile/media", { method: "POST", body: form, credentials: "same-origin" });
    const result = await response.json();
    if (!response.ok || !result.ok) throw new Error(copy("No se pudo subir la imagen.", "Image upload failed."));
    return result.url as string;
  }

  document.querySelector<HTMLInputElement>("#avatar-input")?.addEventListener("change", async (event) => {
    const input = event.currentTarget as HTMLInputElement;
    const file = input.files?.[0];
    if (!file) return;
    try {
      if (feedback) feedback.textContent = copy("Subiendo foto…", "Uploading picture…");
      const url = await uploadImage("avatar", file);
      const preview = document.querySelector<HTMLImageElement>("#avatar-preview");
      if (preview) preview.src = url;
      if (feedback) feedback.textContent = copy("Foto de perfil actualizada.", "Profile picture updated.");
    } catch (error) {
      if (feedback) feedback.textContent = error instanceof Error ? error.message : copy("Error al subir.", "Upload error.");
    } finally { input.value = ""; }
  });

  document.querySelector<HTMLInputElement>("#cover-input")?.addEventListener("change", async (event) => {
    const input = event.currentTarget as HTMLInputElement;
    const file = input.files?.[0];
    if (!file) return;
    try {
      if (feedback) feedback.textContent = copy("Subiendo banner…", "Uploading cover…");
      const url = await uploadImage("cover", file);
      const preview = document.querySelector<HTMLElement>("#cover-preview");
      if (preview) preview.style.backgroundImage = `linear-gradient(0deg, rgba(5,5,5,.94), rgba(5,5,5,.08)), url("${url}")`;
      if (feedback) feedback.textContent = copy("Banner actualizado.", "Cover updated.");
    } catch (error) {
      if (feedback) feedback.textContent = error instanceof Error ? error.message : copy("Error al subir.", "Upload error.");
    } finally { input.value = ""; }
  });

  document.querySelector<HTMLButtonElement>("#save-profile")?.addEventListener("click", async (event) => {
    const button = event.currentTarget as HTMLButtonElement;
    button.disabled = true;
    if (feedback) feedback.textContent = copy("Guardando…", "Saving…");
    try {
      const response = await fetch("/api/auth/profile", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        credentials: "same-origin",
        body: JSON.stringify({
          bio: (document.querySelector<HTMLTextAreaElement>("#profile-bio")?.value || "").trim(),
          location: (document.querySelector<HTMLInputElement>("#profile-location")?.value || "").trim()
        })
      });
      const result = await response.json();
      if (!response.ok || !result.ok) throw new Error(copy("No se pudieron guardar los cambios.", "Could not save changes."));
      if (feedback) feedback.textContent = copy("Perfil actualizado.", "Profile updated.");
    } catch (error) {
      if (feedback) feedback.textContent = error instanceof Error ? error.message : copy("Error al guardar.", "Save error.");
    } finally { button.disabled = false; }
  });

  logoutButton?.addEventListener("click", async () => {
    logoutButton.disabled = true;
    logoutButton.textContent = isEnglish ? "Logging out…" : "Cerrando sesión…";
    try {
      const response = await fetch("/api/auth/logout", { method: "POST", credentials: "same-origin" });
      if (!response.ok) throw new Error("logout_failed");
      window.location.href = isEnglish ? "/en/login/" : "/login/";
    } catch {
      logoutButton.disabled = false;
      logoutButton.textContent = isEnglish ? "Log out" : "Cerrar sesión";
    }
  });
</script>
