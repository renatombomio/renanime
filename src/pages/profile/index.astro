---
export const prerender = false;
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/layout/Navbar.astro";
import { createSupabaseSsrClient } from "../../lib/supabase-ssr";
import { localizedPath } from "../../i18n";

const lang = Astro.locals.lang;
const isEnglish = lang === "en";
const user = Astro.locals.renanimeUser;
if (!user) return Astro.redirect(localizedPath(Astro.locals.lang, "/login/"));
const supabase = createSupabaseSsrClient(Astro.request, Astro.cookies);
const { data: libraryData, error: libraryError } = await supabase
  .from("user_anime")
  .select("anime_id, status, updated_at")
  .eq("user_id", user.id)
  .order("updated_at", { ascending: false });

if (libraryError) {
  console.error("Renanime profile library error:", libraryError.message);
}

const { data: profileData } = await supabase
  .from("profiles")
  .select("id, name, aka, headline, bio, location, avatar_url, cover_url, interests, created_at")
  .eq("id", user.id)
  .maybeSingle();
const profile = { ...user, ...profileData };
const library = Array.isArray(libraryData) ? libraryData : [];
const watched = library.filter((entry: any) => entry?.status === "seen");
const pending = library.filter((entry: any) => entry?.status === "pending");

---

<Layout
  title={`${isEnglish ? "My Profile" : "Mi perfil"} — Renanime's Gallery`}
  description={isEnglish ? "Your personal profile on Renanime." : "Tu perfil personal en Renanime."}
>
  <Navbar />

  <main class="profile-page">
    <section class="profile-card">
      <section class="profile-editor" aria-labelledby="profile-editor-title">
        <div class="cover-preview" id="cover-preview" style={profile.cover_url ? `background-image: linear-gradient(0deg, rgba(5,5,5,.94), rgba(5,5,5,.08)), url("${profile.cover_url}")` : undefined}>
          <label class="media-edit cover-edit" for="cover-input">
            <span>{isEnglish ? "Add cover photo" : "Añadir foto de portada"}</span>
          </label>
          <input class="cover-file-input" id="cover-input" name="cover" type="file" accept="image/jpeg,.jpg,.jpeg,.png,.webp,.avif" aria-label={isEnglish ? "Choose cover photo" : "Elegir foto de portada"} />
          <span id="cover-upload-feedback" class="cover-upload-feedback" role="status" aria-live="polite"></span>
        </div>
        <div class="identity-editor">
          <div class="avatar-wrap">
            <img id="avatar-preview" class="avatar-preview" src={profile.avatar_url || "/images/profile-avatar-placeholder.svg"} alt={isEnglish ? "Profile picture" : "Foto de perfil"} />
            <label class="avatar-edit" for="avatar-input" aria-label={isEnglish ? "Change profile picture" : "Cambiar foto de perfil"} title={isEnglish ? "Change profile picture" : "Cambiar foto de perfil"}>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7.5h3l1.5-2h7l1.5 2h3v11H4z"/><circle cx="12" cy="13" r="3.2"/></svg>
            </label>
            <input class="file-input" id="avatar-input" type="file" accept="image/jpeg,image/png,image/webp,image/avif" />
          </div>
          <div class="identity-copy">
            <h2 id="identity-name">{profile.name}</h2>
            <p class="handle" id="identity-aka">@{profile.aka}</p>
          </div>
          <button class="profile-edit-toggle" id="toggle-profile-editor" type="button" aria-expanded="false" aria-controls="profile-editor-fields" aria-label={isEnglish ? "Edit profile information" : "Editar información del perfil"} title={isEnglish ? "Edit profile" : "Editar perfil"}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L8 18l-4 1 1-4Z"/></svg>
          </button>
        </div>
        <div class="editor-fields" id="profile-editor-fields" hidden>
          <h2 id="profile-editor-title">{isEnglish ? "Edit your information" : "Editar tu información"}</h2>
          <label>{isEnglish ? "Display name" : "Nombre"}
            <input id="profile-name" maxlength="40" value={profile.name || ""} placeholder={isEnglish ? "Your name" : "Tu nombre"} />
          </label>
          <label>{isEnglish ? "Username" : "Nombre de usuario"}
            <div class="username-input"><span>@</span><input id="profile-aka" maxlength="24" value={profile.aka || ""} placeholder="username" /></div>
          </label>
          <label>{isEnglish ? "Profile headline" : "Título"}
            <input id="profile-headline" maxlength="80" value={profile.headline || ""} placeholder={isEnglish ? "A line that says something about you…" : "Una frase que te represente…"} />
          </label>
          <label>{isEnglish ? "About me" : "Sobre mí"}
            <textarea id="profile-bio" maxlength="280" placeholder={isEnglish ? "Tell the community a little about yourself…" : "Cuéntale a la comunidad algo sobre ti…"}>{profile.bio || ""}</textarea>
          </label>
          <label>{isEnglish ? "Favourite anime genres" : "Géneros de anime favoritos"}
            <input id="profile-interests" maxlength="180" value={(profile.interests || []).join(", ")} placeholder={isEnglish ? "Action, fantasy, psychological…" : "Acción, fantasía, psicológico…"} />
            <span class="field-hint">{isEnglish ? "Separate genres with commas." : "Separa los géneros con comas."}</span>
          </label>
          <label>{isEnglish ? "Location (optional)" : "Ubicación (opcional)"}
            <input id="profile-location" maxlength="80" value={profile.location || ""} placeholder={isEnglish ? "City, country" : "Ciudad, país"} />
          </label>
          <div class="editor-actions">
            <button class="save-profile" id="save-profile" type="button">{isEnglish ? "Save changes" : "Guardar cambios"}</button>
            <p id="profile-feedback" role="status" aria-live="polite"></p>
          </div>
          <p class="upload-note">{isEnglish ? "JPG, PNG, WebP or AVIF · Max. 5 MB per image." : "JPG, PNG, WebP o AVIF · Máximo 5 MB por imagen."}</p>
        </div>
      </section>

      <section class="profile-about" aria-label={isEnglish ? "About" : "Sobre mí"}>
        {profile.headline && <h1 id="profile-headline-view">{profile.headline}</h1>}
        {profile.bio && <p id="profile-bio-view">{profile.bio}</p>}
        {profile.location && <p class="profile-location-view">{profile.location}</p>}
        <div class="genre-tags" id="profile-genre-tags">
          {(profile.interests || []).map((genre: string) => <span>#{genre}</span>)}
        </div>
      </section>

      <section class="profile-stats" aria-label={isEnglish ? "Anime activity" : "Actividad anime"}>
        <a href={localizedPath(Astro.locals.lang, "/collection/")} class="profile-stat">
          <strong>{watched.length}</strong><span>{isEnglish ? "Viewed anime" : "Animes vistos"}</span>
        </a>
        <a href={localizedPath(Astro.locals.lang, "/pending/")} class="profile-stat">
          <strong>{pending.length}</strong><span>{isEnglish ? "On my list" : "En mi lista"}</span>
        </a>
        <div class="profile-stat"><strong>—</strong><span>{isEnglish ? "Activity" : "Actividad"}</span></div>
      </section>

      <section class="profile-library-links">
        <div class="profile-library-heading"><h2>{isEnglish ? "Watched anime" : "Animes vistos"}</h2><a href={localizedPath(Astro.locals.lang, "/collection/")}>{isEnglish ? "See all" : "Ver todos"}</a></div>
        <div class="profile-anime-grid" id="profile-watched-grid" data-ids={JSON.stringify(watched.slice(0, 4).map((entry: any) => String(entry.anime_id)))}></div>
        <div class="profile-library-heading"><h2>{isEnglish ? "Watchlist" : "Mi lista"}</h2><a href={localizedPath(Astro.locals.lang, "/pending/")}>{isEnglish ? "See all" : "Ver todos"}</a></div>
        <div class="profile-anime-grid" id="profile-pending-grid" data-ids={JSON.stringify(pending.slice(0, 4).map((entry: any) => String(entry.anime_id)))}></div>
      </section>

      <div class="profile-actions">
        <button class="delete-account-button" id="delete-account-button" type="button">{isEnglish ? "Delete account" : "Eliminar cuenta"}</button>
      </div>
    </section>
  </main>
</Layout>

<style>
  .profile-editor { margin: 0; overflow: visible; border: 0; border-radius: 0; background: transparent; }
  .cover-preview { position: relative; width: 100%; height: clamp(210px, 34vw, 340px); background: linear-gradient(135deg,#24202a,#111); background-size: cover; background-position: center; isolation: isolate; }
  .cover-file-input { position:absolute; inset:0; z-index:3; width:100%; height:100%; opacity:0; cursor:pointer; font-size:100px; }
  .cover-edit { pointer-events:none; }
  .cover-upload-feedback { position:absolute; z-index:4; left:1rem; bottom:.75rem; max-width:55%; color:#fff; font-size:.72rem; text-shadow:0 1px 5px #000; pointer-events:none; }
  .cover-preview::after { content: ""; position: absolute; inset: 0; z-index: 0; pointer-events: none; background: linear-gradient(180deg, rgba(0,0,0,.02) 28%, rgba(0,0,0,.22) 58%, #050505 100%); }
   .cover-edit { position: absolute; right: 1rem; bottom: 1rem; z-index: 2; display: none; }
  .profile-editor.is-editing .cover-edit { display: inline-flex; }
  .profile-editor.is-editing .avatar-edit { display: grid; }
  .media-edit { display:inline-flex; align-items:center; border: 1px solid rgba(255,255,255,.35); border-radius: 999px; padding: .65rem .9rem; color: white; background: rgba(0,0,0,.45); backdrop-filter: blur(10px); cursor: pointer; font: inherit; font-size: .78rem; }

  .file-input { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; opacity: 0; }
  .identity-editor { display: flex; align-items: end; gap: 1rem; padding: 0 1.5rem; margin-top: -3.4rem; position: relative; }
  .avatar-wrap { position: relative; flex: 0 0 auto; }
  .avatar-preview { width: 112px; height: 112px; border-radius: 50%; object-fit: cover; border: 4px solid #090909; background: #242424; }
  .avatar-edit { display: none; place-items: center; position: absolute; right: -2px; bottom: 5px; width: 36px; height: 36px; border: 2px solid #090909; border-radius: 50%; background: #ec4899; color: white; cursor: pointer; box-shadow: 0 3px 12px rgba(0,0,0,.4); }
  .avatar-edit svg { width: 17px; height: 17px; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
  .identity-copy { padding-bottom: .45rem; min-width: 0; flex: 1; }
  .profile-edit-toggle { display: grid; place-items: center; flex: 0 0 42px; width: 42px; height: 42px; margin: 0 0 .55rem auto; border: 1px solid rgba(255,255,255,.2); border-radius: 50%; background: rgba(255,255,255,.06); color: #fff; cursor: pointer; }
  .profile-edit-toggle svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
  .username-input { display: flex; align-items: center; gap: .5rem; padding-left: 1rem; border: 1px solid rgba(255,255,255,.13); border-radius: 12px; background: rgba(255,255,255,.04); color: #888; }
  .username-input input { border: 0; background: transparent; padding-left: 0; }
  .identity-copy h2 { margin: .2rem 0; font-size: clamp(1.4rem,3vw,2rem); }
  .handle { margin: 0; color: #aaa; font-size: .85rem; }
  .editor-fields { display: grid; gap: 1rem; padding: 1.5rem; }
  .editor-fields[hidden] { display: none; }
  .editor-fields h2 { margin: 0; font-size: 1.15rem; }
  .editor-fields label { display: grid; gap: .45rem; color: #aaa; font-size: .78rem; }
  .editor-fields textarea,.editor-fields input { width: 100%; border: 1px solid rgba(255,255,255,.13); border-radius: 12px; padding: .85rem 1rem; background: rgba(255,255,255,.04); color: white; font: inherit; font-size: .9rem; }
  .editor-fields textarea { min-height: 96px; resize: vertical; }
  .editor-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 1rem; }
  .save-profile { border: 0; border-radius: 999px; padding: .8rem 1.2rem; background: #ec4899; color: white; font: inherit; font-size: .82rem; font-weight: 650; cursor: pointer; }
  .save-profile:disabled { opacity: .55; cursor: wait; }
  #profile-feedback { margin: 0; color: #9ed9b0; font-size: .8rem; }
  .upload-note { margin: 0; color: #777; font-size: .72rem; }
  .profile-page {
    min-height: 100vh;
    padding: 88px 0 2.5rem;
  }

  .profile-card { width: min(100%, 860px); margin: 0 auto; }
  .profile-about { padding: 1.25rem 1.5rem .5rem; }
  .profile-about h1 { margin: 0 0 .55rem; font-size: clamp(1.35rem, 4vw, 2rem); line-height: 1.15; letter-spacing: -.025em; }
  .profile-about p { margin: .4rem 0; color: #c5c5c5; font-size: .92rem; line-height: 1.55; }
  .profile-location-view { color: #888 !important; font-size: .78rem !important; }
  .genre-tags { display: flex; flex-wrap: wrap; gap: .45rem; margin-top: .9rem; }
  .genre-tags span { padding: .42rem .65rem; border: 1px solid rgba(255,255,255,.12); border-radius: 999px; background: rgba(255,255,255,.045); color: #ddd; font-size: .68rem; }
  .profile-stats { display: grid; grid-template-columns: repeat(3,1fr); gap: .5rem; padding: 1rem 1.5rem; }
  .profile-stat { display: grid; gap: .25rem; color: inherit; text-decoration: none; }
  .profile-stat strong { font-size: 1.45rem; font-weight: 650; }
  .profile-stat span { color: #888; font-size: .65rem; }
  .profile-library-links { padding: .5rem 1.5rem 2rem; }
  .profile-library-heading { display:flex; align-items:center; justify-content:space-between; margin-top:1.25rem; }
  .profile-library-heading h2 { margin:0; font-size:1.05rem; }
  .profile-library-heading a { color:#ec4899; font-size:.72rem; text-decoration:none; }
  .profile-anime-grid { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:.55rem; margin-top:.8rem; }
  .profile-anime-card { display:block; min-width:0; overflow:hidden; border-radius:9px; aspect-ratio:2/3; background:#171717; color:#eee; text-decoration:none; position:relative; }
  .profile-anime-card img { width:100%; height:100%; display:block; object-fit:cover; }
  .profile-anime-card span { position:absolute; inset:auto 0 0; padding:1.2rem .4rem .45rem; background:linear-gradient(transparent,rgba(0,0,0,.9)); font-size:.62rem; line-height:1.2; }
  .profile-anime-empty { grid-column:1/-1; padding:.8rem 0; color:#777; font-size:.75rem; }
  .field-hint { color:#777; font-size:.68rem; }
  

  .profile-header {
    padding-bottom: 1.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.09);
  }

  .eyebrow,
  .section-label,
  .info-label,
  .stat-label {
    font-size: 0.68rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    opacity: 0.48;
  }

  .eyebrow {
    margin: 0 0 0.8rem;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.75rem, 7vw, 5.5rem);
    line-height: 0.9;
    letter-spacing: -0.045em;
  }

  .community-line {
    margin: .65rem 0 0;
    max-width: 620px;
    font-size: 0.95rem;
    line-height: 1.6;
    opacity: 0.62;
  }

  .community-line strong {
    color: #ff4f8b;
    font-weight: 600;
  }

  .stat-card {
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.025);
  }

  .stat-label {
    display: block;
    margin-bottom: 0.65rem;
  }

  .library-section {
    margin-top: 2rem;
  }

  .section-label {
    margin: 0 0 1rem;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  .stat-card {
    padding: 1.15rem 1.35rem;
  }

  .stat-number {
    display: block;
    font-size: clamp(2.6rem, 6vw, 4rem);
    line-height: 0.9;
    letter-spacing: -0.04em;
  }

  .stat-label {
    margin: 1rem 0 0;
  }

  .profile-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .profile-actions a {
    padding: 0.65rem .85rem;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 12px;
    color: inherit;
    text-decoration: none;
    transition: border-color 0.2s ease, background 0.2s ease;
  }

  .profile-actions a:hover {
    border-color: rgba(255, 79, 139, 0.45);
    background: rgba(255, 79, 139, 0.06);
  }

  .profile-actions button {
    padding: 0.85rem 1rem;
    border: 1px solid rgba(255, 79, 139, 0.28);
    border-radius: 12px;
    background: transparent;
    color: inherit;
    font: inherit;
    cursor: pointer;
    transition: border-color 0.2s ease, background 0.2s ease;
  }

  .profile-actions button:hover:not(:disabled) {
    border-color: rgba(255, 79, 139, 0.55);
    background: rgba(255, 79, 139, 0.06);
  }

  .profile-actions button:disabled { cursor: wait; opacity: 0.55; }
  .profile-actions .delete-account-button { border-color: rgba(239,68,68,.35); color:#fca5a5; }

  @media (max-width: 520px) {
    .profile-page { padding: 68px 0 1.5rem; }
    .profile-card { width: 100%; }
    .cover-preview { height: 220px; }
    .identity-editor { padding: 0 1.25rem; }
    .editor-fields { padding: 1rem 1.25rem; }
    .identity-editor { padding: 0 1.25rem; margin-top: -2.8rem; gap: .75rem; }
    .avatar-preview { width: 88px; height: 88px; }
    .editor-fields { padding: 1rem 1.25rem; }
    .cover-preview { height: 220px; }

    .profile-card { width: 100%; }
    .profile-about { padding: 1rem 1.25rem .4rem; }
    .profile-stats { padding: .8rem 1.25rem; }
    .profile-library-links { padding: .4rem 1.25rem 1.5rem; }

    .stats {
      grid-template-columns: 1fr 1fr;
      gap: .65rem;
    }

    .stat-card {
      padding: 1rem;
      border-radius: 15px;
    }

    .stat-number {
      font-size: 2.5rem;
    }

    .stat-label {
      font-size: .58rem;
      line-height: 1.25;
    }

    .profile-actions {
      margin-top: .75rem;
    }

    .profile-actions a,
    .profile-actions button {
      padding: .6rem .75rem;
      font-size: .8rem;
    }
  }
</style>


<script>
  const isEnglish = document.documentElement.lang === "en";
  const profileEditor = document.querySelector<HTMLElement>(".profile-editor");
  const editorToggle = document.querySelector<HTMLButtonElement>("#toggle-profile-editor");
  const editorFields = document.querySelector<HTMLElement>("#profile-editor-fields");
  editorToggle?.addEventListener("click", () => {
    if (!editorFields) return;
    const opening = editorFields.hidden;
    editorFields.hidden = !opening;
    profileEditor?.classList.toggle("is-editing", opening);
    editorToggle.setAttribute("aria-expanded", String(opening));
    if (opening) editorFields.querySelector<HTMLInputElement>("input")?.focus();
  });
  const feedback = document.querySelector<HTMLElement>("#profile-feedback");
  const copy = (es: string, en: string) => isEnglish ? en : es;

  async function loadProfileAnime() {
    const grids = ["#profile-watched-grid", "#profile-pending-grid"].map(selector => document.querySelector<HTMLElement>(selector)).filter(Boolean) as HTMLElement[];
    const ids = [...new Set(grids.flatMap(grid => JSON.parse(grid.dataset.ids || "[]") as string[]))].filter(id => /^\d+$/.test(id));
    if (!ids.length) {
      grids.forEach(grid => { grid.innerHTML = '<span class="profile-anime-empty">' + copy("Todavía no hay animes aquí.", "No anime here yet.") + '</span>'; });
      return;
    }
    const variables: Record<string, number> = {};
    const fields = ids.map((id, index) => { variables["id" + index] = Number(id); return `a${index}: Media(id: $id${index}, type: ANIME) { id title { romaji english } coverImage { large } }`; }).join("\n");
    const definitions = ids.map((_, index) => `$id${index}: Int!`).join(", ");
    try {
      const response = await fetch("https://graphql.anilist.co", { method:"POST", headers:{"Content-Type":"application/json","Accept":"application/json"}, body:JSON.stringify({query:`query ProfileAnime(${definitions}) { ${fields} }`,variables}) });
      if (!response.ok) throw new Error("anime_fetch_failed");
      const payload = await response.json();
      const media = new Map(ids.map((id,index) => [id,payload.data?.["a"+index]]));
      grids.forEach(grid => {
        const gridIds = JSON.parse(grid.dataset.ids || "[]") as string[];
        const cards: HTMLElement[] = gridIds.map(id => {
          const anime = media.get(id);
          if (!anime) return null;
          const title = anime.title?.english || anime.title?.romaji || "Anime";
          const card = document.createElement("a"); card.className = "profile-anime-card"; card.href = (isEnglish ? "/en" : "") + "/anime/" + id; card.setAttribute("aria-label",title);
          const img = document.createElement("img"); img.src = anime.coverImage?.large || ""; img.alt = ""; img.loading = "lazy";
          const label = document.createElement("span"); label.textContent = title;
          card.append(img,label); return card;
        }).filter((card): card is HTMLAnchorElement => card instanceof HTMLAnchorElement);
        grid.replaceChildren(...(cards.length ? cards : [Object.assign(document.createElement("span"),{className:"profile-anime-empty",textContent:copy("No se pudieron cargar los animes.","Could not load anime.")})]));
      });
    } catch {
      grids.forEach(grid => { grid.innerHTML = '<span class="profile-anime-empty">' + copy("No se pudieron cargar los animes.", "Could not load anime.") + '</span>'; });
    }
  }
  void loadProfileAnime();

  async function uploadImage(kind: "avatar" | "cover", file: File) {
    if (file.size > 5 * 1024 * 1024) throw new Error(copy("La imagen supera el límite de 5 MB.", "Image exceeds the 5 MB limit."));
    const form = new FormData();
    form.set("kind", kind);
    form.set("file", file);
    const response = await fetch("/api/auth/profile/media", { method: "POST", body: form, credentials: "same-origin" });
    const result = await response.json().catch(() => ({}));
    if (!response.ok || !result.ok) {
      const reason = typeof result.error === "string" ? result.error : "UPLOAD_FAILED";
      throw new Error(copy("No se pudo subir la imagen (" + reason + ").", "Image upload failed (" + reason + ")."));
    }
    return result.url as string;
  }

  // Delegate media controls: Astro ClientRouter swaps page DOM without rerunning this module.


  document.addEventListener("change", async (event) => {
    const input = event.target;
    if (!(input instanceof HTMLInputElement) || (input.id !== "avatar-input" && input.id !== "cover-input")) return;
    const file = input.files?.[0];
    if (!file) return;
    const kind = input.id === "avatar-input" ? "avatar" : "cover";
    const status = document.querySelector<HTMLElement>("#profile-feedback") || document.querySelector<HTMLElement>("#cover-upload-feedback");
    try {
      if (status) status.textContent = kind === "avatar" ? copy("Subiendo foto…", "Uploading picture…") : copy("Subiendo banner…", "Uploading cover…");
      const url = await uploadImage(kind, file);
      if (kind === "avatar") {
        const preview = document.querySelector<HTMLImageElement>("#avatar-preview");
        if (preview) preview.src = url;
      } else {
        const preview = document.querySelector<HTMLElement>("#cover-preview");
        if (preview) {
          preview.style.backgroundImage = `url("${url}")`;
          preview.dataset.coverUrl = url;
        }
      }
      if (status) status.textContent = kind === "avatar" ? copy("Foto de perfil actualizada.", "Profile picture updated.") : copy("Banner actualizado.", "Cover updated.");
    } catch (error) {
      if (status) status.textContent = error instanceof Error ? error.message : copy("Error al subir.", "Upload error.");
    } finally { input.value = ""; }
  });

  document.querySelector<HTMLButtonElement>("#save-profile")?.addEventListener("click", async (event) => {
    const button = event.currentTarget as HTMLButtonElement;
    button.disabled = true;
    if (feedback) feedback.textContent = copy("Guardando…", "Saving…");
    try {
      const response = await fetch("/api/auth/profile", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        credentials: "same-origin",
        body: JSON.stringify({
          name: (document.querySelector<HTMLInputElement>("#profile-name")?.value || "").trim(),
          aka: (document.querySelector<HTMLInputElement>("#profile-aka")?.value || "").trim(),
          bio: (document.querySelector<HTMLTextAreaElement>("#profile-bio")?.value || "").trim(),
          location: (document.querySelector<HTMLInputElement>("#profile-location")?.value || "").trim(),
          headline: (document.querySelector<HTMLInputElement>("#profile-headline")?.value || "").trim(),
          interests: (document.querySelector<HTMLInputElement>("#profile-interests")?.value || "").split(",").map(value => value.trim()).filter(Boolean)
        })
      });
      const result = await response.json();
      if (!response.ok || !result.ok) throw new Error(copy("No se pudieron guardar los cambios.", "Could not save changes."));
      const savedName = result.profile?.name || (document.querySelector<HTMLInputElement>("#profile-name")?.value || "").trim();
      const savedAka = result.profile?.aka || (document.querySelector<HTMLInputElement>("#profile-aka")?.value || "").trim();
      const nameNode = document.querySelector<HTMLElement>("#identity-name");
      const akaNode = document.querySelector<HTMLElement>("#identity-aka");
      if (nameNode) nameNode.textContent = savedName;
      if (akaNode) akaNode.textContent = "@" + savedAka;
      const headline = (document.querySelector<HTMLInputElement>("#profile-headline")?.value || "").trim();
      const bio = (document.querySelector<HTMLTextAreaElement>("#profile-bio")?.value || "").trim();
      const interests = (document.querySelector<HTMLInputElement>("#profile-interests")?.value || "").split(",").map(value => value.trim()).filter(Boolean);
      const headlineView = document.querySelector<HTMLElement>("#profile-headline-view");
      if (headline && headlineView) headlineView.textContent = headline;
      else if (headline) {
        const node = document.createElement("h1"); node.id = "profile-headline-view"; node.textContent = headline;
        document.querySelector(".profile-about")?.prepend(node);
      } else headlineView?.remove();
      const bioView = document.querySelector<HTMLElement>("#profile-bio-view");
      if (bio && bioView) bioView.textContent = bio;
      else if (bio) {
        const node = document.createElement("p"); node.id = "profile-bio-view"; node.textContent = bio;
        document.querySelector(".profile-about")?.append(node);
      } else bioView?.remove();
      const tags = document.querySelector<HTMLElement>("#profile-genre-tags");
      if (tags) tags.replaceChildren(...interests.map(genre => { const tag = document.createElement("span"); tag.textContent = "#" + genre; return tag; }));
      if (feedback) feedback.textContent = copy("Perfil actualizado.", "Profile updated.");
    } catch (error) {
      if (feedback) feedback.textContent = error instanceof Error ? error.message : copy("Error al guardar.", "Save error.");
    } finally { button.disabled = false; }
  });


</script>
