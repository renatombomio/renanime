---
export const prerender = false;
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/layout/Navbar.astro";
import Footer from "../../components/layout/Footer.astro";
import { getRenanimeUser } from "../../lib/auth";
import { supabaseServer } from "../../lib/supabase-server";

const token = Astro.cookies.get("renanime_session")?.value;
const user = await getRenanimeUser(token);

if (!user) {
  return Astro.redirect("/login");
}

const { data: libraryData, error: libraryError } = await supabaseServer.rpc("renanime_get_library", {
  p_token: token,
});

if (libraryError) {
  console.error("Renanime profile library error:", libraryError.message);
}

const profile = user;
const library = Array.isArray(libraryData) ? libraryData : [];
const watched = library.filter((entry: any) => entry?.state?.status === "WATCHED");
const pending = library.filter((entry: any) => entry?.state?.status === "PENDING");

const joinedDate = profile.created_at
  ? new Intl.DateTimeFormat("es-ES", {
      day: "numeric",
      month: "long",
      year: "numeric",
    }).format(new Date(profile.created_at))
  : "—";
---

<Layout
  title="Mi perfil — Renanime's Gallery"
  description="Tu perfil personal en Renanime."
>
  <Navbar />

  <main class="profile-page">
    <section class="profile-card">
      <header class="profile-header">
        <p class="eyebrow">MI PERFIL</p>
        <h1>{profile.name}</h1>
        <p class="community-line">
          Miembro de la comunidad otaku desde <strong>{joinedDate}</strong>.
        </p>
      </header>

      <section class="library-section">
        <p class="section-label">MI RENANIME</p>

        <div class="stats">
          <article class="stat-card">
            <span class="stat-number" data-personal-count="PENDING">{pending.length}</span>
            <span class="stat-label">ANIMES EN MI LISTA</span>
          </article>

          <article class="stat-card">
            <span class="stat-number" data-personal-count="WATCHED">{watched.length}</span>
            <span class="stat-label">ANIMES EN MI COLECCIÓN</span>
          </article>
        </div>
      </section>

      <section class="recovery-section">
        <div>
          <p class="section-label">CÓDIGO DE RECUPERACIÓN</p>
          <p class="recovery-description">
            Guárdalo en un lugar seguro. Lo necesitarás para recuperar tu acceso desde otro dispositivo.
          </p>
        </div>

        <div class="recovery-code">{profile.recovery_code}</div>
      </section>

      <div class="profile-actions">
        <a href="/collection/">Ver mi colección</a>
        <a href="/pending/">Ver mi lista</a>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .profile-page {
    min-height: 100vh;
    padding: 128px 1.25rem 5rem;
  }

  .profile-card {
    width: min(100%, 860px);
    margin: 0 auto;
  }

  .profile-header {
    padding-bottom: 2.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.09);
  }

  .eyebrow,
  .section-label,
  .info-label,
  .stat-label {
    font-size: 0.68rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    opacity: 0.48;
  }

  .eyebrow {
    margin: 0 0 0.8rem;
  }

  h1 {
    margin: 0;
    font-size: clamp(3rem, 9vw, 6.5rem);
    line-height: 0.9;
    letter-spacing: -0.045em;
  }

  .community-line {
    margin: 1.5rem 0 0;
    max-width: 620px;
    font-size: 0.95rem;
    line-height: 1.6;
    opacity: 0.62;
  }

  .community-line strong {
    color: #ff4f8b;
    font-weight: 600;
  }

  .stat-card {
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.025);
  }

  .stat-label {
    display: block;
    margin-bottom: 0.65rem;
  }

  .library-section {
    margin-top: 3rem;
  }

  .section-label {
    margin: 0 0 1rem;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  .stat-card {
    padding: 1.5rem;
  }

  .stat-number {
    display: block;
    font-size: clamp(3rem, 7vw, 4.5rem);
    line-height: 0.9;
    letter-spacing: -0.04em;
  }

  .stat-label {
    margin: 1rem 0 0;
  }

  .recovery-section {
    display: grid;
    gap: 1.25rem;
    margin-top: 3rem;
    padding: 1.5rem;
    border: 1px solid rgba(255, 79, 139, 0.28);
    border-radius: 20px;
    background: rgba(255, 79, 139, 0.045);
  }

  .recovery-section .section-label {
    margin-bottom: 0.5rem;
  }

  .recovery-description {
    max-width: 620px;
    margin: 0;
    font-size: 0.85rem;
    line-height: 1.55;
    opacity: 0.55;
  }

  .recovery-code {
    padding: 1.1rem 1.25rem;
    border-radius: 13px;
    background: rgba(0, 0, 0, 0.35);
    color: #ff4f8b;
    font-family: monospace;
    font-size: clamp(1rem, 4vw, 1.35rem);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-align: center;
    overflow-wrap: anywhere;
  }

  .profile-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .profile-actions a {
    padding: 0.85rem 1rem;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 12px;
    color: inherit;
    text-decoration: none;
    transition: border-color 0.2s ease, background 0.2s ease;
  }

  .profile-actions a:hover {
    border-color: rgba(255, 79, 139, 0.45);
    background: rgba(255, 79, 139, 0.06);
  }

  @media (max-width: 520px) {
    .profile-page {
      padding-top: 100px;
    }

    .stats {
      grid-template-columns: 1fr;
    }

    .profile-header {
      padding-bottom: 2rem;
    }
  }
</style>

<script>
  import { hydratePersonalLibrary } from "../../data/personal-library";
  void hydratePersonalLibrary();
</script>
