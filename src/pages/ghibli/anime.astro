---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/layout/Navbar.astro";
import Footer from "../../components/layout/Footer.astro";
import AnimeSearchDetail from "../../components/anime/AnimeSearchDetail";
const { lang } = Astro.locals;
const pageTitle = lang === "en" ? "Ghibli film — Renanime's Gallery" : "Película Ghibli — Renanime's Gallery";
---
<Layout title={pageTitle} description={lang === "en" ? "Discover the story, details and recommendations behind a Studio Ghibli film." : "Descubre la historia, los detalles y las recomendaciones de una película de Studio Ghibli."}>
  <Navbar variant="ghibli" />
  <main id="main-content" class="anime-detail-page"><AnimeSearchDetail variant="ghibli" lang={lang} client:load /></main>
  <Footer />
</Layout>
