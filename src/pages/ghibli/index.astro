---
import Layout from "../../layouts/Layout.astro";
import GhibliView from "../../components/ghibli/GhibliView";
import Navbar from "../../components/layout/Navbar.astro";
import Hero from "../../components/hero/Hero.astro";
import { getGhibliFilms } from "../../data/ghibli";
import "../../styles/ghibli-tokens.css";

const films = getGhibliFilms();
---

<Layout title="El secreto de Ren — Renanime's Gallery">
  <div class="ghibli-shell">
    <Navbar variant="ghibli" />

    <main id="main-content" class="ghibli-page">
      <Hero
        kicker="Bienvenidos a"
        title="Ghibli."
        copy="Mi rincón favorito del anime. Aquí escapo para conectar con la naturaleza, la música, la comida, lo simple, la VIDA."
        videoSrc="/videos/hero2.mp4"
      />

      <section id="archivo" class="ghibli-content" aria-labelledby="archive-title">
        <div class="ghibli-section-heading">
          <div>
            <p>Mi archivo</p>
            <h2 id="archive-title">Un mundo por descubrir.</h2>
          </div>
        </div>
        <GhibliView films={films} client:load />
      </section>
    </main>

    <footer class="ghibli-footer"><span>Renanime</span><span>Hecho de recuerdos, viento y películas.</span></footer>
  </div>
</Layout>

<style>
.ghibli-page{min-height:100vh;background:var(--ghibli-cream);color:var(--ghibli-ink);font-family:var(--ghibli-body);padding-top:88px}
@media(max-width:1120px){.ghibli-page{padding-top:74px}}
@media(max-width:600px){.ghibli-page{padding-top:68px}.ghibli-section-heading{display:block}.ghibli-section-heading h2{font-size:3rem}}

.ghibli-page .ghibli-meta{display:flex;justify-content:space-between;gap:1rem;padding:0 0 1rem;border:0;border-bottom:1px solid rgba(25,54,47,.16);color:var(--ghibli-moss);font:600 .62rem/1 var(--ghibli-meta);letter-spacing:.08em;text-transform:uppercase}.ghibli-page .ghibli-meta strong{color:var(--ghibli-coral);font-size:.8rem}
.ghibli-page .ghibli-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:clamp(2rem,5vw,5rem) 1.15rem}
.ghibli-page .ghibli-card{overflow:hidden;border:0;border-radius:var(--ghibli-radius);background:#fff;box-shadow:0 12px 35px rgba(25,54,47,.08);border:1px solid rgba(25,54,47,.08);transition:transform .45s var(--ghibli-ease)}
.ghibli-page .ghibli-card:hover{border-color:rgba(25,54,47,.12);transform:translateY(-8px);box-shadow:0 20px 45px rgba(25,54,47,.12)}
.ghibli-page .ghibli-card a{display:block;color:var(--ghibli-ink)}
.ghibli-page .ghibli-poster{position:relative;aspect-ratio:2/3;overflow:hidden;border-radius:var(--ghibli-radius);background:var(--ghibli-sky);box-shadow:0 18px 45px var(--ghibli-shadow)}
.ghibli-page .ghibli-poster:after{position:absolute;inset:0;background:linear-gradient(180deg,transparent 62%,rgba(25,54,47,.2));content:"";pointer-events:none}
.ghibli-page .ghibli-poster img{width:100%;height:100%;object-fit:cover;transition:transform .8s var(--ghibli-ease)}.ghibli-page .ghibli-card:hover .ghibli-poster img{transform:scale(1.045)}
.ghibli-page .ghibli-year{position:absolute;left:.8rem;bottom:.8rem;z-index:2;padding:.4rem .55rem;border-radius:999px;background:rgba(255,247,232,.88);color:var(--ghibli-blue);font:600 .52rem/1 var(--ghibli-meta);letter-spacing:.08em}
.ghibli-page .ghibli-badge{position:absolute;right:.8rem;top:.8rem;z-index:2;padding:.4rem .55rem;border:0;border-radius:999px;background:var(--ghibli-lime);color:var(--ghibli-ink);font:600 .5rem/1 var(--ghibli-meta);letter-spacing:.08em;text-transform:uppercase}
.ghibli-page .ghibli-info{display:grid;min-height:6.4rem;gap:.5rem;padding:1rem 1rem 1.15rem;background:#fff}.ghibli-page .ghibli-info h3{margin:0;color:var(--ghibli-blue);font:400 1.05rem/1.08 var(--ghibli-display);letter-spacing:-.025em}.ghibli-page .ghibli-info span{color:var(--ghibli-moss);font:500 .58rem/1.4 var(--ghibli-body)}
.ghibli-page .ghibli-placeholder{display:flex;height:100%;align-items:flex-end;padding:1rem;background:linear-gradient(145deg,var(--ghibli-pink),var(--ghibli-sky));color:var(--ghibli-blue)}.ghibli-page .ghibli-placeholder strong{font:400 1rem/1.1 var(--ghibli-display)}
.ghibli-page .ghibli-loading{padding:5rem 0;color:var(--ghibli-moss);font:600 .65rem/1 var(--ghibli-meta);letter-spacing:.12em;text-transform:uppercase;text-align:center}
@media(max-width:900px){.ghibli-page .ghibli-grid{grid-template-columns:repeat(3,minmax(0,1fr))}}
@media(max-width:600px){.ghibli-page .ghibli-meta{flex-wrap:wrap}.ghibli-page .ghibli-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:2.75rem .85rem}.ghibli-page .ghibli-info{min-height:6rem;padding-top:.75rem}.ghibli-page .ghibli-info h3{font-size:.92rem}.ghibli-page .ghibli-info span{font-size:.52rem}}
@media(prefers-reduced-motion:reduce){.ghibli-page .ghibli-card,.ghibli-page .ghibli-poster img{transition:none}.ghibli-page .ghibli-card:hover{transform:none}.ghibli-page .ghibli-card:hover .ghibli-poster img{transform:none}}
</style>