---
import Layout from "../../layouts/Layout.astro";
import GhibliView from "../../components/ghibli/GhibliView";
import GhibliStory from "../../components/ghibli/GhibliStory";
import Navbar from "../../components/layout/Navbar.astro";
import Hero from "../../components/hero/Hero.astro";
import { getGhibliFilms, ghibliStory } from "../../data/ghibli";
import "../../styles/ghibli-tokens.css";

const films = getGhibliFilms();
---

<Layout title="El secreto de Ren — Renanime's Gallery">
  <div class="ghibli-shell">
    <Navbar variant="ghibli" />

    <main id="main-content" class="ghibli-page">
      <Hero
        kicker="Bienvenidos a"
        title="Mi inicio en el anime."
        copy="Mi rincón favorito del anime. Aquí escapo para conectar con la naturaleza, la música, la comida, lo simple, la VIDA."
        videoSrc="/videos/hero2.mp4"
        variant="ghibli"
      />

      <section id="archivo" class="ghibli-content" aria-labelledby="archive-title">


        <GhibliStory entries={ghibliStory} client:load />

        <header class="ghibli-archive-intro" id="archive-title">
          <h2>Descubre el universo de Estudio Ghibli</h2>
        </header>
        <GhibliView films={films} client:load />
      </section>
    </main>

    <footer class="ghibli-footer">
      <div class="ghibli-footer-mark">
        <span>Ren</span>anime
      </div>
      <p>Hecho de recuerdos, viento y películas.</p>
      <div class="ghibli-footer-line" aria-hidden="true"></div>
      <small>El secreto de Ren · Mi viaje con Ghibli</small>
    </footer>
  </div>
</Layout>

<style>
.ghibli-page{min-height:100vh;background:var(--ghibli-cream);color:var(--ghibli-ink);font-family:var(--ghibli-body);padding-top:88px}

@media(max-width:1120px){.ghibli-page{padding-top:74px}}
.ghibli-footer{
  margin-top:clamp(3rem,6vw,6rem);
  padding:clamp(3rem,6vw,5rem) var(--gutter) 2rem;
  background:#fff;
  color:var(--ghibli-ink);
  text-align:center;
}
.ghibli-footer-mark{
  font-family:var(--font-heading);
  font-size:1.35rem;
  font-weight:600;
  letter-spacing:.03em;
}
.ghibli-footer-mark span{color:var(--ghibli-blue)}
.ghibli-footer p{
  margin:.75rem 0 0;
  color:#59756b;
  font-family:var(--ghibli-display);
  font-size:1rem;
}
.ghibli-footer-line{
  width:min(240px,60%);
  height:1px;
  margin:2rem auto 1rem;
  background:rgba(25,54,47,.14);
}
.ghibli-footer small{
  color:#7b8c85;
  font:500 .5rem/1 var(--ghibli-meta);
  letter-spacing:.13em;
  text-transform:uppercase;
}
@media(max-width:600px){.ghibli-page{padding-top:68px}.ghibli-section-heading{display:block}.ghibli-section-heading h2{font-size:3rem}}


.ghibli-page .ghibli-story{
  max-width:1240px;
  margin:0 auto;
  padding:clamp(4rem,8vw,7.5rem) var(--gutter) clamp(5rem,9vw,9rem);
}
.ghibli-page .ghibli-story-intro{
  position:relative;
  display:grid;
  grid-template-columns:minmax(0,.8fr) minmax(0,1.2fr);
  min-height:500px;
  margin-bottom:clamp(3.5rem,7vw,7rem);
  overflow:hidden;
  border-radius:36px;
  background:#fff;
  box-shadow:0 24px 70px rgba(25,54,47,.1);
}
.ghibli-page .ghibli-story-intro:before{
  position:absolute;
  inset:auto 0 0;
  height:42%;
  background:linear-gradient(90deg,var(--ghibli-sky),#fff7e8);
  content:"";
}
.ghibli-page .ghibli-story-intro-art{
  position:relative;
  min-height:500px;
  overflow:hidden;
  background:linear-gradient(145deg,var(--ghibli-teal),var(--ghibli-blue));
}
.ghibli-page .ghibli-story-intro-art:before,
.ghibli-page .ghibli-story-intro-art:after{
  position:absolute;
  border-radius:50%;
  content:"";
}
.ghibli-page .ghibli-story-intro-art:before{
  width:340px;height:340px;left:-90px;bottom:-110px;
  background:var(--ghibli-lime);opacity:.9;
}
.ghibli-page .ghibli-story-intro-art:after{
  width:230px;height:230px;right:-70px;top:-70px;
  background:var(--ghibli-coral);
}
.ghibli-page .ghibli-story-art-sun{
  position:absolute;z-index:2;width:150px;height:150px;right:20%;top:17%;
  border-radius:50%;background:var(--ghibli-pink);
  box-shadow:0 0 0 24px rgba(240,169,165,.12),0 0 0 52px rgba(240,169,165,.07);
}
.ghibli-page .ghibli-story-art-leaf{
  position:absolute;z-index:3;width:120px;height:54px;
  border-radius:100% 0 100% 0;background:var(--ghibli-lime);
  transform:rotate(-28deg);
}
.ghibli-page .ghibli-story-art-leaf:after{
  position:absolute;left:50%;top:50%;width:72%;height:1px;
  background:rgba(25,54,47,.3);content:"";transform:rotate(-12deg);
}
.ghibli-page .leaf-one{left:20%;bottom:25%}
.ghibli-page .leaf-two{right:13%;bottom:13%;transform:rotate(38deg);background:var(--ghibli-pink)}
.ghibli-page .ghibli-story-intro-copy{
  position:relative;z-index:4;
  display:flex;flex-direction:column;justify-content:center;
  padding:clamp(2rem,5vw,5.5rem);
}
.ghibli-page .ghibli-story-kicker{
  margin:0 0 1.5rem;color:var(--ghibli-coral);
  font:600 .62rem/1 var(--ghibli-meta);letter-spacing:.16em;text-transform:uppercase;
}
.ghibli-page .ghibli-story-intro h2{
  margin:0;color:var(--ghibli-ink);
  font:400 clamp(3.3rem,6vw,6.8rem)/.88 var(--ghibli-display);
  letter-spacing:-.055em;
}
.ghibli-page .ghibli-story-intro h2 em{color:var(--ghibli-blue);font-style:italic}
.ghibli-page .ghibli-story-intro-copy>p:last-child{
  max-width:620px;margin:2rem 0 0;color:#49675d;
  font-size:1.02rem;line-height:1.75;
}
.ghibli-page .ghibli-story-intro-copy strong{color:var(--ghibli-red);font-weight:600}
.ghibli-page .ghibli-story-rule{
  display:flex;align-items:center;gap:1rem;margin:0 0 1rem;
  color:var(--ghibli-moss);font:600 .58rem/1 var(--ghibli-meta);
  letter-spacing:.12em;text-transform:uppercase;
}
.ghibli-page .ghibli-story-rule i{height:1px;flex:1;background:rgba(25,54,47,.18)}
.ghibli-page .ghibli-story-timeline{display:grid;gap:2.25rem}
.ghibli-page .ghibli-story-entry{
  position:relative;
  display:grid;
  grid-template-columns:42% minmax(0,1fr);
  min-height:520px;
  overflow:hidden;
  border-radius:32px;
  background:#fff;
  box-shadow:0 18px 55px rgba(25,54,47,.08);
}
.ghibli-page .ghibli-story-entry:nth-child(even){grid-template-columns:minmax(0,1fr) 42%}
.ghibli-page .ghibli-story-entry:nth-child(even) .ghibli-story-visual{order:2}
.ghibli-page .ghibli-story-entry:nth-child(even) .ghibli-story-copy{order:1}
.ghibli-page .ghibli-story-number{
  position:absolute;z-index:5;left:1.5rem;top:1.5rem;
  display:grid;place-items:center;width:48px;height:48px;border-radius:50%;
  background:var(--ghibli-cream);color:var(--ghibli-blue);
  font:600 .6rem/1 var(--ghibli-meta);box-shadow:0 8px 20px rgba(25,54,47,.12);
}
.ghibli-page .ghibli-story-visual{
  position:relative;min-height:520px;overflow:hidden;background:var(--ghibli-sky);
}
.ghibli-page .ghibli-story-visual:after{
  position:absolute;inset:0;
  background:linear-gradient(180deg,transparent 58%,rgba(25,54,47,.24));
  content:"";pointer-events:none;
}
.ghibli-page .ghibli-story-visual img{
  display:block;width:100%;height:100%;object-fit:cover;
  transition:transform .9s var(--ghibli-ease);
}
.ghibli-page .ghibli-story-entry:hover .ghibli-story-visual img{transform:scale(1.035)}
.ghibli-page .ghibli-story-year{
  position:absolute;z-index:2;right:1.2rem;bottom:1.1rem;
  padding:.5rem .7rem;border-radius:999px;
  background:rgba(255,247,232,.9);color:var(--ghibli-blue);
  font:600 .55rem/1 var(--ghibli-meta);letter-spacing:.08em;
}
.ghibli-page .ghibli-story-placeholder{
  display:grid;height:100%;min-height:520px;place-items:end;padding:2rem;
  background:linear-gradient(145deg,var(--ghibli-pink),var(--ghibli-sky));
  color:var(--ghibli-blue);font:400 2rem/1 var(--ghibli-display);
}
.ghibli-page .ghibli-story-copy{
  display:flex;flex-direction:column;justify-content:center;
  padding:clamp(2rem,5vw,5.5rem);
}
.ghibli-page .ghibli-story-chapter{
  margin:0 0 .75rem;color:var(--ghibli-coral);
  font:600 .62rem/1 var(--ghibli-meta);letter-spacing:.12em;text-transform:uppercase;
}
.ghibli-page .ghibli-story-copy h3{
  margin:0;color:var(--ghibli-blue);
  font:400 clamp(2.5rem,4vw,4.8rem)/.9 var(--ghibli-display);
  letter-spacing:-.045em;
}
.ghibli-page .ghibli-story-ren{
  max-width:600px;margin:1.5rem 0 0;color:var(--ghibli-ink);
  font:400 clamp(1rem,1.35vw,1.18rem)/1.7 var(--ghibli-body);
}
.ghibli-page .ghibli-story-creator{
  max-width:600px;margin-top:2rem;padding-top:1.2rem;
  border-top:1px solid rgba(25,54,47,.14);
}
.ghibli-page .ghibli-story-creator-label{
  display:flex;align-items:baseline;justify-content:space-between;gap:1rem;
  color:var(--ghibli-moss);
}
.ghibli-page .ghibli-story-creator-label span{
  font:600 .55rem/1 var(--ghibli-meta);letter-spacing:.12em;text-transform:uppercase;
}
.ghibli-page .ghibli-story-creator-label b{
  color:var(--ghibli-blue);font:600 .62rem/1 var(--ghibli-meta);
  letter-spacing:.05em;text-transform:uppercase;text-align:right;
}
.ghibli-page .ghibli-story-creator p{
  margin:.75rem 0 0;color:#49675d;font-size:.86rem;line-height:1.65;
}
.ghibli-page .ghibli-story-entry--pink .ghibli-story-number{color:var(--ghibli-coral)}
.ghibli-page .ghibli-story-entry--blue .ghibli-story-number{color:var(--ghibli-blue)}
.ghibli-page .ghibli-story-entry--lime .ghibli-story-number{color:var(--ghibli-moss)}
.ghibli-page .ghibli-story-entry--coral .ghibli-story-number{color:var(--ghibli-coral)}
.ghibli-page .ghibli-story-entry--teal .ghibli-story-number{color:var(--ghibli-teal)}
.ghibli-page .ghibli-story-entry--red .ghibli-story-number{color:var(--ghibli-red)}
.ghibli-page .ghibli-story-entry--sky .ghibli-story-number{color:var(--ghibli-blue)}
.ghibli-page .ghibli-story-entry--pink .ghibli-story-visual{background:var(--ghibli-pink)}
.ghibli-page .ghibli-story-entry--blue .ghibli-story-visual{background:var(--ghibli-sky)}
.ghibli-page .ghibli-story-entry--lime .ghibli-story-visual{background:var(--ghibli-lime)}
.ghibli-page .ghibli-story-entry--coral .ghibli-story-visual{background:var(--ghibli-coral)}
.ghibli-page .ghibli-story-entry--teal .ghibli-story-visual{background:var(--ghibli-teal)}
.ghibli-page .ghibli-story-entry--red .ghibli-story-visual{background:var(--ghibli-red)}
.ghibli-page .ghibli-story-entry--sky .ghibli-story-visual{background:var(--ghibli-sky)}
.ghibli-page .ghibli-story-end{
  margin:3rem 0 0;padding:clamp(4rem,8vw,7rem) 1rem;text-align:center;
}
.ghibli-page .ghibli-story-end span{
  color:var(--ghibli-coral);font:600 .6rem/1 var(--ghibli-meta);
  letter-spacing:.14em;text-transform:uppercase;
}
.ghibli-page .ghibli-story-end p{
  margin:1rem 0 0;color:var(--ghibli-blue);
  font:400 clamp(2.4rem,5vw,5rem)/.95 var(--ghibli-display);
  letter-spacing:-.045em;
}
.ghibli-page .ghibli-story-end em{color:var(--ghibli-coral);font-style:italic}
.ghibli-page .ghibli-story-loading{
  padding:7rem var(--gutter);color:var(--ghibli-moss);
  font:600 .65rem/1 var(--ghibli-meta);letter-spacing:.12em;
  text-align:center;text-transform:uppercase;
}
@media(max-width:900px){
  .ghibli-page .ghibli-story{padding-inline:var(--gutter)}
  .ghibli-page .ghibli-story-intro{grid-template-columns:38% 62%;min-height:420px;border-radius:26px}
  .ghibli-page .ghibli-story-intro-art{min-height:420px}
  .ghibli-page .ghibli-story-intro-copy{padding:2rem 2.25rem}
  .ghibli-page .ghibli-story-intro h2{font-size:clamp(2.8rem,7vw,4.4rem)}
  .ghibli-page .ghibli-story-entry,
  .ghibli-page .ghibli-story-entry:nth-child(even){grid-template-columns:40% 60%;min-height:0;border-radius:24px}
  .ghibli-page .ghibli-story-entry:nth-child(even) .ghibli-story-visual{order:2}
  .ghibli-page .ghibli-story-entry:nth-child(even) .ghibli-story-copy{order:1}
  .ghibli-page .ghibli-story-visual{min-height:430px}
  .ghibli-page .ghibli-story-placeholder{min-height:430px}
  .ghibli-page .ghibli-story-copy{padding:2.25rem}
  .ghibli-page .ghibli-story-copy h3{font-size:clamp(2rem,5vw,3.5rem)}
  .ghibli-page .ghibli-story-ren{font-size:.96rem}
  .ghibli-page .ghibli-story-creator-label{display:block}
  .ghibli-page .ghibli-story-creator-label b{display:block;margin-top:.55rem;text-align:left}
}
@media(max-width:600px){
  .ghibli-page .ghibli-story{padding-top:3rem;padding-bottom:4rem}
  .ghibli-page .ghibli-story-intro{
    display:block;min-height:0;margin-bottom:2.5rem;border-radius:22px;
  }
  .ghibli-page .ghibli-story-intro-art{min-height:180px;height:180px}
  .ghibli-page .ghibli-story-art-sun{width:90px;height:90px;right:18%;top:18%}
  .ghibli-page .ghibli-story-art-leaf{width:90px;height:40px}
  .ghibli-page .ghibli-story-intro-copy{padding:2rem 1.35rem 2.25rem}
  .ghibli-page .ghibli-story-kicker{margin-bottom:1rem}
  .ghibli-page .ghibli-story-intro h2{font-size:clamp(2.65rem,12vw,4rem)}
  .ghibli-page .ghibli-story-intro-copy>p:last-child{margin-top:1.25rem;font-size:.92rem;line-height:1.65}
  .ghibli-page .ghibli-story-rule{margin-bottom:.75rem}
  .ghibli-page .ghibli-story-rule span:last-child{display:none}
  .ghibli-page .ghibli-story-entry,
  .ghibli-page .ghibli-story-entry:nth-child(even){
    display:grid;grid-template-columns:43% 57%;min-height:0;
    border-radius:20px;box-shadow:0 12px 32px rgba(25,54,47,.09);
  }
  .ghibli-page .ghibli-story-entry:nth-child(even) .ghibli-story-visual{order:2}
  .ghibli-page .ghibli-story-entry:nth-child(even) .ghibli-story-copy{order:1}
  .ghibli-page .ghibli-story-number{
    left:.7rem;top:.7rem;width:32px;height:32px;
    font-size:.48rem;
  }
  .ghibli-page .ghibli-story-visual{min-height:360px}
  .ghibli-page .ghibli-story-placeholder{min-height:360px;padding:1rem;font-size:1.25rem}
  .ghibli-page .ghibli-story-year{right:.65rem;bottom:.65rem;padding:.4rem .5rem;font-size:.48rem}
  .ghibli-page .ghibli-story-copy{padding:1.35rem 1rem}
  .ghibli-page .ghibli-story-chapter{margin-bottom:.55rem;font-size:.5rem;line-height:1.3}
  .ghibli-page .ghibli-story-copy h3{font-size:clamp(1.75rem,8vw,2.5rem);line-height:.92}
  .ghibli-page .ghibli-story-ren{margin-top:1rem;font-size:.8rem;line-height:1.5}
  .ghibli-page .ghibli-story-creator{margin-top:1.1rem;padding-top:.8rem}
  .ghibli-page .ghibli-story-creator-label span,
  .ghibli-page .ghibli-story-creator-label b{font-size:.46rem}
  .ghibli-page .ghibli-story-creator-label b{margin-top:.4rem;line-height:1.25}
  .ghibli-page .ghibli-story-creator p{margin-top:.55rem;font-size:.68rem;line-height:1.45}
  .ghibli-page .ghibli-story-end{padding:3.5rem .5rem}
  .ghibli-page .ghibli-story-end p{font-size:2.4rem}
}
@media(prefers-reduced-motion:reduce){
  .ghibli-page .ghibli-story-visual img{transition:none}
  .ghibli-page .ghibli-story-entry:hover .ghibli-story-visual img{transform:none}
}
.ghibli-page .ghibli-archive-intro{
  position:relative;
  width:min(1120px,calc(100% - clamp(2rem,8vw,6rem)));
  min-height:clamp(320px,34vw,430px);
  margin:0 auto 1.25rem;
  overflow:hidden;
  border-radius:28px;
  background:var(--ghibli-cream);
  border:1px solid rgba(25,54,47,.1);
  box-shadow:0 18px 55px rgba(25,54,47,.08);
}
.ghibli-page .ghibli-archive-bg{position:absolute;z-index:0;overflow:hidden;background-position:center;background-size:cover}
.ghibli-page .ghibli-archive-bg--chihiro{
  inset:0 0 0 0;background-image:url("https://www.ghibli.jp/images/red-turtle.jpg");background-position:center center;
}
.ghibli-page .ghibli-archive-bg--totoro{
  inset:12% auto 12% 53%;width:24%;border:7px solid var(--ghibli-cream);border-radius:22px;
  background-image:url("https://www.ghibli.jp/images/hotarunohaka.jpg");background-position:center;
  box-shadow:0 18px 35px rgba(25,54,47,.22);transform:rotate(3deg);
}
.ghibli-page .ghibli-archive-bg--heron{
  inset:10% 5% 10% auto;width:24%;border:7px solid var(--ghibli-cream);border-radius:22px;
  background-image:url("https://www.ghibli.jp/images/baron.jpg");background-position:center;
  box-shadow:0 18px 35px rgba(25,54,47,.22);transform:rotate(-4deg);
}
.ghibli-page .ghibli-archive-shade{
  position:absolute;z-index:1;inset:0;
  background:linear-gradient(90deg,rgba(9,25,28,.05) 0%,rgba(9,25,28,.08) 42%,rgba(9,25,28,.72) 67%,rgba(9,25,28,.9) 100%);
}
.ghibli-page .ghibli-archive-copy{
  position:absolute;z-index:3;inset:0 0 0 auto;width:49%;
  display:flex;flex-direction:column;justify-content:center;
  padding:clamp(2rem,4vw,4rem);
}
.ghibli-page .ghibli-archive-kicker{
  display:flex;align-items:center;gap:.7rem;margin:0 0 1rem;color:var(--ghibli-pink);
  font:600 .58rem/1 var(--ghibli-meta);letter-spacing:.14em;text-transform:uppercase;
}
.ghibli-page .ghibli-archive-kicker i{width:34px;height:1px;background:var(--ghibli-coral)}
.ghibli-page .ghibli-archive-copy h2{
  margin:0;color:#fff;font:400 clamp(3.4rem,5.4vw,6.2rem)/.82 var(--ghibli-display);letter-spacing:-.06em;
}
.ghibli-page .ghibli-archive-copy h2 em{color:var(--ghibli-pink);font-style:italic}
.ghibli-page .ghibli-archive-copy>p{
  max-width:360px;margin:1.25rem 0 0;color:rgba(255,255,255,.86);font-size:.88rem;line-height:1.55;
}
@media(max-width:800px){
  .ghibli-page .ghibli-archive-intro{width:calc(100% - 2rem);min-height:330px;border-radius:22px}
  .ghibli-page .ghibli-archive-bg--chihiro{inset:0 0 42% 0;background-position:center 36%}
  .ghibli-page .ghibli-archive-bg--totoro{
    inset:auto 3% 5% auto;width:28%;height:44%;border-width:5px;border-radius:15px;transform:rotate(4deg)
  }
  .ghibli-page .ghibli-archive-bg--heron{
    inset:auto 25% 7% auto;width:25%;height:39%;border-width:5px;border-radius:15px;transform:rotate(-5deg)
  }
  .ghibli-page .ghibli-archive-shade{
    background:linear-gradient(180deg,rgba(9,25,28,.02) 0%,rgba(9,25,28,.08) 34%,rgba(9,25,28,.88) 61%,rgba(9,25,28,.96) 100%)
  }
  .ghibli-page .ghibli-archive-copy{inset:auto 0 0;width:100%;min-height:58%;padding:1.15rem 1.25rem 1.35rem}
  .ghibli-page .ghibli-archive-kicker{margin-bottom:.7rem;font-size:.44rem;gap:.45rem}
  .ghibli-page .ghibli-archive-kicker i{width:18px}
  .ghibli-page .ghibli-archive-copy h2{font-size:clamp(2.65rem,11vw,4rem);line-height:.82}
  .ghibli-page .ghibli-archive-copy>p{max-width:270px;margin-top:.8rem;font-size:.68rem;line-height:1.45}
}
