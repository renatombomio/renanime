---
import Layout from "../../layouts/Layout.astro";
import GhibliView from "../../components/ghibli/GhibliView";
import GhibliStory from "../../components/ghibli/GhibliStory";
import Navbar from "../../components/layout/Navbar.astro";
import Hero from "../../components/hero/Hero.astro";
import { getGhibliFilms, ghibliStory } from "../../data/ghibli";
import "../../styles/ghibli-tokens.css";

const films = getGhibliFilms();
---

<Layout title="El secreto de Ren — Renanime's Gallery">
  <div class="ghibli-shell">
    <Navbar variant="ghibli" />

    <main id="main-content" class="ghibli-page">
      <Hero
        kicker="Bienvenidos a"
        title="Mi inicio en el anime."
        copy="Mi rincón favorito del anime. Aquí escapo para conectar con la naturaleza, la música, la comida, lo simple, la VIDA."
        videoSrc="/videos/hero2.mp4"
        variant="ghibli"
      />

      <section id="archivo" class="ghibli-content" aria-labelledby="archive-title">
        <GhibliStory entries={ghibliStory} client:load />

        <div class="ghibli-section-heading">
          <div>
            <p>Mi archivo</p>
            <h2 id="archive-title">Un mundo por descubrir.</h2>
          </div>
        </div>
        <GhibliView films={films} client:load />
      </section>
    </main>

    <footer class="ghibli-footer"><span>Renanime</span><span>Hecho de recuerdos, viento y películas.</span></footer>
  </div>
</Layout>

<style>
.ghibli-page{min-height:100vh;background:var(--ghibli-cream);color:var(--ghibli-ink);font-family:var(--ghibli-body);padding-top:88px}
@media(max-width:1120px){.ghibli-page{padding-top:74px}}
@media(max-width:600px){.ghibli-page{padding-top:68px}.ghibli-section-heading{display:block}.ghibli-section-heading h2{font-size:3rem}}


.ghibli-page .ghibli-story{max-width:1180px;margin:0 auto;padding:clamp(5rem,11vw,10rem) var(--gutter) 7rem}
.ghibli-page .ghibli-story-intro{max-width:760px;margin:0 auto 8rem;text-align:center}
.ghibli-page .ghibli-story-kicker{margin:0 0 1rem;color:var(--ghibli-coral);font:600 .62rem/1 var(--ghibli-meta);letter-spacing:.16em;text-transform:uppercase}
.ghibli-page .ghibli-story-intro h2{margin:0;color:var(--ghibli-ink);font:400 clamp(3rem,6vw,5.8rem)/.92 var(--ghibli-display);letter-spacing:-.045em}
.ghibli-page .ghibli-story-intro h2 em{color:var(--ghibli-blue);font-style:italic}
.ghibli-page .ghibli-story-intro>p:last-child{max-width:620px;margin:2rem auto 0;color:var(--ghibli-moss);font-size:1.05rem;line-height:1.8}
.ghibli-page .ghibli-story-timeline{position:relative}
.ghibli-page .ghibli-story-timeline:before{position:absolute;top:0;bottom:0;left:50%;width:1px;background:rgba(25,54,47,.15);content:""}
.ghibli-page .ghibli-story-entry{position:relative;display:grid;grid-template-columns:minmax(0,1fr) 1fr;gap:clamp(3rem,8vw,8rem);align-items:center;min-height:720px;padding:5rem 0}
.ghibli-page .ghibli-story-entry:nth-child(even){grid-template-columns:1fr minmax(0,1fr)}
.ghibli-page .ghibli-story-entry:nth-child(even) .ghibli-story-visual{grid-column:2;grid-row:1}
.ghibli-page .ghibli-story-entry:nth-child(even) .ghibli-story-copy{grid-column:1;grid-row:1}
.ghibli-page .ghibli-story-marker{position:absolute;top:50%;left:50%;z-index:3;display:grid;place-items:center;width:54px;height:54px;border:1px solid rgba(25,54,47,.2);border-radius:50%;background:var(--ghibli-cream);color:var(--ghibli-blue);font:600 .58rem/1 var(--ghibli-meta);transform:translate(-50%,-50%)}
.ghibli-page .ghibli-story-visual{position:relative;overflow:hidden;border-radius:32px;background:var(--ghibli-sky);box-shadow:0 28px 70px rgba(25,54,47,.14)}
.ghibli-page .ghibli-story-visual:after{position:absolute;inset:0;background:linear-gradient(180deg,transparent 55%,rgba(25,54,47,.22));content:"";pointer-events:none}
.ghibli-page .ghibli-story-visual img{display:block;width:100%;aspect-ratio:2/3;object-fit:cover}
.ghibli-page .ghibli-story-placeholder{display:grid;aspect-ratio:2/3;place-items:end;padding:2rem;background:linear-gradient(145deg,var(--ghibli-pink),var(--ghibli-sky));color:var(--ghibli-blue);font:400 2rem/1 var(--ghibli-display)}
.ghibli-page .ghibli-story-copy{max-width:470px}
.ghibli-page .ghibli-story-chapter{margin:0 0 1rem;color:var(--ghibli-coral);font:600 .62rem/1 var(--ghibli-meta);letter-spacing:.12em;text-transform:uppercase}
.ghibli-page .ghibli-story-copy h3{margin:0;color:var(--ghibli-blue);font:400 clamp(2.5rem,4vw,4.5rem)/.95 var(--ghibli-display);letter-spacing:-.04em}
.ghibli-page .ghibli-story-ren{margin:2rem 0 0;color:var(--ghibli-ink);font:400 1.18rem/1.75 var(--ghibli-body)}
.ghibli-page .ghibli-story-creator{margin-top:2.5rem;padding-top:1.5rem;border-top:1px solid rgba(25,54,47,.16)}
.ghibli-page .ghibli-story-creator span{color:var(--ghibli-moss);font:600 .58rem/1 var(--ghibli-meta);letter-spacing:.08em;text-transform:uppercase}
.ghibli-page .ghibli-story-creator p{margin:.8rem 0 0;color:#49675d;font-size:.9rem;line-height:1.7}
.ghibli-page .ghibli-story-end{margin:2rem auto 0;padding-top:5rem;border-top:1px solid rgba(25,54,47,.15);text-align:center}
.ghibli-page .ghibli-story-end span{color:var(--ghibli-coral);font:600 .62rem/1 var(--ghibli-meta);letter-spacing:.12em;text-transform:uppercase}
.ghibli-page .ghibli-story-end p{margin:.9rem 0 0;color:var(--ghibli-ink);font:400 2rem/1.2 var(--ghibli-display)}
.ghibli-page .ghibli-story-loading{padding:7rem var(--gutter);color:var(--ghibli-moss);font:600 .65rem/1 var(--ghibli-meta);letter-spacing:.12em;text-align:center;text-transform:uppercase}
@media(max-width:900px){
  .ghibli-page .ghibli-story{padding-inline:var(--gutter)}
  .ghibli-page .ghibli-story-intro{margin-bottom:4rem}
  .ghibli-page .ghibli-story-timeline:before{left:24px}
  .ghibli-page .ghibli-story-entry,.ghibli-page .ghibli-story-entry:nth-child(even){display:grid;grid-template-columns:48px minmax(0,1fr);gap:1.5rem;min-height:0;padding:3rem 0 5rem}
  .ghibli-page .ghibli-story-entry:nth-child(even) .ghibli-story-visual,.ghibli-page .ghibli-story-entry:nth-child(even) .ghibli-story-copy{grid-column:auto;grid-row:auto}
  .ghibli-page .ghibli-story-marker{position:relative;top:auto;left:auto;align-self:start;width:48px;height:48px;transform:none}
  .ghibli-page .ghibli-story-visual{grid-column:2;grid-row:1;border-radius:24px}
  .ghibli-page .ghibli-story-copy{grid-column:2;grid-row:2}
}
@media(max-width:600px){
  .ghibli-page .ghibli-story{padding-top:5rem}
  .ghibli-page .ghibli-story-intro h2{font-size:3rem}
  .ghibli-page .ghibli-story-intro>p:last-child{font-size:.95rem;line-height:1.65}
  .ghibli-page .ghibli-story-entry,.ghibli-page .ghibli-story-entry:nth-child(even){grid-template-columns:34px minmax(0,1fr);gap:.9rem}
  .ghibli-page .ghibli-story-timeline:before{left:17px}
  .ghibli-page .ghibli-story-marker{width:34px;height:34px;font-size:.48rem}
  .ghibli-page .ghibli-story-visual{border-radius:20px}
  .ghibli-page .ghibli-story-copy h3{font-size:2.5rem}
  .ghibli-page .ghibli-story-ren{font-size:1rem;line-height:1.65}
  .ghibli-page .ghibli-story-creator{margin-top:1.75rem}
  .ghibli-page .ghibli-story-end p{font-size:1.55rem}
}
@media(prefers-reduced-motion:reduce){.ghibli-page .ghibli-story-visual img{transition:none}}

.ghibli-page .ghibli-meta{display:flex;justify-content:space-between;gap:1rem;padding:0 0 1rem;border:0;border-bottom:1px solid rgba(25,54,47,.16);color:var(--ghibli-moss);font:600 .62rem/1 var(--ghibli-meta);letter-spacing:.08em;text-transform:uppercase}.ghibli-page .ghibli-meta strong{color:var(--ghibli-coral);font-size:.8rem}
.ghibli-page .ghibli-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:clamp(2rem,5vw,5rem) 1.15rem}
.ghibli-page .ghibli-card{overflow:hidden;border:0;border-radius:var(--ghibli-radius);background:#fff;box-shadow:0 12px 35px rgba(25,54,47,.08);border:1px solid rgba(25,54,47,.08);transition:transform .45s var(--ghibli-ease)}
.ghibli-page .ghibli-card:hover{border-color:rgba(25,54,47,.12);transform:translateY(-8px);box-shadow:0 20px 45px rgba(25,54,47,.12)}
.ghibli-page .ghibli-card a{display:block;color:var(--ghibli-ink)}
.ghibli-page .ghibli-poster{position:relative;aspect-ratio:2/3;overflow:hidden;border-radius:var(--ghibli-radius);background:var(--ghibli-sky);box-shadow:0 18px 45px var(--ghibli-shadow)}
.ghibli-page .ghibli-poster:after{position:absolute;inset:0;background:linear-gradient(180deg,transparent 62%,rgba(25,54,47,.2));content:"";pointer-events:none}
.ghibli-page .ghibli-poster img{width:100%;height:100%;object-fit:cover;transition:transform .8s var(--ghibli-ease)}.ghibli-page .ghibli-card:hover .ghibli-poster img{transform:scale(1.045)}
.ghibli-page .ghibli-year{position:absolute;left:.8rem;bottom:.8rem;z-index:2;padding:.4rem .55rem;border-radius:999px;background:rgba(255,247,232,.88);color:var(--ghibli-blue);font:600 .52rem/1 var(--ghibli-meta);letter-spacing:.08em}
.ghibli-page .ghibli-badge{position:absolute;right:.8rem;top:.8rem;z-index:2;padding:.4rem .55rem;border:0;border-radius:999px;background:var(--ghibli-lime);color:var(--ghibli-ink);font:600 .5rem/1 var(--ghibli-meta);letter-spacing:.08em;text-transform:uppercase}
.ghibli-page .ghibli-info{display:grid;min-height:6.4rem;gap:.5rem;padding:1rem 1rem 1.15rem;background:#fff}.ghibli-page .ghibli-info h3{margin:0;color:var(--ghibli-blue);font:400 1.05rem/1.08 var(--ghibli-display);letter-spacing:-.025em}.ghibli-page .ghibli-info span{color:var(--ghibli-moss);font:500 .58rem/1.4 var(--ghibli-body)}
.ghibli-page .ghibli-placeholder{display:flex;height:100%;align-items:flex-end;padding:1rem;background:linear-gradient(145deg,var(--ghibli-pink),var(--ghibli-sky));color:var(--ghibli-blue)}.ghibli-page .ghibli-placeholder strong{font:400 1rem/1.1 var(--ghibli-display)}
.ghibli-page .ghibli-loading{padding:5rem 0;color:var(--ghibli-moss);font:600 .65rem/1 var(--ghibli-meta);letter-spacing:.12em;text-transform:uppercase;text-align:center}
@media(max-width:900px){.ghibli-page .ghibli-grid{grid-template-columns:repeat(3,minmax(0,1fr))}}
@media(max-width:600px){.ghibli-page .ghibli-meta{flex-wrap:wrap}.ghibli-page .ghibli-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:2.75rem .85rem}.ghibli-page .ghibli-info{min-height:6rem;padding-top:.75rem}.ghibli-page .ghibli-info h3{font-size:.92rem}.ghibli-page .ghibli-info span{font-size:.52rem}}
@media(prefers-reduced-motion:reduce){.ghibli-page .ghibli-card,.ghibli-page .ghibli-poster img{transition:none}.ghibli-page .ghibli-card:hover{transform:none}.ghibli-page .ghibli-card:hover .ghibli-poster img{transform:none}}
</style>