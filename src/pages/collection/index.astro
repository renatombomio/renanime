---
export const prerender = false;
import Layout from "../../layouts/Layout.astro";
import { useT } from "../../i18n";
import Navbar from "../../components/layout/Navbar.astro";
import PersonalLibraryView from "../../components/personal-library/PersonalLibraryView";
const t = useT(Astro.locals.lang);
---

<Layout title={`${t("library.pageTitle")} — Renanime's Gallery`}>
  <Navbar />

  <main id="main-content" class="collection-page">
    <h1 class="sr-only">{t("library.pageHeading")}</h1>
    <section class="collection-content" aria-label={Astro.locals.lang === "en" ? "My anime collection" : "Mi colección de anime"}>
      <PersonalLibraryView mode="WATCHED" lang={Astro.locals.lang} client:load />
    </section>
  </main>
</Layout>

<style>
  .collection-page {
    min-height: 60vh;
    padding-block: clamp(6rem, 11vw, 10rem) var(--section-space);
  }

  .collection-content {
    width: min(calc(100% - (var(--gutter) * 2)), var(--container-max));
    margin-inline: auto;
    container-type: inline-size;
  }

  @media (max-width: 560px) {
    .collection-page {
      padding-top: 4.5rem;
    }
  }
</style>
