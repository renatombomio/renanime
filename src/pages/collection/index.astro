---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/layout/Navbar.astro";
import Footer from "../../components/layout/Footer.astro";
import SectionHeader from "../../components/ui/SectionHeader.astro";
import PersonalLibraryView from "../../components/personal-library/PersonalLibraryView";
---

<Layout title="Mi colección — Renanime's Gallery">
  <Navbar />

  <main id="main-content" class="collection-page">
    <div class="collection-header">
      <SectionHeader
        eyebrow="Tu archivo"
        index="02"
        variant="ren"
        title="Mi colección"
        description="El archivo de las historias que ya forman parte de tu recorrido. Aquí no está Ren: este espacio empieza a ser tuyo desde el primer anime que ves."
      />
    </div>

    <section class="collection-content" aria-label="Mi colección de anime">
      <PersonalLibraryView mode="WATCHED" client:load />
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .collection-page {
    min-height: 60vh;
    padding-block: clamp(6rem, 11vw, 10rem) var(--section-space);
  }

  .collection-header,
  .collection-content {
    width: min(calc(100% - (var(--gutter) * 2)), var(--container-max));
    margin-inline: auto;
  }

  .collection-header {
    margin-bottom: clamp(3.5rem, 7vw, 6rem);
  }

  .collection-content {
    container-type: inline-size;
  }

  @media (max-width: 560px) {
    .collection-page {
      padding-top: 4.5rem;
    }

    .collection-header {
      margin-bottom: 2.5rem;
    }
  }
</style>
