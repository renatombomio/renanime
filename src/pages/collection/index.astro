---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/layout/Navbar.astro";
import Footer from "../../components/layout/Footer.astro";
import SectionHeader from "../../components/ui/SectionHeader.astro";
import CollectionView from "../../components/collection/CollectionView";
import { getWatchedLibrary } from "../../data/library";

const entries = getWatchedLibrary();
---

<Layout title="Colección — Renanime's Gallery">
  <Navbar />

  <main class="collection-page">
    <div class="collection-header">
      <SectionHeader
        eyebrow="Mi colección"
        title="Colección"
        description="Aquí están todos los animes que he visto. Son muchos, pero nunca parece suficiente. Porque esa es la magia del anime: terminas una historia y, de alguna manera, ya estás buscando la siguiente."
      />
    </div>

    <section class="collection-content" aria-label="Colección de anime">
      <CollectionView entries={entries} client:load />
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .collection-page {
    min-height: 60vh;
    padding-block: clamp(6rem, 11vw, 10rem) var(--section-space);
  }

  .collection-header,
  .collection-content {
    width: min(calc(100% - (var(--gutter) * 2)), var(--container-max));
    margin-inline: auto;
  }

  .collection-header {
    margin-bottom: clamp(3.5rem, 7vw, 6rem);
  }

  .collection-content {
    container-type: inline-size;
  }

  :global(.collection-toolbar) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  :global(.collection-filters),
  :global(.collection-tools) {
    display: flex;
    align-items: center;
    gap: .65rem;
  }

  :global(.collection-filters) {
    overflow-x: auto;
    scrollbar-width: none;
  }

  :global(.collection-filters::-webkit-scrollbar) {
    display: none;
  }

  :global(.collection-filters button) {
    position: relative;
    flex: 0 0 auto;
    padding: .65rem .15rem .7rem;
    border: 0;
    background: transparent;
    color: var(--color-muted-400);
    font-family: var(--font-meta);
    font-size: .65rem;
    letter-spacing: .1em;
    text-transform: uppercase;
    cursor: pointer;
  }

  :global(.collection-filters button::after) {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 1px;
    background: var(--color-paper-50);
    content: "";
    transform: scaleX(0);
    transform-origin: center;
    transition: transform 180ms ease;
  }

  :global(.collection-filters button:hover),
  :global(.collection-filters button.is-active) {
    color: var(--color-paper-50);
  }

  :global(.collection-filters button.is-active::after) {
    transform: scaleX(1);
  }

  :global(.collection-tools input),
  :global(.collection-tools select) {
    min-height: 2.5rem;
    border: 1px solid var(--color-border);
    background: var(--color-ink-900);
    color: var(--color-paper-50);
    padding: .65rem .8rem;
    font-family: var(--font-body);
    font-size: .8rem;
    outline: none;
  }

  :global(.collection-tools input) {
    width: min(15rem, 32vw);
  }

  :global(.collection-tools input:focus),
  :global(.collection-tools select:focus) {
    border-color: var(--color-border-strong);
  }

  :global(.collection-count) {
    margin: 1rem 0 2rem;
    color: var(--color-muted-400);
    font-family: var(--font-meta);
    font-size: .62rem;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  :global(.collection-grid) {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: clamp(3rem, 5vw, 5rem) clamp(.85rem, 1.8vw, 1.75rem);
  }

  :global(.collection-card) {
    min-width: 0;
  }

  :global(.collection-card a) {
    display: block;
    color: inherit;
  }

  :global(.poster) {
    position: relative;
    aspect-ratio: 2 / 3;
    overflow: hidden;
    background: var(--color-ink-800);
  }

  :global(.poster::after) {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(9,9,9,.08) 45%, rgba(9,9,9,.82) 100%);
    content: "";
    opacity: .82;
    pointer-events: none;
    transition: opacity 300ms ease;
  }

  :global(.poster img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 650ms cubic-bezier(.2,.7,.2,1);
  }

  :global(.collection-card a:hover .poster img) {
    transform: scale(1.035);
  }

  :global(.collection-card a:hover .poster::after) {
    opacity: .96;
  }

  :global(.poster-placeholder) {
    display: grid;
    place-items: center;
    height: 100%;
    padding: 1.5rem;
    color: var(--color-muted-400);
    text-align: center;
    font-family: var(--font-meta);
    font-size: .62rem;
  }

  :global(.card-top) {
    position: absolute;
    top: .65rem;
    right: .65rem;
    left: .65rem;
    z-index: 2;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }

  :global(.format-badge),
  :global(.score-badge) {
    padding: .35rem .45rem;
    border: 1px solid rgba(245,242,236,.22);
    background: rgba(9,9,9,.58);
    color: var(--color-paper-50);
    font-family: var(--font-meta);
    font-size: .52rem;
    letter-spacing: .1em;
    line-height: 1;
    backdrop-filter: blur(8px);
  }

  :global(.score-badge) {
    border-radius: 999px;
    letter-spacing: .02em;
  }

  :global(.card-overlay) {
    position: absolute;
    right: .7rem;
    bottom: .7rem;
    left: .7rem;
    z-index: 2;
    color: var(--color-paper-50);
  }

  :global(.card-overlay-title) {
    display: -webkit-box;
    overflow: hidden;
    font-size: .78rem;
    font-weight: 500;
    line-height: 1.15;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  :global(.card-overlay-meta) {
    display: flex;
    gap: .55rem;
    margin-top: .35rem;
    color: var(--color-paper-200);
    font-family: var(--font-meta);
    font-size: .5rem;
    letter-spacing: .06em;
    text-transform: uppercase;
  }

  :global(.card-info) {
    display: grid;
    gap: .35rem;
    padding-top: .7rem;
  }

  :global(.card-info h3) {
    display: -webkit-box;
    overflow: hidden;
    margin: 0;
    color: var(--color-paper-50);
    font-family: var(--font-body);
    font-size: .82rem;
    font-weight: 500;
    line-height: 1.2;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  :global(.meta) {
    display: flex;
    gap: .65rem;
    color: var(--color-muted-400);
    font-family: var(--font-meta);
    font-size: .52rem;
    letter-spacing: .04em;
    text-transform: uppercase;
  }

  :global(.load-more) {
    display: block;
    margin: 4rem auto 0;
    padding: .8rem 1.2rem;
    border: 1px solid var(--color-border-strong);
    background: transparent;
    color: var(--color-paper-50);
    font-family: var(--font-meta);
    font-size: .62rem;
    letter-spacing: .1em;
    text-transform: uppercase;
    cursor: pointer;
  }

  :global(.load-more:hover) {
    background: var(--color-paper-50);
    color: var(--color-ink-950);
  }

  :global(.loading),
  :global(.empty) {
    margin: 3rem 0;
    color: var(--color-muted-400);
    text-align: center;
  }

  :global(.sr-only) {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0,0,0,0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 1100px) {
    :global(.collection-grid) {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (max-width: 800px) {
    :global(.collection-toolbar) {
      align-items: stretch;
      flex-direction: column;
    }

    :global(.collection-tools) {
      justify-content: space-between;
    }

    :global(.collection-tools input) {
      width: 100%;
    }

    :global(.collection-grid) {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    :global(.collection-page) {
      padding-top: 4.5rem;
    }

    :global(.collection-header) {
      margin-bottom: 2.5rem;
    }

    :global(.collection-tools) {
      width: 100%;
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: .5rem;
    }

    :global(.collection-tools input) {
      width: 100%;
      min-width: 0;
    }

    :global(.collection-tools select) {
      width: auto;
      max-width: 7rem;
    }

    :global(.collection-grid) {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 2.25rem .65rem;
    }

    :global(.card-info) {
      padding-top: .55rem;
    }

    :global(.card-info h3) {
      font-size: .72rem;
    }

    :global(.meta) {
      font-size: .46rem;
      gap: .45rem;
    }

    :global(.card-overlay) {
      right: .5rem;
      bottom: .5rem;
      left: .5rem;
    }

    :global(.card-overlay-title) {
      font-size: .68rem;
    }

    :global(.format-badge),
    :global(.score-badge) {
      padding: .28rem .35rem;
      font-size: .45rem;
    }
  }
</style>
