---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/layout/Navbar.astro";
import Footer from "../../components/layout/Footer.astro";
import Container from "../../components/ui/Container.astro";
import SectionHeader from "../../components/ui/SectionHeader.astro";
import GenresView from "../../components/genres/GenresView";
import { getWatchedLibrary } from "../../data/library";

const entries = getWatchedLibrary();
---

<Layout title="Géneros de Ren — Renanime's Gallery">
  <Navbar />
  <main id="main-content" class="genres-page">
    <Container>
      <SectionHeader
        eyebrow="Archivo de Ren"
        variant="ren"
        title="Géneros de Ren"
        description="Un mapa de lo que he visto. No es una lista universal de géneros: cada palabra aquí existe porque forma parte de mi colección."
      />
      <div class="genres-page-content">
        <GenresView entries={entries} client:load />
      </div>
    </Container>
  </main>
  <Footer />
</Layout>

<style>
  .genres-page {
    min-height: 70vh;
    padding-block: clamp(6rem, 11vw, 10rem) var(--section-space);
  }

  .genres-page-content {
    margin-top: clamp(5rem, 10vw, 9rem);
  }
</style>