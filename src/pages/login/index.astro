---
import Layout from "../../layouts/Layout.astro";
---

<Layout
  title="Acceso — Renanime's Gallery"
  description="Accede a Renanime's Gallery."
>
  <main class="access-page">
    <section class="access-card" aria-labelledby="access-title">
      <div class="brand" aria-label="Renanime">
        <span class="brand-ren">Ren</span><span class="brand-anime">anime</span>
      </div>

      <p class="eyebrow">RENANIME'S GALLERY</p>
      <h1 id="access-title">Acceso</h1>
      <p class="subtitle">Introduce la contraseña para entrar a tu archivo personal.</p>

      <form id="login-form">
        <label for="recovery-code">Código de recuperación</label>
        <input
          id="recovery-code"
          name="recoveryCode"
          type="text"
          autocomplete="off"
          placeholder="REN-XXXX-XXXX"
          required
        />

        <label for="access-password">Contraseña de acceso</label>
        <input
          id="access-password"
          name="accessPassword"
          type="password"
          autocomplete="current-password"
          required
        />

        <button type="submit">Entrar</button>
        <p id="error-message" class="message" aria-live="polite"></p>
      </form>

      <p class="register-link">
        ¿Es tu primera vez? <a href="/register">Crear perfil</a>
      </p>
    </section>
  </main>
</Layout>

<script>
  const form = document.querySelector<HTMLFormElement>("#login-form");
  const passwordInput = document.querySelector<HTMLInputElement>("#access-password");
  const recoveryInput = document.querySelector<HTMLInputElement>("#recovery-code");
  const errorMessage = document.querySelector<HTMLParagraphElement>("#error-message");

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();

    if (!passwordInput || !errorMessage) return;

    errorMessage.textContent = "";

    try {
      const response = await fetch("/api/auth/recover", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ accessPassword: passwordInput.value }),
      });

      const data = await response.json();

      if (!response.ok) {
        errorMessage.textContent =
          data.error === "INVALID_ACCESS_PASSWORD"
            ? "Contraseña incorrecta."
            : data.error === "INVALID_RECOVERY_CODE"
              ? "Código de recuperación incorrecto."
              : "No se ha podido iniciar sesión.";
        return;
      }

      window.location.href = "/";
    } catch {
      errorMessage.textContent = "No se ha podido conectar con Renanime.";
    }
  });
</script>

<style>
  .access-page {
    min-height: 100vh;
    display: grid;
    place-items: center;
    padding: 2rem 1.25rem;
  }

  .access-card {
    width: min(100%, 430px);
  }

  .brand {
    margin-bottom: 3rem;
    font-size: 2rem;
    font-weight: 700;
    letter-spacing: -0.05em;
  }

  .brand-ren {
    color: var(--accent, #ff4f8b);
  }

  .brand-anime {
    color: white;
  }

  .eyebrow {
    margin: 0 0 0.65rem;
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    opacity: 0.5;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.4rem, 9vw, 4rem);
    line-height: 0.95;
  }

  .subtitle {
    max-width: 360px;
    margin: 1rem 0 2rem;
    line-height: 1.6;
    opacity: 0.62;
  }

  form {
    display: grid;
    gap: 0.75rem;
  }

  label {
    font-size: 0.85rem;
    opacity: 0.75;
  }

  input {
    width: 100%;
    min-height: 52px;
    padding: 0 1rem;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.05);
    color: inherit;
    font: inherit;
  }

  input:focus {
    outline: 2px solid var(--accent, #ff4f8b);
    outline-offset: 2px;
  }

  button {
    min-height: 52px;
    margin-top: 0.5rem;
    border: 0;
    border-radius: 12px;
    background: var(--accent, #ff4f8b);
    color: white;
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }

  .message {
    min-height: 1.25rem;
    margin: 0.25rem 0 0;
    font-size: 0.85rem;
    color: #ff7b9f;
  }

  .register-link {
    margin-top: 2rem;
    text-align: center;
    font-size: 0.9rem;
    opacity: 0.7;
  }

  .register-link a {
    color: inherit;
    font-weight: 600;
  }
</style>
