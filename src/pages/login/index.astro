---
export const prerender = false;
import Layout from "../../layouts/Layout.astro";
import { getRenanimeUser } from "../../lib/auth";

const token = Astro.cookies.get("renanime_session")?.value;
const user = await getRenanimeUser(token);

if (user) {
  return Astro.redirect("/");
}
---

<Layout
  title="Acceso — Renanime's Gallery"
  description="Entra en tu espacio personal de Renanime's Gallery."
>
  <main class="access-page auth-login" data-auth-screen="login">
    <div class="auth-backgrounds" aria-hidden="true">
      <img id="auth-background" class="auth-background" src="/images/loginM.jpg" alt="" />
    </div>
    <section class="access-card" aria-labelledby="access-title">
      <div class="brand" aria-label="Renanime">
        <span class="brand-ren">Ren</span><span class="brand-anime">anime</span>
      </div>

      <p class="eyebrow">RENANIME'S GALLERY</p>
      <h1 id="access-title">Acceso</h1>
      <p class="subtitle">La puerta de entrada a tu archivo personal de anime.</p>

      <form id="access-form">
        <label for="access-password">Código de acceso</label>
        <input
          id="access-password"
          name="accessPassword"
          type="password"
          autocomplete="current-password"
          required
          autofocus
        />
        <button type="submit">Entrar</button>
        <p id="access-message" class="message" aria-live="polite"></p>
      </form>

      <div class="member-entry">
        <span>¿Eres miembro de Renanime?</span>
        <button id="show-recovery" type="button">Entra con tu código de recuperación</button>
      </div>

      <section id="onboarding" class="panel" hidden>
        <div class="step" data-step="profile">
          <p class="panel-eyebrow">BIENVENIDO</p>
          <h2>¿Cómo te llamas?</h2>
          <p>Vamos a crear tu espacio personal.</p>
          <label for="name">Tu nombre</label>
          <input id="name" type="text" maxlength="80" autocomplete="name" />
          <button id="continue-name" type="button">Continuar</button>
          <p id="name-message" class="message" aria-live="polite"></p>
        </div>

        <div class="step" data-step="aka" hidden>
          <p class="panel-eyebrow">UNA ÚLTIMA COSA</p>
          <h2>¿Cuál es tu AKA de anime?</h2>
          <p>Venga va. Dame un nombre divertido. Ya que hemos llegado hasta aquí.</p>
          <label for="aka">AKA de anime</label>
          <input id="aka" type="text" maxlength="40" autocomplete="nickname" placeholder="Ej. Ren-sama, Hokage, Goku..." />
          <button id="create-profile" type="button">Vale, este es</button>
          <p id="aka-message" class="message" aria-live="polite"></p>
        </div>

        <div class="step complete-step" data-step="complete" hidden>
          <h2 class="welcome-title">Bienvenido a Renanime, <span id="welcome-name"></span>.</h2>
          <p class="joke-result">
            Ja, ja, ja. Era broma. A nadie le importa tu AKA.<br />
            No me puedo creer que lo hayas escrito. Mereces entrar a la web.
          </p>
          <p class="recovery-note">Tu código de recuperación es:</p>
          <div id="recovery-display" class="recovery-display"></div>
          <p class="recovery-help">Guárdalo. Lo necesitarás para entrar desde otro dispositivo.</p>
          <button id="enter-renanime" type="button">Iniciar sesión</button>
        </div>

        <div class="step" data-step="recovery" hidden>
          <p class="panel-eyebrow">MIEMBRO DE RENANIME</p>
          <h2>Volvamos a casa.</h2>
          <p>Introduce tu código de recuperación. No necesitas registrarte otra vez.</p>
          <label for="recovery-code">Código de recuperación</label>
          <input id="recovery-code" type="text" placeholder="REN-XXXX-XXXX" autocomplete="off" />
          <button id="recover-account" type="button">Entrar en mi cuenta</button>
          <button id="back-to-create" class="secondary" type="button">Soy nuevo, crear un perfil</button>
          <p id="recovery-message" class="message" aria-live="polite"></p>
        </div>
      </section>
    </section>
  </main>
</Layout>

<script>
  const accessForm = document.querySelector<HTMLFormElement>("#access-form");
  const accessPasswordInput = document.querySelector<HTMLInputElement>("#access-password");
  const accessMessage = document.querySelector<HTMLParagraphElement>("#access-message");
  const accessCard = document.querySelector<HTMLElement>(".access-card");
  const onboarding = document.querySelector<HTMLElement>("#onboarding");
  const memberEntry = document.querySelector<HTMLElement>(".member-entry");
  const accessPage = document.querySelector<HTMLElement>(".access-page");
  const authBackground = document.querySelector<HTMLImageElement>("#auth-background");

  const accessJokes = document.createElement("div");
  accessJokes.className = "access-jokes";
  accessJokes.setAttribute("aria-live", "polite");
  document.body.appendChild(accessJokes);

  const accessFailureMessages = [
    "Alguien se ha olvidado del código de acceso.",
    "Renato no te quiere por aquí.",
    "¿Seguro que sabes dónde estás?",
    "Ese código no abre ni la nevera.",
    "RenAnime dice: acceso denegado."
  ];

  const accessFailureKey = "renanime-access-failure-index";
  let accessFailureIndex = Number(sessionStorage.getItem(accessFailureKey) ?? "0");
  if (!Number.isInteger(accessFailureIndex) || accessFailureIndex < 0 || accessFailureIndex >= accessFailureMessages.length) {
    accessFailureIndex = 0;
  }

  const showAccessFailure = () => {
    accessJokes.innerHTML = "";
    accessCard?.classList.remove("access-wrong");
    void accessCard?.offsetWidth;
    accessCard?.classList.add("access-wrong");

    const message = accessFailureMessages[accessFailureIndex];
    accessFailureIndex = (accessFailureIndex + 1) % accessFailureMessages.length;
    sessionStorage.setItem(accessFailureKey, String(accessFailureIndex));

    if (accessMessage) {
      accessMessage.textContent = message;
      accessMessage.hidden = false;
    }

    const bubble = document.createElement("span");
    bubble.textContent = message;
    accessJokes.appendChild(bubble);

    window.setTimeout(() => {
      accessJokes.innerHTML = "";
      accessCard?.classList.remove("access-wrong");
    }, 3200);
  };

  const nameStep = document.querySelector<HTMLElement>('[data-step="profile"]');
  const akaStep = document.querySelector<HTMLElement>('[data-step="aka"]');
  const completeStep = document.querySelector<HTMLElement>('[data-step="complete"]');
  const recoveryStep = document.querySelector<HTMLElement>('[data-step="recovery"]');

  const nameInput = document.querySelector<HTMLInputElement>("#name");
  const akaInput = document.querySelector<HTMLInputElement>("#aka");
  const recoveryInput = document.querySelector<HTMLInputElement>("#recovery-code");

  const nameMessage = document.querySelector<HTMLParagraphElement>("#name-message");
  const akaMessage = document.querySelector<HTMLParagraphElement>("#aka-message");
  const recoveryMessage = document.querySelector<HTMLParagraphElement>("#recovery-message");

  const welcomeName = document.querySelector<HTMLSpanElement>("#welcome-name");
  const recoveryDisplay = document.querySelector<HTMLDivElement>("#recovery-display");

  const continueName = document.querySelector<HTMLButtonElement>("#continue-name");
  const createProfile = document.querySelector<HTMLButtonElement>("#create-profile");
  const recoverAccount = document.querySelector<HTMLButtonElement>("#recover-account");
  const backToCreate = document.querySelector<HTMLButtonElement>("#back-to-create");
  const showRecovery = document.querySelector<HTMLButtonElement>("#show-recovery");
  const enterRenanime = document.querySelector<HTMLButtonElement>("#enter-renanime");

  let accessPassword = "";

  const showStep = (step: HTMLElement | null) => {
    [nameStep, akaStep, completeStep, recoveryStep].forEach((item) => {
      if (item) item.hidden = item !== step;
    });

    const screen = step === recoveryStep ? "recovery" : "register";
    accessPage?.setAttribute("data-auth-screen", screen);
    accessPage?.classList.remove("auth-login", "auth-register", "auth-recovery");
    accessPage?.classList.add(screen === "recovery" ? "auth-recovery" : "auth-register");

    if (authBackground) {
      authBackground.src = screen === "recovery" ? "/images/login2.jpg" : "/images/login1.jpg";
    }

    accessCard?.classList.add("panel-open");
  };

  const openRecovery = () => {
    accessPage?.classList.remove("auth-login", "auth-register");
    accessPage?.classList.add("auth-recovery");

    if (onboarding) onboarding.hidden = false;
    if (accessForm) accessForm.hidden = true;
    if (memberEntry) memberEntry.hidden = true;
    showStep(recoveryStep);
  };

  showRecovery?.addEventListener("click", openRecovery);

  accessForm?.addEventListener("submit", async (event) => {
    event.preventDefault();

    if (!accessPasswordInput || !accessMessage || !onboarding) return;

    accessMessage.textContent = "";
    accessPassword = accessPasswordInput.value.trim();

    if (!accessPassword) {
      accessMessage.textContent = "Introduce el código de acceso.";
      accessMessage.hidden = false;
      return;
    }

    try {
      const response = await fetch("/api/auth/access", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        credentials: "same-origin",
        body: JSON.stringify({ accessPassword }),
      });

      const raw = await response.text();
      let data: { ok?: boolean; error?: string } = {};

      try {
        data = JSON.parse(raw);
      } catch {
        data = {};
      }

      if (!response.ok || data.ok !== true) {
        accessMessage.textContent =
          data.error === "INVALID_ACCESS_PASSWORD"
            ? "Código de acceso incorrecto."
            : "No se ha podido abrir la puerta de Renanime.";
        accessMessage.hidden = false;
        showAccessFailure();
        return;
      }

      // El código de acceso solo abre la puerta.
      // Nunca identifica a un usuario existente.
      onboarding.hidden = false;
      accessForm.hidden = true;
      memberEntry!.hidden = true;
      showStep(nameStep);
      nameInput?.focus();
    } catch (error) {
      console.error("Renanime access request failed:", error);
      accessMessage.textContent = "No se ha podido conectar con Renanime.";
      accessMessage.hidden = false;
    }
  });

  backToCreate?.addEventListener("click", () => {
    showStep(nameStep);
    if (nameInput) nameInput.value = "";
    if (akaInput) akaInput.value = "";
  });

  continueName?.addEventListener("click", () => {
    if (!nameInput || !nameMessage) return;
    const name = nameInput.value.trim();
    nameMessage.textContent = "";

    if (!name) {
      nameMessage.textContent = "Escribe tu nombre.";
      return;
    }

    showStep(akaStep);
  });

  createProfile?.addEventListener("click", async () => {
    if (!nameInput || !akaInput || !akaMessage) return;

    const name = nameInput.value.trim();
    const aka = akaInput.value.trim();
    akaMessage.textContent = "";

    if (!aka) {
      akaMessage.textContent = "Venga va. Dame un AKA.";
      return;
    }

    if (name.toLocaleLowerCase() === aka.toLocaleLowerCase()) {
      akaMessage.textContent = "Venga va. Ese es tu nombre, no tu AKA. Sé creativo.";
      return;
    }

    try {
      const response = await fetch("/api/auth/register", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ accessPassword, name, aka }),
      });

      const data = await response.json();

      if (!response.ok) {
        akaMessage.textContent =
          data.error === "SAME_NAME_AKA"
            ? "Venga va. Ese es tu nombre, no tu AKA. Sé creativo."
            : data.error === "INVALID_PROFILE"
              ? "Revisa tu nombre y tu AKA."
              : "No se ha podido crear el perfil.";
        return;
      }

      welcomeName!.textContent = data.user.name;
      recoveryDisplay!.textContent = data.recoveryCode;
      showStep(completeStep);
    } catch {
      akaMessage.textContent = "No se ha podido conectar con Renanime.";
    }
  });

  recoverAccount?.addEventListener("click", async () => {
    if (!recoveryInput || !recoveryMessage) return;

    const recoveryCode = recoveryInput.value.trim();
    recoveryMessage.textContent = "";

    if (!recoveryCode) {
      recoveryMessage.textContent = "Introduce tu código de recuperación.";
      return;
    }

    try {
      const response = await fetch("/api/auth/recover", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ recoveryCode }),
      });

      const data = await response.json();

      if (!response.ok) {
        recoveryMessage.textContent =
          data.error === "INVALID_RECOVERY_CODE"
            ? "Código de recuperación incorrecto."
            : "No se ha podido iniciar sesión.";
        return;
      }

      window.location.href = "/";
    } catch {
      recoveryMessage.textContent = "No se ha podido conectar con Renanime.";
    }
  });

  enterRenanime?.addEventListener("click", () => {
    window.location.href = "/";
  });
</script>

<style>
  .access-page {
    position: relative;
    min-height: 100vh;
    display: grid;
    place-items: center;
    padding: 2rem 1.25rem;
    overflow: hidden;
    background-color: #050505;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    background-attachment: fixed;
    transition: background-image 0.5s ease;
  }

  .auth-backgrounds {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    background: #050505;
  }

  .auth-background {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: center;
  }

  .access-card {
    z-index: 1;
  }

  .panel {
    z-index: 2;
  }

  .access-card {
    position: relative;
    width: min(100%, 430px);
  }

  .access-card.panel-open > .brand,
  .access-card.panel-open > .eyebrow,
  .access-card.panel-open > h1,
  .access-card.panel-open > .subtitle,
  .access-card.panel-open > #access-form,
  .access-card.panel-open > .member-entry {
    visibility: hidden;
  }

  .access-wrong { animation: access-shake 0.42s ease; }

  .access-jokes {
    position: fixed;
    inset: 0;
    z-index: 120;
    pointer-events: none;
    overflow: hidden;
  }

  .access-jokes span {
    position: absolute;
    left: 50%;
    top: 50%;
    max-width: min(220px, 42vw);
    padding: 0.7rem 0.9rem;
    border: 1px solid rgba(255,255,255,0.16);
    border-radius: 999px;
    background: rgba(12,12,12,0.96);
    color: rgba(255,255,255,0.82);
    font-size: 0.72rem;
    line-height: 1.25;
    text-align: center;
    box-shadow: 0 12px 40px rgba(0,0,0,0.5);
    animation: access-joke-pop 2.9s cubic-bezier(.2,.8,.2,1) forwards;
  }

  .brand {
    margin-bottom: 3rem;
    font-size: 2rem;
    font-weight: 700;
    letter-spacing: -0.05em;
  }

  .brand-ren { color: var(--accent, #ff4f8b); }
  .brand-anime { color: white; }

  .eyebrow, .panel-eyebrow {
    margin: 0 0 0.65rem;
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    opacity: 0.5;
  }

  h1 { margin: 0; font-size: clamp(2.4rem, 9vw, 4rem); line-height: 0.95; }
  h2 { margin: 0; font-size: clamp(2.2rem, 7vw, 2.7rem); line-height: 1.02; letter-spacing: -0.03em; }

  .subtitle, .panel p {
    max-width: 390px;
    margin: 0.65rem 0 1.15rem;
    line-height: 1.6;
    opacity: 0.62;
  }

  form, .panel { display: grid; gap: 0.75rem; }

  .member-entry {
    display: grid;
    gap: 0.45rem;
    margin-top: 1.5rem;
    text-align: center;
    font-size: 0.82rem;
    opacity: 0.65;
  }

  .member-entry button {
    width: auto;
    min-height: 0;
    margin: 0;
    padding: 0;
    background: none;
    color: #ff4f8b;
    font-size: inherit;
    font-weight: 600;
  }

  .panel {
    position: fixed;
    inset: 50% auto auto 50%;
    z-index: 100;
    width: min(calc(100% - 2rem), 430px);
    max-height: min(88vh, 720px);
    overflow-y: auto;
    transform: translate(-50%, -50%);
    padding: 1.45rem;
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 20px;
    background: rgba(8,8,10,0.12);
    backdrop-filter: blur(5px);
    -webkit-backdrop-filter: blur(5px);
    box-shadow: 0 0 0 100vmax rgba(0,0,0,0.04), 0 24px 80px rgba(0,0,0,0.45);
  }

  label { font-size: 0.85rem; opacity: 0.75; }

  input {
    width: 100%;
    min-height: 48px;
    padding: 0 1rem;
    border: 1px solid rgba(255,255,255,0.15);
    border-radius: 12px;
    background: rgba(255,255,255,0.05);
    color: inherit;
    font: inherit;
    box-sizing: border-box;
  }

  input:focus {
    outline: 2px solid var(--accent, #ff4f8b);
    outline-offset: 2px;
  }

  button {
    width: 100%;
    min-height: 50px;
    margin-top: 0.35rem;
    border: 0;
    border-radius: 12px;
    background: var(--accent, #ff4f8b);
    color: white;
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }

  button.secondary {
    width: 100%;
    background: transparent;
    border: 1px solid rgba(255,255,255,0.14);
    color: rgba(255,255,255,0.72);
  }

  .message {
    width: 100%;
    min-height: 1.25rem;
    margin: 0.25rem 0 0;
    padding: 0.45rem 0.65rem;
    box-sizing: border-box;
    border-radius: 8px;
    background: rgba(255,79,139,0.08);
    font-size: 0.85rem;
    line-height: 1.35;
    color: #ff9cbb;
  }

  #access-message:empty {
    display: none;
  }

  #access-message:not(:empty) {
    display: block;
  }

  .welcome-title {
    font-size: clamp(2.2rem, 8vw, 3.4rem);
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .joke-result {
    color: rgba(255,255,255,0.72) !important;
    margin-top: 1.25rem !important;
  }

  .recovery-note { margin: 1.5rem 0 0.5rem !important; }

  .recovery-display {
    padding: 1rem;
    border: 1px solid rgba(255,79,139,0.4);
    border-radius: 12px;
    background: rgba(255,79,139,0.08);
    color: #ff4f8b;
    font-family: monospace;
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-align: center;
  }

  .recovery-help {
    margin: 0.75rem 0 0.5rem !important;
    font-size: 0.82rem;
  }

  @keyframes access-shake {
    0%, 100% { transform: translateX(0); }
    20% { transform: translateX(-8px); }
    40% { transform: translateX(8px); }
    60% { transform: translateX(-5px); }
    80% { transform: translateX(5px); }
  }

  @keyframes access-joke-pop {
    0% { opacity: 0; scale: 0.35; filter: blur(4px); }
    12% { opacity: 1; scale: 1.05; filter: blur(0); }
    22% { scale: 1; }
    78% { opacity: 1; }
    100% { opacity: 0; scale: 0.9; translate: 0 12px; }
  }
</style>


<style>
  @media (max-width: 640px) {
    .access-page {
      background-attachment: scroll;
      background-position: 58% center;
    }

    .access-page.auth-login .auth-background { object-position: 62% center; }
    .access-page.auth-register .auth-background { object-position: 50% center; }
    .access-page.auth-recovery .auth-background { object-position: 54% center; }
  }
</style>
