---
export const prerender = false;
import Layout from "../../layouts/Layout.astro";
import { localizedPath, useT } from "../../i18n";

const lang = Astro.locals.lang;
const isEnglish = lang === "en";
const t = useT(lang);
const confirmed = Astro.url.searchParams.get("confirmed") === "1";
const recovery = Astro.url.searchParams.get("recovery") === "1";
const completeProfile = Astro.url.searchParams.get("complete-profile") === "1";
---

<Layout
  title={isEnglish ? "Sign in — Renanime's Gallery" : "Acceso — Renanime's Gallery"}
  description={isEnglish ? "Sign in or create your Renanime account." : "Inicia sesión o crea tu cuenta de Renanime."}
>
  <main class="auth-shell" data-initial-recovery={recovery ? "true" : "false"} data-initial-confirmed={confirmed ? "true" : "false"} data-initial-complete-profile={completeProfile ? "true" : "false"}>
  <section class="access-gate access-page auth-login" id="access-gate" aria-labelledby="access-gate-title">
    <a class="language-toggle-auth" data-astro-reload href={`${localizedPath(lang === "es" ? "en" : "es", "/login/")}${Astro.url.search}`} hreflang={lang === "es" ? "en" : "es"} aria-label={t(lang === "es" ? "language.switchToEnglish" : "language.switchToSpanish")} title={t(lang === "es" ? "language.switchToEnglish" : "language.switchToSpanish")}>{isEnglish ? "EN · ES" : "ES · EN"}</a>
    <div class="auth-backgrounds" aria-hidden="true">
      <img class="auth-background" src="/images/login2.jpg" alt="" />
    </div>
    <section class="access-card" id="access-gate-card" aria-labelledby="access-gate-title">
      <div class="brand" aria-label="Renanime"><span class="brand-ren">Ren</span><span class="brand-anime">anime</span></div>
      <p class="eyebrow">{isEnglish ? "PRIVATE ACCESS" : "ACCESO PRIVADO"}</p>
      <h1 id="access-gate-title">{isEnglish ? "Your anime world awaits." : "Tu mundo anime te espera."}</h1>
      <p class="subtitle">{isEnglish ? "Enter the access code to continue to Renanime." : "Introduce tu código de acceso para entrar en Renanime."}</p>
      <form id="access-gate-form">
        <label for="access-gate-password">{isEnglish ? "Access code" : "Código de acceso"}</label>
        <input id="access-gate-password" name="accessPassword" type="password" autocomplete="current-password" required autofocus />
        <button type="submit" id="access-gate-submit">{isEnglish ? "Enter" : "Entrar"}</button>
        <p id="access-gate-feedback" class="message" role="alert" aria-live="polite"></p>
      </form>
    </section>
  </section>

    <a class="language-toggle-auth" data-astro-reload href={`${localizedPath(Astro.locals.lang === "es" ? "en" : "es", "/login/")}${Astro.url.search}`} hreflang={Astro.locals.lang === "es" ? "en" : "es"} aria-label={t(Astro.locals.lang === "es" ? "language.switchToEnglish" : "language.switchToSpanish")} title={t(Astro.locals.lang === "es" ? "language.switchToEnglish" : "language.switchToSpanish")}>
      {isEnglish ? "EN · ES" : "ES · EN"}
    </a>
    <div class="auth-art" aria-hidden="true">
      <img src="/images/login2.jpg" alt="" />
      <div class="art-shade"></div>
      <a class="brand" href={localizedPath(lang, "/")} aria-label="Renanime"><span>Ren</span>anime</a>
      <p class="art-caption">{isEnglish ? "YOUR ANIME WORLD. YOUR STORY." : "TU MUNDO ANIME. TU HISTORIA."}</p>
    </div>

    <section class="auth-panel" id="auth-content" aria-labelledby="auth-title" hidden>
      <div class="mobile-brand brand"><span>Ren</span>anime</div>
      <p class="eyebrow">{isEnglish ? "WELCOME, NAKAMA" : "BIENVENIDO, NAKAMA"}</p>
      <h1 id="auth-title">{recovery ? (isEnglish ? "Choose a new password" : "Crea una nueva contraseña") : confirmed ? (isEnglish ? "Verify your email" : "Verifica tu email") : (isEnglish ? "Your anime journey starts here." : "Tu aventura anime empieza aquí.")}</h1>
      <p class="intro" id="auth-intro">{recovery ? (isEnglish ? "Choose a strong password for your account." : "Elige una contraseña segura para tu cuenta.") : confirmed ? (isEnglish ? "Check your inbox to confirm your account, then sign in." : "Revisa tu bandeja de entrada para confirmar tu cuenta y después inicia sesión.") : (isEnglish ? "Sign in to your collection or create your own space." : "Entra en tu colección o crea tu propio espacio.")}</p>

      <div class="auth-social-options" hidden={recovery}>
        <div class="auth-tabs" role="tablist" aria-label={isEnglish ? "Account access" : "Acceso a la cuenta"}>
          <button type="button" id="tab-login" class:list={["tab", !confirmed ? "active" : ""]} role="tab" aria-selected={!confirmed ? "true" : "false"}>{isEnglish ? "Sign in" : "Iniciar sesión"}</button>
          <button type="button" id="tab-register" class="tab" role="tab" aria-selected="false">{isEnglish ? "Create account" : "Crear cuenta"}</button>
        </div>

        <button type="button" class="google-button" id="google-auth">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="#4285F4" d="M21.35 12.23c0-.72-.06-1.25-.2-1.8H12v3.27h5.36a4.6 4.6 0 0 1-1.99 3.02l-.02.11 2.89 2.24.2.02c1.85-1.71 2.91-4.23 2.91-7.36Z"/><path fill="#34A853" d="M12 21.6c2.64 0 4.86-.87 6.48-2.36l-3.09-2.4c-.83.56-1.94.95-3.39.95-2.59 0-4.79-1.71-5.57-4.07l-.1.01-3 2.32-.04.1A9.79 9.79 0 0 0 12 21.6Z"/><path fill="#FBBC05" d="M6.43 13.72A5.9 5.9 0 0 1 6.1 12c0-.6.11-1.18.31-1.72l-.01-.12-3.04-2.36-.1.05A9.7 9.7 0 0 0 2.2 12c0 1.57.38 3.06 1.06 4.35l3.17-2.63Z"/><path fill="#EA4335" d="M12 6.2c1.84 0 3.08.79 3.79 1.45l2.77-2.7C16.85 3.37 14.64 2.4 12 2.4a9.8 9.8 0 0 0-8.74 5.45l3.16 2.43C7.21 7.91 9.41 6.2 12 6.2Z"/></svg>
          {isEnglish ? "Continue with Google" : "Continuar con Google"}
        </button>

        <div class="separator"><span>{isEnglish ? "or with email" : "o con email"}</span></div>
      </div>

      <form id="auth-form">
        <div class="field" id="aka-field" hidden>
          <label for="aka">{isEnglish ? "Otaku nickname" : "Mote otaku"}</label>
          <input id="aka" name="aka" type="text" minlength="2" maxlength="24" autocomplete="nickname" placeholder={isEnglish ? "e.g. Rensensei" : "Ej. Rensensei"} />
          <small>{isEnglish ? "This is how other nakama will know you." : "Así te conocerán los demás nakamas."}</small>
        </div>
        <div class="field" id="email-field">
          <label for="email">Email</label>
          <input id="email" name="email" type="email" autocomplete="email" required maxlength="254" placeholder="you@example.com" />
        </div>
        <div class="field" id="password-field">
          <label for="password">{isEnglish ? "Password" : "Contraseña"}</label>
          <input id="password" name="password" type="password" autocomplete={recovery ? "new-password" : "current-password"} required minlength="8" maxlength="128" placeholder="••••••••" />
          <small id="password-help">{isEnglish ? "At least 8 characters." : "Mínimo 8 caracteres."}</small>
        </div>
        <div class="field" id="confirm-field" hidden>
          <label for="confirm-password">{isEnglish ? "Confirm password" : "Repite la contraseña"}</label>
          <input id="confirm-password" name="confirmPassword" type="password" autocomplete="new-password" minlength="8" maxlength="128" />
        </div>
        <button type="submit" class="primary-button" id="submit-auth">{recovery ? (isEnglish ? "Update password" : "Actualizar contraseña") : confirmed ? (isEnglish ? "Sign in" : "Iniciar sesión") : (isEnglish ? "Sign in" : "Iniciar sesión")}</button>
        <button type="button" class="text-button" id="forgot-password" hidden>{isEnglish ? "Forgot your password?" : "¿Has olvidado tu contraseña?"}</button>
        <p class="feedback" id="auth-feedback" role="status" aria-live="polite"></p>
      </form>

      <p class="legal">{isEnglish ? "By continuing, you agree to use Renanime respectfully. Account and privacy terms will be available before public launch." : "Al continuar, te comprometes a utilizar Renanime de forma respetuosa. Las condiciones de cuenta y privacidad estarán disponibles antes del lanzamiento público."}</p>
    </section>
  </main>
</Layout>

<script>
  const accessGate = document.querySelector<HTMLElement>("#access-gate");
  const accessContent = document.querySelector<HTMLElement>("#auth-content");
  const accessGateForm = document.querySelector<HTMLFormElement>("#access-gate-form");
  const accessGatePassword = document.querySelector<HTMLInputElement>("#access-gate-password");
  const accessGateSubmit = document.querySelector<HTMLButtonElement>("#access-gate-submit");
  const accessGateFeedback = document.querySelector<HTMLParagraphElement>("#access-gate-feedback");
  const ACCESS_SESSION_KEY = "renanime-access-granted";
  const accessGateCard = document.querySelector<HTMLElement>("#access-gate-card");
  const accessJokes = document.createElement("div");
  accessJokes.className = "access-jokes";
  accessJokes.setAttribute("aria-live", "polite");
  document.body.appendChild(accessJokes);
  const gateIsEnglish = document.documentElement.lang === "en";
  const accessFailureMessages = gateIsEnglish
    ? ["Someone forgot the access code.", "Renato does not want you here.", "Are you sure you know where you are?", "That code would not even open the fridge.", "Kami says: access denied."]
    : ["Alguien se ha olvidado del código de acceso.", "Renato no te quiere por aquí.", "¿Seguro que sabes dónde estás?", "Ese código no abre ni la nevera.", "Kami dice: acceso denegado."];
  const accessFailureKey = "renanime-access-failure-index";
  let accessFailureIndex = Number(sessionStorage.getItem(accessFailureKey) ?? "0");
  if (!Number.isInteger(accessFailureIndex) || accessFailureIndex < 0 || accessFailureIndex >= accessFailureMessages.length) accessFailureIndex = 0;
  const showAccessFailure = () => {
    accessJokes.innerHTML = "";
    accessGateCard?.classList.remove("access-wrong");
    void accessGateCard?.offsetWidth;
    accessGateCard?.classList.add("access-wrong");
    const message = accessFailureMessages[accessFailureIndex];
    accessFailureIndex = (accessFailureIndex + 1) % accessFailureMessages.length;
    sessionStorage.setItem(accessFailureKey, String(accessFailureIndex));
    if (accessGateFeedback) accessGateFeedback.textContent = message;
    const bubble = document.createElement("span");
    bubble.textContent = message;
    accessJokes.appendChild(bubble);
    window.setTimeout(() => {
      accessJokes.innerHTML = "";
      accessGateCard?.classList.remove("access-wrong");
    }, 3200);
  };

  const unlockAccess = () => {
    if (accessGate) accessGate.hidden = true;
    if (accessContent) accessContent.hidden = false;
  };

  if (sessionStorage.getItem(ACCESS_SESSION_KEY) === "1") {
    unlockAccess();
  }

  accessGateForm?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!accessGatePassword || !accessGateFeedback || !accessGateSubmit) return;
    accessGateFeedback.textContent = "";
    accessGateSubmit.disabled = true;
    accessGateSubmit.textContent = isEnglish ? "Checking…" : "Comprobando…";
    try {
      const response = await fetch("/api/auth/access", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        credentials: "same-origin",
        body: JSON.stringify({ accessPassword: accessGatePassword.value }),
      });
      const data = await response.json().catch(() => ({}));
      if (!response.ok || data.ok !== true) {
        accessGateFeedback.textContent = data.error === "INVALID_ACCESS_PASSWORD"
          ? (isEnglish ? "Incorrect access code." : "Código de acceso incorrecto.")
          : (isEnglish ? "Could not open the door to Renanime." : "No se ha podido abrir la puerta de Renanime.");
        if (data.error === "INVALID_ACCESS_PASSWORD") showAccessFailure();
        return;
      }
      sessionStorage.setItem(ACCESS_SESSION_KEY, "1");
      unlockAccess();
    } catch {
      accessGateFeedback.textContent = isEnglish ? "Could not connect. Try again." : "No se pudo conectar. Inténtalo de nuevo.";
    } finally {
      accessGateSubmit.disabled = false;
      accessGateSubmit.textContent = isEnglish ? "Unlock access" : "Desbloquear acceso";
    }
  });

  const root = document.querySelector<HTMLElement>(".auth-shell");
  const initialRecovery = root?.dataset.initialRecovery === "true";
  const initialConfirmed = root?.dataset.initialConfirmed === "true";
  const initialCompleteProfile = root?.dataset.initialCompleteProfile === "true";
  const isEnglish = document.documentElement.lang === "en";
  const form = document.querySelector<HTMLFormElement>("#auth-form");
  const tabLogin = document.querySelector<HTMLButtonElement>("#tab-login");
  const tabRegister = document.querySelector<HTMLButtonElement>("#tab-register");
  const akaField = document.querySelector<HTMLElement>("#aka-field");
  const emailField = document.querySelector<HTMLElement>("#email-field");
  const passwordField = document.querySelector<HTMLElement>("#password-field");
  const confirmField = document.querySelector<HTMLElement>("#confirm-field");
  const emailInput = document.querySelector<HTMLInputElement>("#email");
  const passwordInput = document.querySelector<HTMLInputElement>("#password");
  const confirmInput = document.querySelector<HTMLInputElement>("#confirm-password");
  const akaInput = document.querySelector<HTMLInputElement>("#aka");
  const submit = document.querySelector<HTMLButtonElement>("#submit-auth");
  const feedback = document.querySelector<HTMLParagraphElement>("#auth-feedback");
  const googleButton = document.querySelector<HTMLButtonElement>("#google-auth");
  const forgotButton = document.querySelector<HTMLButtonElement>("#forgot-password");
  const title = document.querySelector<HTMLHeadingElement>("#auth-title");
  const intro = document.querySelector<HTMLParagraphElement>("#auth-intro");
  const separator = document.querySelector<HTMLElement>(".separator");
  const socialOptions = document.querySelector<HTMLElement>(".auth-social-options");
  const tabs = document.querySelector<HTMLElement>(".auth-tabs");
  let mode: "login" | "register" | "recovery" | "profile" = initialRecovery ? "recovery" : initialCompleteProfile ? "profile" : "login";

  const setFeedback = (message: string, error = false) => {
    if (!feedback) return;
    feedback.textContent = message;
    feedback.dataset.error = error ? "true" : "false";
  };

  const setMode = (next: "login" | "register" | "recovery" | "profile") => {
    mode = next;
    const registering = next === "register";
    const recovering = next === "recovery";
    const completingProfile = next === "profile";
    if (akaField) akaField.hidden = !(registering || completingProfile);
    if (confirmField) confirmField.hidden = !registering;
    if (emailField) emailField.hidden = recovering || completingProfile;
    if (passwordField) passwordField.hidden = completingProfile;
    if (googleButton) googleButton.hidden = recovering || completingProfile;
    if (separator) separator.hidden = recovering || completingProfile;
    if (socialOptions) socialOptions.hidden = recovering || completingProfile;
    if (tabs) tabs.hidden = recovering || completingProfile;
    if (tabLogin) tabLogin.hidden = completingProfile;
    if (tabRegister) tabRegister.hidden = completingProfile;
    if (forgotButton) forgotButton.hidden = next !== "login";
    if (tabLogin) { tabLogin.classList.toggle("active", next === "login"); tabLogin.setAttribute("aria-selected", String(next === "login")); }
    if (tabRegister) { tabRegister.classList.toggle("active", registering); tabRegister.setAttribute("aria-selected", String(registering)); }
    if (title) title.textContent = recovering
      ? (isEnglish ? "Choose a new password" : "Crea una nueva contraseña")
      : completingProfile
        ? (isEnglish ? "Choose your otaku nickname." : "Elige tu mote otaku.")
        : (isEnglish ? (registering ? "Join your anime world." : "Your anime journey starts here.") : (registering ? "Tu mundo anime te espera." : "Tu aventura anime empieza aquí."));
    if (intro) intro.textContent = recovering
      ? (isEnglish ? "Choose a strong password for your account." : "Elige una contraseña segura para tu cuenta.")
      : completingProfile
        ? (isEnglish ? "One last step before entering Renanime." : "Un último paso antes de entrar en Renanime.")
        : (isEnglish ? (registering ? "Create your account and choose your otaku nickname." : "Sign in to your collection or create your own space.") : (registering ? "Crea tu cuenta y elige tu mote otaku." : "Entra en tu colección o crea tu propio espacio."));
    if (submit) submit.textContent = recovering
      ? (isEnglish ? "Update password" : "Actualizar contraseña")
      : completingProfile
        ? (isEnglish ? "Save nickname" : "Guardar mote")
        : (isEnglish ? (registering ? "Create account" : "Sign in") : (registering ? "Crear cuenta" : "Iniciar sesión"));
    if (emailInput) emailInput.required = !recovering && !completingProfile;
    if (passwordInput) {
      passwordInput.required = !completingProfile;
      passwordInput.autocomplete = registering || recovering ? "new-password" : "current-password";
    }
    if (akaInput) akaInput.required = registering || completingProfile;
    setFeedback("");
  };

  tabLogin?.addEventListener("click", () => setMode("login"));
  tabRegister?.addEventListener("click", () => setMode("register"));

  googleButton?.addEventListener("click", async () => {
    setFeedback("");
    googleButton.disabled = true;
    try {
      const response = await fetch("/api/auth/oauth", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        credentials: "same-origin",
        body: JSON.stringify({ provider: "google" }),
      });
      const data = await response.json().catch(() => ({}));
      if (!response.ok || !data.url) {
        const diagnostic = [data.error, data.code, data.stage, data.errorName].filter(Boolean).join(":") || "OAUTH_FAILED";
        throw new Error(diagnostic);
      }
      window.location.assign(data.url);
    } catch (error) {
      const diagnostic = error instanceof Error ? error.message : "UNKNOWN_ERROR";
      setFeedback(
        isEnglish
          ? `Google sign-in failed (${diagnostic}). You can try email instead.`
          : `No se pudo iniciar sesión con Google (${diagnostic}). Puedes probar con email.`,
        true,
      );
      googleButton.disabled = false;
    }
  });

  forgotButton?.addEventListener("click", async () => {
    const email = emailInput?.value.trim().toLowerCase() ?? "";
    if (!email) {
      setFeedback(isEnglish ? "Enter your email first, then choose this option." : "Introduce primero tu email y vuelve a pulsar esta opción.", true);
      emailInput?.focus();
      return;
    }
    forgotButton.disabled = true;
    try {
      const response = await fetch("/api/auth/reset", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        credentials: "same-origin",
        body: JSON.stringify({ email }),
      });
      const data = await response.json();
      if (!response.ok) throw new Error(data.error || "RESET_FAILED");
      setFeedback(isEnglish ? "If an account exists for this email, a reset link will be sent." : "Si existe una cuenta con ese email, recibirás un enlace para restablecer la contraseña.");
    } catch {
      setFeedback(isEnglish ? "Password reset is temporarily unavailable." : "La recuperación de contraseña no está disponible temporalmente.", true);
    } finally {
      forgotButton.disabled = false;
    }
  });

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    setFeedback("");
    const email = emailInput?.value.trim().toLowerCase() ?? "";
    const password = passwordInput?.value ?? "";
    const aka = akaInput?.value.trim() ?? "";
    if (mode !== "recovery" && mode !== "profile" && !email) return setFeedback(isEnglish ? "Enter a valid email." : "Introduce un email válido.", true);
    if (mode !== "profile" && password.length < 8) return setFeedback(isEnglish ? "Use at least 8 characters for your password." : "La contraseña debe tener al menos 8 caracteres.", true);
    if (mode === "register" && !/^[\p{L}\p{N}_-]{2,24}$/u.test(aka)) return setFeedback(isEnglish ? "Your nickname must be 2–24 letters, numbers, underscores or hyphens." : "El mote debe tener entre 2 y 24 letras, números, guiones o guiones bajos.", true);
    if (mode === "register" && password !== (confirmInput?.value ?? "")) return setFeedback(isEnglish ? "Passwords do not match." : "Las contraseñas no coinciden.", true);

    submit && (submit.disabled = true);
    try {
      let response: Response;
      let data: any;
      if (mode === "profile") {
        response = await fetch("/api/auth/profile", {
          method: "POST", headers: { "Content-Type": "application/json" }, credentials: "same-origin",
          body: JSON.stringify({ aka }),
        });
      } else if (mode === "recovery") {
        response = await fetch("/api/auth/update-password", {
          method: "POST", headers: { "Content-Type": "application/json" }, credentials: "same-origin",
          body: JSON.stringify({ password }),
        });
      } else {
        response = await fetch(mode === "register" ? "/api/auth/register" : "/api/auth/login", {
          method: "POST", headers: { "Content-Type": "application/json" }, credentials: "same-origin",
          body: JSON.stringify(mode === "register" ? { email, password, aka } : { email, password }),
        });
      }
      data = await response.json();
      if (!response.ok || data.ok !== true) {
        const message = data.error === "INVALID_CREDENTIALS"
          ? (isEnglish ? "Email or password is incorrect." : "El email o la contraseña no son correctos.")
          : data.error === "NICKNAME_TAKEN"
            ? (isEnglish ? "That nickname is already taken." : "Ese mote ya está en uso.")
            : data.error === "EMAIL_PASSWORD_SIGNUP_DISABLED"
              ? (isEnglish ? "Email sign-up is not enabled yet." : "El registro por email aún no está habilitado.")
              : data.error === "PROFILE_UPDATE_FAILED"
                ? (isEnglish
                    ? `Profile update failed (${data.code || "UNKNOWN"}).`
                    : `No se pudo guardar el mote (${data.code || "UNKNOWN"}).`)
                : (isEnglish ? "We couldn't complete that request. Please try again." : "No se ha podido completar la solicitud. Inténtalo de nuevo.");
        throw new Error(message);
      }
      if (mode === "register") {
        setMode("login");
        setFeedback(isEnglish ? "Account created. Check your email to confirm it before signing in." : "Cuenta creada. Revisa tu email para confirmarla antes de iniciar sesión.");
      } else if (mode === "recovery") {
        window.location.assign(isEnglish ? "/en/login/?password_updated=1" : "/login/?password_updated=1");
      } else if (mode === "profile") {
        window.location.assign(isEnglish ? "/en/" : "/");
      } else {
        window.location.assign(isEnglish ? "/en/" : "/");
      }
    } catch (error) {
      setFeedback(error instanceof Error ? error.message : (isEnglish ? "Connection error. Try again." : "Error de conexión. Inténtalo de nuevo."), true);
    } finally {
      if (submit) submit.disabled = false;
    }
  });

  if (initialRecovery) setMode("recovery");
  else if (initialCompleteProfile) setMode("profile");
  else if (initialConfirmed) setMode("login");
</script>

<style is:global>
  .access-gate { position:fixed; inset:0; z-index:50; min-height:100svh; display:grid; place-items:center; padding:2rem 1.25rem; overflow:hidden; background:#050505; color:#fff; }
  .access-gate[hidden] { display:none!important; }
  .access-gate .auth-backgrounds { position:absolute; inset:0; z-index:0; overflow:hidden; background:#050505; }
  .access-gate .auth-background { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; object-position:center; }
  .access-gate .access-card { position:relative; z-index:1; width:min(100%,430px); margin-inline:auto; }
  .access-gate .access-card > .brand { position:static; display:block; width:fit-content; margin:0 0 3rem; text-align:left; font-size:2rem; font-weight:700; letter-spacing:-.05em; }
  .access-gate .brand-ren { color:var(--accent,#ff4f8b); }
  .access-gate .brand-anime { color:#fff; }
  .access-gate .eyebrow { margin:0 0 .65rem; color:#ff4f8b; font-size:.7rem; font-weight:800; letter-spacing:.18em; opacity:1; }
  .access-gate h1 { margin:0; font-size:clamp(2.4rem,9vw,4rem); line-height:.95; letter-spacing:-.045em; }
  .access-gate .subtitle { max-width:390px; margin:.8rem 0 1.2rem; color:rgba(255,255,255,.82); line-height:1.6; opacity:1; }
  .access-gate form { display:grid; gap:.75rem; }
  .access-gate label { color:#fff; font-size:.85rem; font-weight:650; }
  .access-gate input { width:100%; min-height:48px; box-sizing:border-box; padding:0 1rem; border:1px solid rgba(255,255,255,.2); border-radius:12px; background:rgba(15,15,22,.72); color:#fff; font:inherit; }
  .access-gate input:focus { outline:2px solid #ff4f8b; outline-offset:2px; }
  .access-gate button { width:100%; min-height:50px; margin-top:.35rem; border:0; border-radius:12px; background:var(--accent,#ff4f8b); color:#fff; font:inherit; font-weight:700; cursor:pointer; }
  .access-gate button:disabled { opacity:.65; cursor:wait; }
