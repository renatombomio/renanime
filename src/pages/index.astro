---
export const prerender = false;
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/layout/Navbar.astro";
import Footer from "../components/layout/Footer.astro";
import Hero from "../components/hero/Hero.astro";
import HomeGallery from "../components/home/HomeGallery";
import { getWatchedLibrary } from "../data/library";
const collectionEntries = getWatchedLibrary();
---

<Layout
  title={Astro.locals.lang === "en" ? "Renanime's Gallery — My personal anime archive" : "Renanime's Gallery — Mi archivo personal de anime"}
  description={Astro.locals.lang === "en" ? "Personal anime gallery: favourites, collection, genres and watchlist." : "Galería personal de anime: favoritos, colección, géneros, pendientes."}
>
  <Navbar />

  <main id="main-content">
    <Hero />

    <section class="home-gallery-section" aria-label={Astro.locals.lang === "en" ? "Ren's collection" : "Colección de Ren"}>
      <HomeGallery entries={collectionEntries} lang={Astro.locals.lang} client:load />
    </section>
  </main>

  <Footer />
</Layout>

<style>
  #main-content {
    margin: 0;
    padding-top: 88px;
  }

  :global(.hero) {
    margin: 0;
    padding: 0;
  }

  @media (max-width: 1120px) {
    #main-content {
      padding-top: 74px;
    }
  }

  @media (max-width: 520px) {
    #main-content {
      padding-top: 68px;
    }
  }

  .home-gallery-section {
    width: min(calc(100% - (var(--gutter) * 2)), var(--container-max));
    margin: 0 auto;
    padding: 1rem 0 var(--section-space);
  }

  @media (max-width: 700px) {
    .home-gallery-section {
      width: calc(100% - 1.25rem);
      padding-top: 0.75rem;
    }
  }
</style>