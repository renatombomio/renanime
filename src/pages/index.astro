---
export const prerender = false;
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/layout/Navbar.astro";
import Footer from "../components/layout/Footer.astro";
import Hero from "../components/hero/Hero.astro";
import HomeGallery from "../components/home/HomeGallery";
import AnimeOfTheWeek from "../components/home/AnimeOfTheWeek.astro";
import WeeklyEpisodes from "../components/home/WeeklyEpisodes.astro";
import RecommendedManga from "../components/home/RecommendedManga.astro";
import { getRecommendedManga } from "../lib/recommended-manga";
import SeasonalFeaturedAnime from "../components/home/SeasonalFeaturedAnime.astro";
import { getSeasonFeaturedAnime } from "../lib/season-featured-anime";
import HomeCommunity from "../components/home/HomeCommunity.astro";
import { createSupabaseSsrClient } from "../lib/supabase-ssr";
import { getWatchedLibrary } from "../data/library";
import { localizedPath } from "../i18n";
const collectionEntries = getWatchedLibrary();
const supabase = createSupabaseSsrClient(Astro.request, Astro.cookies);
let communityMembers: { id: string; aka: string; avatar_url: string | null; last_seen_at: string | null }[] = [];
let otakuCount = 0;
try {
  const [{ data: memberRows, error: memberError }, { count: userCount, error: userCountError }] = await Promise.all([
    supabase.from("profiles").select("id, aka, avatar_url, last_seen_at").eq("is_private", false).not("aka", "is", null).order("last_seen_at", { ascending: false, nullsFirst: false }).limit(18),
    supabase.from("profiles").select("id", { count: "exact", head: true }),
  ]);
  if (userCountError) console.error("[home] Historical otaku count unavailable:", userCountError.message);
  otakuCount = userCountError ? 0 : userCount ?? 0;
  if (memberError) console.error("[home] Community members unavailable:", memberError.message);
  else communityMembers = (memberRows ?? []).filter((member) => Boolean(member.aka));
} catch (error) { console.error("[home] Community data unavailable:", error); }
const lang = Astro.locals.lang;
const isEnglish = lang === "en";
let seasonalAnime = [];
try {
  const payload = await getSeasonFeaturedAnime();
  seasonalAnime = payload.anime;
} catch (error) {
  console.error("[home] Seasonal featured anime unavailable:", error);
}
let recommendedManga = null;
try {
  recommendedManga = await getRecommendedManga(lang);
} catch (error) {
  console.error("[home] Recommended manga unavailable:", error);
}
let weeklyEpisodes = [];
try {
  const requestCookie = Astro.request.headers.get("cookie");
  const response = await fetch(new URL(`/api/weekly-popular-episodes?lang=${lang}`, Astro.url), {
    headers: {
      Accept: "application/json",
      ...(requestCookie ? { Cookie: requestCookie } : {}),
    },
    redirect: "manual",
    cache: "no-store",
  });
  if (!response.ok) throw new Error(`Weekly episodes API returned HTTP ${response.status}${response.status >= 300 && response.status < 400 ? ` (redirect ${response.headers.get("location") ?? "unknown"})` : ""}`);
  const payload = await response.json();
  if (!payload.success || !Array.isArray(payload.episodes)) throw new Error("Weekly episodes API returned an invalid payload.");
  weeklyEpisodes = payload.episodes;
} catch (error) {
  console.error("[home] Weekly popular episodes unavailable:", error);
}
---

<Layout
  title={isEnglish ? "Renanime's Gallery — My personal anime archive" : "Renanime's Gallery — Mi archivo personal de anime"}
  description={isEnglish ? "Personal anime gallery: favorites, collection, genres and watchlist." : "Galería personal de anime: favoritos, colección, géneros, pendientes."}
>
  <Navbar />

  <main id="main-content">
    <Hero
      kicker="Renanime's"
      title="Gallery."
      copy={isEnglish ? "Anime through my eyes.\nThis is my gift to you." : "Anime a través de mis ojos.\nEste es mi regalo para ti."}
      ariaLabel={isEnglish ? "Renanime's Gallery" : "Galería de Renanime"}
    />

    <section class="home-gallery-section" aria-label={isEnglish ? "Ren's collection" : "Colección de Ren"}>
      <HomeGallery entries={collectionEntries} lang={Astro.locals.lang} client:load />
    </section>

    <AnimeOfTheWeek />
    <SeasonalFeaturedAnime
      anime={seasonalAnime}
      labels={{
        eyebrow: isEnglish ? "Now airing" : "En emisión",
        title: isEnglish ? "Season highlights" : "Estrenos de temporada",
        ariaLabel: isEnglish ? "Featured anime of the current season" : "Animes destacados de la temporada actual",
      }}
    />
    <WeeklyEpisodes
      episodes={weeklyEpisodes}
      href={(animeId) => localizedPath(lang, `/anime/${animeId}/`)}
      labels={{
        eyebrow: isEnglish ? "This week" : "Esta semana",
        title: isEnglish ? "Popular episodes this week" : "Episodios populares de la semana",
        titleAccent: isEnglish ? "this week" : "de la semana",
        subtitle: isEnglish ? "Top 5 by popularity · AniList" : "Top 5 por popularidad · AniList",
        episode: isEnglish ? "Episode" : "Episodio",
        episodeShort: "Ep.",
      }}
    />

    <RecommendedManga
      manga={recommendedManga}
      href={recommendedManga?.siteUrl || "#"}
      labels={{
        subtitle: isEnglish ? "A story worth discovering" : "Una historia que merece ser descubierta",
        volumes: isEnglish ? "volumes" : "tomos",
        cta: isEnglish ? "View details" : "Ver ficha",
      }}
    />

    <HomeCommunity
      members={communityMembers}
      labels={{
        title: isEnglish ? "Community" : "Comunidad",
        members: isEnglish ? "People on Renanime" : "Gente en Renanime",
        emptyMembers: isEnglish ? "The community is just getting started." : "La comunidad está empezando a crecer.",
      }}
    />

    <section class="otaku-counter" aria-label={isEnglish ? "Registered otakus" : "Otakus registrados"}>
      <strong>{new Intl.NumberFormat(isEnglish ? "en" : "es").format(otakuCount)}</strong>
      <span>otakus</span>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  #main-content {
    margin: 0;
    padding-top: 88px;
  }

  :global(.hero) {
    margin: 0;
    padding: 0;
  }

  @media (max-width: 1120px) {
    #main-content {
      padding-top: 74px;
    }
  }

  @media (max-width: 520px) {
    #main-content {
      padding-top: 68px;
    }
  }

  .otaku-counter{display:grid;grid-template-columns:max-content;justify-items:center;gap:.35rem;width:max-content;max-width:100%;padding:5rem 1rem 6rem;margin:0 auto;text-align:center;color:#f5f2ec}
  .otaku-counter strong{font-size:clamp(5.5rem,15vw,10rem);font-weight:900;line-height:.88;letter-spacing:-.075em;font-variant-numeric:tabular-nums}
  .otaku-counter span{display:block;width:100%;text-align:center;color:#929297;font-size:.78rem;font-weight:650;letter-spacing:.16em;text-transform:uppercase}
  .home-gallery-section {
    width: min(calc(100% - (var(--gutter) * 2)), var(--container-max));
    margin: 0 auto;
    padding: 1rem 0 var(--section-space);
  }

  @media (max-width: 700px) {
    .home-gallery-section {
      width: calc(100% - 1.25rem);
      padding-top: 0.75rem;
    }
  }
</style>
