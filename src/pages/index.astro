---
export const prerender = false;
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/layout/Navbar.astro";
import Footer from "../components/layout/Footer.astro";
import Hero from "../components/hero/Hero.astro";
import HomeGallery from "../components/home/HomeGallery";
import AnimeOfTheWeek from "../components/home/AnimeOfTheWeek.astro";
import WeeklyEpisodes from "../components/home/WeeklyEpisodes.astro";
import HomeCommunity from "../components/home/HomeCommunity.astro";
import { createSupabaseSsrClient } from "../lib/supabase-ssr";
import { getWatchedLibrary } from "../data/library";
import { localizedPath } from "../i18n";
const collectionEntries = getWatchedLibrary();
const supabase = createSupabaseSsrClient(Astro.request, Astro.cookies);
let communityMembers: { id: string; aka: string; avatar_url: string | null; last_seen_at: string | null }[] = [];
let communityActivity: { id: string; animeId: number | null; action: "comment" | "like" | "joined"; content: string | null; createdAt: string; aka: string; avatarUrl: string | null; animeTitle: string }[] = [];
let communityStats = { users: 0, comments: 0, likes: 0 };
try {
  const [{ data: memberRows, error: memberError }, { data: commentRows, error: commentError }, { data: likeRows, error: likeError }, { data: joinedRows, error: joinedError }, { count: userCount, error: userCountError }, { count: commentCount, error: commentCountError }, { count: likeCount, error: likeCountError }] = await Promise.all([
    supabase.from("profiles")
      .select("id, aka, avatar_url, last_seen_at")
      .eq("is_private", false)
      .not("aka", "is", null)
      .order("last_seen_at", { ascending: false, nullsFirst: false })
      .limit(18),
    supabase.from("anime_comments")
      .select("id, anime_id, content, created_at, profiles!inner(aka, avatar_url)")
      .order("created_at", { ascending: false })
      .limit(8),
    supabase.from("anime_likes")
      .select("id, anime_id, created_at, profiles!inner(aka, avatar_url)")
      .order("created_at", { ascending: false })
      .limit(8),
    supabase.from("profiles")
      .select("id, aka, avatar_url, created_at")
      .eq("is_private", false)
      .not("aka", "is", null)
      .order("created_at", { ascending: false })
      .limit(5),
    supabase.from("profiles").select("id", { count: "exact", head: true }),
    supabase.from("anime_comments").select("id", { count: "exact", head: true }),
    supabase.from("anime_likes").select("id", { count: "exact", head: true }),
  ]);
  if (userCountError) console.error("[home] User count unavailable:", userCountError.message);
  if (commentCountError) console.error("[home] Comment count unavailable:", commentCountError.message);
  if (likeCountError) console.error("[home] Like count unavailable:", likeCountError.message);
  communityStats = { users: userCountError ? 0 : userCount ?? 0, comments: commentCountError ? 0 : commentCount ?? 0, likes: likeCountError ? 0 : likeCount ?? 0 };
  if (memberError) console.error("[home] Community members unavailable:", memberError.message);
  else communityMembers = (memberRows ?? []).filter((member) => Boolean(member.aka));
  if (commentError) console.error("[home] Community activity unavailable:", commentError.message);
  else communityActivity = (commentRows ?? []).flatMap((comment) => {
    const profile = Array.isArray(comment.profiles) ? comment.profiles[0] : comment.profiles;
    if (!profile?.aka || !Number.isInteger(comment.anime_id)) return [];
    return [{
      id: comment.id, animeId: comment.anime_id, action: "comment" as const,
      content: comment.content, createdAt: comment.created_at, aka: profile.aka,
      avatarUrl: profile.avatar_url, animeTitle: "",
    }];
  });
  if (likeError) console.error("[home] Community likes unavailable:", likeError.message);
  else communityActivity.push(...(likeRows ?? []).flatMap((like) => {
    const profile = Array.isArray(like.profiles) ? like.profiles[0] : like.profiles;
    if (!profile?.aka || !Number.isInteger(like.anime_id)) return [];
    return [{ id: like.id, animeId: like.anime_id, action: "like" as const, content: null,
      createdAt: like.created_at, aka: profile.aka, avatarUrl: profile.avatar_url, animeTitle: "" }];
  }));
  if (joinedError) console.error("[home] New community members unavailable:", joinedError.message);
  else communityActivity.push(...(joinedRows ?? []).flatMap((profile) => {
    if (!profile.aka || !profile.created_at) return [];
    return [{ id: profile.id, animeId: null, action: "joined" as const, content: null, createdAt: profile.created_at, aka: profile.aka, avatarUrl: profile.avatar_url, animeTitle: "" }];
  }));
  communityActivity.sort((a, b) => new Date(b.createdAt).getTime() - new Date(a.createdAt).getTime());
  communityActivity = communityActivity.slice(0, 5);
  const animeIds = [...new Set(communityActivity.flatMap((item) => item.animeId === null ? [] : [item.animeId]))];
  if (animeIds.length) {
    try {
      const titleResponse = await fetch("https://graphql.anilist.co", {
        method: "POST", headers: { "Content-Type": "application/json", Accept: "application/json" },
        body: JSON.stringify({ query: "query ($ids: [Int]) { Page { media(id_in: $ids, type: ANIME) { id title { romaji english } } } }", variables: { ids: animeIds } }),
      });
      if (titleResponse.ok) {
        const payload = await titleResponse.json();
        const titles = new Map((payload.data?.Page?.media ?? []).map((item: any) => [item.id, item.title.english || item.title.romaji || "Anime"]));
        communityActivity = communityActivity.map((item) => item.animeId === null ? item : ({ ...item, animeTitle: titles.get(item.animeId) || "Anime" }));
      }
    } catch (titleError) { console.error("[home] Community anime titles unavailable:", titleError); }
  }
} catch (error) {
  console.error("[home] Community data unavailable:", error);
}
const lang = Astro.locals.lang;
const isEnglish = lang === "en";
let weeklyEpisodes = [];
try {
  const requestCookie = Astro.request.headers.get("cookie");
  const response = await fetch(new URL(`/api/weekly-popular-episodes?lang=${lang}`, Astro.url), {
    headers: {
      Accept: "application/json",
      ...(requestCookie ? { Cookie: requestCookie } : {}),
    },
    redirect: "manual",
    cache: "no-store",
  });
  if (!response.ok) throw new Error(`Weekly episodes API returned HTTP ${response.status}${response.status >= 300 && response.status < 400 ? ` (redirect ${response.headers.get("location") ?? "unknown"})` : ""}`);
  const payload = await response.json();
  if (!payload.success || !Array.isArray(payload.episodes)) throw new Error("Weekly episodes API returned an invalid payload.");
  weeklyEpisodes = payload.episodes;
} catch (error) {
  console.error("[home] Weekly popular episodes unavailable:", error);
}
---

<Layout
  title={isEnglish ? "Renanime's Gallery — My personal anime archive" : "Renanime's Gallery — Mi archivo personal de anime"}
  description={isEnglish ? "Personal anime gallery: favorites, collection, genres and watchlist." : "Galería personal de anime: favoritos, colección, géneros, pendientes."}
>
  <Navbar />

  <main id="main-content">
    <Hero
      kicker="Renanime's"
      title="Gallery."
      copy={isEnglish ? "Anime through my eyes.\nThis is my gift to you." : "Anime a través de mis ojos.\nEste es mi regalo para ti."}
      ariaLabel={isEnglish ? "Renanime's Gallery" : "Galería de Renanime"}
    />

    <section class="home-gallery-section" aria-label={isEnglish ? "Ren's collection" : "Colección de Ren"}>
      <HomeGallery entries={collectionEntries} lang={Astro.locals.lang} client:load />
    </section>

    <AnimeOfTheWeek />
    <WeeklyEpisodes
      episodes={weeklyEpisodes}
      href={(animeId) => localizedPath(lang, `/anime/${animeId}/`)}
      labels={{
        eyebrow: isEnglish ? "This week" : "Esta semana",
        title: isEnglish ? "Popular episodes this week" : "Episodios populares de la semana",
        titleAccent: isEnglish ? "this week" : "de la semana",
        subtitle: isEnglish ? "Top 5 by popularity · AniList" : "Top 5 por popularidad · AniList",
        episode: isEnglish ? "Episode" : "Episodio",
        episodeShort: "Ep.",
      }}
    />

    <HomeCommunity
      members={communityMembers}
      activity={communityActivity}
      stats={communityStats}
      href={(animeId) => localizedPath(lang, `/anime/${animeId}/`)}
      profileHref={(aka) => localizedPath(lang, `/u/${encodeURIComponent(aka)}/`)}
      labels={{
        title: isEnglish ? "Community" : "Comunidad",
        members: isEnglish ? "People on Renanime" : "Gente en Renanime",
        activity: isEnglish ? "Recent activity" : "Actividad reciente",
        emptyMembers: isEnglish ? "The community is just getting started." : "La comunidad está empezando a crecer.",
        emptyActivity: isEnglish ? "No recent activity yet." : "Todavía no hay actividad reciente.",
        viewAll: "",
        commented: isEnglish ? "commented on" : "ha comentado",
        liked: isEnglish ? "liked" : "le ha dado like a",
        joined: isEnglish ? "joined Renanime" : "se ha unido a Renanime",
      }}
    />
  </main>

  <Footer />
</Layout>

<style>
  #main-content {
    margin: 0;
    padding-top: 88px;
  }

  :global(.hero) {
    margin: 0;
    padding: 0;
  }

  @media (max-width: 1120px) {
    #main-content {
      padding-top: 74px;
    }
  }

  @media (max-width: 520px) {
    #main-content {
      padding-top: 68px;
    }
  }

  .home-gallery-section {
    width: min(calc(100% - (var(--gutter) * 2)), var(--container-max));
    margin: 0 auto;
    padding: 1rem 0 var(--section-space);
  }

  @media (max-width: 700px) {
    .home-gallery-section {
      width: calc(100% - 1.25rem);
      padding-top: 0.75rem;
    }
  }
</style>
