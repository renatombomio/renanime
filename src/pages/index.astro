---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/layout/Navbar.astro";
import Footer from "../components/layout/Footer.astro";
import Container from "../components/ui/Container.astro";
import Hero from "../components/hero/Hero.astro";
import SectionHeader from "../components/ui/SectionHeader.astro";
import CollectionView from "../components/collection/CollectionView";
import FavoritesView from "../components/favorites/FavoritesView";
import { getFavoritesLibrary, getWatchedLibrary } from "../data/library";

const favoriteEntries = getFavoritesLibrary();
const collectionEntries = getWatchedLibrary();
---

<Layout
  title="Renanime's Gallery — Mi archivo personal de anime"
  description="Galería personal de anime: favoritos, colección, géneros, pendientes y próximos estrenos."
>
  <Navbar />

  <main id="main-content">
    <Hero />

    <section id="favorites" class="favorites-section section-space">
      <Container>
        <SectionHeader
          eyebrow="Selección personal"
          title="Favoritos"
          description="Mis animes favoritos. Historias que me han conmovido, personajes que se quedan contigo y valores que, sin pedir permiso, terminan enseñándote algo. Algunos te hacen reír, otros te rompen un poco. Los buenos hacen las dos cosas."
        />

        <div class="favorites-view-wrap">
          <FavoritesView entries={favoriteEntries} client:load />
        </div>
      </Container>
    </section>

    <section id="collection" class="collection-section section-space">
      <Container>
        <SectionHeader
          title="Colección"
          description="Aquí están todos los animes que he visto. Son muchos, pero nunca parece suficiente. Porque esa es la magia del anime: terminas una historia y, de alguna manera, ya estás buscando la siguiente."
        />

        <div class="collection-view-wrap">
          <CollectionView entries={collectionEntries} client:load />
        </div>
      </Container>
    </section>

    <section id="genres" class="placeholder-section section-space">
      <Container>
        <SectionHeader
          title="Géneros"
          description="Venga, toma un mapa. Aquí puedes explorar los animes que he visto por género, para encontrar algo que te apetezca y dejar de dar golpes de ciego en ese océano infinito que es el anime."
        />
      </Container>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .placeholder-section {
    border-top: 0;
  }

  .favorites-view-wrap {
    margin-top: clamp(3.5rem, 7vw, 6rem);
  }

  :global(.favorites-view) {
    width: 100%;
  }

  :global(.favorites-intro) {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-bottom: .8rem;
    border-bottom: 1px solid var(--color-border);
    color: var(--color-muted-400);
    font-family: var(--font-meta);
    font-size: .55rem;
    letter-spacing: .1em;
    text-transform: uppercase;
  }

  :global(.favorites-grid) {
    display: grid;
    grid-template-columns: 1.15fr .925fr .925fr;
    gap: clamp(1rem, 2vw, 2rem);
    align-items: end;
  }

  :global(.favorite-card) {
    min-width: 0;
  }

  :global(.favorite-card--2) {
    margin-top: clamp(3rem, 8vw, 8rem);
  }

  :global(.favorite-card--3) {
    margin-top: clamp(1.5rem, 4vw, 4rem);
  }

  :global(.favorite-card a) {
    display: block;
  }

  :global(.favorite-media) {
    position: relative;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background: var(--color-ink-800);
  }

  :global(.favorite-card--1 .favorite-media) {
    aspect-ratio: 4 / 5;
  }

  :global(.favorite-media::after) {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 48%, rgba(9,9,9,.72));
    content: "";
    pointer-events: none;
  }

  :global(.favorite-media img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 800ms cubic-bezier(.2,.7,.2,1), filter 500ms ease;
  }

  :global(.favorite-card a:hover .favorite-media img) {
    transform: scale(1.025);
    filter: saturate(1.04);
  }

  :global(.favorite-overlay) {
    position: absolute;
    right: .8rem;
    bottom: .8rem;
    left: .8rem;
    z-index: 2;
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: var(--color-paper-50);
    font-family: var(--font-meta);
    font-size: .52rem;
    letter-spacing: .08em;
  }

  :global(.favorite-mark) {
    font-size: .9rem;
  }

  :global(.favorite-caption) {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: .8rem;
    padding-top: .85rem;
  }

  :global(.favorite-number) {
    color: var(--color-muted-500);
    font-family: var(--font-meta);
    font-size: .55rem;
    letter-spacing: .08em;
  }

  :global(.favorite-caption h3) {
    margin: 0;
    color: var(--color-paper-50);
    font-family: var(--font-body);
    font-size: clamp(.9rem, 1.35vw, 1.2rem);
    font-weight: 500;
    line-height: 1.1;
  }

  :global(.favorite-caption p) {
    margin: .3rem 0 0;
    color: var(--color-muted-400);
    font-family: var(--font-meta);
    font-size: .52rem;
    letter-spacing: .06em;
    text-transform: uppercase;
  }

  :global(.favorite-placeholder) {
    display: grid;
    height: 100%;
    align-content: end;
    gap: .7rem;
    padding: 1rem;
    background: linear-gradient(145deg, var(--color-ink-700), var(--color-ink-950));
    color: var(--color-paper-50);
  }

  :global(.favorite-placeholder span) {
    color: var(--color-muted-400);
    font-family: var(--font-meta);
    font-size: .55rem;
  }

  :global(.favorite-placeholder strong) {
    max-width: 80%;
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.05;
  }

  :global(.favorites-loading) {
    display: block;
    margin-top: 1rem;
    color: var(--color-muted-500);
    font-family: var(--font-meta);
    font-size: .52rem;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .collection-view-wrap {
    margin-top: clamp(3.5rem, 7vw, 6rem);
  }
  @media (max-width: 700px) {
    :global(.favorites-intro) {
      font-size: .48rem;
    }

    :global(.favorites-grid) {
      grid-template-columns: 1fr 1fr;
      gap: .8rem;
    }

    :global(.favorite-card--1) {
      grid-column: 1 / -1;
    }

    :global(.favorite-card--2),
    :global(.favorite-card--3) {
      margin-top: 0;
    }

    :global(.favorite-card--1 .favorite-media) {
      aspect-ratio: 16 / 10;
    }

    :global(.favorite-media) {
      aspect-ratio: 3 / 4;
    }

    :global(.favorite-caption) {
      gap: .55rem;
      padding-top: .6rem;
    }

    :global(.favorite-caption h3) {
      font-size: .78rem;
    }
  }
</style>
