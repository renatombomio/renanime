---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/layout/Navbar.astro";
import Hero from "../components/hero/Hero.astro";
import HomeGallery from "../components/home/HomeGallery";
import { getWatchedLibrary } from "../data/library";

const collectionEntries = getWatchedLibrary();
---

<Layout
  title="Renanime's Gallery — Mi archivo personal de anime"
  description="Galería personal de anime: favoritos, colección, géneros, pendientes y próximos estrenos."
>
  <Navbar />

  <main id="main-content">
    <Hero />

    <section class="home-gallery-section" aria-label="Mi colección de anime">
      <HomeGallery entries={collectionEntries} client:load />
    </section>
  </main>

</Layout>

<style>
  #main-content {
    margin: 0;
    padding-top: 88px;
  }

  :global(.hero) {
    margin: 0;
    padding: 0;
  }

  @media (max-width: 1120px) {
    #main-content {
      padding-top: 74px;
    }
  }

  @media (max-width: 520px) {
    #main-content {
      padding-top: 68px;
    }
  }

  .home-gallery-section {
    width: min(calc(100% - (var(--gutter) * 2)), var(--container-max));
    margin: 0 auto;
    padding: 1rem 0 var(--section-space);
  }

  @media (max-width: 700px) {
    .home-gallery-section {
      padding-top: 0.75rem;
    }
  }
</style>