---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/layout/Navbar.astro";
import Footer from "../components/layout/Footer.astro";
import Container from "../components/ui/Container.astro";
import Hero from "../components/hero/Hero.astro";
import SectionHeader from "../components/ui/SectionHeader.astro";
import CollectionView from "../components/collection/CollectionView";
import FavoritesView from "../components/favorites/FavoritesView";
import { getFavoritesLibrary, getWatchedLibrary } from "../data/library";

const favoriteEntries = getFavoritesLibrary();
const collectionEntries = getWatchedLibrary();
---

<Layout
  title="Renanime's Gallery — Mi archivo personal de anime"
  description="Galería personal de anime: favoritos, colección, géneros, pendientes y próximos estrenos."
>
  <Navbar />

  <main id="main-content">
    <Hero />

    <section id="favorites" class="favorites-section section-space">
      <Container>
        <SectionHeader
          eyebrow="Selección personal"
          title="Favoritos"
          description="Mis animes favoritos. Historias que me han conmovido, personajes que se quedan contigo y valores que, sin pedir permiso, terminan enseñándote algo. Algunos te hacen reír, otros te rompen un poco. Los buenos hacen las dos cosas."
        />

        <div class="favorites-view-wrap">
          <FavoritesView entries={favoriteEntries} client:load />
        </div>
      </Container>
    </section>

    <section id="collection" class="collection-section section-space">
      <Container>
        <SectionHeader
          title="Colección"
          description="Aquí están todos los animes que he visto. Son muchos, pero nunca parece suficiente. Porque esa es la magia del anime: terminas una historia y, de alguna manera, ya estás buscando la siguiente."
        />

        <div class="collection-view-wrap">
          <CollectionView entries={collectionEntries} client:load />
        </div>
      </Container>
    </section>

    <section id="genres" class="placeholder-section section-space">
      <Container>
        <SectionHeader
          title="Géneros"
          description="Venga, toma un mapa. Aquí puedes explorar los animes que he visto por género, para encontrar algo que te apetezca y dejar de dar golpes de ciego en ese océano infinito que es el anime."
        />
      </Container>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .placeholder-section {
    border-top: 0;
  }

  .favorites-view-wrap {
    margin-top: clamp(3rem, 6vw, 5rem);
  }

  :global(.favorites-view) {
    width: 100%;
  }

  :global(.favorites-intro) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: .85rem;
    border-bottom: 1px solid var(--color-border);
    color: var(--color-muted-400);
    font-family: var(--font-meta);
    font-size: .55rem;
    letter-spacing: .1em;
    text-transform: uppercase;
  }

  :global(.favorites-intro > div:first-child) {
    display: flex;
    align-items: baseline;
    gap: .9rem;
  }

  :global(.favorites-controls) {
    display: flex;
    gap: .35rem;
  }

  :global(.favorites-controls button) {
    width: 2rem;
    height: 2rem;
    border: 1px solid var(--color-border);
    background: transparent;
    color: var(--color-paper-200);
    cursor: pointer;
    font-family: var(--font-body);
    font-size: .85rem;
  }

  :global(.favorites-controls button:hover) {
    border-color: var(--color-border-strong);
    color: var(--color-paper-50);
  }

  :global(.favorites-track) {
    display: flex;
    gap: clamp(.8rem, 1.5vw, 1.35rem);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    padding: 1.25rem 0 .9rem;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  :global(.favorites-track::-webkit-scrollbar) {
    display: none;
  }

  :global(.favorite-card) {
    flex: 0 0 clamp(13.5rem, 20vw, 18rem);
    min-width: 0;
    scroll-snap-align: start;
  }

  :global(.favorite-card a) {
    display: block;
  }

  :global(.favorite-media) {
    position: relative;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background: var(--color-ink-800);
  }

  :global(.favorite-media::after) {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 48%, rgba(9,9,9,.68));
    content: "";
    pointer-events: none;
  }

  :global(.favorite-media img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 650ms cubic-bezier(.2,.7,.2,1);
  }

  :global(.favorite-card a:hover .favorite-media img) {
    transform: scale(1.035);
  }

  :global(.favorite-overlay) {
    position: absolute;
    right: .7rem;
    bottom: .65rem;
    left: .7rem;
    z-index: 2;
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: var(--color-paper-50);
    font-family: var(--font-meta);
    font-size: .52rem;
    letter-spacing: .08em;
  }

  :global(.favorite-mark) {
    font-size: .8rem;
  }

  :global(.favorite-caption) {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: .7rem;
    padding-top: .7rem;
  }

  :global(.favorite-number) {
    color: var(--color-muted-500);
    font-family: var(--font-meta);
    font-size: .52rem;
    letter-spacing: .08em;
  }

  :global(.favorite-caption h3) {
    margin: 0;
    color: var(--color-paper-50);
    font-family: var(--font-body);
    font-size: clamp(.82rem, 1vw, 1rem);
    font-weight: 500;
    line-height: 1.12;
  }

  :global(.favorite-caption p) {
    margin: .25rem 0 0;
    color: var(--color-muted-400);
    font-family: var(--font-meta);
    font-size: .48rem;
    letter-spacing: .06em;
    text-transform: uppercase;
  }

  :global(.favorite-placeholder) {
    display: grid;
    height: 100%;
    align-content: end;
    gap: .65rem;
    padding: .9rem;
    background: linear-gradient(145deg, var(--color-ink-700), var(--color-ink-950));
    color: var(--color-paper-50);
  }

  :global(.favorite-placeholder span) {
    color: var(--color-muted-400);
    font-family: var(--font-meta);
    font-size: .52rem;
  }

  :global(.favorite-placeholder strong) {
    max-width: 85%;
    font-size: .9rem;
    font-weight: 500;
    line-height: 1.05;
  }

  :global(.favorites-loading) {
    display: block;
    margin-top: .4rem;
    color: var(--color-muted-500);
    font-family: var(--font-meta);
    font-size: .5rem;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  @media (max-width: 700px) {
    :global(.favorites-intro) {
      font-size: .48rem;
    }

    :global(.favorites-intro > div:first-child) {
      gap: .55rem;
    }

    :global(.favorites-note) {
      display: none;
    }

    :global(.favorites-controls button) {
      width: 1.8rem;
      height: 1.8rem;
      font-size: .75rem;
    }

    :global(.favorites-track) {
      gap: .65rem;
      padding-top: 1rem;
      padding-right: 12vw;
    }

    :global(.favorite-card) {
      flex-basis: 68vw;
    }

    :global(.favorite-caption h3) {
      font-size: .82rem;
    }
  }

  .collection-view-wrap {
    margin-top: clamp(3.5rem, 7vw, 6rem);
  }
  @media (max-width: 700px) {
    :global(.favorites-intro) {
      font-size: .48rem;
    }

    :global(.favorites-grid) {
      grid-template-columns: 1fr 1fr;
      gap: .8rem;
    }

    :global(.favorite-card--1) {
      grid-column: 1 / -1;
    }

    :global(.favorite-card--2),
    :global(.favorite-card--3) {
      margin-top: 0;
    }

    :global(.favorite-card--1 .favorite-media) {
      aspect-ratio: 16 / 10;
    }

    :global(.favorite-media) {
      aspect-ratio: 3 / 4;
    }

    :global(.favorite-caption) {
      gap: .55rem;
      padding-top: .6rem;
    }

    :global(.favorite-caption h3) {
      font-size: .78rem;
    }
  }
</style>
