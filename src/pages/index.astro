---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/layout/Navbar.astro";
import Footer from "../components/layout/Footer.astro";
import Container from "../components/ui/Container.astro";
import Divider from "../components/ui/Divider.astro";
import SectionHeader from "../components/ui/SectionHeader.astro";
---

<Layout
  title="Renanime's Gallery — Mi archivo personal de anime"
  description="Galería personal de anime: favoritos, colección, géneros, pendientes y próximos estrenos."
>
  <Navbar />

  <main>
    <section class="intro">
      <Container>
        <div class="intro-grid">
          <div>
            <span class="eyebrow">Archivo personal / 001</span>
            <h1>Historias que<br /><em>guardé.</em></h1>
          </div>

          <div class="intro-copy">
            <p>
              Una galería personal de anime que me marcó: recopilado,
              recordado y vuelto a visitar.
            </p>
            <span class="intro-index">REN / ANIME / 2026</span>
          </div>
        </div>

        <Divider />
      </Container>
    </section>

    <section id="favorites" class="placeholder-section section-space">
      <Container>
        <SectionHeader
          eyebrow="01 / Seleccionado"
          title="Favoritos"
          description="La parte más personal de la colección. Los títulos reales llegarán con la capa de datos."
        />
      </Container>
    </section>

    <section id="collection" class="placeholder-section section-space">
      <Container>
        <SectionHeader
          eyebrow="02 / Archivo"
          title="Colección"
          description="El archivo completo de anime vistos, separado entre series y películas."
        />
      </Container>
    </section>

    <section id="genres" class="placeholder-section section-space">
      <Container>
        <SectionHeader
          eyebrow="03 / Taxonomía"
          title="Géneros"
          description="Los géneros se generarán a partir de los títulos presentes en la colección."
        />
      </Container>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .intro {
    min-height: min(72vh, 48rem);
    display: grid;
    align-items: end;
    padding-block: clamp(7rem, 15vw, 13rem) var(--space-16);
  }

  .intro-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(15rem, 0.5fr);
    align-items: end;
    gap: var(--space-12);
    padding-bottom: var(--space-12);
  }

  h1 {
    margin: 0;
    color: var(--color-paper-50);
    font-family: var(--font-display);
    font-size: clamp(4rem, 12vw, 11rem);
    font-weight: 500;
    letter-spacing: -0.065em;
    line-height: 0.84;
  }

  h1 em {
    color: var(--color-paper-300);
    font-weight: 400;
  }

  .intro-copy {
    display: grid;
    gap: var(--space-8);
    max-width: 22rem;
    padding-bottom: 0.4rem;
  }

  .intro-copy p {
    margin: 0;
    color: var(--color-paper-200);
    font-size: var(--text-lg);
    line-height: 1.45;
  }

  .intro-index {
    color: var(--color-muted-500);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.12em;
  }

  .placeholder-section {
    border-top: 0;
  }

  @media (max-width: 720px) {
    .intro {
      min-height: 70vh;
      padding-top: 6rem;
    }

    .intro-grid {
      grid-template-columns: 1fr;
      gap: var(--space-10);
    }

    h1 {
      font-size: clamp(3.75rem, 20vw, 7rem);
    }

    .intro-copy {
      max-width: 28rem;
    }
  }
</style>
