---
export const prerender = false;
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/layout/Navbar.astro";
import Footer from "../components/layout/Footer.astro";
import Hero from "../components/hero/Hero.astro";
import HomeGallery from "../components/home/HomeGallery";
import AnimeOfTheWeek from "../components/home/AnimeOfTheWeek.astro";
import WeeklyEpisodes from "../components/home/WeeklyEpisodes.astro";
import { getWatchedLibrary } from "../data/library";
import { localizedPath } from "../i18n";
const collectionEntries = getWatchedLibrary();
const lang = Astro.locals.lang;
const isEnglish = lang === "en";
let weeklyEpisodes = [];
try {
  const requestCookie = Astro.request.headers.get("cookie");
  const response = await fetch(new URL(`/api/weekly-popular-episodes?lang=${lang}`, Astro.url), {
    headers: {
      Accept: "application/json",
      ...(requestCookie ? { Cookie: requestCookie } : {}),
    },
    redirect: "manual",
    cache: "no-store",
  });
  if (!response.ok) throw new Error(`Weekly episodes API returned HTTP ${response.status}${response.status >= 300 && response.status < 400 ? ` (redirect ${response.headers.get("location") ?? "unknown"})` : ""}`);
  const payload = await response.json();
  if (!payload.success || !Array.isArray(payload.episodes)) throw new Error("Weekly episodes API returned an invalid payload.");
  weeklyEpisodes = payload.episodes;
} catch (error) {
  console.error("[home] Weekly popular episodes unavailable:", error);
}
---

<Layout
  title={isEnglish ? "Renanime's Gallery — My personal anime archive" : "Renanime's Gallery — Mi archivo personal de anime"}
  description={isEnglish ? "Personal anime gallery: favorites, collection, genres and watchlist." : "Galería personal de anime: favoritos, colección, géneros, pendientes."}
>
  <Navbar />

  <main id="main-content">
    <Hero
      kicker="Renanime's"
      title="Gallery."
      copy={isEnglish ? "Anime through my eyes.\nThis is my gift to you." : "Anime a través de mis ojos.\nEste es mi regalo para ti."}
      ariaLabel={isEnglish ? "Renanime's Gallery" : "Galería de Renanime"}
    />

    <section class="home-gallery-section" aria-label={isEnglish ? "Ren's collection" : "Colección de Ren"}>
      <HomeGallery entries={collectionEntries} lang={Astro.locals.lang} client:load />
    </section>

    <AnimeOfTheWeek />
    <WeeklyEpisodes
      episodes={weeklyEpisodes}
      href={(animeId) => localizedPath(lang, `/anime/${animeId}/`)}
      labels={{
        eyebrow: isEnglish ? "This week" : "Esta semana",
        title: isEnglish ? "Popular episodes this week" : "Episodios populares de la semana",
        titleAccent: isEnglish ? "this week" : "de la semana",
        subtitle: isEnglish ? "Top 5 by popularity · AniList" : "Top 5 por popularidad · AniList",
        episode: isEnglish ? "Episode" : "Episodio",
        episodeShort: "Ep.",
      }}
    />
  </main>

  <Footer />
</Layout>

<style>
  #main-content {
    margin: 0;
    padding-top: 88px;
  }

  :global(.hero) {
    margin: 0;
    padding: 0;
  }

  @media (max-width: 1120px) {
    #main-content {
      padding-top: 74px;
    }
  }

  @media (max-width: 520px) {
    #main-content {
      padding-top: 68px;
    }
  }

  .home-gallery-section {
    width: min(calc(100% - (var(--gutter) * 2)), var(--container-max));
    margin: 0 auto;
    padding: 1rem 0 var(--section-space);
  }

  @media (max-width: 700px) {
    .home-gallery-section {
      width: calc(100% - 1.25rem);
      padding-top: 0.75rem;
    }
  }
</style>
