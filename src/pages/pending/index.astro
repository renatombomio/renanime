---
export const prerender = false;
import Layout from "../../layouts/Layout.astro";
import { useT } from "../../i18n";
import Navbar from "../../components/layout/Navbar.astro";
import Footer from "../../components/layout/Footer.astro";
import SectionHeader from "../../components/ui/SectionHeader.astro";
import PersonalLibraryView from "../../components/personal-library/PersonalLibraryView";
const t = useT(Astro.locals.lang);
---

<Layout title={`${t("pending.pageTitle")} — Renanime's Gallery`}>
  <Navbar />
  <main id="main-content" class="pending-page">
    <div class="pending-header">
      <SectionHeader variant="ren" title={t("pending.pageHeading")} description={t("pending.pageDescription")} />
    </div>
    <section class="pending-content" aria-label={Astro.locals.lang === "en" ? "Anime on my list" : "Anime pendiente"}>
      <PersonalLibraryView mode="PENDING" lang={Astro.locals.lang} client:load />
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .pending-page { min-height: 60vh; padding-block: clamp(6rem, 11vw, 10rem) var(--section-space); }
  .pending-header, .pending-content { width: min(calc(100% - (var(--gutter) * 2)), var(--container-max)); margin-inline: auto; }
  .pending-header { margin-bottom: clamp(3rem, 6vw, 5rem); }
</style>
