---
export const prerender = false;
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/layout/Navbar.astro";
import { createSupabaseSsrClient } from "../../lib/supabase-ssr";

const lang = Astro.locals.lang;
const isEnglish = lang === "en";
const title = isEnglish ? "My community" : "Mi comunidad";
const supabase = createSupabaseSsrClient(Astro.request, Astro.cookies);
const { count: publicCount, error: countError } = await supabase.from("profiles").select("id", { count: "exact", head: true }).eq("is_private", false).not("aka", "is", null);
const maxOffset = Math.max(0, (publicCount ?? 0) - 9);
const randomOffset = maxOffset > 0 ? Math.floor(Math.random() * (maxOffset + 1)) : 0;
const { data: members, error } = await supabase.from("profiles").select("id, aka, headline, bio, avatar_url, interests, last_seen_at, created_at").eq("is_private", false).not("aka", "is", null).order("created_at", { ascending: true }).range(randomOffset, randomOffset + 8);
if (countError) console.error("Community profile count error:", countError.message);
if (error) console.error("Community directory error:", error.message);
const profiles = Array.isArray(members) ? members : [];
const { data: latestDebates } = await supabase.from("community_debates").select("id,title,body,category,created_at,profiles!inner(aka,is_private)").eq("status","published").eq("profiles.is_private",false).order("created_at",{ascending:false}).limit(2);
const debateCategories: Record<string,string> = isEnglish ? {anime:"Anime",characters:"Characters",theories:"Theories",comparisons:"Comparisons",manga:"Manga",general:"General"} : {anime:"Anime",characters:"Personajes",theories:"Teorías",comparisons:"Comparaciones",manga:"Manga",general:"General"};
const onlineCutoff = Date.now() - 5 * 60 * 1000;
type ActivityItem = { id: string; action: "comment" | "like" | "joined"; content: string | null; createdAt: string; aka: string; avatarUrl: string | null; animeId: number | null; animeTitle: string };
let activity: ActivityItem[] = [];
try {
  const [comments, likes, joined] = await Promise.all([
    supabase.from("anime_comments").select("id, anime_id, content, created_at, profiles!inner(aka, avatar_url, is_private)").eq("profiles.is_private", false).order("created_at", { ascending: false }).limit(8),
    supabase.from("anime_likes").select("id, anime_id, created_at, profiles!inner(aka, avatar_url, is_private)").eq("profiles.is_private", false).order("created_at", { ascending: false }).limit(8),
    supabase.from("profiles").select("id, aka, avatar_url, created_at").eq("is_private", false).not("aka", "is", null).order("created_at", { ascending: false }).limit(5),
  ]);
  if (!comments.error) activity.push(...(comments.data ?? []).flatMap((row) => { const p = Array.isArray(row.profiles) ? row.profiles[0] : row.profiles; return p?.aka && Number.isInteger(row.anime_id) ? [{ id: row.id, action: "comment" as const, content: row.content, createdAt: row.created_at, aka: p.aka, avatarUrl: p.avatar_url, animeId: row.anime_id, animeTitle: "" }] : []; }));
  if (!likes.error) activity.push(...(likes.data ?? []).flatMap((row) => { const p = Array.isArray(row.profiles) ? row.profiles[0] : row.profiles; return p?.aka && Number.isInteger(row.anime_id) ? [{ id: row.id, action: "like" as const, content: null, createdAt: row.created_at, aka: p.aka, avatarUrl: p.avatar_url, animeId: row.anime_id, animeTitle: "" }] : []; }));
  if (!joined.error) activity.push(...(joined.data ?? []).map((row) => ({ id: row.id, action: "joined" as const, content: null, createdAt: row.created_at, aka: row.aka, avatarUrl: row.avatar_url, animeId: null, animeTitle: "" })));
  activity.sort((a,b) => new Date(b.createdAt).getTime() - new Date(a.createdAt).getTime()); activity = activity.slice(0,5);
  const ids = [...new Set(activity.flatMap((item) => item.animeId === null ? [] : [item.animeId]))];
  if (ids.length) { const response = await fetch("https://graphql.anilist.co", { method:"POST", headers:{"Content-Type":"application/json",Accept:"application/json"}, body:JSON.stringify({query:"query ($ids: [Int]) { Page { media(id_in: $ids, type: ANIME) { id title { romaji english } } } }",variables:{ids}}) }); if (response.ok) { const payload = await response.json(); const titles = new Map((payload.data?.Page?.media ?? []).map((item:any) => [item.id,item.title.english || item.title.romaji || "Anime"])); activity = activity.map((item) => item.animeId === null ? item : ({...item,animeTitle:titles.get(item.animeId) || "Anime"})); } }
} catch (activityError) { console.error("Community activity unavailable:", activityError); }
const formatAge = (value: string) => { const minutes = Math.max(0, Math.floor((Date.now() - new Date(value).getTime()) / 60000)); if (isEnglish) { if (minutes < 1) return "just now"; if (minutes < 60) return minutes + "m ago"; const hours = Math.floor(minutes / 60); return hours < 24 ? hours + "h ago" : Math.floor(hours / 24) + "d ago"; } if (minutes < 1) return "ahora"; if (minutes < 60) return "hace " + minutes + " min"; const hours = Math.floor(minutes / 60); return hours < 24 ? "hace " + hours + " h" : "hace " + Math.floor(hours / 24) + " d"; };
---

<Layout title={`${title} — Renanime's Gallery`}>
  <Navbar />
  <main id="main-content" class="community-page">
    <section class="community-directory" aria-label={title}>
      <div class="community-tools">
        <label class="community-search">
          <span class="sr-only">{isEnglish ? "Search community" : "Buscar en la comunidad"}</span>
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.8"/><path d="m16 16 5 5"/></svg>
          <input id="community-search" type="search" autocomplete="off" placeholder={isEnglish ? "Search by username or interest…" : "Buscar por usuario o interés…"} />
        </label>
      </div>
      {error ? (
        <p class="community-empty">{isEnglish ? "We couldn't load the community right now." : "No se ha podido cargar la comunidad."}</p>
      ) : profiles.length ? (
        <div class="community-grid" id="community-grid">
          {profiles.map((member) => {
            const online = member.last_seen_at && new Date(member.last_seen_at).getTime() >= onlineCutoff;
            const searchable = [member.aka, member.headline, member.bio, ...(Array.isArray(member.interests) ? member.interests : [])].filter(Boolean).join(" ").toLocaleLowerCase();
            return (
              <a class="community-member" href={`${isEnglish ? "/en" : ""}/u/${encodeURIComponent(member.aka)}/`} data-search={searchable}>
                <div class="community-avatar-wrap">
                  <img src={member.avatar_url || "/images/profile-avatar-placeholder.svg"} alt="" loading="lazy" />
                  <span class:list={["community-presence", online ? "is-online" : "is-offline"]} aria-label={online ? (isEnglish ? "Online" : "En línea") : (isEnglish ? "Offline" : "Desconectado")} title={online ? (isEnglish ? "Online" : "En línea") : (isEnglish ? "Offline" : "Desconectado")} />
                </div>
                <strong>@{member.aka}</strong>
              </a>
            );
          })}
        </div>
      ) : (
        <p class="community-empty">{isEnglish ? "No public profiles yet. Be the first to open your profile to the community." : "Todavía no hay perfiles públicos. Puedes ser el primero en abrir tu perfil a la comunidad."}</p>
      )}
      <p class="community-no-results" id="community-no-results" hidden>{isEnglish ? "No profiles match your search." : "No hay perfiles que coincidan con tu búsqueda."}</p>
    </section>
    <section class="community-activity" aria-labelledby="activity-title">
      <details class="activity-disclosure">
        <summary><strong id="activity-title">{isEnglish ? "Recent activity" : "Actividad reciente"}</strong>
          {activity.length ? <span class="activity-summary-preview"><img src={activity[0].avatarUrl || "/images/profile-avatar-placeholder.svg"} alt="" /><span><b>@{activity[0].aka}</b> {isEnglish ? "recently active" : "actividad reciente"}</span></span> : <span class="activity-summary-preview">{isEnglish ? "No recent activity" : "Sin actividad reciente"}</span>}
          <span class="activity-chevron" aria-hidden="true">⌄</span></summary>
        {activity.length ? <div class="activity-list">{activity.map((item) => <article class="activity-item"><a class="activity-avatar" href={(isEnglish ? "/en" : "") + "/u/" + encodeURIComponent(item.aka) + "/"} aria-label={"@" + item.aka}><img src={item.avatarUrl || "/images/profile-avatar-placeholder.svg"} alt="" loading="lazy" /></a><div class="activity-copy"><p><a href={(isEnglish ? "/en" : "") + "/u/" + encodeURIComponent(item.aka) + "/"}>@{item.aka}</a><span>{item.action === "like" ? (isEnglish ? "liked" : "le ha dado like a") : item.action === "joined" ? (isEnglish ? "joined Renanime" : "se ha unido a Renanime") : (isEnglish ? "commented on" : "ha comentado en")}</span></p>{item.action === "comment" && item.content && <p class="activity-content">{item.content}</p>}{item.animeId !== null && <a class="activity-anime" href={(isEnglish ? "/en" : "") + "/anime/" + item.animeId + "/"}>{item.animeTitle}</a>}<time datetime={item.createdAt}>{formatAge(item.createdAt)}</time></div></article>)}</div> : <p class="community-empty">{isEnglish ? "No recent activity yet." : "Todavía no hay actividad reciente."}</p>}
      </details>
      <a class="community-create-debate" href={(isEnglish ? "/en" : "") + "/community/debates/"}><strong>{isEnglish ? "Start a debate" : "Generar debate"}</strong><span>{isEnglish ? "Share an opinion or theory" : "Comparte una opinión o teoría"} ↗</span></a>
      <div class="community-debate-previews"><header><h2>{isEnglish ? "Latest debates" : "Últimos debates"}</h2><a href={(isEnglish ? "/en" : "") + "/community/debates/"}>{isEnglish ? "View all" : "Ver todos"}</a></header>
        {latestDebates?.length ? latestDebates.map((debate: any) => { const profile = Array.isArray(debate.profiles) ? debate.profiles[0] : debate.profiles; return <a class="community-debate-card" href={(isEnglish ? "/en" : "") + "/community/debates/" + debate.id + "/"}><small>{debateCategories[debate.category] || "General"}</small><strong>{debate.title}</strong><span>{debate.body}</span><small>@{profile?.aka} · {formatAge(debate.created_at)}</small></a>; }) : <p class="community-empty">{isEnglish ? "No debates yet." : "Todavía no hay debates."}</p>}
      </div>
    </section>
  </main>
</Layout>

<style>
  .community-page{min-height:70vh;padding-block:clamp(6rem,11vw,10rem) var(--section-space)}
  .community-activity{width:min(calc(100% - (var(--gutter)*2)),var(--container-max));margin:4rem auto 0}
  .community-section-heading{margin-bottom:1.4rem}.community-section-heading h2{margin:0;color:#f5f2ec;font-size:clamp(1.8rem,4vw,2.6rem);letter-spacing:-.04em}
  .community-eyebrow{margin:0 0 .4rem;color:#929297;font-size:.68rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase}
  .activity-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.7rem}
  .activity-item{display:flex;gap:.75rem;min-width:0;padding:.9rem;border:1px solid rgba(255,255,255,.09);border-radius:14px;background:rgba(255,255,255,.025)}
  .activity-avatar{display:block;flex:0 0 38px;width:38px;height:38px}.activity-avatar img{width:100%;height:100%;border-radius:50%;object-fit:cover;background:#191919}
  .activity-copy{display:grid;gap:.3rem;min-width:0}.activity-copy p{display:flex;flex-wrap:wrap;gap:.3rem;margin:0;color:#929297;font-size:.72rem;line-height:1.4}
  .activity-copy p a:first-child{color:#f0f0f0;font-weight:700;text-decoration:none}.activity-content{display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden;color:#d2d2d5;font-size:.82rem;line-height:1.45;overflow-wrap:anywhere}
  .activity-anime{color:#ddd;font-size:.74rem;text-decoration:none}.activity-copy time{color:#777;font-size:.66rem}
  @media(max-width:680px){.activity-list{grid-template-columns:1fr}}
  .activity-disclosure{border-bottom:1px solid rgba(255,255,255,.1)}
  .activity-disclosure summary{display:flex;align-items:center;gap:.7rem;min-height:68px;padding:.75rem 0;list-style:none;cursor:pointer}
  .activity-disclosure summary::-webkit-details-marker{display:none}
  #activity-title{color:#f5f2ec;font-size:clamp(1.3rem,4vw,1.7rem);letter-spacing:-.04em}
  .activity-summary-preview{display:flex;align-items:center;gap:.5rem;min-width:0;margin-left:auto;color:#999;font-size:.7rem}
  .activity-summary-preview img{width:27px;height:27px;border-radius:50%;object-fit:cover}.activity-summary-preview span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.activity-summary-preview b{color:#eee}
  .activity-chevron{color:#aaa}.activity-disclosure[open] .activity-chevron{transform:rotate(180deg)}.activity-disclosure[open] .activity-summary-preview{display:none}
  .community-create-debate{display:flex;justify-content:space-between;align-items:center;gap:1rem;margin:1.4rem 0;padding:1rem 1.1rem;border:1px solid rgba(236,72,153,.35);border-radius:14px;background:rgba(236,72,153,.08);color:#f5f2ec;text-decoration:none}.community-create-debate strong{font-size:.95rem}.community-create-debate span{color:#aaa;font-size:.72rem}
  .community-debate-previews{display:grid;gap:.7rem}.community-debate-previews header{display:flex;align-items:center;justify-content:space-between}.community-debate-previews h2{margin:0;color:#f5f2ec;font-size:1.2rem}.community-debate-previews header>a{color:#ec4899;font-size:.72rem;text-decoration:none}
  .community-debate-card{display:grid;gap:.4rem;padding:1rem;border:1px solid rgba(255,255,255,.1);border-radius:13px;color:#f5f2ec;text-decoration:none}.community-debate-card small{color:#ec4899;font-size:.67rem}.community-debate-card span{display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden;color:#aaa;font-size:.75rem;line-height:1.5}
  @media(max-width:680px){.activity-disclosure summary{flex-wrap:wrap}#activity-title{width:100%}.activity-summary-preview{margin-left:0}}
  .community-directory{width:min(calc(100% - (var(--gutter)*2)),var(--container-max));margin:0 auto}
  .community-tools{display:flex;justify-content:flex-end;margin-bottom:1.25rem}
  .community-search{display:flex;align-items:center;gap:.65rem;width:min(100%,440px);height:42px;padding:0 .9rem;border:1px solid rgba(245,242,236,.16);border-radius:999px;background:#0b0b0b;color:#999}
  .community-search svg{width:17px;height:17px;fill:none;stroke:currentColor;stroke-width:1.6;flex:0 0 auto}
  .community-search input{width:100%;min-width:0;border:0;outline:0;background:transparent;color:#f5f2ec;font:inherit;font-size:.82rem}
  .community-search input::placeholder{color:#777}
  .community-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1.35rem .65rem}
  .community-member{display:flex;flex-direction:column;align-items:center;gap:.55rem;min-width:0;padding:.35rem .15rem;color:#f5f2ec;text-align:center;text-decoration:none}
  .community-member:hover strong{color:#ec4899}
  .community-avatar-wrap{position:relative;width:clamp(58px,7vw,82px);aspect-ratio:1}
  .community-avatar-wrap img{display:block;width:100%;height:100%;border-radius:50%;object-fit:cover;background:#171717}
  .community-presence{position:absolute;right:2px;bottom:2px;width:11px;height:11px;border:2px solid #050505;border-radius:50%}.community-presence.is-online{background:#35d06f}.community-presence.is-offline{background:#686868}
  .community-member strong{max-width:100%;font-size:clamp(.68rem,1.1vw,.82rem);font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;transition:color .18s}
  .community-empty,.community-no-results{padding:1.5rem 0;color:#888;font-size:.85rem}
  .community-no-results[hidden]{display:none}
  @media(min-width:900px){.community-grid{grid-template-columns:repeat(5,minmax(0,1fr));gap:1.8rem 1rem}}
  @media(max-width:680px){.community-tools{justify-content:stretch}.community-search{width:100%}.community-grid{gap:1.1rem .4rem}}
</style>

<script>
  const search = document.querySelector<HTMLInputElement>("#community-search");
  const cards = [...document.querySelectorAll<HTMLElement>(".community-member")];
  const empty = document.querySelector<HTMLElement>("#community-no-results");
  search?.addEventListener("input", () => {
    const query = search.value.trim().toLocaleLowerCase();
    let visible = 0;
    cards.forEach(card => {
      const matches = !query || (card.dataset.search || "").includes(query);
      card.hidden = !matches;
      if (matches) visible++;
    });
    if (empty) empty.hidden = visible > 0;
  });
</script>
