---
export const prerender = false;
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/layout/Navbar.astro";
import DebateComposerBar from "../../components/community/DebateComposerBar.astro";
import "../../styles/community-social.css";
import { createSupabaseSsrClient } from "../../lib/supabase-ssr";
const en=Astro.locals.lang==="en", base=en?"/en":"";
const supabase=createSupabaseSsrClient(Astro.request,Astro.cookies);
const {data:auth}=await supabase.auth.getUser();
const {data:me}=auth.user?await supabase.from("profiles").select("avatar_url").eq("id",auth.user.id).maybeSingle():{data:null};
const cutoff=new Date(Date.now()-5*60*1000).toISOString();
const {data:members,error:membersError}=await supabase.from("profiles").select("id,aka,avatar_url,headline,bio,interests,last_seen_at").eq("is_private",false).not("aka","is",null).gte("last_seen_at",cutoff).order("last_seen_at",{ascending:false}).limit(8);
const {data:debates,error:debatesError}=await supabase.from("community_debates").select("id,title,body,category,created_at,profiles!inner(aka,avatar_url,is_private)").eq("status","published").eq("profiles.is_private",false).order("created_at",{ascending:false}).limit(2);
type Activity={id:string;kind:"comment"|"like"|"joined";aka:string;avatar:string|null;created:string;content:string|null;animeId:number|null;animeTitle:string};
let activity:Activity[]=[];
try{
 const [comments,likes,joined]=await Promise.all([
  supabase.from("anime_comments").select("id,anime_id,content,created_at,profiles!inner(aka,avatar_url,is_private)").eq("profiles.is_private",false).order("created_at",{ascending:false}).limit(10),
  supabase.from("anime_likes").select("id,anime_id,created_at,profiles!inner(aka,avatar_url,is_private)").eq("profiles.is_private",false).order("created_at",{ascending:false}).limit(10),
  supabase.from("profiles").select("id,aka,avatar_url,created_at").eq("is_private",false).not("aka","is",null).order("created_at",{ascending:false}).limit(8)]);
 if(!comments.error)activity.push(...(comments.data??[]).flatMap((r:any)=>{const p=Array.isArray(r.profiles)?r.profiles[0]:r.profiles;return p?.aka?[{id:r.id,kind:"comment" as const,aka:p.aka,avatar:p.avatar_url,created:r.created_at,content:r.content,animeId:r.anime_id,animeTitle:""}]:[]}));
 if(!likes.error)activity.push(...(likes.data??[]).flatMap((r:any)=>{const p=Array.isArray(r.profiles)?r.profiles[0]:r.profiles;return p?.aka?[{id:r.id,kind:"like" as const,aka:p.aka,avatar:p.avatar_url,created:r.created_at,content:null,animeId:r.anime_id,animeTitle:""}]:[]}));
 if(!joined.error)activity.push(...(joined.data??[]).map((r:any)=>({id:r.id,kind:"joined" as const,aka:r.aka,avatar:r.avatar_url,created:r.created_at,content:null,animeId:null,animeTitle:""})));
 activity.sort((a,b)=>new Date(b.created).getTime()-new Date(a.created).getTime());activity=activity.slice(0,6);
 const ids=[...new Set(activity.flatMap(x=>x.animeId?[x.animeId]:[]))];
 if(ids.length){const response=await fetch("https://graphql.anilist.co",{method:"POST",headers:{"Content-Type":"application/json","Accept":"application/json"},body:JSON.stringify({query:"query ($ids: [Int]) { Page { media(id_in: $ids, type: ANIME) { id title { romaji english } } } }",variables:{ids}})});if(response.ok){const payload=await response.json();const titles=new Map((payload.data?.Page?.media??[]).map((x:any)=>[x.id,x.title.english||x.title.romaji||"Anime"]));activity=activity.map(x=>({...x,animeTitle:x.animeId?titles.get(x.animeId)||"Anime":""}));}}
}catch(e){console.error("Community activity error:",e);}
const age=(v:string)=>{const m=Math.max(0,Math.floor((Date.now()-new Date(v).getTime())/60000));if(en){if(m<1)return"now";if(m<60)return m+"m";if(m<1440)return Math.floor(m/60)+"h";return Math.floor(m/1440)+"d";}if(m<1)return"ahora";if(m<60)return m+" min";if(m<1440)return Math.floor(m/60)+" h";return Math.floor(m/1440)+" d";};
const cats:Record<string,string>=en?{anime:"Anime",characters:"Characters",theories:"Theories",comparisons:"Comparisons",manga:"Manga",general:"General"}:{anime:"Anime",characters:"Personajes",theories:"Teorías",comparisons:"Comparaciones",manga:"Manga",general:"General"};
---
<Layout title={en?"Community — Renanime":"Comunidad — Renanime"}>
<Navbar/>
<main id="main-content" class="community-feed">
 <header class="community-top"><h1>{en?"Community":"Comunidad"}</h1></header>
 <label class="srch"><span class="sr-only">{en?"Search users or debates":"Buscar usuarios o debates"}</span><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.8"/><path d="m16 16 5 5"/></svg><input id="community-search" type="search" placeholder={en?"Search users or debates":"Buscar usuarios o debates"} autocomplete="off"/></label>
 <section><div class="sec"><h2>{en?"Online":"En línea"} <small>{members?.length??0} {en?"now":"ahora"}</small></h2></div>
 {membersError?<p class="community-note">{en?"Could not load active profiles.":"No se han podido cargar los perfiles activos."}</p>:members?.length?<div class="stories">{members.map((m:any)=><a class="story community-searchable" data-search={["@"+m.aka,m.headline,m.bio,...(m.interests??[])].filter(Boolean).join(" ").toLowerCase()} href={base+"/u/"+encodeURIComponent(m.aka)+"/"}><div class="a"><img class="av" src={m.avatar_url||"/images/profile-avatar-placeholder.svg"} alt="" loading="lazy"/><i aria-label={en?"Online":"En línea"}></i></div><span class="n">@{m.aka}</span></a>)}</div>:<p class="community-note">{en?"No one is online right now.":"No hay usuarios conectados en este momento."}</p>}
 </section>
 <DebateComposerBar lang={en?"en":"es"} avatarUrl={me?.avatar_url??null}/>
 <section><div class="sec"><h2>{en?"Trending debates":"Debates en tendencia"}</h2><a href={base+"/community/debates/"}>{en?"View all":"Ver todos"}</a></div>
 {debatesError?<p class="community-note">{en?"Debates are temporarily unavailable.":"Los debates no están disponibles temporalmente."}</p>:debates?.length?<div class="trending-posts">{debates.map((d:any)=>{const p=Array.isArray(d.profiles)?d.profiles[0]:d.profiles;return <article class="post community-searchable" data-search={[d.title,d.body,d.category,p?.aka].join(" ").toLowerCase()}><div class="hd"><a class="author" href={base+"/u/"+encodeURIComponent(p?.aka||"")+"/"}><img class="av" src={p?.avatar_url||"/images/profile-avatar-placeholder.svg"} alt="" loading="lazy"/><span>@{p?.aka}</span></a><time>{age(d.created_at)}</time></div><a class="post-main" href={base+"/community/debates/"+d.id+"/"}><h3>{d.title}</h3><p class="tx">{d.body}</p></a><div class="tags"><span class="tag">{cats[d.category]||"General"}</span></div><div class="acts"><a class="act" href={base+"/community/debates/"+d.id+"/"}><span>♡</span>{en?"Like":"Me gusta"}</a><a class="act" href={base+"/community/debates/"+d.id+"/"}><span>▢</span>{en?"Comment":"Comentar"}</a><a class="act" href={base+"/community/debates/"+d.id+"/"}><span>↗</span>{en?"Open debate":"Abrir debate"}</a></div></article>})}</div>:<p class="community-note">{en?"No debates yet. Start the first one.":"Todavía no hay debates. Inicia el primero."}</p>}
 </section>
 <section class="activity-section"><div class="sec"><h2>{en?"Recent activity":"Actividad reciente"}</h2></div>
 {activity.length?<div class="activity-feed">{activity.map(x=><article class="actv"><a href={base+"/u/"+encodeURIComponent(x.aka)+"/"} aria-label={"@"+x.aka}><img class="av" src={x.avatar||"/images/profile-avatar-placeholder.svg"} alt="" loading="lazy"/></a><div class="t"><a href={base+"/u/"+encodeURIComponent(x.aka)+"/"}><b>@{x.aka}</b></a> {x.kind==="like"?(en?"liked":"le ha gustado"):x.kind==="joined"?(en?"joined Renanime":"se ha unido a Renanime"):(en?"commented on":"ha comentado en")} {x.animeId!==null&&<a href={base+"/anime/"+x.animeId+"/"}><q>{x.animeTitle}</q></a>}{x.kind==="comment"&&x.content&&<span class="activity-quote"> “{x.content}”</span>}</div><em>{age(x.created)}</em></article>)}</div>:<p class="community-note">{en?"No recent activity yet.":"Todavía no hay actividad reciente."}</p>}
 </section><p id="community-no-results" class="community-note" hidden>{en?"No results match your search.":"No hay resultados para esa búsqueda."}</p>
</main></Layout>
<script>
const input=document.querySelector<HTMLInputElement>("#community-search");const items=[...document.querySelectorAll<HTMLElement>(".community-searchable")];const empty=document.querySelector<HTMLElement>("#community-no-results");
input?.addEventListener("input",()=>{const q=input.value.trim().toLowerCase();let n=0;items.forEach(el=>{const ok=!q||(el.dataset.search||"").includes(q);el.hidden=!ok;if(ok)n++;});if(empty)empty.hidden=n>0;});
</script>
