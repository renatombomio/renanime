---
export const prerender = false;
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/layout/Navbar.astro";
import { createSupabaseSsrClient } from "../../lib/supabase-ssr";

const lang = Astro.locals.lang;
const isEnglish = lang === "en";
const title = isEnglish ? "My community" : "Mi comunidad";
const supabase = createSupabaseSsrClient(Astro.request, Astro.cookies);
const { data: members, error } = await supabase
  .from("profiles")
  .select("id, aka, headline, bio, avatar_url, interests, last_seen_at")
  .eq("is_private", false)
  .not("aka", "is", null)
  .order("last_seen_at", { ascending: false, nullsFirst: false })
  .order("created_at", { ascending: false })
  .limit(60);
if (error) console.error("Community directory error:", error.message);
const profiles = Array.isArray(members) ? members : [];
const onlineCutoff = Date.now() - 5 * 60 * 1000;
---

<Layout title={`${title} — Renanime's Gallery`}>
  <Navbar />
  <main id="main-content" class="community-page">
    <section class="community-directory" aria-label={title}>
      <div class="community-tools">
        <label class="community-search">
          <span class="sr-only">{isEnglish ? "Search community" : "Buscar en la comunidad"}</span>
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.8"/><path d="m16 16 5 5"/></svg>
          <input id="community-search" type="search" autocomplete="off" placeholder={isEnglish ? "Search by username or interest…" : "Buscar por usuario o interés…"} />
        </label>
      </div>
      {error ? (
        <p class="community-empty">{isEnglish ? "We couldn't load the community right now." : "No se ha podido cargar la comunidad."}</p>
      ) : profiles.length ? (
        <div class="community-grid" id="community-grid">
          {profiles.map((member) => {
            const online = member.last_seen_at && new Date(member.last_seen_at).getTime() >= onlineCutoff;
            const searchable = (member.aka || "").toLocaleLowerCase();
            return (
              <a class="community-member" href={`${isEnglish ? "/en" : ""}/u/${encodeURIComponent(member.aka)}/`} data-search={searchable}>
                <div class="community-avatar-wrap">
                  <img src={member.avatar_url || "/images/profile-avatar-placeholder.svg"} alt="" loading="lazy" />
                  <span class:list={["community-presence", online ? "is-online" : "is-offline"]} aria-label={online ? (isEnglish ? "Online" : "En línea") : (isEnglish ? "Offline" : "Desconectado")} title={online ? (isEnglish ? "Online" : "En línea") : (isEnglish ? "Offline" : "Desconectado")} />
                </div>
                <strong>@{member.aka}</strong>
              </a>
            );
          })}
        </div>
      ) : (
        <p class="community-empty">{isEnglish ? "No public profiles yet. Be the first to open your profile to the community." : "Todavía no hay perfiles públicos. Puedes ser el primero en abrir tu perfil a la comunidad."}</p>
      )}
      <p class="community-no-results" id="community-no-results" hidden>{isEnglish ? "No profiles match your search." : "No hay perfiles que coincidan con tu búsqueda."}</p>
    </section>
  </main>
</Layout>

<style>
  .community-page{min-height:70vh;padding-block:clamp(6rem,11vw,10rem) var(--section-space)}
  .community-directory{width:min(calc(100% - (var(--gutter)*2)),var(--container-max));margin:0 auto}
  .community-tools{display:flex;justify-content:flex-end;margin-bottom:1.25rem}
  .community-search{display:flex;align-items:center;gap:.65rem;width:min(100%,440px);height:42px;padding:0 .9rem;border:1px solid rgba(245,242,236,.16);border-radius:999px;background:#0b0b0b;color:#999}
  .community-search svg{width:17px;height:17px;fill:none;stroke:currentColor;stroke-width:1.6;flex:0 0 auto}
  .community-search input{width:100%;min-width:0;border:0;outline:0;background:transparent;color:#f5f2ec;font:inherit;font-size:.82rem}
  .community-search input::placeholder{color:#777}
  .community-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1.35rem .65rem}
  .community-member{display:flex;flex-direction:column;align-items:center;gap:.55rem;min-width:0;padding:.35rem .15rem;color:#f5f2ec;text-align:center;text-decoration:none}
  .community-member:hover strong{color:#ec4899}
  .community-avatar-wrap{position:relative;width:clamp(58px,7vw,82px);aspect-ratio:1}
  .community-avatar-wrap img{display:block;width:100%;height:100%;border-radius:50%;object-fit:cover;background:#171717}
  .community-presence{position:absolute;right:2px;bottom:2px;width:11px;height:11px;border:2px solid #050505;border-radius:50%}.community-presence.is-online{background:#35d06f}.community-presence.is-offline{background:#686868}
  .community-member strong{max-width:100%;font-size:clamp(.68rem,1.1vw,.82rem);font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;transition:color .18s}
  .community-empty,.community-no-results{padding:1.5rem 0;color:#888;font-size:.85rem}
  .community-no-results[hidden]{display:none}
  @media(min-width:900px){.community-grid{grid-template-columns:repeat(5,minmax(0,1fr));gap:1.8rem 1rem}}
  @media(max-width:680px){.community-tools{justify-content:stretch}.community-search{width:100%}.community-grid{gap:1.1rem .4rem}}
</style>

<script>
  const search = document.querySelector<HTMLInputElement>("#community-search");
  const cards = [...document.querySelectorAll<HTMLElement>(".community-member")];
  const empty = document.querySelector<HTMLElement>("#community-no-results");
  search?.addEventListener("input", () => {
    const query = search.value.trim().toLocaleLowerCase();
    let visible = 0;
    cards.forEach(card => {
      const matches = !query || (card.dataset.search || "").includes(query);
      card.hidden = !matches;
      if (matches) visible++;
    });
    if (empty) empty.hidden = visible > 0;
  });
</script>
