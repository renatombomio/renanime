---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/layout/Navbar.astro";
import SectionHeader from "../../components/ui/SectionHeader.astro";
import { useT } from "../../i18n";

const lang = Astro.locals.lang;
const t = useT(lang);
const title = lang === "en" ? "My community" : "Mi comunidad";
const description = lang === "en"
  ? "Your space to connect with anime fans, discover profiles, and follow conversations."
  : "Tu espacio para conectar con otros fans del anime, descubrir perfiles y seguir conversaciones.";
---

<Layout title={`${title} — Renanime's Gallery`} description={description}>
  <Navbar />
  <main id="main-content" class="community-page">
    <SectionHeader variant="ren" title={title} description={description} />
    <section class="community-intro" aria-label={title}>
      <p>{lang === "en" ? "The community is taking shape." : "La comunidad está tomando forma."}</p>
      <span>{lang === "en" ? "Profiles, followers, and anime conversations will live here." : "Aquí reuniremos perfiles, seguidores y conversaciones sobre anime."}</span>
    </section>
  </main>
</Layout>

<style>
  .community-page {
    min-height: 70vh;
    padding-block: clamp(6rem, 11vw, 10rem) var(--section-space);
  }

  .community-intro {
    width: min(calc(100% - (var(--gutter) * 2)), var(--container-max));
    margin: clamp(3rem, 7vw, 6rem) auto 0;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }

  .community-intro p {
    margin: 0;
    color: var(--color-paper-50);
    font-family: var(--font-heading);
    font-size: clamp(1.5rem, 3vw, 2.25rem);
  }

  .community-intro span {
    display: block;
    margin-top: .65rem;
    color: var(--color-muted-400);
    font-size: .9rem;
  }
</style>
