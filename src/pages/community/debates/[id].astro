---
export const prerender = false;
import Layout from "../../../layouts/Layout.astro";
import Navbar from "../../../components/layout/Navbar.astro";
import { createSupabaseSsrClient } from "../../../lib/supabase-ssr";
const en=Astro.locals.lang==="en",base=en?"/en":"",id=Astro.params.id;
const supabase=createSupabaseSsrClient(Astro.request,Astro.cookies);
const {data:auth}=await supabase.auth.getUser();
const {data:debate}=await supabase.from("community_debates").select("id,title,body,category,image_path,image_status,created_at,profiles!inner(aka,avatar_url,is_private)").eq("id",id).eq("status","published").eq("profiles.is_private",false).maybeSingle();
if(!debate)Astro.response.status=404;
const {data:comments}=debate?await supabase.from("community_debate_comments").select("id,content,created_at,profiles!inner(aka,avatar_url,is_private)").eq("debate_id",id).eq("status","visible").eq("profiles.is_private",false).order("created_at",{ascending:true}):{data:[]};
const profile=debate?(Array.isArray(debate.profiles)?debate.profiles[0]:debate.profiles):null;
const imageUrl=debate?.image_path&&debate.image_status==="approved"?supabase.storage.from("debate-images").getPublicUrl(debate.image_path).data.publicUrl:null;
const age=(v:string)=>{const m=Math.max(0,Math.floor((Date.now()-new Date(v).getTime())/60000));if(en){if(m<1)return"now";if(m<60)return m+"m";if(m<1440)return Math.floor(m/60)+"h";return Math.floor(m/1440)+"d";}if(m<1)return"ahora";if(m<60)return m+" min";if(m<1440)return Math.floor(m/60)+" h";return Math.floor(m/1440)+" d";};
---
<Layout title={debate?debate.title+" — Renanime":"Debate no encontrado — Renanime"}><Navbar/>
<main class="conversation">
<a class="back" href={base+"/community/debates/"}>← {en?"All debates":"Todos los debates"}</a>
{debate&&profile?<><article class="thread">
<header class="author"><img src={profile.avatar_url||"/images/profile-avatar-placeholder.svg"} alt=""/><div><b>@{profile.aka}</b><time>{age(debate.created_at)}</time></div></header>
<h1>{debate.title}</h1>{debate.body&&<p class="body">{debate.body}</p>}{imageUrl&&<img class="thread-image" src={imageUrl} alt={debate.title}/>}<span class="category">{debate.category}</span>
</article><section class="replies"><h2>{en?"Conversation":"Conversación"} <span>{comments?.length??0}</span></h2>
{comments?.length?<div class="reply-list">{comments.map((comment:any)=>{const p=Array.isArray(comment.profiles)?comment.profiles[0]:comment.profiles;return <article class="reply"><img src={p?.avatar_url||"/images/profile-avatar-placeholder.svg"} alt=""/><div><header><b>@{p?.aka}</b><time>{age(comment.created_at)}</time></header><p>{comment.content}</p></div></article>})}</div>:<p class="empty">{en?"No replies yet. Start the conversation.":"Todavía no hay respuestas. Inicia la conversación."}</p>}
{auth.user?<form id="reply-form" data-debate-id={id}><label for="reply-content">{en?"Add a reply":"Añade una respuesta"}</label><textarea id="reply-content" maxlength="1500" required placeholder={en?"Write your reply…":"Escribe tu respuesta…"}></textarea><div><small id="reply-count">0 / 1500</small><button type="submit">{en?"Reply":"Responder"}</button></div><p id="reply-error" role="alert" hidden></p></form>:<p class="login">{en?"Sign in to join the conversation.":"Inicia sesión para participar en la conversación."} <a href={base+"/login/"}>{en?"Sign in":"Iniciar sesión"}</a></p>}
</section></>:<section class="not-found"><h1>{en?"Debate not found":"Debate no encontrado"}</h1><p>{en?"This debate may have been removed or is no longer public.":"Este debate puede haberse eliminado o ya no ser público."}</p><a href={base+"/community/debates/"}>{en?"Back to debates":"Volver a Debates"}</a></section>}
</main></Layout>
<script>
const form=document.querySelector<HTMLFormElement>("#reply-form"),input=document.querySelector<HTMLTextAreaElement>("#reply-content"),count=document.querySelector<HTMLElement>("#reply-count"),error=document.querySelector<HTMLElement>("#reply-error");
input?.addEventListener("input",()=>{if(count)count.textContent=input.value.length+" / 1500";});
form?.addEventListener("submit",async(event)=>{event.preventDefault();if(!input||!form.reportValidity())return;const button=form.querySelector<HTMLButtonElement>("button[type=submit]");if(button){button.disabled=true;button.textContent="…";}if(error)error.hidden=true;try{const response=await fetch("/api/community/debates/"+form.dataset.debateId+"/comments",{method:"POST",credentials:"same-origin",headers:{"Content-Type":"application/json"},body:JSON.stringify({content:input.value})});const result=await response.json();if(!response.ok||!result.ok)throw new Error(result.error||"REPLY_FAILED");window.location.reload();}catch{if(error){error.textContent="No se pudo publicar la respuesta. Inténtalo de nuevo.";error.hidden=false;}if(button){button.disabled=false;button.textContent="Responder";}}});
</script>
<style>
.conversation{width:min(100%,640px);min-height:70vh;margin:0 auto;padding:calc(var(--header-height,64px) + 22px) 16px 4rem;background:#09090b;color:#f2efe9}.back{display:inline-block;margin-bottom:20px;color:var(--color-accent);font-size:13px;text-decoration:none}.thread{padding:0 0 20px;border-bottom:1px solid rgba(255,255,255,.1)}.author{display:flex;align-items:center;gap:10px}.author img,.reply>img{width:38px;height:38px;border-radius:50%;object-fit:cover}.author div{display:grid;gap:3px}.author b,.reply b{font-size:12px}.author time,.reply time{color:#77737d;font-size:11px}.thread h1{margin:18px 0 8px;font-size:22px;line-height:1.25}.thread .body{margin:0;color:#c5c1ca;font-size:14px;line-height:1.6;white-space:pre-wrap;overflow-wrap:anywhere}.thread-image{display:block;width:100%;max-height:360px;object-fit:cover;margin-top:14px;border-radius:14px}.category{display:inline-block;margin-top:14px;padding:5px 11px;border-radius:999px;background:#25252a;color:#a39fa9;font-size:12px}.replies{padding-top:20px}.replies h2{margin:0 0 18px;font-size:17px}.replies h2 span{margin-left:6px;color:#77737d;font-size:12px}.reply-list{display:grid;gap:18px}.reply{display:flex;align-items:flex-start;gap:10px}.reply>div{flex:1;min-width:0}.reply header{display:flex;align-items:center;gap:10px}.reply p{margin:6px 0 0;color:#c5c1ca;font-size:14px;line-height:1.5;white-space:pre-wrap;overflow-wrap:anywhere}.empty,.login{color:#77737d;font-size:13px}#reply-form{display:grid;gap:9px;margin-top:22px}#reply-form label{font-size:13px;font-weight:700}#reply-form textarea{min-height:90px;padding:12px;border:1px solid rgba(255,255,255,.1);border-radius:12px;background:#131316;color:#f2efe9;font:inherit;font-size:14px;resize:vertical}#reply-form>div{display:flex;align-items:center;justify-content:space-between}#reply-count{color:#77737d;font-size:11px}#reply-form button{padding:9px 16px;border:0;border-radius:999px;background:var(--color-accent);color:#fff;font-size:13px;font-weight:700}#reply-form button:disabled{opacity:.5}#reply-error{color:#ff9da9;font-size:12px}#reply-error[hidden]{display:none}.login a,.not-found a{color:var(--color-accent)}.not-found{padding:36px 0}.not-found h1{font-size:22px}.not-found p{color:#a39fa9;font-size:14px}
</style>