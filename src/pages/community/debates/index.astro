---
export const prerender = false;
import Layout from "../../../layouts/Layout.astro";
import Navbar from "../../../components/layout/Navbar.astro";
import DebateComposerBar from "../../../components/community/DebateComposerBar.astro";
import { createSupabaseSsrClient } from "../../../lib/supabase-ssr";

const en = Astro.locals.lang === "en";
const base = en ? "/en" : "";
const url = new URL(Astro.request.url);
const sort = ["for-you","newest","likes","comments"].includes(url.searchParams.get("sort") ?? "") ? url.searchParams.get("sort")! : "for-you";
const category = ["all","anime","characters","theories","comparisons","manga","general"].includes(url.searchParams.get("category") ?? "") ? url.searchParams.get("category")! : "all";
const labels:Record<string,string> = en
  ? {all:"All",anime:"Anime",characters:"Characters",theories:"Theories",comparisons:"Comparisons",manga:"Manga",general:"General"}
  : {all:"Todos",anime:"Anime",characters:"Personajes",theories:"Teorías",comparisons:"Comparaciones",manga:"Manga",general:"General"};
const sortLabels:Record<string,string> = en
  ? {"for-you":"For you",newest:"Recent",likes:"Popular",comments:"Most discussed"}
  : {"for-you":"Para ti",newest:"Recientes",likes:"Populares",comments:"Más comentados"};
const supabase = createSupabaseSsrClient(Astro.request, Astro.cookies);
const {data:auth} = await supabase.auth.getUser();
const {data:viewer} = auth.user ? await supabase.from("profiles").select("avatar_url,aka").eq("id",auth.user.id).maybeSingle() : {data:null};
const {data,error} = await supabase.from("community_debates")
  .select("id,title,body,category,image_path,image_status,created_at,profiles!inner(aka,avatar_url,is_private)")
  .eq("status","published").eq("profiles.is_private",false).order("created_at",{ascending:false}).limit(60);
const rows=(data??[]).filter((x:any)=>category==="all"||x.category===category);
const ids=rows.map((x:any)=>x.id);
const [likes,comments,mine]=ids.length?await Promise.all([
  supabase.from("community_debate_likes").select("debate_id").in("debate_id",ids),
  supabase.from("community_debate_comments").select("debate_id").eq("status","visible").in("debate_id",ids),
  auth.user?supabase.from("community_debate_likes").select("debate_id").eq("user_id",auth.user.id).in("debate_id",ids):Promise.resolve({data:[]})
]):[{data:[]},{data:[]},{data:[]}];
const stats=new Map(ids.map((id:string)=>[id,{likes:0,comments:0,liked:false}]));
for(const x of likes.data??[])stats.get(x.debate_id)!.likes++;
for(const x of comments.data??[])stats.get(x.debate_id)!.comments++;
for(const x of mine.data??[])stats.get(x.debate_id)!.liked=true;
const ordered=[...rows].sort((a:any,b:any)=>{
  if(sort==="likes")return stats.get(b.id)!.likes-stats.get(a.id)!.likes;
  if(sort==="comments")return stats.get(b.id)!.comments-stats.get(a.id)!.comments;
  return new Date(b.created_at).getTime()-new Date(a.created_at).getTime();
});
const relativeTime=(value:string)=>{
 const minutes=Math.max(0,Math.floor((Date.now()-new Date(value).getTime())/60000));
 if(en){if(minutes<1)return "now";if(minutes<60)return minutes+" m";const hours=Math.floor(minutes/60);if(hours<24)return hours+" h";const days=Math.floor(hours/24);return days+" d";}
 if(minutes<1)return "ahora";if(minutes<60)return minutes+" min";const hours=Math.floor(minutes/60);if(hours<24)return hours+" h";return Math.floor(hours/24)+" d";
};
const publicImage=(path:string|null,status:string|null)=>{
 if(!path||status!=="approved")return null;
 return supabase.storage.from("debate-images").getPublicUrl(path).data.publicUrl;
};
---
<Layout title={en ? "Debates — Renanime" : "Debates — Renanime"}>
<Navbar />
<main id="main-content" class="debates">
  <header class="debates-head">
    <h1>Debates</h1>
    <button class="search-toggle" id="search-toggle" type="button" aria-label={en?"Search debates":"Buscar debates"} aria-expanded="false">
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.8"/><path d="m16 16 5 5"/></svg>
    </button>
  </header>
  <label class="feed-search" id="feed-search" hidden>
    <span class="sr-only">{en?"Search debates":"Buscar debates"}</span>
    <input id="feed-search-input" type="search" placeholder={en?"Search debates…":"Buscar debates…"} autocomplete="off"/>
  </label>

  <div class="create-row">
    <DebateComposerBar lang={en?"en":"es"} avatarUrl={viewer?.avatar_url??null}/>
  </div>

  <nav class="sort" aria-label={en?"Sort debates":"Ordenar debates"}>
    {Object.entries(sortLabels).map(([key,label])=><a class:list={{active:sort===key}} href={base+"/community/debates/?sort="+key+"&category="+category}>{label}</a>)}
  </nav>
  <nav class="cats" aria-label={en?"Debate categories":"Categorías de debate"}>
    {Object.entries(labels).map(([key,label])=><a class:list={{active:category===key}} href={base+"/community/debates/?sort="+sort+"&category="+key}>{label}</a>)}
  </nav>

  {error ? <p class="empty">{en?"Debates are temporarily unavailable.":"Los debates no están disponibles temporalmente."}</p> :
  ordered.length ? <section class="feed" id="debate-feed">
    {ordered.map((debate:any)=>{
      const profile=Array.isArray(debate.profiles)?debate.profiles[0]:debate.profiles;
      const statsForPost=stats.get(debate.id)!;
      const imageUrl=publicImage(debate.image_path,debate.image_status);
      return <article class="post" data-search={[debate.title,debate.body,debate.category,profile?.aka].filter(Boolean).join(" ").toLowerCase()}>
        <div class="hd">
          <a class="author" href={base+"/u/"+encodeURIComponent(profile?.aka??"")+"/"}>
            <img class="av" src={profile?.avatar_url||"/images/profile-avatar-placeholder.svg"} alt="" loading="lazy"/>
            <span>@{profile?.aka}</span>
          </a>
          <time datetime={debate.created_at}>{relativeTime(debate.created_at)}</time>
          <button class="more" type="button" disabled aria-label={en?"More options unavailable":"Más opciones no disponibles"} title={en?"Coming soon":"Próximamente"}>⋯</button>
        </div>
        <div class="post-content">
          <a class="body" href={base+"/community/debates/"+debate.id+"/"}>
            <h2>{debate.title}</h2>
            {debate.body&&<p class="tx">{debate.body}</p>}
          </a>
          {imageUrl&&<a class="image-link" href={imageUrl} target="_blank" rel="noreferrer"><img class="img" src={imageUrl} alt={debate.title} loading="lazy"/></a>}
          <div class="tags">
            <span class="tag">{labels[debate.category]||labels.general}</span>
          </div>
        </div>
        <div class="acts">
          <button class="act" type="button" disabled aria-label={en?"Like unavailable":"Me gusta no disponible"} title={en?"Coming soon":"Próximamente"}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.8 8.8c0 5.2-8.8 11-8.8 11S3.2 14 3.2 8.8a4.5 4.5 0 0 1 8.8-1.1 4.5 4.5 0 0 1 8.8 1.1Z"/></svg><span>{statsForPost.likes}</span>
          </button>
          <button class="act" type="button" disabled aria-label={en?"Comments unavailable":"Comentarios no disponibles"} title={en?"Coming soon":"Próximamente"}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 11.5a7.5 7.5 0 0 1-7.5 7.5H5l-1-4.5A7.5 7.5 0 1 1 20 11.5Z"/></svg><span>{statsForPost.comments}</span>
          </button>
          <button class="act share" type="button" data-share-url={base+"/community/debates/"+debate.id+"/"} aria-label={en?"Share debate":"Compartir debate"}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 16V3m-5 5 5-5 5 5M4 14v6h16v-6"/></svg>
          </button>
        </div>
      </article>;
    })}
  </section> : <p class="empty">{en?"No debates yet. Start the first one.":"Todavía no hay debates. Inicia el primero."}</p>}
  <p id="search-empty" class="empty" hidden>{en?"No debates match your search.":"No hay debates que coincidan con tu búsqueda."}</p>
</main>

<dialog class="composer-sheet" id="composer-sheet">
  <section class="sheet-panel">
    <form id="debate-form" enctype="multipart/form-data">
      <div class="sheet-grab" aria-hidden="true"></div>
      <div class="sheet-top">
        <button class="cancel" type="button" id="cancel-composer">{en?"Cancel":"Cancelar"}</button>
        <button class="publish" type="submit" disabled>{en?"Publish":"Publicar"}</button>
      </div>
      {auth.user ? <>
        <div class="composer-content">
          <img class="av composer-avatar" src={viewer?.avatar_url||"/images/profile-avatar-placeholder.svg"} alt=""/>
          <div class="composer-fields">
            <textarea name="title" id="debate-title" minlength="8" maxlength="120" required rows="1" autofocus placeholder={en?"What would you like to debate?":"¿Qué quieres debatir?"}></textarea>
            <textarea name="body" id="debate-body" maxlength="500" rows="1" placeholder={en?"Add your argument (optional)":"Añade tu argumento (opcional)"}></textarea><span class="body-count" id="body-count" hidden></span>
            <div class="image-preview" id="image-preview" hidden><img id="preview-img" alt=""/><button type="button" id="remove-image" aria-label={en?"Remove image":"Quitar imagen"}>×</button></div>
            <div class="image-controls" id="image-controls" hidden>
              <label class="image-control"><span>{en?"Zoom":"Zoom"}</span><input id="image-zoom" type="range" min="1" max="2.5" step="0.05" value="1"/><output id="image-zoom-value">1×</output></label>
              <label class="image-control"><span>{en?"Vertical position":"Posición vertical"}</span><input id="image-position" type="range" min="0" max="100" step="1" value="50"/><output id="image-position-value">{en?"Center":"Centro"}</output></label>
              <button class="image-reset" type="button" id="reset-image">{en?"Reset":"Restablecer"}</button>
            </div>
            <div class="anime-field">
              <label class="anime-label" for="anime-title">{en?"RELATED ANIME · OPTIONAL":"ANIME RELACIONADO · OPCIONAL"}</label>
              <div class="anime-control">
                <input type="text" name="animeTitle" id="anime-title" maxlength="120" placeholder={en?"Choose an anime":"Selecciona un anime"}/>
                <button type="button" id="remove-anime" aria-label={en?"Remove related anime":"Quitar anime relacionado"} hidden>×</button>
              </div>
              <input type="hidden" name="animeId" id="anime-id" value=""/>
            </div>
            <div class="cats composer-cats" role="group" aria-label={en?"Choose a category":"Elige una categoría"}>
              {Object.entries(labels).filter(([key])=>key!=="all").map(([key,label],index)=><button type="button" class:list={["cat-choice",index===0&&"active"]} data-category={key}>{label}</button>)}
              <input type="hidden" name="category" id="debate-category" value="anime"/>
            </div>
            <div class="composer-bottom">
              <label class="image-picker" for="debate-image" aria-label={en?"Add image":"Añadir imagen"}>
                <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="8.5" cy="9" r="1.5"/><path d="m21 15-5-5L5 20"/></svg>
              </label>
              <input id="debate-image" name="image" type="file" accept="image/jpeg,image/png,image/webp,image/avif" hidden/>
              <span id="title-count">0 / 120</span>
            </div>
            <p class="form-error" id="form-error" role="alert" hidden></p>
          </div>
        </div>
      </> : <div class="login-prompt">{en?"Sign in to publish a debate.":"Inicia sesión para publicar un debate."} <a href={base+"/login/"}>{en?"Sign in":"Iniciar sesión"}</a></div>}
    </form>
  </section>
</dialog>
</Layout>

<script>
const en=document.documentElement.lang.toLowerCase().startsWith("en");
const sheet=document.querySelector<HTMLDialogElement>("#composer-sheet");
const closeSheet=()=>{if(sheet?.open)sheet.close();document.body.classList.remove("sheet-open");};
const openSheet=()=>{if(sheet&&!sheet.open){sheet.showModal();document.body.classList.add("sheet-open");requestAnimationFrame(()=>document.querySelector<HTMLTextAreaElement>("#debate-title")?.focus({preventScroll:true}));}};
document.querySelector(".create-row .compose")?.addEventListener("click",(event)=>{event.preventDefault();openSheet();});
document.querySelector("#cancel-composer")?.addEventListener("click",closeSheet);
sheet?.addEventListener("click",(event)=>{if(event.target===sheet)closeSheet();});
sheet?.addEventListener("close",()=>document.body.classList.remove("sheet-open"));
if(new URLSearchParams(window.location.search).get("compose")==="1"){openSheet();const clean=new URL(window.location.href);clean.searchParams.delete("compose");history.replaceState({}, "", clean);}
sheet?.addEventListener("click",(event)=>{if(event.target===sheet)closeSheet();});
const categoryInput=document.querySelector<HTMLInputElement>("#debate-category");
document.querySelectorAll<HTMLButtonElement>("[data-category]").forEach(button=>button.addEventListener("click",()=>{
 document.querySelectorAll("[data-category]").forEach(x=>x.classList.remove("active"));button.classList.add("active");if(categoryInput)categoryInput.value=button.dataset.category||"general";
}));
const imageInput=document.querySelector<HTMLInputElement>("#debate-image");
const preview=document.querySelector<HTMLElement>("#image-preview");
const previewImage=document.querySelector<HTMLImageElement>("#preview-img");
const imageControls=document.querySelector<HTMLElement>("#image-controls");
const zoomInput=document.querySelector<HTMLInputElement>("#image-zoom");
const positionInput=document.querySelector<HTMLInputElement>("#image-position");
const zoomValue=document.querySelector<HTMLOutputElement>("#image-zoom-value");
const positionValue=document.querySelector<HTMLOutputElement>("#image-position-value");
const imageZoomField=document.createElement("input");
imageZoomField.type="hidden";imageZoomField.name="imageZoom";imageZoomField.value="1";
const imagePositionField=document.createElement("input");
imagePositionField.type="hidden";imagePositionField.name="imagePositionY";imagePositionField.value="50";
document.querySelector<HTMLFormElement>("#debate-form")?.append(imageZoomField,imagePositionField);
let previewUrl:string|undefined;
let previewDimensions:{width:number;height:number}|null=null;
const fitImagePreview=()=>{
 if(!preview||!previewDimensions)return;
 const maxWidth=preview.parentElement?.clientWidth??320;
 const scale=Math.min(maxWidth/previewDimensions.width,260/previewDimensions.height);
 preview.style.width=Math.round(previewDimensions.width*scale)+"px";
 preview.style.height=Math.round(previewDimensions.height*scale)+"px";
};
window.addEventListener("resize",fitImagePreview);
const updateImageAdjustments=()=>{
 const zoom=Number(zoomInput?.value||1);
 const position=Number(positionInput?.value||50);
 const pan=(50-position)*(zoom-1);
 if(previewImage){previewImage.style.transform="translateY("+pan+"%) scale("+zoom+")";}
 if(zoomValue)zoomValue.value=zoom.toFixed(2).replace(/0+$/,"").replace(/\.$/,"")+"×";
 if(positionValue)positionValue.value=position<45?(en?"Top":"Arriba"):position>55?(en?"Bottom":"Abajo"):(en?"Center":"Centro");
 imageZoomField.value=String(zoom);
 imagePositionField.value=String(position);
};
const resetImageAdjustments=()=>{
 if(zoomInput)zoomInput.value="1";
 if(positionInput)positionInput.value="50";
 updateImageAdjustments();
};
zoomInput?.addEventListener("input",updateImageAdjustments);
positionInput?.addEventListener("input",updateImageAdjustments);
document.querySelector("#reset-image")?.addEventListener("click",resetImageAdjustments);
imageInput?.addEventListener("change",()=>{
 const file=imageInput.files?.[0];if(!file)return;
 if(file.size>5*1024*1024||!["image/jpeg","image/png","image/webp","image/avif"].includes(file.type)){imageInput.value="";return;}
 if(previewUrl)URL.revokeObjectURL(previewUrl);previewUrl=URL.createObjectURL(file);
 if(previewImage){
  previewImage.onload=()=>{
   previewDimensions={width:previewImage.naturalWidth,height:previewImage.naturalHeight};
   fitImagePreview();
  };
  previewImage.src=previewUrl;
 }
 if(preview)preview.hidden=false;
 if(imageControls)imageControls.hidden=false;
 resetImageAdjustments();
});
document.querySelector("#remove-image")?.addEventListener("click",()=>{
 if(previewUrl)URL.revokeObjectURL(previewUrl);previewUrl=undefined;if(imageInput)imageInput.value="";
 if(preview){preview.hidden=true;preview.style.aspectRatio="";preview.style.width="";preview.style.height="";}previewDimensions=null;
 if(imageControls)imageControls.hidden=true;
 resetImageAdjustments();
});
const titleInput=document.querySelector<HTMLTextAreaElement>("#debate-title");
const bodyInput=document.querySelector<HTMLTextAreaElement>("#debate-body");
const titleCount=document.querySelector<HTMLElement>("#title-count");
const publishButton=document.querySelector<HTMLButtonElement>(".publish");
const autoGrow=(field:HTMLTextAreaElement,minHeight:number)=>{
 field.style.height="auto";
 field.style.height=Math.max(minHeight,field.scrollHeight)+"px";
};
const updateTitleState=()=>{
 if(!titleInput)return;
 autoGrow(titleInput,24);
 if(titleCount)titleCount.textContent=titleInput.value.length+" / 120";
 if(publishButton)publishButton.disabled=titleInput.value.trim().length<8||titleInput.value.trim().length>120;
};
const bodyCount=document.querySelector<HTMLElement>("#body-count");
const updateBodyState=()=>{if(bodyInput)autoGrow(bodyInput,22);if(bodyCount){const length=bodyInput?.value.length??0;bodyCount.textContent=length+" / 500";bodyCount.hidden=length<=400;}};
titleInput?.addEventListener("input",updateTitleState);
bodyInput?.addEventListener("input",updateBodyState);
updateTitleState();
updateBodyState();
const animeInput=document.querySelector<HTMLInputElement>("#anime-title");
const removeAnime=document.querySelector<HTMLButtonElement>("#remove-anime");
const updateAnimeState=()=>{if(removeAnime)removeAnime.hidden=!animeInput?.value.trim();};
animeInput?.addEventListener("input",updateAnimeState);
removeAnime?.addEventListener("click",()=>{if(animeInput)animeInput.value="";const animeId=document.querySelector<HTMLInputElement>("#anime-id");if(animeId)animeId.value="";updateAnimeState();animeInput?.focus();});
const form=document.querySelector<HTMLFormElement>("#debate-form");
const error=document.querySelector<HTMLElement>("#form-error");
form?.addEventListener("submit",async(event)=>{
 event.preventDefault();if(!form.reportValidity())return;
 const submit=form.querySelector<HTMLButtonElement>(".publish");if(submit){submit.disabled=true;submit.textContent="…";}
 if(error)error.hidden=true;
 try{
  const response=await fetch("/api/community/debates",{method:"POST",credentials:"same-origin",body:new FormData(form)});
  const result=await response.json();
  if(!response.ok||!result.ok){if(result.error==="IMAGE_UPLOAD_FAILED")throw new Error("IMAGE_UPLOAD_FAILED");throw new Error(result.error||"CREATE_FAILED");}
  window.location.reload();
 }catch(err){
  if(error){error.textContent=err instanceof Error&&err.message==="IMAGE_UPLOAD_FAILED"?(en?"Could not upload the image. Try again.":"No se pudo subir la imagen. Inténtalo de nuevo."):(en?"Could not publish the debate. Try again.":"No se pudo publicar el debate. Inténtalo de nuevo.");error.hidden=false;}
  if(submit){submit.textContent=en?"Publish":"Publicar";submit.disabled=!titleInput||titleInput.value.trim().length<8;}
 }
});
document.querySelectorAll<HTMLButtonElement>(".share").forEach(button=>button.addEventListener("click",async()=>{
 const url=new URL(button.dataset.shareUrl||"",window.location.origin).toString();
 try{if(navigator.share)await navigator.share({url});else if(navigator.clipboard)await navigator.clipboard.writeText(url);}catch{}
}));
const searchToggle=document.querySelector<HTMLButtonElement>("#search-toggle");
const searchPanel=document.querySelector<HTMLElement>("#feed-search");
const searchInput=document.querySelector<HTMLInputElement>("#feed-search-input");
searchToggle?.addEventListener("click",()=>{const open=searchPanel?.hidden??true;if(searchPanel)searchPanel.hidden=!open;searchToggle.setAttribute("aria-expanded",String(open));if(open)searchInput?.focus();});
searchInput?.addEventListener("input",()=>{const query=searchInput.value.trim().toLowerCase();const cards=[...document.querySelectorAll<HTMLElement>(".post")];let count=0;cards.forEach(card=>{const match=!query||(card.dataset.search||"").includes(query);card.hidden=!match;if(match)count++;});const empty=document.querySelector<HTMLElement>("#search-empty");if(empty)empty.hidden=count>0;});
</script>

<style>
.debates{width:min(100%,640px);min-height:70vh;margin:0 auto;padding:calc(var(--header-height,64px) + 18px) 0 4rem;color:#f2efe9;background:#09090b}
.debates-head{display:flex;align-items:center;justify-content:space-between;padding:16px 16px 6px}
.debates-head h1{margin:0;font-size:26px;font-weight:800;letter-spacing:-.035em;line-height:1.2}
.search-toggle{display:grid;place-items:center;width:40px;height:40px;border:0;background:transparent;color:#a39fa9}
.search-toggle svg,.image-picker svg{width:21px;height:21px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
.feed-search{display:block;padding:8px 16px}.feed-search[hidden]{display:none}
.feed-search input{width:100%;padding:11px 14px;border:1px solid rgba(255,255,255,.1);border-radius:999px;background:#131316;color:#f2efe9;font:inherit;font-size:14px;outline:none}
.create-row{padding:8px 16px 4px}.create-row :global(.compose){display:flex;align-items:center;gap:8px;width:100%;min-height:58px;margin:0;padding:0;border:0;border-radius:0;background:transparent;overflow:visible}.create-row :global(.compose>.av){display:block;width:38px;height:38px;flex:0 0 38px;border-radius:50%;object-fit:cover}.create-row :global(.compose-field){display:flex;align-items:center;gap:10px;flex:1;min-width:0;height:52px;padding:6px 7px 6px 14px;border:1px solid rgba(255,255,255,.08);border-radius:999px;background:#131316}.create-row :global(.compose .in){flex:1;min-width:0;font-size:13px;color:#a39fa9;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.create-row :global(.compose .go){display:grid;place-items:center;width:34px;height:34px;flex:0 0 34px;border-radius:50%;background:var(--color-accent);color:#fff}.create-row :global(.compose .go svg){display:block;width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round}
.sort,.cats{display:flex;align-items:center;gap:8px;padding:12px 16px 4px;flex-wrap:nowrap;overflow-x:auto;overscroll-behavior-x:contain;scrollbar-width:none;-webkit-overflow-scrolling:touch}.sort::-webkit-scrollbar,.cats::-webkit-scrollbar{display:none}.sort a,.cats a{flex:0 0 auto}
.sort a,.cats a,.cat-choice{display:inline-flex;align-items:center;justify-content:center;min-height:34px;padding:0 12px;border:1px solid rgba(255,255,255,.08);border-radius:999px;background:#131316;color:#a39fa9;text-decoration:none;font-size:12px;font-weight:650;white-space:nowrap}.cats a{min-height:28px;padding:5px 11px;font-size:12px}
.sort a.active,.cats a.active,.cat-choice.active{border-color:var(--color-border-accent);background:var(--color-accent-subtle);color:#f2efe9}
.feed{display:grid;gap:0;padding:8px 0 0}
.post{min-width:0;padding:18px 16px;border:0;border-bottom:1px solid rgba(255,255,255,.08);border-radius:0;background:transparent}.post:first-child{border-top:1px solid rgba(255,255,255,.08)}
.hd{display:flex;align-items:center;gap:9px;min-height:38px}
.author{display:flex;align-items:center;gap:9px;min-width:0;color:#f2efe9;text-decoration:none;font-size:12px;font-weight:750}
.av{display:block;width:38px;height:38px;flex:0 0 38px;border-radius:50%;object-fit:cover;background:#25252a}
.hd time{margin-left:auto;color:#77737d;font-size:11px;white-space:nowrap}
.more{width:36px;height:36px;border:0;background:transparent;color:#77737d;font-size:22px;line-height:1}.more:disabled{opacity:.75;cursor:default}
.post-content{margin-left:47px;min-width:0}.body{display:block;margin-top:10px;color:inherit;text-decoration:none}
