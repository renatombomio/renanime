---
export const prerender = false;
import Layout from "../../../layouts/Layout.astro";
import Navbar from "../../../components/layout/Navbar.astro";
import { createSupabaseSsrClient } from "../../../lib/supabase-ssr";
const en = Astro.locals.lang === "en";
const base = en ? "/en" : "";
const url = new URL(Astro.request.url);
const sort = ["newest","comments","likes"].includes(url.searchParams.get("sort") ?? "") ? url.searchParams.get("sort")! : "newest";
const category = ["all","anime","characters","theories","comparisons","manga","general"].includes(url.searchParams.get("category") ?? "") ? url.searchParams.get("category")! : "all";
const labels: Record<string,string> = en ? {all:"All",anime:"Anime",characters:"Characters",theories:"Theories",comparisons:"Comparisons",manga:"Manga",general:"General"} : {all:"Todos",anime:"Anime",characters:"Personajes",theories:"Teorías",comparisons:"Comparaciones",manga:"Manga",general:"General"};
const supabase = createSupabaseSsrClient(Astro.request, Astro.cookies);
const { data: auth } = await supabase.auth.getUser();
const { data, error } = await supabase.from("community_debates").select("id,title,body,category,created_at,profiles!inner(aka,avatar_url,is_private)").eq("status","published").eq("profiles.is_private",false).order("created_at",{ascending:false}).limit(60);
const rows = (data ?? []).filter((x:any) => category === "all" || x.category === category);
const ids = rows.map((x:any) => x.id);
const [likes,comments,mine] = ids.length ? await Promise.all([
  supabase.from("community_debate_likes").select("debate_id").in("debate_id",ids),
  supabase.from("community_debate_comments").select("debate_id").eq("status","visible").in("debate_id",ids),
  auth.user ? supabase.from("community_debate_likes").select("debate_id").eq("user_id",auth.user.id).in("debate_id",ids) : Promise.resolve({data:[]})
]) : [{data:[]},{data:[]},{data:[]}];
const stats = new Map(ids.map((id:string) => [id,{likes:0,comments:0,liked:false}]));
for (const x of likes.data ?? []) stats.get(x.debate_id)!.likes++;
for (const x of comments.data ?? []) stats.get(x.debate_id)!.comments++;
for (const x of mine.data ?? []) stats.get(x.debate_id)!.liked = true;
const ordered = [...rows].sort((a:any,b:any) => sort === "likes" ? stats.get(b.id)!.likes-stats.get(a.id)!.likes : sort === "comments" ? stats.get(b.id)!.comments-stats.get(a.id)!.comments : new Date(b.created_at).getTime()-new Date(a.created_at).getTime());
---
<Layout title={en ? "Community debates — Renanime" : "Debates de la comunidad — Renanime"}>
<Navbar />
<main id="main-content" class="debates">
<header><p class="eyebrow">{en ? "Community" : "Comunidad"}</p><h1>Debates</h1><p>{en ? "Ideas, theories and conversations about the stories we love." : "Ideas, teorías y conversaciones sobre las historias que nos gustan."}</p><button id="open-form" type="button">{en ? "＋ Start a debate" : "＋ Crear debate"}</button></header>
<section id="create-panel" class="composer" hidden>
{auth.user ? <form id="debate-form" enctype="multipart/form-data">
  <div class="composer-intro"><span class="composer-step">NUEVO DEBATE</span><h2>{en ? "What's on your mind?" : "¿Qué quieres debatir?"}</h2><p>{en ? "Start with a clear question or opinion. Explain your reasons and invite others to join in." : "Plantea una pregunta o una opinión clara. Explica tus razones y deja espacio para que otros participen."}</p></div>
  <label class="field-label">{en ? "Debate title" : "Título del debate"}<input name="title" minlength="8" maxlength="120" required placeholder={en ? "e.g. Is Tengen Uzui the strongest Sound Hashira?" : "Ej. ¿Es Tengen Uzui el hashira del sonido más fuerte?"} /><small>{en ? "Make it specific so people know what they're discussing." : "Procura que sea concreto: así todos sabrán de qué trata."}</small></label>
  <div class="field-label"><label for="debate-category">{en ? "Topic" : "Tema"}</label><select id="debate-category" name="category">{Object.entries(labels).filter(([k])=>k!=="all").map(([k,v])=><option value={k}>{v}</option>)}</select></div>
  <label class="field-label">{en ? "Your point of view" : "Tu argumento"}<textarea name="body" minlength="20" maxlength="3000" rows="5" required placeholder={en ? "What do you think? Add context, examples or reasons…" : "¿Qué opinas? Añade contexto, ejemplos o razones para defender tu postura…"}></textarea><small>{en ? "Avoid spoilers without a warning. Keep the conversation respectful." : "Evita spoilers sin avisar y mantén un tono respetuoso."}</small></label>
  <div class="image-field"><div><strong>{en ? "Add an image" : "Añadir una imagen"}</strong><p>{en ? "Optional · JPG, PNG, WebP or AVIF · up to 5 MB" : "Opcional · JPG, PNG, WebP o AVIF · máximo 5 MB"}</p></div><label class="image-picker" for="debate-image">{en ? "Choose image" : "Elegir imagen"}</label><input id="debate-image" name="image" type="file" accept="image/jpeg,image/png,image/webp,image/avif" hidden /><div id="image-preview" class="image-preview" hidden><img id="preview-img" alt="" /><span id="preview-name"></span><button id="remove-image" type="button" aria-label={en ? "Remove image" : "Quitar imagen"}>×</button></div><small class="image-review-note">{en ? "Images are reviewed before they become visible to everyone." : "Las imágenes se revisan antes de mostrarse públicamente."}</small></div>
  <div class="composer-footer"><span id="body-count">0 / 3000</span><p id="form-error" role="alert" hidden></p><button class="publish-button" type="submit">{en ? "Publish debate" : "Publicar debate"} <span aria-hidden="true">↗</span></button></div>
</form> : <div class="login-prompt"><p>{en ? "Sign in to start a conversation with the community." : "Inicia sesión para abrir una conversación con la comunidad."}</p><a href={base+"/login/"}>{en ? "Sign in" : "Iniciar sesión"}</a></div>}
</section>
<nav class="filters"><div>{["newest","comments","likes"].map((item)=><a class:list={{active:sort===item}} href={base+"/community/debates/?sort="+item+"&category="+category}>{item==="newest"?(en?"Newest":"Más recientes"):item==="comments"?(en?"Most discussed":"Más comentados"):(en?"Most liked":"Más valorados")}</a>)}</div><div>{Object.entries(labels).map((entry)=><a class:list={{active:category===entry[0]}} href={base+"/community/debates/?sort="+sort+"&category="+entry[0]}>{entry[1]}</a>)}</div></nav>
{error ? <p class="empty">{en ? "Debates are temporarily unavailable." : "Los debates no están disponibles temporalmente."}</p> : ordered.length ? <section class="list">{ordered.map((d:any)=>{const p=Array.isArray(d.profiles)?d.profiles[0]:d.profiles;const s=stats.get(d.id)!;return <article><div class="author"><img src={p?.avatar_url||"/images/profile-avatar-placeholder.svg"} alt="" /><a href={base+"/u/"+encodeURIComponent(p.aka)+"/"}>@{p.aka}</a><time>{new Intl.DateTimeFormat(en?"en":"es",{dateStyle:"medium"}).format(new Date(d.created_at))}</time></div><a class="title" href={base+"/community/debates/"+d.id+"/"}><h2>{d.title}</h2></a><p class="excerpt">{d.body}</p><footer><span>{labels[d.category]}</span><span>{s.comments} {en?"comments":"comentarios"}</span><span>{s.likes} likes</span></footer></article>})}</section> : <p class="empty">{en ? "No debates yet. Start the first one." : "Todavía no hay debates. Inicia el primero."}</p>}
</main>
</Layout>
<style>
.debates{width:min(calc(100% - 2*var(--gutter)),850px);min-height:70vh;margin:auto;padding:clamp(6rem,11vw,9rem) 0 var(--section-space);color:#f5f2ec}.debates header{padding-bottom:1.6rem;border-bottom:1px solid #ffffff1a}.eyebrow{color:#ec4899;font-size:.7rem;font-weight:700;letter-spacing:.14em;text-transform:uppercase}.debates h1{margin:0;font-size:clamp(2.5rem,8vw,4.5rem);letter-spacing:-.06em}.debates header p:not(.eyebrow){color:#999}.debates button{border:0;border-radius:999px;background:#f5f2ec;color:#111;padding:.7rem 1rem;font:inherit;font-size:.8rem;font-weight:700;cursor:pointer}.composer{margin:1.15rem 0 1.4rem;padding:clamp(1rem,4vw,1.5rem);border:1px solid rgba(255,255,255,.13);border-radius:16px;background:#101012}.composer[hidden]{display:none}.composer-intro{margin-bottom:1.3rem}.composer-step{color:#ec4899;font-size:.62rem;font-weight:800;letter-spacing:.16em}.composer-intro h2{margin:.35rem 0;font-size:1.35rem;letter-spacing:-.04em}.composer-intro p{max-width:540px;margin:0;color:#999;font-size:.78rem;line-height:1.55}.field-label{display:grid;gap:.45rem;margin:1rem 0;color:#e7e4df;font-size:.78rem;font-weight:600}.field-label small{color:#85858a;font-size:.68rem;font-weight:400;line-height:1.45}.field-label input,.field-label select,.field-label textarea{width:100%;min-height:44px;padding:.75rem .85rem;border:1px solid #38383d;border-radius:9px;background:#09090b;color:#f5f2ec;font:inherit;font-size:.82rem;outline:none}.field-label input:focus,.field-label select:focus,.field-label textarea:focus{border-color:#ec4899;box-shadow:0 0 0 2px rgba(236,72,153,.13)}.field-label textarea{min-height:138px;resize:vertical;line-height:1.55}.image-field{display:grid;grid-template-columns:1fr auto;gap:.35rem .8rem;align-items:center;margin-top:1.2rem;padding:1rem;border:1px dashed #45454b;border-radius:11px}.image-field strong{font-size:.78rem}.image-field p{margin:.25rem 0 0;color:#888;font-size:.67rem}.image-picker{padding:.58rem .8rem;border:1px solid #444;border-radius:999px;color:#eee;font-size:.7rem;cursor:pointer}.image-picker:hover{border-color:#ec4899}.image-review-note{grid-column:1/-1;color:#888;font-size:.65rem;line-height:1.4}.image-preview{position:relative;grid-column:1/-1;display:flex;align-items:center;gap:.7rem;margin-top:.55rem;padding:.55rem;background:#080809;border-radius:8px;color:#bbb;font-size:.68rem}.image-preview[hidden]{display:none}.image-preview img{width:58px;height:58px;border-radius:6px;object-fit:cover}.image-preview span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.image-preview button{margin-left:auto;border:0;background:none;color:#ddd;font-size:1.2rem}.composer-footer{display:flex;align-items:center;gap:.8rem;margin-top:1.1rem;padding-top:.9rem;border-top:1px solid #ffffff12}.composer-footer>span{color:#777;font-size:.67rem}.publish-button{margin-left:auto;display:flex;align-items:center;gap:.7rem;padding:.78rem 1.1rem;border:0;border-radius:999px;background:#f5f2ec;color:#111;font:inherit;font-size:.76rem;font-weight:700}.publish-button:disabled{opacity:.55}.composer-footer p{margin:0;color:#fca5a5;font-size:.68rem}.composer-footer p[hidden]{display:none}.login-prompt{padding:1.2rem;border:1px solid #ffffff1a;border-radius:12px;color:#aaa;font-size:.8rem}.login-prompt a{color:#ec4899}..filters{display:grid;gap:.7rem;padding:1rem 0}.filters div{display:flex;gap:.4rem;overflow:auto;scrollbar-width:none}.filters a{flex:0 0 auto;padding:.5rem .7rem;border:1px solid #ffffff20;border-radius:99px;color:#aaa;font-size:.7rem;text-decoration:none}.filters a.active{background:#f5f2ec;color:#111}.list{display:grid;gap:.8rem}.list article{padding:1rem;border:1px solid #ffffff1a;border-radius:14px;background:#ffffff06}.author{display:flex;align-items:center;gap:.55rem;color:#888;font-size:.7rem}.author img{width:28px;height:28px;border-radius:50%;object-fit:cover}.author a{color:#eee;text-decoration:none;font-weight:700}.author time{margin-left:auto}.title{color:#f5f2ec;text-decoration:none}.title h2{margin:.8rem 0 .4rem;font-size:1.3rem;letter-spacing:-.03em}.excerpt{display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:3;overflow:hidden;color:#aaa;font-size:.82rem;line-height:1.6;white-space:pre-wrap}.list footer{display:flex;gap:1rem;margin-top:.9rem;color:#888;font-size:.7rem}.list footer span:first-child{color:#ddd}.empty{padding:2rem 0;color:#888}
</style>
<script>
const panel=document.querySelector<HTMLElement>("#create-panel");
document.querySelector("#open-form")?.addEventListener("click",()=>{if(panel){panel.hidden=!panel.hidden;if(!panel.hidden)panel.scrollIntoView({behavior:"smooth",block:"start"})}});
const form=document.querySelector<HTMLFormElement>("#debate-form");
const imageInput=document.querySelector<HTMLInputElement>("#debate-image");
const preview=document.querySelector<HTMLElement>("#image-preview");
const previewImage=document.querySelector<HTMLImageElement>("#preview-img");
const previewName=document.querySelector<HTMLElement>("#preview-name");
const bodyInput=form?.querySelector<HTMLTextAreaElement>('textarea[name="body"]');
const counter=document.querySelector<HTMLElement>("#body-count");
const error=document.querySelector<HTMLElement>("#form-error");
let imageUrl:string|undefined;
bodyInput?.addEventListener("input",()=>{if(counter)counter.textContent=bodyInput.value.length+" / 3000"});
imageInput?.addEventListener("change",()=>{const file=imageInput.files?.[0];if(!file)return;if(!["image/jpeg","image/png","image/webp","image/avif"].includes(file.type)||file.size>5*1024*1024){imageInput.value="";if(error){error.textContent="Imagen no válida. Usa JPG, PNG, WebP o AVIF de máximo 5 MB.";error.hidden=false}return}if(imageUrl)URL.revokeObjectURL(imageUrl);imageUrl=URL.createObjectURL(file);if(previewImage)previewImage.src=imageUrl;if(previewName)previewName.textContent=file.name;if(preview)preview.hidden=false;if(error)error.hidden=true});
document.querySelector("#remove-image")?.addEventListener("click",()=>{if(imageUrl)URL.revokeObjectURL(imageUrl);imageUrl=undefined;if(imageInput)imageInput.value="";if(preview)preview.hidden=true});
form?.addEventListener("submit",async(event)=>{event.preventDefault();if(!form.reportValidity())return;const button=form.querySelector<HTMLButtonElement>('button[type="submit"]');if(button){button.disabled=true;button.innerHTML="Publicando…"}if(error)error.hidden=true;try{const r=await fetch("/api/community/debates",{method:"POST",credentials:"same-origin",body:new FormData(form)});const result=await r.json();if(!r.ok||!result.ok)throw new Error(result.error||"CREATE_FAILED");window.location.href="/community/debates/"}catch{if(error){error.textContent="No se ha podido publicar. Revisa los campos e inténtalo de nuevo.";error.hidden=false}if(button){button.disabled=false;button.innerHTML='Publicar debate <span aria-hidden="true">↗</span>'}}});
</script>
