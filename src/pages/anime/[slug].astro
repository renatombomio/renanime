---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/layout/Navbar.astro";
import Footer from "../../components/layout/Footer.astro";
import AnimeDetail from "../../components/anime/AnimeDetail";
import { getLibrary } from "../../data/library";
import type { LibraryEntry } from "../../types/personal";

export const prerender = false;

const { slug } = Astro.params;
const library = getLibrary();
let entry: LibraryEntry | undefined = library.find((item) => item.animeId === slug);

if (!entry && slug && /^\d+$/.test(slug)) {
  try {
    const response = await fetch("https://graphql.anilist.co", {
      method: "POST",
      headers: { "Content-Type": "application/json", Accept: "application/json" },
      body: JSON.stringify({
        query: `query AnimeExists($id:Int!){Media(id:$id,type:ANIME){id title{romaji english}}}`,
        variables: { id: Number(slug) },
      }),
    });
    if (response.ok) {
      const payload = await response.json();
      const media = payload.data?.Media;
      if (media) {
        entry = {
          animeId: slug,
          title: media.title?.romaji || media.title?.english || "Anime",
          state: { status: "NOT_IN_COLLECTION", favorite: false, recommended: false },
        };
      }
    }
  } catch {}
}

if (!entry) {
  return new Response(
    `<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width><title>Anime no encontrado — Renanime's Gallery</title></head><body style="margin:0;background:#090909;color:#f5f2ec;font-family:system-ui,sans-serif"><main style="min-height:100vh;display:grid;place-items:center;padding:2rem;text-align:center"><div><p style="font-size:.65rem;letter-spacing:.14em;text-transform:uppercase;opacity:.55">404 · Archivo</p><h1 style="font-size:clamp(2rem,6vw,4rem);font-weight:500;margin:.5rem 0 1rem">Anime no encontrado.</h1><p style="opacity:.65;margin:0 0 1.5rem">Este anime no existe en AniList o la ficha ya no está disponible.</p><a href="/search/" style="color:#f5f2ec;text-decoration:underline;text-underline-offset:4px">Volver al buscador →</a></div></main></body></html>`,
    { status: 404, headers: { "Content-Type": "text/html; charset=utf-8" } },
  );
}
---

<Layout title={`${entry.title} — Renanime's Gallery`} description={`Ficha de ${entry.title} en Renanime's Gallery.`}>
  <Navbar />
  <main id="main-content" class="anime-detail-page">
    <AnimeDetail entry={entry} client:load />
  </main>
  <Footer />
</Layout>
