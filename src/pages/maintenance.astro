---
export const prerender = false;
const isEnglish = /^\/en(?:\/|$)/.test(Astro.url.pathname);
---
<!doctype html>
<html lang={isEnglish ? "en" : "es"}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#0b0b0e" />
    <title>{isEnglish ? "Renanime 2.0 — Updates in progress" : "Renanime 2.0 — Actualizaciones en curso"}</title>
    <meta
      name="description"
      content={isEnglish
        ? "Renanime is being updated. A new version is on the way."
        : "Renanime está en actualización. Una nueva versión llegará pronto."}
    />
  </head>
  <body>
    <main class="maintenance">
      <section class="content" aria-labelledby="maintenance-title">
        <p class="eyebrow">{isEnglish ? "WE'LL BE BACK SOON" : "VOLVEMOS PRONTO"}</p>
        <h1 id="maintenance-title">Renanime <span>2.0</span></h1>
        <div class="accent" aria-hidden="true"></div>
        <p class="message">
          {isEnglish ? "I'm working on the new version of the site." : "Estoy trabajando en la nueva versión de la web."}
        </p>
        <p class="apology">
          {isEnglish ? "New updates are on the way. Sorry for the inconvenience." : "Nuevas actualizaciones en camino. Disculpa las molestias."}
        </p>
      </section>
    </main>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(html) { min-height: 100%; background: #0b0b0e; }
  :global(body) {
    margin: 0;
    min-height: 100vh;
    color: #f5f5f6;
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }
  .maintenance {
    display: grid;
    min-height: 100svh;
    place-items: center;
    padding: 32px 24px;
    background: #0b0b0e;
  }
  .content {
    width: min(100%, 620px);
    text-align: center;
  }
  .eyebrow {
    margin: 0 0 22px;
    color: #ff5b98;
    font-size: .78rem;
    font-weight: 700;
    letter-spacing: .13em;
  }
  h1 {
    margin: 0;
    font-size: clamp(2.8rem, 9vw, 5.4rem);
    font-weight: 800;
    letter-spacing: -.065em;
    line-height: 1.08;
  }
  h1 span { color: #ff5b98; }
  .accent {
    width: 42px;
    height: 3px;
    margin: 30px auto;
    background: #ff5b98;
  }
  .message {
    margin: 0;
    color: #ededf0;
    font-size: clamp(1.05rem, 3vw, 1.25rem);
    line-height: 1.6;
  }
  .apology {
    max-width: 440px;
    margin: 12px auto 0;
    color: #b8b8c0;
    font-size: 1rem;
    line-height: 1.7;
  }
  @media (max-width: 480px) {
    .maintenance { padding: 24px; }
    .eyebrow { font-size: .7rem; }
  }
</style>
