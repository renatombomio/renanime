---
export const prerender = false;
const isEnglish = /^\/en(?:\/|$)/.test(Astro.url.pathname);
---
<!doctype html>
<html lang={isEnglish ? "en" : "es"}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#09090d" />
    <title>{isEnglish ? "Renanime 2.0 — Updates in progress" : "Renanime 2.0 — Actualizaciones en curso"}</title>
    <meta
      name="description"
      content={isEnglish
        ? "I'm working on Renanime 2.0. New updates are on the way. Sorry for the inconvenience."
        : "Estoy trabajando en Renanime 2.0. Nuevas actualizaciones en camino. Disculpa las molestias."}
    />
  </head>
  <body>
    <main class="maintenance">
      <div class="glow glow-one" aria-hidden="true"></div>
      <div class="glow glow-two" aria-hidden="true"></div>
      <section class="content" aria-labelledby="maintenance-title">
        <div class="brand" aria-label="Renanime">
          <span class="brand-ren">Ren</span><span class="brand-anime">anime</span>
        </div>
        <div class="status">
          <span class="status-dot" aria-hidden="true"></span>
          {isEnglish ? "UPDATING THE UNIVERSE" : "ACTUALIZANDO EL UNIVERSO"}
        </div>
        <div class="symbol" aria-hidden="true">
          <svg viewBox="0 0 120 120" fill="none">
            <path d="M60 12 70.5 43.5 102 33 81 60 108 81 75 79.5 60 110 45 79.5 12 81 39 60 18 33 49.5 43.5 60 12Z" />
            <circle cx="60" cy="60" r="15" />
          </svg>
        </div>
        <p class="eyebrow">{isEnglish ? "A NEW CHAPTER IS LOADING" : "SE ESTÁ CARGANDO UN NUEVO CAPÍTULO"}</p>
        <h1 id="maintenance-title">
          {isEnglish ? "Renanime" : "Renanime"} <span>2.0</span>
        </h1>
        <p class="message">
          {isEnglish
            ? "I'm working on Renanime 2.0."
            : "Estoy trabajando en Renanime 2.0."}
        </p>
        <p class="submessage">
          {isEnglish
            ? "New updates are on the way."
            : "Nuevas actualizaciones en camino."}
        </p>
        <div class="divider" aria-hidden="true"><span></span></div>
        <p class="apology">
          {isEnglish ? "Sorry for the inconvenience." : "Disculpa las molestias."}
        </p>
        <p class="signature">{isEnglish ? "See you soon, nakama." : "Nos vemos pronto, nakama."}</p>
      </section>
      <footer>RENANIME'S GALLERY <span>·</span> 2.0</footer>
    </main>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(html) { min-height: 100%; background: #09090d; }
  :global(body) { margin: 0; min-height: 100vh; color: #f7f5fa; font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
  .maintenance { position: relative; display: grid; min-height: 100vh; place-items: center; overflow: hidden; padding: 48px 24px 72px; isolation: isolate; background: radial-gradient(ellipse at 50% 44%, #21101d 0%, #111016 42%, #09090d 78%); }
  .content { position: relative; z-index: 1; width: min(100%, 650px); text-align: center; animation: enter .7s ease-out both; }
  .brand { margin-bottom: 58px; font-size: 1.65rem; font-weight: 800; letter-spacing: -.075em; }
  .brand-ren { color: #ff4f8b; }
  .brand-anime { color: #fff; }
  .status { display: inline-flex; align-items: center; gap: 9px; padding: 9px 13px; border: 1px solid rgba(255,79,139,.22); border-radius: 999px; background: rgba(255,79,139,.07); color: #ff9abd; font-size: .68rem; font-weight: 700; letter-spacing: .16em; }
  .status-dot { width: 7px; height: 7px; border-radius: 50%; background: #ff4f8b; box-shadow: 0 0 14px #ff4f8b; animation: pulse 1.8s ease-in-out infinite; }
  .symbol { display: grid; width: 84px; height: 84px; place-items: center; margin: 35px auto 27px; border: 1px solid rgba(255,79,139,.2); border-radius: 26px; background: rgba(255,255,255,.025); transform: rotate(-7deg); }
  .symbol svg { width: 57px; stroke: #ff4f8b; stroke-width: 2; stroke-linejoin: round; }
  .symbol svg path { fill: rgba(255,79,139,.1); }
  .symbol svg circle { fill: #ff4f8b; stroke: #ff4f8b; }
  .eyebrow { margin: 0 0 13px; color: #a9a2b2; font-size: .7rem; font-weight: 700; letter-spacing: .2em; }
  h1 { margin: 0; font-size: clamp(3.4rem, 11vw, 6.6rem); font-weight: 850; letter-spacing: -.085em; line-height: .98; }
  h1 span { color: #ff4f8b; }
  .message { margin: 27px 0 7px; font-size: clamp(1.05rem, 3vw, 1.3rem); font-weight: 600; }
  .submessage { margin: 0; color: #c0b9c7; font-size: clamp(.95rem, 2.6vw, 1.1rem); }
  .divider { display: flex; justify-content: center; margin: 29px 0 22px; }
  .divider span { width: 44px; height: 2px; border-radius: 2px; background: #ff4f8b; }
  .apology { margin: 0; color: #ded9e3; font-size: .95rem; }
  .signature { margin: 19px 0 0; color: #8c8494; font-size: .83rem; }
  footer { position: absolute; bottom: 27px; left: 16px; right: 16px; color: #696270; font-size: .65rem; font-weight: 700; letter-spacing: .2em; text-align: center; }
  footer span { padding: 0 5px; color: #ff4f8b; }
  .glow { position: absolute; z-index: -1; width: 360px; height: 360px; border-radius: 50%; filter: blur(100px); opacity: .13; pointer-events: none; }
  .glow-one { top: -210px; left: -160px; background: #ff4f8b; }
  .glow-two { right: -210px; bottom: -210px; background: #6e42b8; }
  @keyframes pulse { 50% { opacity: .45; } }
  @keyframes enter { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: translateY(0); } }
  @media (prefers-reduced-motion: reduce) { *, *::before, *::after { animation-duration: .01ms !important; animation-iteration-count: 1 !important; scroll-behavior: auto !important; } }
  @media (max-width: 480px) { .maintenance { padding: 34px 20px 66px; } .brand { margin-bottom: 45px; } .symbol { width: 72px; height: 72px; margin-top: 29px; } .symbol svg { width: 49px; } .status { font-size: .6rem; letter-spacing: .12em; } }
</style>
