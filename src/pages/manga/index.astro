---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/layout/Navbar.astro";
import { getMangaHome, demographicLabel, type MangaDemographic } from "../../lib/manga";
import { localizedPath } from "../../i18n";

export const prerender = false;
const { lang } = Astro.locals;
const isEnglish = lang === "en";
const url = new URL(Astro.request.url);
const search = url.searchParams.get("q")?.trim() ?? "";
const rawDemographic = url.searchParams.get("demographic")?.toUpperCase() ?? "";
const allowed = ["SHOUNEN", "SEINEN", "SHOUJO", "JOSEI"];
const demographic = allowed.includes(rawDemographic) ? rawDemographic as MangaDemographic : null;
const unclassified = url.searchParams.get("unclassified") === "1";
const data = await getMangaHome({ search, demographic, unclassified });
const basePath = localizedPath(lang, "/manga/");
const detailPath = (id: number) => localizedPath(lang, `/manga/${id}/`);
const coverAlt = (title: string) => isEnglish ? `${title} cover` : `Portada de ${title}`;
const statusLabel = (status: string | null) => {
  const labels: Record<string, { es: string; en: string }> = {
    FINISHED: { es: "Finalizado", en: "Finished" }, RELEASING: { es: "En publicación", en: "Releasing" },
    NOT_YET_RELEASED: { es: "Próximamente", en: "Upcoming" }, HIATUS: { es: "En pausa", en: "Hiatus" },
    CANCELLED: { es: "Cancelado", en: "Cancelled" },
  };
  return status ? labels[status]?.[lang] ?? status : null;
};
const categories: { id: MangaDemographic; label: string; count: number }[] = [
  { id: "SHOUNEN", label: "Shonen", count: data.counts.SHOUNEN },
  { id: "SEINEN", label: "Seinen", count: data.counts.SEINEN },
  { id: "SHOUJO", label: "Shojo", count: data.counts.SHOUJO },
  { id: "JOSEI", label: "Josei", count: data.counts.JOSEI },
];
const queryFor = (next: { q?: string; demographic?: MangaDemographic | null }) => {
  const params = new URLSearchParams();
  const nextSearch = next.q ?? search;
  const nextDemo = next.demographic === undefined ? demographic : next.demographic;
  if (nextSearch) params.set("q", nextSearch);
  if (nextDemo) params.set("demographic", nextDemo.toLowerCase());
  return `${basePath}${params.size ? `?${params.toString()}` : ""}`;
};
const unclassifiedPath = `${basePath}?${search ? `q=${encodeURIComponent(search)}&` : ""}unclassified=1`;
---
<Layout title="Manga — Renanime" description={isEnglish ? "Discover manga, explore demographics and find your next read." : "Descubre manga, explora demografías y encuentra tu próxima lectura."}>
  <Navbar />
  <main id="main-content" class="manga-home">
    <header class="manga-intro">
      <div><p class="manga-overline">{isEnglish ? "THE MANGA LIBRARY" : "LA BIBLIOTECA MANGA"}</p><h1>Manga<span>.</span></h1></div>
      <form class="manga-search" action={basePath} method="get" role="search">
        <label class="sr-only" for="manga-query">{isEnglish ? "Search manga" : "Buscar manga"}</label>
        <input id="manga-query" type="search" name="q" value={search} placeholder={isEnglish ? "Search by title..." : "Buscar por título..."} />
        {demographic && <input type="hidden" name="demographic" value={demographic.toLowerCase()} />}
        <button type="submit">{isEnglish ? "Search" : "Buscar"}</button>
      </form>
    </header>
    <nav class="demographic-nav" aria-label={isEnglish ? "Manga demographics" : "Demografías del manga"}>
      <a class:list={["demographic-link", !demographic && !unclassified && "is-current"]} href={queryFor({ demographic: null })}>{isEnglish ? "All" : "Todos"}</a>
      {categories.map((category) => <a class:list={["demographic-link", demographic === category.id && "is-current"]} href={queryFor({ demographic: category.id })}>{category.label}</a>)}
    </nav>
    {(search || demographic) && <p class="results-caption">{isEnglish ? "Results" : "Resultados"}{search ? ` · “${search}”` : ""}{demographic ? ` · ${demographicLabel(demographic, lang)}` : ""}</p>}
    {data.featured && <section class="manga-section featured-section" aria-labelledby="weekly-title">
      <header class="section-heading"><div><h2 id="weekly-title">{isEnglish ? "Pick of the week" : "Selección de la semana"}</h2></div></header>
      <a class="weekly-feature" href={detailPath(data.featured.id)}>
        <div class="weekly-cover-wrap">
          {data.featured.cover ? <img class="weekly-cover" src={data.featured.cover} alt={coverAlt(data.featured.title)} width="320" height="480" fetchpriority="high" /> : <div class="cover-placeholder"><span>{data.featured.title}</span></div>}
          <span class="book-shelf" aria-hidden="true"></span>
        </div>
        <div class="weekly-copy">
          <h3>{data.featured.title}</h3>
          {data.featured.nativeTitle && data.featured.nativeTitle !== data.featured.title && <p class="native-title">{data.featured.nativeTitle}</p>}
          {data.featured.author && <p class="byline">{isEnglish ? "by" : "por"} {data.featured.author}</p>}
          <p class="book-meta">{data.featured.volumes ? `${data.featured.volumes} ${isEnglish ? "volumes" : "tomos"}` : ""}{data.featured.volumes && statusLabel(data.featured.status) ? " · " : ""}{statusLabel(data.featured.status)}</p>
          {data.featured.synopsis && <p class="weekly-synopsis">{data.featured.synopsis}</p>}
          <span class="text-link">{isEnglish ? "View details" : "Ver ficha"}</span>
        </div>
      </a>
    </section>}
    {data.arrivals.length > 0 && <section class="manga-section" aria-labelledby="arrivals-title">
      <header class="section-heading"><div><h2 id="arrivals-title">{isEnglish ? "New arrivals" : "Recién llegados"}</h2></div></header>
      <div class="arrival-grid">
        {data.arrivals.map((manga) => <a class="arrival-item" href={detailPath(manga.id)}>
          <div class="arrival-cover-wrap">
            {manga.cover ? <img src={manga.cover} alt={coverAlt(manga.title)} loading="lazy" width="220" height="330" /> : <div class="cover-placeholder"><span>{manga.title}</span></div>}
            <span class="book-shelf" aria-hidden="true"></span>
          </div>
          <h3>{manga.title}</h3>
          {manga.author && <p class="arrival-author">{manga.author}</p>}
          {manga.volumes && <p class="arrival-volumes">{manga.volumes} {isEnglish ? "vol." : "tomos"}</p>}
        </a>)}
      </div>
    </section>}
    {data.popular.length > 0 && <section class="manga-section" aria-labelledby="popular-title">
      <header class="section-heading"><div><h2 id="popular-title">{isEnglish ? "Most read" : "Los más leídos"}</h2></div></header>
      <ol class="popular-list">
        {data.popular.map((manga, index) => <li>
          <span class="rank-number">{String(index + 1).padStart(2, "0")}</span>
          <a class="popular-entry" href={detailPath(manga.id)}>
            {manga.cover ? <img src={manga.cover} alt="" loading="lazy" width="64" height="96" /> : <span class="rank-placeholder"></span>}
            <span class="popular-info"><strong>{manga.title}</strong>{manga.author && <span>{manga.author}</span>}</span>
            <span class="popular-meta">{manga.volumes ? `${manga.volumes} ${isEnglish ? "vol." : "tomos"}` : "—"}</span>
          </a>
        </li>)}
      </ol>
    </section>}
    <section class="manga-section demographic-section" aria-labelledby="demographics-title">
      <header class="section-heading"><div><h2 id="demographics-title">{isEnglish ? "Explore by demographic" : "Por demografía"}</h2></div></header>
      <div class="demographic-index">
        {categories.map((category) => <a href={queryFor({ demographic: category.id })}><span>{category.label}</span><span class="demographic-count">{category.count.toLocaleString(isEnglish ? "en" : "es")}</span></a>)}
        <a href={unclassifiedPath}><span>{isEnglish ? "Unclassified" : "Sin demografía"}</span><span class="demographic-count">{data.counts.UNKNOWN.toLocaleString(isEnglish ? "en" : "es")}</span></a>
      </div>
    </section>
  </main>
</Layout>
<style>
@import url('https://fonts.googleapis.com/css2?family=Newsreader:opsz,wght@6..72,400;6..72,500;6..72,600;6..72,700&display=swap');
.manga-home{width:min(calc(100% - 32px),1080px);margin:0 auto;padding:clamp(6rem,12vw,9rem) 0 6rem;color:#f2efe9}
.manga-intro{display:flex;align-items:end;justify-content:space-between;gap:2rem;padding-bottom:2rem}
.manga-overline{margin:0 0 .65rem;color:#92929f;font-size:.65rem;letter-spacing:.13em}
.manga-intro h1{margin:0;font-size:clamp(3.5rem,10vw,6.5rem);font-weight:500;letter-spacing:-.075em;line-height:.88}
.manga-intro h1 span{color:#ec4899}
.manga-search{display:flex;width:min(100%,390px);border-bottom:1px solid rgba(242,239,233,.35)}
.manga-search input{min-width:0;flex:1;padding:.9rem .2rem;border:0;outline:0;background:transparent;color:#f2efe9;font-size:.9rem}
.manga-search input::placeholder{color:#77747d}.manga-search button{padding:0 .2rem 0 1rem;border:0;background:transparent;color:#f2efe9;font-size:.8rem;cursor:pointer}
.demographic-nav{display:flex;gap:clamp(1.2rem,4vw,2.8rem);overflow-x:auto;border-bottom:1px solid rgba(242,239,233,.13);scrollbar-width:none}.demographic-nav::-webkit-scrollbar{display:none}
.demographic-link{position:relative;flex:0 0 auto;padding:1rem 0;color:#92929f;font-size:.82rem}.demographic-link.is-current{color:#f2efe9}.demographic-link.is-current:after{position:absolute;right:0;bottom:-1px;left:0;height:2px;background:#ec4899;content:""}
.results-caption{margin:1.4rem 0 0;color:#92929f;font-size:.8rem}
.manga-section{margin-top:clamp(3.5rem,8vw,6rem)}.featured-section{margin-top:2.8rem}
.section-heading{display:flex;align-items:baseline;justify-content:space-between;margin-bottom:1.5rem}.section-heading h2{margin:0;font-size:clamp(1.65rem,4vw,2.25rem);font-weight:500;letter-spacing:-.045em}
.weekly-feature{display:grid;grid-template-columns:minmax(145px,250px) minmax(0,1fr);gap:clamp(1.25rem,4vw,3rem);align-items:center;color:inherit}
.weekly-cover-wrap,.arrival-cover-wrap{position:relative;padding-bottom:7px}.weekly-cover,.arrival-cover-wrap img{display:block;width:100%;aspect-ratio:2/3;object-fit:cover;background:#17171d}
.book-shelf{position:absolute;right:0;bottom:0;left:0;height:7px;background:linear-gradient(180deg,#6d6b68,#28272a);box-shadow:0 5px 9px rgba(0,0,0,.35)}
.weekly-copy h3{margin:0;font-family:"Newsreader",Georgia,serif;font-size:clamp(2rem,5vw,3.8rem);font-weight:500;line-height:.98;letter-spacing:-.035em}
.native-title{margin:.55rem 0 0;color:#92929f;font-family:"Newsreader",Georgia,serif;font-size:1.1rem}.byline{margin:.85rem 0 0;color:#c6c1c7;font-size:.88rem}.book-meta{margin:.4rem 0 0;color:#92929f;font-size:.78rem}
.weekly-synopsis{display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:5;overflow:hidden;margin:1.2rem 0 0;color:#d0cbd0;font-family:"Newsreader",Georgia,serif;font-size:1.08rem;line-height:1.55}
.text-link{display:inline-block;margin-top:1.25rem;color:#ec4899;font-size:.86rem;font-weight:600}
.cover-placeholder{display:flex;align-items:end;aspect-ratio:2/3;padding:1rem;background:#202027;color:#f2efe9;font-family:"Newsreader",Georgia,serif;font-size:1.4rem;line-height:1.05}
.arrival-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:clamp(.8rem,2.4vw,1.6rem)}.arrival-item{min-width:0;color:inherit}
.arrival-item h3{margin:.85rem 0 .2rem;font-family:"Newsreader",Georgia,serif;font-size:clamp(1rem,2vw,1.25rem);font-weight:500;line-height:1.15}
.arrival-author,.arrival-volumes{margin:.25rem 0 0;color:#92929f;font-size:.74rem;line-height:1.35}.arrival-volumes{font-size:.7rem}
.popular-list{margin:0;padding:0;list-style:none;border-top:1px solid rgba(242,239,233,.13)}.popular-list li{display:grid;grid-template-columns:3.6rem minmax(0,1fr);align-items:center;border-bottom:1px solid rgba(242,239,233,.13)}
.rank-number{color:#77747d;font-family:"Newsreader",Georgia,serif;font-size:2.4rem;line-height:1}
.popular-entry{display:flex;align-items:center;gap:1rem;min-width:0;padding:.8rem 0;color:inherit}.popular-entry img,.rank-placeholder{width:48px;height:72px;object-fit:cover;background:#202027;flex:0 0 auto}
.popular-info{display:flex;flex:1;min-width:0;flex-direction:column;gap:.25rem}.popular-info strong{overflow:hidden;text-overflow:ellipsis;font-family:"Newsreader",Georgia,serif;font-size:1.15rem;font-weight:500}
.popular-info>span,.popular-meta{color:#92929f;font-size:.72rem}.popular-meta{flex:0 0 auto}
.demographic-index{border-top:1px solid rgba(242,239,233,.13)}.demographic-index a{display:flex;justify-content:space-between;align-items:center;padding:1rem 0;border-bottom:1px solid rgba(242,239,233,.13);color:#f2efe9;font-family:"Newsreader",Georgia,serif;font-size:1.35rem}
.demographic-count{color:#92929f;font-family:Inter,Arial,sans-serif;font-size:.75rem;font-variant-numeric:tabular-nums}
@media(max-width:600px){.manga-home{width:calc(100% - 28px);padding-top:6.2rem}.manga-intro{align-items:stretch;flex-direction:column;gap:1.5rem}.manga-search{width:100%}
.weekly-feature{grid-template-columns:124px minmax(0,1fr);gap:1rem;align-items:start}.weekly-copy h3{font-size:1.8rem}.native-title{font-size:.95rem}.byline{margin-top:.55rem;font-size:.78rem}.book-meta{font-size:.7rem}
.weekly-synopsis{margin-top:.8rem;font-size:.96rem;line-height:1.42;-webkit-line-clamp:5}.text-link{margin-top:.85rem;font-size:.8rem}
.arrival-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:1.7rem 1rem}.arrival-item h3{font-size:1.12rem}.popular-list li{grid-template-columns:2.8rem minmax(0,1fr)}.rank-number{font-size:2rem}.popular-entry{gap:.75rem}.popular-info strong{font-size:1.05rem}.popular-meta{font-size:.65rem}}
</style>
