---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/layout/Navbar.astro";
import { getMangaById, demographicLabel } from "../../lib/manga";
import { localizedPath } from "../../i18n";

export const prerender = false;
const { lang } = Astro.locals;
const isEnglish = lang === "en";
const id = Number(Astro.params.id);
const manga = await getMangaById(id);
const backPath = localizedPath(lang, "/manga/");
const statusLabels: Record<string, { es: string; en: string }> = {
  FINISHED: { es: "Finalizado", en: "Finished" },
  RELEASING: { es: "En publicación", en: "Releasing" },
  NOT_YET_RELEASED: { es: "Próximamente", en: "Upcoming" },
  HIATUS: { es: "En pausa", en: "Hiatus" },
  CANCELLED: { es: "Cancelado", en: "Cancelled" },
};
const status = manga?.status ? statusLabels[manga.status]?.[lang] ?? manga.status : null;
const volumeCount = manga?.volumes ? Array.from({ length: manga.volumes }, (_, index) => index + 1) : [];
const title = manga?.title ?? (isEnglish ? "Manga not found" : "Manga no encontrado");
---
<Layout title={`${title} — Renanime`} description={manga?.synopsis ?? (isEnglish ? "Manga details on Renanime." : "Ficha de manga en Renanime.")}>
  <Navbar />
  <main id="main-content" class="manga-detail">
    {manga ? <>
      <a class="back-link" href={backPath}>{isEnglish ? "Manga library" : "Biblioteca manga"}</a>
      <section class="manga-overview" aria-labelledby="manga-title">
        <div class="detail-cover-column">
          <div class="detail-cover-wrap">
            {manga.cover ? <img class="detail-cover" src={manga.cover} alt={isEnglish ? `${manga.title} cover` : `Portada de ${manga.title}`} width="420" height="630" fetchpriority="high" /> : <div class="detail-placeholder"><span>{manga.title}</span></div>}
            <span class="book-shelf" aria-hidden="true"></span>
          </div>
        </div>
        <div class="detail-copy">
          <p class="detail-overline">{isEnglish ? "MANGA ARCHIVE" : "ARCHIVO MANGA"}</p>
          <h1 id="manga-title">{manga.title}</h1>
          {manga.nativeTitle && manga.nativeTitle !== manga.title && <p class="original-title">{manga.nativeTitle}</p>}
          {manga.author && <p class="detail-author">{isEnglish ? "Story by" : "Historia de"} <strong>{manga.author}</strong></p>}
          <div class="detail-facts" aria-label={isEnglish ? "Manga information" : "Información del manga"}>
            <div><span>{isEnglish ? "Volumes" : "Tomos"}</span><strong>{manga.volumes ?? "—"}</strong></div>
            <div><span>{isEnglish ? "Chapters" : "Capítulos"}</span><strong>{manga.chapters ?? "—"}</strong></div>
            <div><span>{isEnglish ? "Status" : "Estado"}</span><strong>{status ?? "—"}</strong></div>
            <div><span>{isEnglish ? "Year" : "Año"}</span><strong>{manga.year ?? "—"}</strong></div>
          </div>
        </div>
      </section>

      {manga.synopsis && <section class="detail-section synopsis-section" aria-labelledby="synopsis-heading">
        <h2 id="synopsis-heading">{isEnglish ? "Synopsis" : "Sinopsis"}</h2>
        <p class="synopsis-text">{manga.synopsis}</p>
      </section>}

      {manga.genres.length > 0 && <p class="genre-line" aria-label={isEnglish ? "Genres" : "Géneros"}>{manga.genres.map((genre, index) => <span>{index > 0 && <span class="genre-separator"> · </span>}{genre}</span>)}</p>}

      {volumeCount.length > 0 && <section class="detail-section volumes-section" aria-labelledby="volumes-heading">
        <header class="section-heading"><h2 id="volumes-heading">{isEnglish ? "Volumes" : "Tomos"}</h2><span>{manga.volumes} {isEnglish ? "volumes" : "tomos"}</span></header>
        <div class="volume-track">
          {volumeCount.map((volume) => <div class="volume-item">
            <div class="volume-cover-wrap">
              {manga.cover ? <img src={manga.cover} alt="" loading="lazy" width="150" height="225" /> : <div class="volume-placeholder"></div>}
              <span class="volume-number">{volume}</span>
              <span class="volume-shelf" aria-hidden="true"></span>
            </div>
            <span class="volume-caption">{isEnglish ? "Volume" : "Tomo"} {volume}</span>
          </div>)}
        </div>
      </section>}
    </> : <section class="not-found">
      <p class="detail-overline">404 · {isEnglish ? "MANGA ARCHIVE" : "ARCHIVO MANGA"}</p>
      <h1>{isEnglish ? "Manga not found." : "Manga no encontrado."}</h1>
      <p>{isEnglish ? "This title is not available on AniList." : "Este título no está disponible en AniList."}</p>
      <a class="text-link" href={backPath}>{isEnglish ? "Back to manga" : "Volver al manga"}</a>
    </section>}
  </main>
</Layout>
<style>
@import url('https://fonts.googleapis.com/css2?family=Newsreader:opsz,wght@6..72,400;6..72,500;6..72,600;6..72,700&display=swap');
.manga-detail{width:min(calc(100% - 32px),980px);margin:0 auto;padding:clamp(6rem,12vw,9rem) 0 7rem;color:#f2efe9}
.back-link{display:inline-block;margin-bottom:2rem;color:#92929f;font-size:.78rem}.back-link:hover{color:#f2efe9}
.manga-overview{display:grid;grid-template-columns:minmax(170px,280px) minmax(0,1fr);gap:clamp(1.5rem,5vw,4rem);align-items:center}
.detail-cover-wrap{position:relative;padding-bottom:7px}.detail-cover{display:block;width:100%;aspect-ratio:2/3;object-fit:cover;background:#17171d}
.book-shelf{position:absolute;right:0;bottom:0;left:0;height:7px;background:linear-gradient(180deg,#6d6b68,#28272a);box-shadow:0 5px 9px rgba(0,0,0,.35)}
.detail-placeholder{display:flex;align-items:end;aspect-ratio:2/3;padding:1.2rem;background:#202027;font-family:"Newsreader",Georgia,serif;font-size:1.8rem;line-height:1.05}
.detail-overline{margin:0 0 .85rem;color:#92929f;font-size:.65rem;letter-spacing:.14em}
.detail-copy h1,.not-found h1{margin:0;font-family:"Newsreader",Georgia,serif;font-size:clamp(2.5rem,6vw,5rem);font-weight:500;line-height:.98;letter-spacing:-.04em}
.original-title{margin:.8rem 0 0;color:#92929f;font-family:"Newsreader",Georgia,serif;font-size:1.2rem}
.detail-author{margin:1.15rem 0 0;color:#aaa6ae;font-size:.84rem}.detail-author strong{color:#f2efe9;font-weight:500}
.detail-facts{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:.5rem;margin-top:2.3rem;padding:1.1rem 0;border-top:1px solid rgba(242,239,233,.15);border-bottom:1px solid rgba(242,239,233,.15)}
.detail-facts div{display:flex;min-width:0;flex-direction:column;gap:.55rem}.detail-facts span{color:#92929f;font-size:.68rem}.detail-facts strong{overflow-wrap:anywhere;color:#f2efe9;font-size:.83rem;font-weight:500}
.detail-section{margin-top:clamp(3rem,7vw,5rem)}.detail-section h2{margin:0;font-size:1.5rem;font-weight:500;letter-spacing:-.035em}
.synopsis-text{max-width:760px;margin:1rem 0 0;color:#d0cbd0;font-family:"Newsreader",Georgia,serif;font-size:clamp(1.1rem,2vw,1.35rem);line-height:1.65}
.synopsis-text:first-letter{float:left;margin:.08em .12em 0 0;color:#ec4899;font-family:"Newsreader",Georgia,serif;font-size:3.7em;line-height:.78}
.genre-line{display:flex;flex-wrap:wrap;gap:0;margin:1.7rem 0 0;color:#b0abb4;font-size:.78rem}.genre-separator{padding:0 .45rem;color:#62606a}
.section-heading{display:flex;align-items:baseline;justify-content:space-between;padding-bottom:1rem;border-bottom:1px solid rgba(242,239,233,.15)}.section-heading span{color:#92929f;font-size:.75rem}
.volume-track{display:flex;gap:1rem;overflow-x:auto;padding:1.4rem 0 1rem;scrollbar-width:thin;scrollbar-color:#444 transparent}
.volume-item{flex:0 0 112px;min-width:0}.volume-cover-wrap{position:relative;padding-bottom:7px}
.volume-cover-wrap img,.volume-placeholder{display:block;width:100%;aspect-ratio:2/3;object-fit:cover;background:#202027}
.volume-number{position:absolute;top:.45rem;left:.45rem;display:grid;width:1.65rem;height:1.65rem;place-items:center;border-radius:50%;background:rgba(9,9,11,.82);color:#fff;font-family:"Newsreader",Georgia,serif;font-size:.9rem}
.volume-shelf{position:absolute;right:0;bottom:0;left:0;height:7px;background:linear-gradient(180deg,#6d6b68,#28272a);box-shadow:0 4px 7px rgba(0,0,0,.3)}
.volume-caption{display:block;margin-top:.55rem;color:#92929f;font-size:.7rem}
.not-found{padding:5rem 0;text-align:center}.not-found>p:not(.detail-overline){color:#92929f}.text-link{display:inline-block;margin-top:1rem;color:#ec4899;font-size:.86rem}
@media(max-width:600px){.manga-detail{width:calc(100% - 28px);padding-top:6.2rem}.manga-overview{grid-template-columns:124px minmax(0,1fr);gap:1rem;align-items:start}.detail-overline{margin-bottom:.6rem;font-size:.58rem}.detail-copy h1{font-size:clamp(1.9rem,8vw,2.7rem)}.original-title{margin-top:.55rem;font-size:.95rem}.detail-author{margin-top:.7rem;font-size:.75rem}
.detail-facts{grid-template-columns:repeat(2,minmax(0,1fr));gap:.85rem .5rem;margin-top:1.3rem;padding:.9rem 0}.detail-facts div{gap:.25rem}.detail-facts span{font-size:.62rem}.detail-facts strong{font-size:.72rem}
.synopsis-text{font-size:1.08rem;line-height:1.55}.synopsis-text:first-letter{font-size:3.1em}.volume-item{flex-basis:96px}}
</style>
