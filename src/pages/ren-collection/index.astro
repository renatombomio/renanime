---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/layout/Navbar.astro";
import Footer from "../../components/layout/Footer.astro";
import SectionHeader from "../../components/ui/SectionHeader.astro";
import RenCollectionGallery from "../../components/archive/RenCollectionGallery";
import { getWatchedLibrary } from "../../data/library";

const collectionEntries = getWatchedLibrary();
---

<Layout title="Colección de Ren — Renanime's Gallery">
  <Navbar />

  <main id="main-content" class="ren-collection-page">
    <div class="ren-collection-header">
      <SectionHeader
        eyebrow={`Archivo de Ren · ${collectionEntries.length} animes vistos`}
        variant="ren"
        title="Colección de Ren"
        description="Historias terminadas, descubrimientos y años de obsesión."
      />
      <div class="ren-collection-stat" aria-label={`${collectionEntries.length} animes en la colección`}>
        <strong>{String(collectionEntries.length).padStart(3, "0")}</strong>
        <span>títulos vistos</span>
      </div>
    </div>

    <section class="ren-collection-content" aria-label="Colección de Ren">
      <RenCollectionGallery entries={collectionEntries} client:load />
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .ren-collection-page {
    min-height: 70vh;
    padding-block: clamp(6rem, 11vw, 10rem) var(--section-space);
  }

  .ren-collection-header,
  .ren-collection-content {
    width: min(calc(100% - (var(--gutter) * 2)), var(--container-max));
    margin-inline: auto;
  }

  .ren-collection-header {
    position: relative;
    margin-bottom: clamp(4.5rem, 9vw, 8rem);
  }


  @media (max-width: 700px) {
    .ren-collection-page { padding-top: 5rem; }
    .ren-collection-header { margin-bottom: 4rem; }
  }
</style>