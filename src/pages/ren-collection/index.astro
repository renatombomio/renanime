---
import Layout from "../../layouts/Layout.astro";
import { useT } from "../../i18n";
import Navbar from "../../components/layout/Navbar.astro";
import Footer from "../../components/layout/Footer.astro";
import SectionHeader from "../../components/ui/SectionHeader.astro";
import RenCollectionGallery from "../../components/archive/RenCollectionGallery";
import { getWatchedLibrary } from "../../data/library";

const collectionEntries = getWatchedLibrary();
const lang = Astro.locals.lang;
const t = useT(lang);
const description = lang === "en"
  ? `${collectionEntries.length} anime watched · Finished stories, discoveries, and years of obsession.`
  : `${collectionEntries.length} animes vistos · Historias terminadas, descubrimientos y años de obsesión.`;
---

<Layout title={`${t("renCollection.pageTitle")} — Renanime's Gallery`} description={description}>
  <Navbar />

  <main id="main-content" class="ren-collection-page">
    <div class="ren-collection-header">
      <SectionHeader
        variant="ren"
        title={t("renCollection.heading")}
        description={description}
      />
    </div>

    <section class="ren-collection-content" aria-label={lang === "en" ? "Ren's anime collection" : "Colección de Ren"}>
      <RenCollectionGallery entries={collectionEntries} lang={lang} client:load />
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .ren-collection-page {
    min-height: 70vh;
    padding-block: clamp(6rem, 11vw, 10rem) var(--section-space);
  }

  .ren-collection-header,
  .ren-collection-content {
    width: min(calc(100% - (var(--gutter) * 2)), var(--container-max));
    margin-inline: auto;
  }

  .ren-collection-header {
    position: relative;
    margin-bottom: clamp(4.5rem, 9vw, 8rem);
  }

  @media (max-width: 700px) {
    .ren-collection-page { padding-top: 5rem; }
    .ren-collection-header { margin-bottom: 4rem; }
  }
</style>
