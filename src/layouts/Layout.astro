---
interface Props {
  title?: string;
  description?: string;
}

const { lang, basePath } = Astro.locals;
const {
  title = "Renanime's Gallery",
  description = lang === "en" ? "Personal anime gallery." : "Galería personal de anime."
} = Astro.props;
const isGhibli = basePath.startsWith("/ghibli");
const isAuth = basePath === "/login" || basePath === "/login/";
const isAuthenticated = Boolean(Astro.locals.renanimeUser);

import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import SoundtrackPlayer from "../components/audio/SoundtrackPlayer";
import Analytics from '@vercel/analytics/astro';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content={isGhibli ? "#FFF7E8" : "#090909"} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <ClientRouter />
    <title>{title}</title>
  </head>

  <body class:list={["texture-grain", isGhibli && "theme-ghibli"]} data-authenticated={isAuthenticated ? "true" : "false"}>
    <a class="skip-link" href="#main-content">{lang === "en" ? "Skip to content" : "Saltar al contenido"}</a>
    <slot />
    <Analytics />
    {!isAuth && <SoundtrackPlayer client:load transition:persist lang={lang} />}
  </body>
</html>

<style>
  :global(body.theme-ghibli) {
    background: #FFF7E8;
    color: #19362F;
  }

  :global(body.theme-ghibli .site-footer) {
    background: #fff;
  }

  :global(body.theme-ghibli .site-header) {
    background: rgba(255,255,255,.94);
    border-bottom-color: rgba(25,54,47,.12);
  }

  .skip-link {
    position: fixed;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 999;
    padding: 0.65rem 0.8rem;
    background: var(--color-paper-50);
    color: var(--color-ink-950);
    font: var(--text-xs)/1 var(--font-mono);
    transform: translateY(-150%);
    transition: transform var(--duration-fast) var(--ease-out);
  }

  .skip-link:focus {
    transform: translateY(0);
  }
</style>

<script>
  let renanimePresenceTimer: number | undefined;
  const sendPresenceHeartbeat = async () => {
    if (document.body.dataset.authenticated !== "true" || document.visibilityState !== "visible") return;
    try {
      const response = await fetch("/api/auth/presence", {
        method: "POST",
        credentials: "same-origin",
        headers: { "Content-Type": "application/json" },
        body: "{}",
      });
      if (response.ok) {
        const status = document.querySelector<HTMLElement>("#profile-presence");
        if (status) status.hidden = false;
      }
    } catch {
      // Presence is best-effort and must never block page rendering.
    }
  };
  const startRenanimePresence = () => {
    if (renanimePresenceTimer) window.clearInterval(renanimePresenceTimer);
    void sendPresenceHeartbeat();
    renanimePresenceTimer = window.setInterval(sendPresenceHeartbeat, 45_000);
  };
  document.addEventListener("astro:page-load", startRenanimePresence);
  document.addEventListener("visibilitychange", () => {
    if (document.visibilityState === "visible") void sendPresenceHeartbeat();
  });
  startRenanimePresence();
</script>
