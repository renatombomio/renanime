---
interface Props {
  title?: string;
  description?: string;
}

const { lang, basePath } = Astro.locals;
const {
  title = "Renanime's Gallery",
  description = lang === "en" ? "Personal anime gallery." : "Galería personal de anime."
} = Astro.props;
const isGhibli = basePath.startsWith("/ghibli");
const isAuth = basePath === "/login" || basePath === "/login/";
const isAuthenticated = Boolean(Astro.locals.renanimeUser);

import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import SoundtrackPlayer from "../components/audio/SoundtrackPlayer";
import Analytics from '@vercel/analytics/astro';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content={isGhibli ? "#FFF7E8" : "#09090b"} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <ClientRouter />
    <title>{title}</title>
  </head>

  <body class:list={[isGhibli && "theme-ghibli"]} data-authenticated={isAuthenticated ? "true" : "false"}>
    <a class="skip-link" href="#main-content">{lang === "en" ? "Skip to content" : "Saltar al contenido"}</a>
    <slot />
    <Analytics />
    {!isAuth && <SoundtrackPlayer client:load transition:persist lang={lang} />}
  </body>
</html>

<style>
  :global(body.theme-ghibli) {
    background: #FFF7E8;
    color: #19362F;
  }

  :global(body.theme-ghibli .site-footer) {
    background: #fff;
  }

  :global(body.theme-ghibli .site-header) {
    background: rgba(255,255,255,.94);
    border-bottom-color: rgba(25,54,47,.12);
  }

  .skip-link {
    position: fixed;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 999;
    padding: 0.65rem 0.8rem;
    background: var(--color-paper-50);
    color: var(--color-ink-950);
    font: var(--text-xs)/1 var(--font-mono);
    transform: translateY(-150%);
    transition: transform var(--duration-fast) var(--ease-out);
  }

  .skip-link:focus {
    transform: translateY(0);
  }
</style>

<script>
  let renanimePresenceTimer: number | undefined;
  const sendPresenceHeartbeat = async () => {
    if (document.body.dataset.authenticated !== "true" || document.visibilityState !== "visible") return;
    try {
      const response = await fetch("/api/auth/presence", {
        method: "POST",
        credentials: "same-origin",
        headers: { "Content-Type": "application/json" },
        body: "{}",
      });
      if (response.ok) {
        const status = document.querySelector<HTMLElement>("#profile-presence");
        if (status) status.hidden = false;
      }
    } catch {
      // Presence is best-effort and must never block page rendering.
    }
  };
  const startRenanimePresence = () => {
    if (renanimePresenceTimer) window.clearInterval(renanimePresenceTimer);
    void sendPresenceHeartbeat();
    renanimePresenceTimer = window.setInterval(sendPresenceHeartbeat, 45_000);
  };
  document.addEventListener("astro:page-load", startRenanimePresence);
  document.addEventListener("visibilitychange", () => {
    if (document.visibilityState === "visible") void sendPresenceHeartbeat();
  });
  startRenanimePresence();
</script>

<script>
  type SolarLocation = { latitude: number; longitude: number; savedAt: number };

  function solarEvent(date: Date, latitude: number, longitude: number, sunrise: boolean): Date | null {
    const rad = Math.PI / 180;
    const day = Math.floor((Date.UTC(date.getUTCFullYear(), date.getUTCMonth(), date.getUTCDate()) - Date.UTC(date.getUTCFullYear(), 0, 0)) / 86400000);
    const longitudeHour = longitude / 15;
    const approximate = day + ((sunrise ? 6 : 18) - longitudeHour) / 24;
    const meanAnomaly = 0.9856 * approximate - 3.289;
    let trueLongitude = meanAnomaly + 1.916 * Math.sin(meanAnomaly * rad) + 0.020 * Math.sin(2 * meanAnomaly * rad) + 282.634;
    trueLongitude = (trueLongitude + 360) % 360;
    let rightAscension = (Math.atan(0.91764 * Math.tan(trueLongitude * rad)) / rad + 360) % 360;
    rightAscension += Math.floor(trueLongitude / 90) * 90 - Math.floor(rightAscension / 90) * 90;
    rightAscension /= 15;
    const sinDeclination = 0.39782 * Math.sin(trueLongitude * rad);
    const cosDeclination = Math.cos(Math.asin(sinDeclination));
    const cosHourAngle = (Math.cos(90.833 * rad) - sinDeclination * Math.sin(latitude * rad)) / (cosDeclination * Math.cos(latitude * rad));
    if (cosHourAngle > 1 || cosHourAngle < -1) return null;
    const hourAngle = (sunrise ? 360 - Math.acos(cosHourAngle) / rad : Math.acos(cosHourAngle) / rad) / 15;
    const localMeanTime = hourAngle + rightAscension - 0.06571 * approximate - 6.622;
    const utcHours = (localMeanTime - longitudeHour + 24) % 24;
    const result = new Date(Date.UTC(date.getUTCFullYear(), date.getUTCMonth(), date.getUTCDate()) + utcHours * 3600000);
    return result;
  }

  function applySolarTheme(location: SolarLocation) {
    if (document.body.classList.contains("theme-ghibli")) {
      delete document.documentElement.dataset.timeTheme;
      delete document.body.dataset.timeTheme;
      const themeColor = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');
      if (themeColor) themeColor.content = "#FFF7E8";
      return;
    }
    const now = new Date();
    const sunrise = solarEvent(now, location.latitude, location.longitude, true);
    const sunset = solarEvent(now, location.latitude, location.longitude, false);
    const isDay = sunrise && sunset ? now >= sunrise && now < sunset : false;
    const theme = isDay ? "day" : "night";
    document.documentElement.dataset.timeTheme = theme;
    document.body.dataset.timeTheme = theme;
    const themeColor = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');
    if (themeColor) themeColor.content = isDay ? "#f5f3ef" : "#09090b";
  }

  async function initSolarTheme() {
    if (document.body.classList.contains("theme-ghibli")) {
      delete document.documentElement.dataset.timeTheme;
      delete document.body.dataset.timeTheme;
      return;
    }
    const key = "renanime-solar-location";
    let location: SolarLocation | null = null;
    try {
      const saved = localStorage.getItem(key);
      if (saved) location = JSON.parse(saved) as SolarLocation;
    } catch { /* Ignore unavailable or malformed local storage. */ }

    if (location && Number.isFinite(location.latitude) && Number.isFinite(location.longitude)) {
      applySolarTheme(location);
      if (Date.now() - location.savedAt < 30 * 86400000) return;
    }

    if (!("geolocation" in navigator)) return;
    navigator.geolocation.getCurrentPosition(
      (position) => {
        const next: SolarLocation = {
          latitude: position.coords.latitude,
          longitude: position.coords.longitude,
          savedAt: Date.now(),
        };
        try { localStorage.setItem(key, JSON.stringify(next)); } catch { /* Theme still works for this visit. */ }
        applySolarTheme(next);
      },
      () => {
        // If location is unavailable or permission is denied, retain the existing night theme.
      },
      { enableHighAccuracy: false, maximumAge: 86400000, timeout: 12000 },
    );
  }

  let solarThemeInterval: number | undefined;
  function startSolarTheme() {
    if (solarThemeInterval) window.clearInterval(solarThemeInterval);
    void initSolarTheme();
    solarThemeInterval = window.setInterval(() => {
      try {
        const saved = localStorage.getItem("renanime-solar-location");
        if (saved) applySolarTheme(JSON.parse(saved) as SolarLocation);
      } catch { /* Keep the current theme if location data is unavailable. */ }
    }, 60000);
  }
  document.addEventListener("astro:page-load", startSolarTheme);
  startSolarTheme();
</script>
