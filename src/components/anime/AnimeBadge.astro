---
interface Props {
  children: string;
  tone?: "default" | "accent";
}
const { children, tone = "default" } = Astro.props;
---
<span class:list={["badge", tone === "accent" && "is-accent"]}>{children}</span>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    min-height: 1.75rem;
    padding-inline: 0.55rem;
    border: 1px solid var(--color-border);
    background: rgba(9, 9, 9, 0.76);
    color: var(--color-paper-100);
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
    line-height: 1;
    backdrop-filter: blur(8px);
  }

  .badge.is-accent {
    border-color: rgba(164, 138, 104, 0.45);
    color: var(--color-accent-soft);
  }
</style>
