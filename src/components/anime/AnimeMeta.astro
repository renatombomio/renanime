---
interface Props { type?: string; year?: string | number; genres?: string[]; }
const { type, year, genres=[] } = Astro.props;
const items = [type, year, genres.length ? genres.slice(0,2).join(" · ") : undefined].filter(Boolean);
---
{items.length > 0 && <div class="anime-meta">{items.map((item,index)=><span class={year!==undefined&&item===year?"anime-year":undefined}>{item}</span>)}</div>}
<style>
.anime-meta{display:flex;flex-wrap:wrap;gap:.25rem .7rem;color:var(--color-muted-400);font:var(--text-xs)/1.4 var(--font-mono);letter-spacing:.01em}
.anime-meta span+span::before{content:"·";margin-right:.7rem;color:var(--color-muted-600)}
.anime-meta .anime-year{font-size:.62rem;font-weight:600;line-height:1}
@media(max-width:560px){.anime-meta .anime-year{font-size:.66rem}}
</style>