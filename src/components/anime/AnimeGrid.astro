---
interface Props {
  columns?: 2 | 3 | 4 | 5;
  gap?: "compact" | "default";
}
const { columns = 4, gap = "default" } = Astro.props;
---

<div class:list={["anime-grid", `columns-${columns}`, gap === "compact" && "is-compact"]}>
  <slot />
</div>

<style>
  .anime-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(2rem, 4vw, 4rem) clamp(1rem, 2.5vw, 2.5rem);
  }

  .anime-grid.columns-2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .anime-grid.columns-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .anime-grid.columns-4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .anime-grid.columns-5 { grid-template-columns: repeat(5, minmax(0, 1fr)); }

  .anime-grid.is-compact {
    gap: 1.5rem 1rem;
  }

  @media (max-width: 1000px) {
    .anime-grid.columns-4,
    .anime-grid.columns-5 {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 700px) {
    .anime-grid,
    .anime-grid.columns-2,
    .anime-grid.columns-3,
    .anime-grid.columns-4,
    .anime-grid.columns-5 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 420px) {
    .anime-grid,
    .anime-grid.columns-2,
    .anime-grid.columns-3,
    .anime-grid.columns-4,
    .anime-grid.columns-5 {
      grid-template-columns: 1fr;
    }
  }
</style>
