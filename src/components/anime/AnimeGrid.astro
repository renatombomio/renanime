---
interface Props { columns?:2|3|4|5; gap?:"compact"|"default"; }
const {columns=4,gap="default"}=Astro.props;
---
<div class:list={["anime-grid",`columns-${columns}`,gap==="compact"&&"is-compact"]}><slot/></div>
<style>
.anime-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:clamp(2rem,4vw,4rem) clamp(1rem,2.5vw,2.5rem)}
.anime-grid.columns-2{grid-template-columns:repeat(2,minmax(0,1fr))}.anime-grid.columns-3{grid-template-columns:repeat(3,minmax(0,1fr))}.anime-grid.columns-4{grid-template-columns:repeat(4,minmax(0,1fr))}.anime-grid.columns-5{grid-template-columns:repeat(5,minmax(0,1fr))}
.anime-grid.is-compact{gap:1.5rem 1rem}
@media(max-width:1000px){.anime-grid.columns-4,.anime-grid.columns-5{grid-template-columns:repeat(3,minmax(0,1fr))}}
@media(max-width:700px){.anime-grid,.anime-grid.columns-2,.anime-grid.columns-3,.anime-grid.columns-4,.anime-grid.columns-5{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:420px){.anime-grid,.anime-grid.columns-2,.anime-grid.columns-3,.anime-grid.columns-4,.anime-grid.columns-5{grid-template-columns:1fr}}


</style>
<script>
  import { gsap } from "gsap";

  const initAnimeGridMotion = () => {
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    document.querySelectorAll<HTMLElement>(".anime-grid").forEach((grid) => {
      if (grid.dataset.motionReady === "true") return;
      grid.dataset.motionReady = "true";

      const cards = Array.from(grid.querySelectorAll<HTMLElement>(".anime-card"));
      if (!cards.length) return;

      if (reduceMotion) {
        gsap.set(cards, { clearProps: "all" });
        return;
      }

      cards.forEach((card, index) => {
        gsap.set(card, { autoAlpha: 0, y: 22, scale: 0.985 });

        const reveal = () => {
          gsap.to(card, {
            autoAlpha: 1,
            y: 0,
            scale: 1,
            duration: 0.55,
            delay: Math.min(index * 0.055, 0.55),
            ease: "power3.out",
            overwrite: true,
          });
        };

        if ("IntersectionObserver" in window) {
          const observer = new IntersectionObserver((entries) => {
            if (!entries[0]?.isIntersecting) return;
            observer.disconnect();
            reveal();
          }, { threshold: 0.05, rootMargin: "0px 0px -6% 0px" });
          observer.observe(card);
        } else {
          reveal();
        }

        const link = card.querySelector<HTMLElement>(".card-link");
        const poster = card.querySelector<HTMLElement>(".poster-wrap");
        if (!link || !poster) return;

        const press = () => gsap.to(card, {
          scale: 0.985,
          duration: 0.12,
          ease: "power2.out",
          overwrite: true,
        });

        const release = () => gsap.to(card, {
          scale: 1,
          y: 0,
          duration: 0.38,
          ease: "power3.out",
          overwrite: true,
        });

        const enter = () => {
          if (!window.matchMedia("(hover: hover)").matches) return;
          gsap.to(card, { y: -4, scale: 1.012, duration: 0.3, ease: "power2.out", overwrite: true });
          gsap.to(poster, { scale: 1.025, duration: 0.5, ease: "power2.out", overwrite: true });
        };

        const leave = () => {
          if (!window.matchMedia("(hover: hover)").matches) return;
          gsap.to(card, { y: 0, scale: 1, duration: 0.38, ease: "power3.out", overwrite: true });
          gsap.to(poster, { scale: 1, duration: 0.5, ease: "power3.out", overwrite: true });
        };

        link.addEventListener("pointerdown", press);
        link.addEventListener("pointerup", release);
        link.addEventListener("pointercancel", release);
        link.addEventListener("pointerenter", enter);
        link.addEventListener("pointerleave", leave);
      });
    });
  };

  initAnimeGridMotion();
  document.addEventListener("astro:page-load", initAnimeGridMotion);
</script>