---
interface Props { score?: number | null; label?: string; }
const { score, label="Puntuación personal" } = Astro.props;
const valid = typeof score === "number" && Number.isFinite(score);
---
{valid && <span class="anime-rating" aria-label={`${label}: ${score} sobre 10`}><span aria-hidden="true">★</span>{score.toFixed(1)}</span>}
<style>
.anime-rating{display:inline-flex;align-items:center;gap:.3rem;color:var(--color-paper-200);font:var(--text-xs)/1 var(--font-mono);letter-spacing:.04em;white-space:nowrap}
.anime-rating span{color:var(--color-accent)}
</style>