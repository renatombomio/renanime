---
interface Props {
  src: string;
  alt: string;
  ratio?: "portrait" | "landscape";
}
const { src, alt, ratio = "portrait" } = Astro.props;
---
<div class:list={["anime-poster", ratio === "landscape" && "is-landscape"]}>
  <img src={src} alt={alt} loading="lazy" decoding="async" />
</div>

<style>
  .anime-poster {
    position: relative;
    aspect-ratio: 2 / 3;
    overflow: hidden;
    background: var(--color-ink-800);
  }

  .anime-poster.is-landscape {
    aspect-ratio: 16 / 9;
  }

  img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-slow) var(--ease-out);
  }

  .anime-poster:hover img {
    transform: scale(1.035);
  }

  @media (prefers-reduced-motion: reduce) {
    .anime-poster:hover img {
      transform: none;
    }
  }
</style>
