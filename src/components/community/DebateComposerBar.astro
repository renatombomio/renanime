---
interface Props { lang?: "es" | "en"; avatarUrl?: string | null; }
const { lang = "es", avatarUrl = null } = Astro.props;
const en = lang === "en";
const base = en ? "/en" : "";
---
<a class="compose" href={base + "/community/debates/?compose=1"} aria-label={en ? "Start a debate" : "Crear un debate"}>
<img class="av" src={avatarUrl || "/images/profile-avatar-placeholder.svg"} alt=""/>
<span class="compose-field"><span class="in">{en ? "What would you like to debate?" : "¿Qué quieres debatir?"}</span><span class="go" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg></span></span>
</a>