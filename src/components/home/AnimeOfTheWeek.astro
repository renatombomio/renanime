---
import { createSupabaseSsrClient } from "../../lib/supabase-ssr";

const lang = Astro.locals.lang;
const isEnglish = lang === "en";
const supabase = createSupabaseSsrClient(Astro.request, Astro.cookies);
const today = new Date().toISOString().slice(0, 10);

const { data: selection, error: selectionError } = await supabase
  .from("anime_of_the_week")
  .select("anilist_id, week_start, week_end, selection_source, selection_reason, source_rank")
  .lte("week_start", today)
  .gt("week_end", today)
  .order("week_start", { ascending: false })
  .limit(1)
  .maybeSingle();

type AnimeData = {
  id: number;
  title: { romaji: string | null; english: string | null; native: string | null };
  description: string | null;
  format: string | null;
  meanScore: number | null;
  averageScore: number | null;
  episodes: number | null;
  coverImage: { extraLarge: string | null; large: string | null };
  siteUrl: string;
};

let anime: AnimeData | null = null;
if (selection?.anilist_id) {
  try {
    const response = await fetch("https://graphql.anilist.co", {
      method: "POST",
      headers: { "Content-Type": "application/json", Accept: "application/json" },
      body: JSON.stringify({
        query: `query WeeklyAnime($id: Int!) {
          Media(id: $id, type: ANIME) {
            id
            title { romaji english native }
            description(asHtml: false)
            format
            meanScore
            averageScore
            episodes
            coverImage { extraLarge large }
            siteUrl
          }
        }`,
        variables: { id: selection.anilist_id },
      }),
    });
    if (response.ok) {
      const payload = await response.json();
      anime = payload.data?.Media ?? null;
    }
  } catch (error) {
    console.error("Anime of the week provider error:", error);
  }
}
if (selectionError) console.error("Anime of the week query failed:", selectionError.message);

const title = anime?.title?.english || anime?.title?.romaji || anime?.title?.native || "";
const synopsis = (anime?.description || "")
  .replace(/<[^>]*>/g, " ")
  .replace(/&#039;|&#39;/g, "'")
  .replace(/&quot;/g, '"')
  .replace(/&amp;/g, "&")
  .replace(/&lt;/g, "<")
  .replace(/&gt;/g, ">")
  .replace(/\s+/g, " ")
  .trim();
const score = anime?.meanScore ?? anime?.averageScore ?? null;
const formatLabel = anime?.format?.replaceAll("_", " ") ?? "";
const cover = anime?.coverImage?.extraLarge || anime?.coverImage?.large || "";
const weekStart = selection?.week_start
  ? new Date(`${selection.week_start}T00:00:00Z`).toLocaleDateString(isEnglish ? "en-GB" : "es-ES", { day: "numeric", month: "short", timeZone: "UTC" })
  : "";
const weekEnd = selection?.week_end
  ? new Date(new Date(`${selection.week_end}T00:00:00Z`).getTime() - 86400000).toLocaleDateString(isEnglish ? "en-GB" : "es-ES", { day: "numeric", month: "short", year: "numeric", timeZone: "UTC" })
  : "";
---

<section class="anime-week" aria-labelledby="anime-week-title">
  <div class="anime-week-inner">
    <div class="anime-week-heading">
      <p class="anime-week-eyebrow">{isEnglish ? "RENANIME SELECTION" : "SELECCIÓN RENANIME"}</p>
      <h2 id="anime-week-title">{isEnglish ? "Anime of the week" : "Anime de la semana"}</h2>
      <p class="anime-week-dates">{weekStart && weekEnd ? `${weekStart} — ${weekEnd}` : (isEnglish ? "Weekly pick" : "Selección semanal")}</p>
    </div>

    {anime && selection ? (
      <article class="anime-week-card">
        {cover && <div class="anime-week-backdrop" style={`background-image:url("${cover}")`} aria-hidden="true"></div>}
        <div class="anime-week-poster">
          {cover ? <img src={cover} alt={title} loading="lazy" /> : <div class="anime-week-poster-fallback">RENANIME</div>}
        </div>
        <div class="anime-week-content">
          <p class="anime-week-kicker">{isEnglish ? "THIS WEEK'S PICK" : "LA ELECCIÓN DE ESTA SEMANA"}</p>
          <h3>{title}</h3>
          <p class="anime-week-native">{anime.title?.native || anime.title?.romaji || ""}</p>
          <p class="anime-week-synopsis">{synopsis || (isEnglish ? "Discover this week's featured anime." : "Descubre el anime destacado de esta semana.")}</p>
          <div class="anime-week-meta">
            {formatLabel && <span>{formatLabel}</span>}
            {anime.episodes && <span>{anime.episodes} {isEnglish ? "episodes" : "episodios"}</span>}
            {score !== null && <span class="anime-week-score">★ {(score / 10).toFixed(1)} / 10</span>}
          </div>
          <a class="anime-week-link" href={`/anime/${anime.id}/`}>
            {isEnglish ? "Explore anime" : "Explorar anime"} <span aria-hidden="true">↗</span>
          </a>
          <p class="anime-week-source">{isEnglish ? "Data and rating: AniList" : "Datos y puntuación: AniList"}</p>
        </div>
      </article>
    ) : (
      <div class="anime-week-unavailable">
        {isEnglish ? "The weekly selection is being prepared." : "Estamos preparando la selección de esta semana."}
      </div>
    )}
  </div>
</section>

<style>
  .anime-week{position:relative;padding:clamp(3.5rem,7vw,6.5rem) 0;background:#080808;color:#f5f2ec;overflow:hidden}
  .anime-week-inner{width:min(calc(100% - (var(--gutter)*2)),var(--container-max));margin:0 auto}
  .anime-week-heading{display:flex;align-items:baseline;gap:1rem;flex-wrap:wrap;margin-bottom:1.5rem}
  .anime-week-eyebrow{width:100%;margin:0;color:#ec4899;font:600 .64rem/1.2 var(--font-mono);letter-spacing:.16em}
  .anime-week-heading h2{margin:0;font-size:clamp(1.65rem,3.2vw,2.7rem);font-weight:650;letter-spacing:-.045em}
  .anime-week-dates{margin:0;color:#888;font-size:.76rem}
  .anime-week-card{position:relative;isolation:isolate;display:grid;grid-template-columns:minmax(190px,30%) 1fr;gap:clamp(1.5rem,4vw,4rem);min-height:390px;padding:clamp(1.25rem,3vw,2.5rem);border:1px solid rgba(255,255,255,.1);border-radius:14px;background:#111;overflow:hidden}
  .anime-week-backdrop{position:absolute;z-index:-2;inset:0;background-position:center 35%;background-size:cover;opacity:.18;filter:blur(28px) saturate(.8);transform:scale(1.12)}
  .anime-week-card:after{content:"";position:absolute;z-index:-1;inset:0;background:linear-gradient(90deg,rgba(8,8,8,.3),#101010 58%),linear-gradient(0deg,rgba(8,8,8,.3),transparent)}
  .anime-week-poster{align-self:stretch;min-height:300px;max-height:480px;overflow:hidden;border-radius:8px;background:#191919;box-shadow:0 18px 60px #0008}
  .anime-week-poster img{display:block;width:100%;height:100%;min-height:300px;max-height:480px;object-fit:cover;object-position:center}
  .anime-week-poster-fallback{display:grid;place-items:center;height:100%;color:#ec4899;font-weight:800}
  .anime-week-content{align-self:center;max-width:760px;padding:1rem 0}
  .anime-week-kicker{margin:0 0 .8rem;color:#ec4899;font:600 .65rem/1.2 var(--font-mono);letter-spacing:.15em}
  .anime-week-content h3{margin:0;font-size:clamp(1.8rem,4.2vw,3.6rem);line-height:1.03;letter-spacing:-.05em}
  .anime-week-native{margin:.55rem 0 1.1rem;color:#9b9b9b;font-size:.88rem}
  .anime-week-synopsis{max-width:680px;margin:0;color:#c3c3c3;font-size:clamp(.88rem,1.15vw,1rem);line-height:1.75}
  .anime-week-meta{display:flex;flex-wrap:wrap;gap:.55rem;margin:1.35rem 0}
  .anime-week-meta span{padding:.38rem .65rem;border:1px solid rgba(255,255,255,.14);border-radius:999px;color:#d5d5d5;font-size:.72rem}
  .anime-week-meta .anime-week-score{border-color:rgba(236,72,153,.5);color:#f9a8d4}
  .anime-week-link{display:inline-flex;align-items:center;gap:.65rem;padding:.8rem 1.05rem;border-radius:5px;background:#ec4899;color:#090909;font-size:.82rem;font-weight:700;text-decoration:none;transition:background .2s,transform .2s}
  .anime-week-link:hover{background:#f9a8d4;transform:translateY(-2px)}
  .anime-week-source{margin:.85rem 0 0;color:#707070;font-size:.68rem}
  .anime-week-unavailable{padding:2rem;border:1px solid #242424;border-radius:10px;color:#999;text-align:center}
  @media(max-width:650px){.anime-week{padding:3rem 0}.anime-week-heading{gap:.55rem}.anime-week-card{grid-template-columns: minmax(0, 1fr);gap:1.25rem;padding:1rem}.anime-week-poster{width:min(100%,260px);min-height:0;aspect-ratio:3/4;margin:0 auto}.anime-week-poster img{min-height:0;height:100%;max-height:none}.anime-week-content{padding:.25rem 0 .5rem}.anime-week-content h3{font-size:2rem}.anime-week-synopsis{font-size:.87rem;line-height:1.65}.anime-week-card:after{background:linear-gradient(180deg,rgba(8,8,8,.05),#101010 45%)}}
</style>
