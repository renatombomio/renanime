---
import { createSupabaseSsrClient } from "../../lib/supabase-ssr";

const lang = Astro.locals.lang;
const isEnglish = lang === "en";
const supabase = createSupabaseSsrClient(Astro.request, Astro.cookies);
const today = new Date().toISOString().slice(0, 10);
// Default catalogue region for future region-aware provider integrations.
const DEFAULT_STREAMING_REGION = "ES";

const { data: selection, error: selectionError } = await supabase
  .from("anime_of_the_week")
  .select("anilist_id, week_start, week_end, selection_source, selection_reason, source_rank")
  .lte("week_start", today)
  .gt("week_end", today)
  .order("week_start", { ascending: false })
  .limit(1)
  .maybeSingle();

type AnimeData = {
  id: number;
  title: { romaji: string | null; english: string | null; native: string | null };
  idMal: number | null;
  format: string | null;
  meanScore: number | null;
  averageScore: number | null;
  episodes: number | null;
  coverImage: { extraLarge: string | null; large: string | null };
  siteUrl: string;
};

let anime: AnimeData | null = null;
if (selection?.anilist_id) {
  try {
    const response = await fetch("https://graphql.anilist.co", {
      method: "POST",
      headers: { "Content-Type": "application/json", Accept: "application/json" },
      body: JSON.stringify({
        query: `query WeeklyAnime($id: Int!) {
          Media(id: $id, type: ANIME) {
            id
            title { romaji english native }
            idMal
            format
            meanScore
            averageScore
            episodes
            coverImage { extraLarge large }
            siteUrl
          }
        }`,
        variables: { id: selection.anilist_id },
      }),
    });
    if (response.ok) {
      const payload = await response.json();
      anime = payload.data?.Media ?? null;
    }
  } catch (error) {
    console.error("Anime of the week provider error:", error);
  }
}
if (selectionError) console.error("Anime of the week query failed:", selectionError.message);

const title = anime?.title?.english || anime?.title?.romaji || anime?.title?.native || "";
const score = anime?.meanScore ?? anime?.averageScore ?? null;
const cover = anime?.coverImage?.extraLarge || anime?.coverImage?.large || "";
let streamingProviders: { name: string; url: string }[] = [];
if (anime?.idMal) {
  try {
    const response = await fetch(`https://api.tenrai.org/v1/anime/${anime.idMal}/streaming`, {
      headers: { Accept: "application/json" },
    });
    if (response.ok) {
      const payload = await response.json();
      streamingProviders = Array.isArray(payload.data)
        ? payload.data.map((provider: { name?: string; url?: string }) => ({
            name: provider.name || "",
            url: provider.url || "",
          })).filter((provider: { name: string; url: string }) => provider.name && provider.url)
        : [];
    }
  } catch (error) {
    console.error("Anime streaming providers query failed:", error);
  }
}
// Tenrai returns provider links but does not verify regional availability (including ES).
// Keep the region preference explicit; do not label these links as confirmed Spanish catalogues.
const providerConfig = [
  { key: "netflix", label: "Netflix", match: /netflix/i },
  { key: "hbo", label: "HBO Max", match: /hbo|max/i },
  { key: "prime", label: "Prime Video", match: /amazon prime|prime video/i },
  { key: "crunchyroll", label: "Crunchyroll", match: /crunchyroll/i },
];
const availableProviders = providerConfig.flatMap((provider) => {
  const match = streamingProviders.find((item) => provider.match.test(item.name));
  return match ? [{ ...provider, url: match.url }] : [];
});
---

<section class="anime-week" aria-labelledby="anime-week-title">
  <div class="anime-week-inner">
    <div class="anime-week-heading">
      <h2 id="anime-week-title">{isEnglish ? "Featured anime" : "Anime destacado"}</h2>
    </div>

    {anime && selection ? (
      <a class="anime-week-card" href={`/anime/${anime.id}/`} aria-label={isEnglish ? `View ${title} anime details` : `Ver ficha de ${title}`}>
        <div class="anime-week-poster">
          {cover ? <img src={cover} alt={title} loading="lazy" /> : <div class="anime-week-poster-fallback">RENANIME</div>}
        </div>
        <div class="anime-week-content">
          <h3>{title}</h3>
          {score !== null && <span class="anime-week-score" aria-label={isEnglish ? `AniList score ${(score / 10).toFixed(1)} out of 10` : `Puntuación AniList ${(score / 10).toFixed(1)} sobre 10`}>★ {(score / 10).toFixed(1)} / 10</span>}
          <div class="anime-week-meta">
            {anime.format && <span>{anime.format.replaceAll("_", " ")}</span>}
            {anime.episodes && <span>{anime.episodes} {isEnglish ? "episodes" : "episodios"}</span>}
          </div>
          <div class="anime-week-streaming" aria-label={isEnglish ? "Streaming platform links" : `Enlaces de plataformas · región preferida ${DEFAULT_STREAMING_REGION}`}>
            {availableProviders.length > 0
              ? availableProviders.map((provider) => (
                  <span class={`anime-week-provider provider-${provider.key}`} title={provider.label} aria-label={provider.label}>
                    {provider.key === "netflix" ? <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 2h4l6 15V2h4v20h-4L9 7v15H5z" fill="currentColor"/></svg> : null}
                    {provider.key === "hbo" ? <span class="provider-wordmark">HBO</span> : null}
                    {provider.key === "prime" ? <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 16.5c5.2 3.4 12.1 3.3 17.5-.6M17.3 13.7l3.6 2.2-2.4 3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg> : null}
                    {provider.key === "crunchyroll" ? <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8.5" fill="none" stroke="currentColor" stroke-width="2.5"/><path d="M15.8 7.4a5.4 5.4 0 1 0 1.1 7.7 4.4 4.4 0 1 1-1.1-7.7Z" fill="currentColor"/></svg> : null}
                  </span>
                ))
              : null}
          </div>
        </div>
      </a>
    ) : (
      <div class="anime-week-unavailable">
        {isEnglish ? "The weekly selection is being prepared." : "Estamos preparando la selección de esta semana."}
      </div>
    )}
  </div>
</section>

<style>
  .anime-week{padding:26px 0 22px;background:transparent;color:#f5f2ec;border-top:1px solid rgba(255,255,255,.08)}
  .anime-week-inner{width:min(calc(100% - 32px),900px);margin:0 auto}
  .anime-week-heading{display:flex;align-items:center;gap:10px;margin-bottom:12px}
  .anime-week-heading:after{content:"WEEKLY PICK";font:600 9px/1 ui-monospace,monospace;letter-spacing:.1em;color:#999;border:1px solid rgba(255,255,255,.12);border-radius:999px;padding:5px 7px}
  .anime-week-heading h2{margin:0;font:700 clamp(18px,2.2vw,22px)/1.2 Inter,ui-sans-serif,system-ui,sans-serif;letter-spacing:-.035em}
  .anime-week-card{display:grid;grid-template-columns:94px minmax(0,1fr);align-items:center;gap:14px;width:100%;max-width:620px;padding:10px;border:1px solid rgba(255,255,255,.1);border-radius:10px;background:#111214;color:inherit;text-decoration:none;transition:border-color .2s,background .2s}
  .anime-week-poster{width:94px;aspect-ratio:3/4;overflow:hidden;border-radius:7px;background:#19191b}
  .anime-week-poster img{display:block;width:100%;height:100%;object-fit:cover;object-position:center;transition:transform .3s ease}
  .anime-week-card:hover{border-color:rgba(249,168,212,.4);background:#171719}
  .anime-week-card:hover .anime-week-poster img{transform:scale(1.025)}
  .anime-week-poster-fallback{display:grid;place-items:center;height:100%;color:#ec4899;font-weight:800}
  .anime-week-content{min-width:0;padding:0}
  .anime-week-content h3{margin:0 0 8px;font:650 clamp(16px,2vw,19px)/1.2 Inter,ui-sans-serif,system-ui,sans-serif;letter-spacing:-.025em;max-width:28ch}
  .anime-week-score{display:inline-flex;align-items:center;gap:.25rem;padding:4px 7px;border:1px solid rgba(236,72,153,.48);border-radius:999px;color:#f9a8d4;font-size:10px;font-weight:650}
  .anime-week-meta{display:flex;flex-wrap:wrap;gap:7px;margin-top:7px;color:#a5a5a5;font-size:10px;text-transform:capitalize}
  .anime-week-meta span+span:before{content:"·";margin-right:7px;color:#666}
  .anime-week-streaming{display:flex;align-items:center;flex-wrap:wrap;gap:7px;margin-top:7px;min-height:22px}
  .anime-week-provider{display:grid;place-items:center;width:22px;height:22px;color:#f5f2ec;opacity:.9}
  .anime-week-provider svg{display:block;width:18px;height:18px}
  .provider-netflix{color:#e50914}.provider-hbo{color:#a78bfa}.provider-wordmark{font-size:12px;font-weight:900;letter-spacing:-.08em}.provider-prime{color:#00a8e1}.provider-crunchyroll{color:#f47521}
  .anime-week-unavailable{padding:10px 0;color:#999;font-size:13px}
  @media(max-width:650px){
    .anime-week{padding:20px 0 16px}
    .anime-week-inner{width:calc(100% - 26px)}
    .anime-week-heading{margin-bottom:10px}
    .anime-week-heading h2{font-size:17px}
    .anime-week-card{grid-template-columns:84px minmax(0,1fr);gap:11px;padding:8px;border-radius:9px}
    .anime-week-poster{width:84px;border-radius:6px}
    .anime-week-content h3{font-size:14px;line-height:1.2;margin-bottom:6px}
    .anime-week-score{font-size:9px;padding:3px 6px}
    .anime-week-meta{font-size:9px;gap:5px;margin-top:5px}
    .anime-week-meta span+span:before{margin-right:5px}
    .anime-week-streaming{gap:5px;margin-top:5px;min-height:19px}
    .anime-week-provider{width:19px;height:19px}
    .anime-week-provider svg{width:16px;height:16px}
    .anime-week-heading:after{font-size:8px;padding:4px 6px}
  }</style>
