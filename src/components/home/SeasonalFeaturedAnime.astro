---
export interface SeasonalAnime {
  id: number;
  title: string;
  cover: string;
  tint: string;
  popularity: number;
}

export interface Props {
  anime: SeasonalAnime[];
  labels: {
    eyebrow: string;
    title: string;
    subtitle: string;
    ariaLabel: string;
  };
}

const { anime, labels } = Astro.props;
const featured = anime.slice(0, 5);
---

{featured.length > 0 && (
  <section class="seasonal-featured" aria-labelledby="seasonal-featured-title">
    <header class="sf-header">
      <p class="sf-eyebrow"><span class="sf-dot" aria-hidden="true"></span>{labels.eyebrow}</p>
      <h2 id="seasonal-featured-title">{labels.title}</h2>
      <p class="sf-subtitle">{labels.subtitle}</p>
    </header>

    <div class="sf-marquee" role="region" aria-label={labels.ariaLabel}>
      <div class="sf-track">
        <div class="sf-group">
          {featured.map((item) => (
            <figure class="sf-card" style={`--anime-tint:${item.tint};`}>
              <div class="sf-poster">
                <img src={item.cover} alt={item.title} loading="lazy" decoding="async" />
                <span class="sf-poster-shade" aria-hidden="true"></span>
              </div>
              <figcaption>{item.title}</figcaption>
            </figure>
          ))}
        </div>
        <div class="sf-group" aria-hidden="true">
          {featured.map((item) => (
            <figure class="sf-card" style={`--anime-tint:${item.tint};`}>
              <div class="sf-poster">
                <img src={item.cover} alt="" loading="lazy" decoding="async" />
                <span class="sf-poster-shade"></span>
              </div>
              <figcaption>{item.title}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </div>
  </section>
)}

<style>
  .seasonal-featured {
    width: min(calc(100% - (var(--gutter) * 2)), 1120px);
    margin: 0 auto;
    padding: 3.5rem 0;
    overflow: hidden;
    color: #f5f2ec;
  }
  .sf-header { margin-bottom: 1.5rem; }
  .sf-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 12px;
    padding: 6px 12px;
    border: 1px solid rgba(255,255,255,.14);
    border-radius: 999px;
    background: rgba(255,255,255,.06);
    color: #cfcbd3;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .14em;
    text-transform: uppercase;
  }
  .sf-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #ec4899;
    box-shadow: 0 0 12px rgba(236,72,153,.65);
  }
  .sf-header h2 {
    margin: 0;
    color: #fff;
    font-size: clamp(28px, 4.4vw, 40px);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -.02em;
  }
  .sf-subtitle { margin: 8px 0 0; color: #8f8a96; font-size: 14px; }
  .sf-marquee { width: 100%; overflow: hidden; }
  .sf-track {
    display: flex;
    width: max-content;
    animation: sf-scroll 42s linear infinite;
    will-change: transform;
  }
  .sf-group {
    display: flex;
    flex: 0 0 auto;
    gap: clamp(12px, 2vw, 22px);
    padding-right: clamp(12px, 2vw, 22px);
  }
  .sf-card {
    position: relative;
    flex: 0 0 clamp(142px, 18vw, 210px);
    width: clamp(142px, 18vw, 210px);
    margin: 0;
  }
  .sf-poster {
    position: relative;
    aspect-ratio: 2 / 3;
    overflow: hidden;
    border: 1px solid rgba(255,255,255,.12);
    border-radius: 15px;
    background: radial-gradient(120% 100% at 50% 0%, color-mix(in srgb, var(--anime-tint) 35%, #15151a), #09090c 75%);
    box-shadow: 0 12px 34px rgba(0,0,0,.24);
  }
  .sf-poster img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform .5s ease;
  }
  .sf-card:hover .sf-poster img { transform: scale(1.035); }
  .sf-poster-shade {
    position: absolute;
    inset: 35% 0 0;
    background: linear-gradient(0deg, rgba(0,0,0,.28), transparent);
    pointer-events: none;
  }
  .sf-card figcaption {
    display: -webkit-box;
    min-height: 2.6em;
    margin-top: 10px;
    overflow: hidden;
    color: #f5f2ec;
    font-size: 13px;
    font-weight: 650;
    line-height: 1.3;
    text-align: center;
    text-overflow: ellipsis;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }
  @keyframes sf-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
  @media (max-width: 640px) {
    .seasonal-featured { width: calc(100% - 2rem); padding: 2.5rem 0; }
    .sf-header h2 { font-size: 28px; }
    .sf-subtitle { font-size: 13px; }
    .sf-card { flex-basis: 142px; width: 142px; }
    .sf-track { animation-duration: 34s; }
  }
  @media (prefers-reduced-motion: reduce) {
    .sf-track { animation: none; }
  }
</style>
