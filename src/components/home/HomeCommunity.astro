---
interface CommunityMember {
  id: string;
  aka: string;
  name: string | null;
  avatar_url: string | null;
  last_seen_at: string | null;
}
interface CommunityActivity {
  id: string;
  animeId: number;
  content: string;
  createdAt: string;
  aka: string;
  avatarUrl: string | null;
}
interface Props {
  members: CommunityMember[];
  activity: CommunityActivity[];
  href: (animeId: number) => string;
  profileHref: (aka: string) => string;
  labels: {
    title: string;
    members: string;
    activity: string;
    emptyMembers: string;
    emptyActivity: string;
    viewAll: string;
    commented: string;
  };
}
const { members, activity, href, profileHref, labels } = Astro.props;
const memberLoop = members.length > 1 ? [...members, ...members] : members.length === 1 ? Array.from({ length: 6 }, () => members[0]) : [];
const formatAge = (value: string) => {
  const elapsed = Math.max(0, Date.now() - new Date(value).getTime());
  const minutes = Math.floor(elapsed / 60_000);
  if (minutes < 1) return "ahora";
  if (minutes < 60) return `hace ${minutes} min`;
  const hours = Math.floor(minutes / 60);
  if (hours < 24) return `hace ${hours} h`;
  const days = Math.floor(hours / 24);
  return `hace ${days} d`;
};
---
{(members.length > 0 || activity.length > 0) && (
  <section class="home-community" aria-label={labels.title}>
    <div class="community-heading">
      <h2>{labels.title}</h2>
      <a href={Astro.locals.lang === "en" ? "/en/community/" : "/community/"}>{labels.viewAll}<span aria-hidden="true"> ↗</span></a>
    </div>
    <div class="community-members-block">
      <p class="community-kicker">{labels.members}</p>
      {members.length > 0 ? (
        <div class="members-marquee" aria-label={labels.members}>
          <div class="members-track">
            {memberLoop.map((member, index) => (
              <div class="member-pill" aria-hidden={index >= members.length ? "true" : undefined}>
                <img src={member.avatar_url || "/images/profile-avatar-placeholder.svg"} alt="" loading="lazy" />
                <span class="member-name">{member.name || member.aka}</span>
                <span class="member-handle">@{member.aka}</span>
              </div>
            ))}
          </div>
        </div>
      ) : <p class="community-empty">{labels.emptyMembers}</p>}
    </div>
    <div class="community-activity-block">
      <p class="community-kicker">{labels.activity}</p>
      {activity.length > 0 ? (
        <div class="activity-list">
          {activity.slice(0, 5).map((item) => (
            <article class="activity-item">
              <a class="activity-avatar" href={profileHref(item.aka)} aria-label={`@${item.aka}`}>
                <img src={item.avatarUrl || "/images/profile-avatar-placeholder.svg"} alt="" loading="lazy" />
              </a>
              <div class="activity-copy">
                <p><a href={profileHref(item.aka)}>@{item.aka}</a><span>{labels.commented}</span></p>
                <a class="activity-content" href={href(item.animeId)}>{item.content}</a>
                <time datetime={item.createdAt}>{formatAge(item.createdAt)}</time>
              </div>
            </article>
          ))}
        </div>
      ) : <p class="community-empty">{labels.emptyActivity}</p>}
    </div>
  </section>
)}
<style>
  .home-community{width:min(calc(100% - (var(--gutter)*2)),var(--container-max));margin:0 auto;padding:3rem 0 3.5rem;color:#f5f2ec}
  .community-heading{display:flex;align-items:center;justify-content:space-between;gap:1rem;margin-bottom:1.8rem}
  .community-heading h2{margin:0;font-size:clamp(2rem,4vw,2.8rem);font-weight:750;letter-spacing:-.035em}
  .community-heading>a{color:#aaa;font-size:.72rem;text-decoration:none;white-space:nowrap}
  .community-heading>a:hover{color:#fff}
  .community-kicker{margin:0 0 1rem;color:#8e8e94;font-size:.68rem;font-weight:650;letter-spacing:.08em;text-transform:uppercase}
  .community-members-block{overflow:hidden}
  .members-marquee{overflow:hidden;position:relative;width:100%;mask-image:linear-gradient(90deg,transparent,#000 3%,#000 97%,transparent)}
  .members-track{display:flex;width:max-content;align-items:flex-start;gap:1.5rem;animation:community-marquee 34s linear infinite;will-change:transform}
  .member-pill{display:flex;flex:0 0 auto;flex-direction:column;align-items:center;gap:.28rem;min-width:0;color:#e8e8e8;text-align:center}
  .member-pill img{width:58px;height:58px;border-radius:50%;object-fit:cover;background:#191919;border:1px solid rgba(255,255,255,.12)}
  .member-pill span{display:block;max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.member-name{font-size:.78rem;font-weight:650;color:#f0f0f0}.member-handle{font-size:.68rem;color:#929297}
  @keyframes community-marquee{from{transform:translateX(0)}to{transform:translateX(-50%)}}
  .community-activity-block{margin-top:2.6rem}
  .activity-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.7rem}
  .activity-item{display:flex;align-items:flex-start;gap:.7rem;min-width:0;padding:.8rem;border:1px solid rgba(255,255,255,.09);border-radius:12px;background:rgba(255,255,255,.025)}
  .activity-avatar{display:block;flex:0 0 34px;width:34px;height:34px}
  .activity-avatar img{width:100%;height:100%;border-radius:50%;object-fit:cover;background:#191919}
  .activity-copy{display:grid;gap:.28rem;min-width:0}
  .activity-copy p{margin:0;color:#929297;font-size:.7rem;line-height:1.4}
  .activity-copy p a:first-child{color:#f0f0f0;font-weight:650;text-decoration:none}
  .activity-copy p a:last-child{color:#c5c5c8;text-decoration:none}
  .activity-content{display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden;color:#d2d2d5;font-size:.82rem;line-height:1.4;text-decoration:none;overflow-wrap:anywhere}
  .activity-copy time{color:#777;font-size:.64rem}
  .community-empty{margin:0;color:#85858b;font-size:.78rem}
  @media(max-width:640px){.home-community{width:calc(100% - 2rem);padding:2.6rem 0 3rem}.community-heading h2{font-size:2.15rem}.members-track{gap:1rem;animation-duration:28s}.member-pill{flex-basis:78px}.member-pill img{width:54px;height:54px}.member-name{font-size:.74rem}.member-handle{font-size:.65rem}.community-activity-block{margin-top:2.1rem}.activity-list{grid-template-columns:1fr;gap:.55rem}.activity-item{padding:.7rem}}
  @media(prefers-reduced-motion:reduce){.members-track{animation:none}}
</style>
