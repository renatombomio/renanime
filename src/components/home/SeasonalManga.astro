---
interface Props {
  manga: {
    id: number;
    title: string;
    author: string | null;
    cover: string | null;
    synopsis: string | null;
    volumes: number | null;
  } | null;
  labels: { title: string; subtitle: string; author: string; volumes: string; volumesUnavailable: string };
}
const { manga, labels } = Astro.props;
---

{manga && (
  <section class="seasonal-manga" aria-labelledby="seasonal-manga-title">
    <div class="sm-inner">
      <header class="sm-heading">
        <h2 id="seasonal-manga-title">{labels.title}</h2>
        <p>{labels.subtitle}</p>
      </header>
      <article class="sm-feature">
        {manga.cover && (
          <div class="sm-cover-wrap">
            <img class="sm-cover" src={manga.cover} alt={manga.title} loading="lazy" decoding="async" />
          </div>
        )}
        <div class="sm-copy">
          <h3>{manga.title}</h3>
          {manga.author && <p class="sm-author">{labels.author} {manga.author}</p>}
          <p class="sm-volumes">{labels.volumes}: {manga.volumes ?? labels.volumesUnavailable}</p>
          {manga.synopsis && <p class="sm-synopsis">{manga.synopsis}</p>}
          <span class="sm-source">AniList · Manga</span>
        </div>
      </article>
    </div>
  </section>
)}

<style>
  .seasonal-manga{padding:28px 0 30px;border-top:1px solid rgba(255,255,255,.08);color:#f5f2ec}
  .sm-inner{width:min(calc(100% - 32px),900px);margin:0 auto}
  .sm-heading{margin-bottom:14px}
  .sm-heading h2{margin:0;font:800 clamp(28px,4vw,38px)/1.08 Inter,ui-sans-serif,system-ui,sans-serif;letter-spacing:-.035em}
  .sm-heading p{margin:7px 0 0;color:#929197;font-size:13px;line-height:1.45}
  .sm-feature{display:grid;grid-template-columns:112px minmax(0,1fr);gap:17px;align-items:start}
  .sm-cover-wrap{overflow:hidden;aspect-ratio:2/3;border-radius:5px;background:#171719;box-shadow:0 12px 26px rgba(0,0,0,.28)}
  .sm-cover{display:block;width:100%;height:100%;object-fit:cover}
  .sm-copy{min-width:0;padding-top:2px}
  .sm-copy h3{margin:0;font:650 clamp(22px,3vw,30px)/1.12 "Newsreader",Georgia,serif;letter-spacing:-.02em}
  .sm-author{margin:7px 0 0;color:#aaa6af;font-size:12px}
  .sm-volumes{margin:7px 0 0;color:#aaa6af;font-size:12px;font-weight:600}
  .sm-synopsis{display:-webkit-box;margin:10px 0 0;overflow:hidden;color:#c9c5cd;font:400 15px/1.5 "Newsreader",Georgia,serif;-webkit-box-orient:vertical;-webkit-line-clamp:5}
  .sm-source{display:block;margin-top:12px;color:#77737d;font-size:10px;letter-spacing:.04em}
  @media(min-width:700px){.sm-feature{grid-template-columns:150px minmax(0,1fr);gap:22px}.sm-heading{margin-bottom:18px}}
  @media(max-width:480px){.sm-inner{width:calc(100% - 26px)}.sm-feature{grid-template-columns:104px minmax(0,1fr);gap:13px}.sm-copy h3{font-size:21px}.sm-synopsis{font-size:14px;line-height:1.42;-webkit-line-clamp:4}}
</style>
