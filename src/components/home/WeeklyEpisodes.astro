---
import { localizedPath, useT, type Lang } from "../../i18n";

export interface WeeklyEpisode {
  animeId: number;
  title: string;
  banner?: string | null;
  tint?: string | null;
  format?: string | null;
  episode: number;
  airingLabel?: string | null;
}

interface Props {
  episodes: WeeklyEpisode[];
  lang: Lang;
}

const { episodes, lang } = Astro.props;
const t = useT(lang);
const rows = episodes.slice(0, 5);
const rankColors = ["#ec4899", "#e0a458", "#9b7bd6", "#1d1d1d", "#1d1d1d"];
const href = (animeId: number) => localizedPath(lang, `/anime/${animeId}/`);
---

{rows.length > 0 && (
  <section class="weekly-episodes" aria-labelledby="weekly-episodes-title">
    <header class="we-header">
      <h2 id="weekly-episodes-title" class="we-title">{lang === "en" ? "Airing this week" : "En emisión esta semana"}</h2>
      <span class="we-count">TOP 5 <i></i> ANILIST</span>
    </header>

    <ol class="we-list">
      {rows.map((ep, i) => (
        <li>
          <a
            class:list={["we-row", { "is-top": i === 0 }]}
            href={href(ep.animeId)}
            style={`--tint:${ep.tint || "#ec4899"}; --rank-bg:${rankColors[i]};`}
          >
            <span class="we-rank" aria-hidden="true">{i + 1}</span>
            <span class="we-body">
              <span
                class="we-banner"
                aria-hidden="true"
                style={ep.banner ? `background-image:url('${ep.banner}')` : undefined}
              ></span>
              <span class="we-text">
                <span class="we-name">{ep.title}</span>
                <span class="we-meta">
                  {ep.format && <span class="we-chip we-chip--format">{ep.format}</span>}
                  <span class="we-ep">
                    <span class="we-ep-long">{t("weeklyEpisodes.episode")}</span>
                    <span class="we-ep-short">{t("weeklyEpisodes.episodeShort")}</span> {ep.episode}
                  </span>
                </span>
              </span>
              {ep.airingLabel && (
                <span class="we-airing">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg>
                  <span>{ep.airingLabel}</span>
                </span>
              )}
            </span>
          </a>
        </li>
      ))}
    </ol>
  </section>
)}

<style>
  .weekly-episodes { width:min(100% - 32px, 900px); margin:0 auto; padding:28px 0 36px; color:#f5f2ec; border-top:1px solid rgba(255,255,255,.08); }
  .we-header { display:flex; align-items:center; justify-content:space-between; gap:12px; margin-bottom:14px; }
  .we-title { margin:0; font:700 clamp(18px,2.2vw,22px)/1.2 Inter,ui-sans-serif,system-ui,sans-serif; letter-spacing:-.035em; }
  .we-count { display:inline-flex; align-items:center; gap:7px; flex:none; padding:5px 8px; border:1px solid rgba(255,255,255,.12); border-radius:999px; color:#aaa; font:600 9px/1 ui-monospace,monospace; letter-spacing:.08em; }
  .we-count i { width:3px; height:3px; border-radius:50%; background:#ec4899; }
  .we-list { list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:7px; }
  .we-row { display:flex; align-items:stretch; min-height:70px; border-radius:10px; overflow:hidden; background:#111214; border:1px solid rgba(255,255,255,.09); color:inherit; text-decoration:none; transition:border-color .18s,transform .18s,background .18s; }
  .we-row.is-top { border-color:rgba(236,72,153,.45); }
  .we-row:hover { border-color:var(--tint); background:#171719; transform:translateY(-1px); }
  .we-row:focus-visible { outline:2px solid #ec4899; outline-offset:2px; }
  .we-rank { flex:0 0 38px; display:flex; align-items:center; justify-content:center; align-self:center; width:26px; height:26px; margin:0 0 0 10px; border-radius:50%; background:rgba(255,255,255,.08); color:#c8c4ca; font:700 12px/1 Inter,ui-sans-serif,system-ui,sans-serif; }
  .is-top .we-rank { background:#ec4899; color:#160b12; }
  .we-body { position:relative; flex:1; display:flex; align-items:center; min-width:0; overflow:hidden; padding:10px 12px 10px 2px; }
  .we-banner { position:absolute; inset:0 0 0 auto; width:42%; background:linear-gradient(90deg,#111214 0%,rgba(17,18,20,.65) 28%,rgba(17,18,20,.12) 100%),linear-gradient(0deg,rgba(10,10,12,.28),rgba(10,10,12,.28)); background-size:cover; background-position:center; opacity:.72; }
  .we-text { position:relative; z-index:1; display:block; min-width:0; max-width:72%; }
  .we-name { display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; font-weight:650; font-size:14px; line-height:1.25; }
  .we-meta { display:flex; flex-wrap:wrap; gap:7px; align-items:center; margin-top:5px; }
  .we-chip { padding:2px 7px; border-radius:5px; font-size:9px; font-weight:700; }
  .we-chip--format { background:#292653; color:#d5d1ff; }
  .we-ep { font-size:11px; color:#aaa6ad; }
  .we-ep-short { display:none; }
  .we-airing { position:relative; z-index:1; display:flex; align-items:center; gap:5px; margin:5px 0 0; color:#e6c36c; font-size:10px; font-weight:650; white-space:nowrap; }
  .we-airing svg { width:12px; height:12px; flex:none; fill:none; stroke:currentColor; stroke-width:2; stroke-linecap:round; }
  @media(max-width:640px){
    .weekly-episodes{width:calc(100% - 26px);padding:22px 0 28px}
    .we-header{margin-bottom:11px}
    .we-title{font-size:17px}
    .we-count{font-size:8px;padding:5px 7px}
    .we-list{gap:6px}
    .we-row{min-height:66px;border-radius:9px}
    .we-rank{flex-basis:32px;width:24px;height:24px;margin-left:8px;font-size:11px}
    .we-body{padding:8px 8px 8px 0}
    .we-banner{width:44%;opacity:.58;background-image:linear-gradient(90deg,#111214 0%,rgba(17,18,20,.62) 30%,rgba(17,18,20,.12) 100%),var(--episode-banner); }
    .we-text{max-width:76%}
    .we-name{font-size:12px;line-height:1.22}
    .we-meta{gap:5px;margin-top:4px}
    .we-chip{font-size:8px;padding:2px 6px}
    .we-ep{font-size:10px}
    .we-ep-long{display:none}
    .we-ep-short{display:inline}
    .we-airing{gap:4px;margin-top:4px;font-size:9px}
    .we-airing svg{width:11px;height:11px}
  }</style>
