---
interface Props {
  manga: { id: number; title: string; author?: string | null; cover?: string | null; volumes?: number | null; status?: string | null; synopsis?: string | null } | null;
  href: string;
  labels: { subtitle: string; volumes: string; cta: string };
}
const { manga, href, labels } = Astro.props;
const isEnglish = Astro.locals.lang === "en";
const statusLabels: Record<string, string> = {
  FINISHED: isEnglish ? "Completed" : "Finalizado",
  RELEASING: isEnglish ? "Ongoing" : "En publicación",
  NOT_YET_RELEASED: isEnglish ? "Upcoming" : "Próximamente",
  CANCELLED: isEnglish ? "Cancelled" : "Cancelado",
  HIATUS: isEnglish ? "On hiatus" : "En pausa",
};
const meta = [manga?.volumes ? manga.volumes + " " + labels.volumes : null, manga?.status ? statusLabels[manga.status] || null : null].filter(Boolean).join(" · ");
---
{manga && (
  <section class="featured-manga" aria-labelledby="featured-manga-title">
    <header class="fm-heading">
      <h2 id="featured-manga-title">{isEnglish ? "Recommended manga" : "Manga recomendado"}</h2>
      <p>{labels.subtitle}</p>
    </header>
    <a class="fm" href={href}>
      {manga.cover ? <img class="fm-cover" src={manga.cover} alt="" width="240" height="360" loading="lazy" decoding="async" /> : <span class="fm-cover fm-ph"><b>{manga.title}</b></span>}
      <span class="fm-tx">
        <h3 class="fm-title">{manga.title}</h3>
        {manga.author && <span class="fm-by">{isEnglish ? "by" : "por"} {manga.author}</span>}
        {meta && <span class="fm-meta">{meta}</span>}
        {manga.synopsis && <p class="fm-syn">{manga.synopsis}</p>}
        <span class="fm-go">{labels.cta}</span>
      </span>
    </a>
  </section>
)}
<style>
.featured-manga{margin:0 auto;width:min(calc(100% - 32px),900px);padding:30px 0 34px;border-top:1px solid rgba(255,255,255,.12);color:#f5f2ec}
.fm-heading{margin:0 0 4px}.fm-heading h2{margin:0;font-size:clamp(27px,4vw,36px);font-weight:750;letter-spacing:-.035em;line-height:1.1}.fm-heading p{margin:7px 0 0;color:#85828b;font-size:13px;line-height:1.45}
.fm{display:flex;gap:18px;padding:20px 0 0;color:inherit;text-decoration:none}.fm-cover{flex:0 0 168px;width:168px;aspect-ratio:2/3;object-fit:cover;border-radius:2px 5px 5px 2px;background:#1f2a33;box-shadow:inset 3px 0 0 rgba(0,0,0,.28),0 14px 24px -14px rgba(0,0,0,.9)}
.fm-ph{display:flex;align-items:flex-end;padding:14px;color:#e9e2d0;font-family:"Newsreader",Georgia,serif;font-size:26px;line-height:1.02}.fm-tx{flex:1;min-width:0;display:flex;flex-direction:column}
.fm-title{margin:0;font-family:"Newsreader",Georgia,serif;font-weight:600;font-size:30px;line-height:1.02;letter-spacing:-.02em}.fm-by{margin-top:8px;font-size:13px;color:#b9b5bf}.fm-meta{margin-top:4px;font-size:12px;color:#77737d}
.fm-syn{margin:12px 0 0;font-family:"Newsreader",Georgia,serif;font-size:15px;line-height:1.5;color:#cfcbd3;display:-webkit-box;-webkit-line-clamp:5;-webkit-box-orient:vertical;overflow:hidden}.fm-go{margin-top:auto;padding-top:14px;font-size:14px;font-weight:600;color:#f472b6}
.fm:focus-visible{outline:2px solid #f472b6;outline-offset:5px;border-radius:3px}
@media(min-width:768px){.featured-manga{padding:38px 0 42px}.fm{gap:32px;padding-top:24px}.fm-cover{flex-basis:240px;width:240px}.fm-title{font-size:44px}}
@media(max-width:480px){.featured-manga{width:calc(100% - 26px)}.fm{gap:14px}.fm-cover{flex-basis:124px;width:124px}.fm-title{font-size:24px}.fm-syn{font-size:14px;line-height:1.42;-webkit-line-clamp:5}}
</style>
