---
interface Item {
  title: string;
  url: string;
  source: string;
  publishedAt: string;
  image?: string | null;
}
interface Props {
  items: Item[];
  locale: "es" | "en";
  labels: { title: string; subtitle: string; more?: string };
  moreHref?: string;
}
const { items, locale, labels, moreHref } = Astro.props;
const list = items.slice(0, 5);
const [lead, ...rest] = list;
const rtf = new Intl.RelativeTimeFormat(locale, { numeric: "auto" });
function ago(iso: string): string {
  const diff = (new Date(iso).getTime() - Date.now()) / 1000;
  const abs = Math.abs(diff);
  if (abs < 3600) return rtf.format(Math.round(diff / 60), "minute");
  if (abs < 86400) return rtf.format(Math.round(diff / 3600), "hour");
  return rtf.format(Math.round(diff / 86400), "day");
}
---
{lead && (
  <section class="nw" aria-labelledby="nw-title">
    <header class="nw-head">
      <h2 id="nw-title">{labels.title}</h2>
      <p>{labels.subtitle}</p>
    </header>

    <a class="nw-lead" href={lead.url} target="_blank" rel="noopener noreferrer">
      {lead.image && <img src={lead.image} alt="" loading="lazy" />}
      <span class="nw-lead-t" lang="en">{lead.title}</span>
      <span class="nw-meta"><b>{lead.source}</b> · {ago(lead.publishedAt)}</span>
    </a>

    <ul class="nw-list">
      {rest.map((n) => (
        <li>
          <a href={n.url} target="_blank" rel="noopener noreferrer">
            <span class="nw-tx">
              <span class="nw-t" lang="en">{n.title}</span>
              <span class="nw-meta"><b>{n.source}</b> · {ago(n.publishedAt)}</span>
            </span>
            {n.image && <img src={n.image} alt="" width="84" height="84" loading="lazy" />}
          </a>
        </li>
      ))}
    </ul>

    {moreHref && labels.more && <a class="nw-more" href={moreHref}>{labels.more}</a>}
  </section>
)}
<style>
  .nw { padding: 36px 16px 8px; color: #f2efe9; }
  .nw-head h2 { margin: 0; font-size: 26px; font-weight: 500; letter-spacing: -.01em; }
  .nw-head p { margin: 6px 0 0; font-size: 13px; color: #8d8993; }

  .nw a { color: inherit; text-decoration: none; }
  .nw-lead { display: block; margin-top: 20px; padding: 18px 0; border-top: 1px solid rgba(255,255,255,.12); }
  .nw-lead img { display: block; width: 100%; aspect-ratio: 16 / 9; object-fit: cover; border-radius: 6px; margin-bottom: 14px; }
  .nw-lead-t { display: -webkit-box; -webkit-line-clamp: 4; -webkit-box-orient: vertical; overflow: hidden;
    font-size: 24px; font-weight: 700; line-height: 1.15; letter-spacing: -.02em; text-wrap: balance; }
  .nw-meta { display: block; margin-top: 10px; font-size: 12px; color: #77737d; }
  .nw-meta b { font-weight: 600; color: #a39fa9; }

  .nw-list { margin: 0; padding: 0; list-style: none; }
  .nw-list li { border-top: 1px solid rgba(255,255,255,.07); }
  .nw-list a { display: flex; gap: 14px; align-items: flex-start; justify-content: space-between; padding: 16px 0; }
  .nw-tx { flex: 1; min-width: 0; }
  .nw-t { display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;
    font-size: 17px; font-weight: 600; line-height: 1.25; letter-spacing: -.01em; }
  .nw-list img { flex: 0 0 84px; width: 84px; height: 84px; object-fit: cover; border-radius: 6px; background: #17171b; }
  .nw a:hover .nw-lead-t, .nw a:hover .nw-t, .nw a:focus-visible .nw-lead-t, .nw a:focus-visible .nw-t { color: #f472b6; }
  .nw a:focus-visible { outline: 2px solid #ec4899; outline-offset: 4px; border-radius: 4px; }
  .nw a.nw-more { display: inline-block; margin-top: 6px; padding: 12px 0; font-size: 14px; font-weight: 600; color: #f472b6; border-top: 1px solid rgba(255,255,255,.07); width: 100%; }

  @media (min-width: 768px) {
    .nw { max-width: 1040px; margin: 0 auto; padding-left: 0; padding-right: 0; }
    .nw-lead-t { font-size: 34px; max-width: 760px; }
    .nw-t { font-size: 19px; }
  }
</style>
