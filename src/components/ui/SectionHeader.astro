---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  id?: string;
}

const { eyebrow, title, description, id } = Astro.props;
---

<header id={id} class="section-header">
  {eyebrow && <span class="eyebrow">{eyebrow}</span>}
  <h2>{title}</h2>
  {description && <p>{description}</p>}
</header>

<style>
  .section-header {
    display: grid;
    gap: var(--space-4);
    max-width: 48rem;
  }

  h2 {
    margin: 0;
    color: var(--color-paper-50);
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 5vw, 4.5rem);
    font-weight: 500;
    letter-spacing: -0.05em;
    line-height: var(--leading-tight);
  }

  p {
    max-width: 38rem;
    margin: 0;
    color: var(--color-muted-300, var(--color-muted-400));
    font-size: var(--text-base);
    line-height: var(--leading-body);
  }
</style>
