---
interface Props { class?: string; narrow?: boolean; }
const { class: className="", narrow=false } = Astro.props;
---
<div class:list={["container-editorial", narrow && "is-narrow", className]}><slot /></div>
<style>
  .container-editorial { width:min(calc(100% - (var(--gutter) * 2)), var(--container-max)); margin-inline:auto; }
  .container-editorial.is-narrow { max-width:56rem; }
</style>