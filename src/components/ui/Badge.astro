---
interface Props { tone?: "default" | "accent"; class?: string; }
const { tone="default", class: className="" } = Astro.props;
---
<span class:list={["ui-badge", `tone-${tone}`, className]}><slot /></span>
<style>
  .ui-badge { display:inline-flex; align-items:center; width:max-content; padding:.38rem .55rem; border:1px solid var(--color-border); color:var(--color-muted-400); background:rgba(9,9,9,.72); font:var(--text-xs)/1 var(--font-mono); letter-spacing:.08em; text-transform:uppercase; }
  .ui-badge.tone-accent { color:var(--color-paper-50); border-color:rgba(164,138,104,.5); }
</style>