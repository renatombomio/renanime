---
interface Props {
  label: string;
  href?: string;
  type?: "button" | "submit";
  disabled?: boolean;
  class?: string;
}
const { label, href, type="button", disabled=false, class: className="" } = Astro.props;
---
{href ? (
  <a class:list={["icon-button", className]} href={href} aria-label={label}><slot /></a>
) : (
  <button class:list={["icon-button", className]} type={type} disabled={disabled} aria-label={label}><slot /></button>
)}
<style>
  .icon-button { display:inline-grid; width:2.75rem; height:2.75rem; place-items:center; border:1px solid var(--color-border); background:transparent; color:var(--color-paper-200); transition:color var(--duration-fast) var(--ease-out),border-color var(--duration-fast) var(--ease-out),transform var(--duration-fast) var(--ease-out); }
  .icon-button:hover { color:var(--color-paper-50); border-color:var(--color-border-strong); transform:translateY(-1px); }
  .icon-button:focus-visible { outline:1px solid var(--color-accent-soft); outline-offset:3px; }
  .icon-button:disabled { opacity:.45; cursor:not-allowed; transform:none; }
</style>