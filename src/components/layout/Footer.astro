---
import Container from "../ui/Container.astro";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-line"></div>

  <Container class="footer-inner">
    <p class="closing">
      Todas las historias tienen un final.<br />
      A veces amargo, otras placentero,<br />
      pero cada final solo trae nuevos comienzos.
    </p>

    <p class="thanks">Gracias por visitar mi galería de Anime.</p>

    <div class="footer-meta">
      <span>RA</span>
      <span>© {year}</span>
    </div>
  </Container>
</footer>

<style>
  .site-footer { background: var(--color-ink-950); }
  .footer-line { height: 1px; background: var(--color-border); }
  .footer-inner {
    position: relative;
    padding-block: clamp(3rem, 6vw, 5rem) 1.5rem;
  }
  .closing {
    margin: 0;
    max-width: 46rem;
    color: var(--color-paper-200);
    font-family: var(--font-body);
    font-size: clamp(1.1rem, 2vw, 1.5rem);
    line-height: 1.5;
  }
  .thanks {
    margin: var(--space-6) 0 0;
    color: var(--color-muted-400);
    font-size: var(--text-sm);
  }
  .footer-meta {
    position: absolute;
    right: var(--gutter);
    bottom: 1.5rem;
    display: flex;
    gap: var(--space-4);
    color: var(--color-muted-500);
    font-family: var(--font-meta);
    font-size: 0.58rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  @media (max-width: 640px) {
    .footer-inner { padding-block: 2.75rem 1.25rem; }
    .closing { font-size: 1.05rem; }
    .footer-meta {
      position: static;
      margin-top: var(--space-8);
    }
  }
</style>
