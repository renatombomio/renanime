---
import Container from "../ui/Container.astro";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-line"></div>

  <Container class="footer-inner">
    <p class="closing">
      Todas las historias tienen un final.<br />
      A veces amargo, otras placentero,<br />
      pero cada final solo trae nuevos comienzos.
    </p>

    <p class="thanks">Gracias por visitar mi galería de Anime.</p>

    <div class="footer-meta">
      <span>Renanime</span>
      <span>© {year}</span>
    </div>
  </Container>
</footer>

<style>
  .site-footer {
    background: #000;
  }

  .footer-line {
    height: 1px;
    background: var(--color-border);
  }

  :global(.footer-inner) {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    padding-block: clamp(4rem, 7vw, 6rem) 2rem;
    text-align: center;
  }

  :global(.closing) {
    width: 100%;
    max-width: 44rem;
    margin: 0 auto;
    color: var(--color-paper-200);
    font-family: var(--font-body);
    font-size: clamp(1rem, 1.6vw, 1.2rem);
    line-height: 1.8;
    letter-spacing: 0.01em;
    text-align: center;
  }

  :global(.thanks) {
    margin: 2rem 0 0;
    color: var(--color-muted-400);
    font-size: 0.75rem;
    line-height: 1.5;
    letter-spacing: 0.04em;
    text-align: center;
  }

  :global(.footer-meta) {
    display: flex;
    gap: var(--space-5);
    margin-top: 2.5rem;
    color: var(--color-muted-500);
    font-family: var(--font-meta);
    font-size: 0.55rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  @media (max-width: 640px) {
    :global(.footer-inner) {
      padding-block: 4rem 1.75rem;
    }

    :global(.closing) {
      max-width: 20rem;
      font-size: 0.95rem;
      line-height: 1.8;
    }

    :global(.thanks) {
      margin-top: 1.75rem;
    }

    :global(.footer-meta) {
      margin-top: 3rem;
    }
  }
</style>
