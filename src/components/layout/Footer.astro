---
import Container from "../ui/Container.astro";

const year = new Date().getFullYear();
const isGhibli = Astro.url.pathname.startsWith("/ghibli");
---

<footer class:list={["site-footer", isGhibli && "site-footer--ghibli"]}>
  <div class="footer-line"></div>

  <Container class="footer-inner">
    <p class="closing">
      Todas las historias tienen un final.<br />
      A veces amargo, otras placentero,<br />
      pero cada final solo trae nuevos comienzos.
    </p>

    <p class="thanks">Gracias por visitar mi galería de Anime.</p>

    <nav class="footer-nav" aria-label="Enlaces del pie de página">
      <a href="/">Inicio</a>
      <a href="/ren-collection/">Colección de Ren</a>
      <a href="/favorites/">Favoritos</a>
      <a href="/genres/">Géneros</a>
      <a href="/search/">Buscar</a>
      <a href="/pending/">Mi lista</a>
      <a href="/collection/">Mi colección</a>
      <a href="/profile/">Mi perfil</a>
      <a href="/ghibli/">El secreto de Ren</a>
    </nav>

    <div class="footer-meta">
      <span>Renanime</span>
      <span>© {year}</span>
    </div>
  </Container>
</footer>

<style>
  .site-footer {
    background: #000;
  }

  .site-footer--ghibli {
    background: #fff;
    color: #19362f;
  }

  .site-footer--ghibli .footer-line {
    background: rgba(25, 54, 47, .12);
  }

  .site-footer--ghibli :global(.closing) {
    color: #19362f !important;
    opacity: 1 !important;
  }

  .site-footer--ghibli :global(.thanks) {
    color: #486b61 !important;
    opacity: 1 !important;
  }

  .site-footer--ghibli :global(.footer-meta) {
    color: #4d665f !important;
    opacity: 1 !important;
  }

  .footer-line {
    height: 1px;
    background: var(--color-border);
  }

  :global(.footer-inner) {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    padding-block: clamp(4rem, 7vw, 6rem) 2rem;
    text-align: center;
  }

  :global(.closing) {
    width: 100%;
    max-width: 44rem;
    margin: 0 auto;
    color: var(--color-paper-200);
    font-family: var(--font-body);
    font-size: clamp(1rem, 1.6vw, 1.2rem);
    line-height: 1.8;
    letter-spacing: 0.01em;
    text-align: center;
  }

  :global(.thanks) {
    margin: 2rem 0 0;
    color: var(--color-muted-400);
    font-size: 0.75rem;
    line-height: 1.5;
    letter-spacing: 0.04em;
    text-align: center;
  }

  :global(.footer-nav) {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: .6rem 1.2rem;
    max-width: 58rem;
    margin-top: 2.25rem;
  }

  :global(.footer-nav a) {
    color: var(--color-muted-400);
    font-family: var(--font-meta);
    font-size: .52rem;
    letter-spacing: .09em;
    text-transform: uppercase;
    transition: color var(--duration-fast) var(--ease-out);
  }

  :global(.footer-nav a:hover),
  :global(.footer-nav a:focus-visible) {
    color: var(--color-paper-50);
  }

  .site-footer--ghibli :global(.footer-nav a) { color: #59756b; }
  .site-footer--ghibli :global(.footer-nav a:hover),
  .site-footer--ghibli :global(.footer-nav a:focus-visible) { color: #18528a; }

  :global(.footer-meta) {
    display: flex;
    gap: var(--space-5);
    margin-top: 2.5rem;
    color: var(--color-muted-500);
    font-family: var(--font-meta);
    font-size: 0.55rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  @media (max-width: 640px) {
    :global(.footer-inner) {
      padding-block: 4rem 1.75rem;
    }

    :global(.closing) {
      max-width: 20rem;
      font-size: 0.95rem;
      line-height: 1.8;
    }

    :global(.thanks) {
      margin-top: 1.75rem;
    }

    :global(.footer-nav) {
      gap: .65rem .9rem;
      margin-top: 2rem;
    }

    :global(.footer-meta) {
      margin-top: 2.5rem;
    }
  }
</style>
