---
import Container from "../ui/Container.astro";
import Divider from "../ui/Divider.astro";
import TotoroButton from "../navigation/TotoroButton.astro";

const links = [
  { label: "Inicio", href: "/" },
  { label: "Favoritos", href: "/#favorites" },
  { label: "Colección", href: "/collection/" },
  { label: "Géneros", href: "/#genres" },
  { label: "Buscar", href: "/search/" },
  { label: "Pendientes", href: "/pending/" },
  { label: "Próximamente", href: "/coming-soon/" }
];
---

<header class="site-header">
  <Container class="header-inner">
    <a class="wordmark" href="/" aria-label="Inicio de Renanime">
      <span class="wordmark-main"><span>REN</span>ANIME</span>
      <span class="wordmark-sub">GALERÍA PERSONAL DE ANIME</span>
    </a>

    <nav aria-label="Navegación principal">
      <ul>
        {links.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
    </nav>

    <TotoroButton />
  </Container>

  <Divider />
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    background: rgba(9, 9, 9, 0.78);
    border-bottom: 1px solid rgba(245, 242, 236, 0.06);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
  }

  .header-inner {
    display: grid;
    grid-template-columns: minmax(12rem, 1fr) auto minmax(3rem, 1fr);
    align-items: center;
    min-height: 4.75rem;
    gap: var(--space-6);
  }

  .wordmark {
    display: inline-flex;
    width: fit-content;
    flex-direction: column;
    gap: 0.28rem;
  }

  .wordmark-main {
    color: var(--color-paper-50);
    font-size: 0.88rem;
    font-weight: var(--weight-semibold);
    letter-spacing: 0.16em;
    line-height: 1;
  }

  .wordmark-main span {
    color: var(--color-accent);
  }

  .wordmark-sub {
    color: var(--color-muted-500);
    font-family: var(--font-meta);
    font-size: 0.47rem;
    letter-spacing: 0.14em;
    line-height: 1;
  }

  nav {
    justify-self: center;
  }

  nav ul {
    display: flex;
    align-items: center;
    gap: clamp(0.9rem, 1.8vw, 1.6rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    position: relative;
    color: var(--color-muted-400);
    font-family: var(--font-meta);
    font-size: 0.58rem;
    font-weight: var(--weight-medium);
    letter-spacing: 0.1em;
    line-height: 1;
    text-transform: uppercase;
    white-space: nowrap;
  }

  nav a::after {
    position: absolute;
    right: 0;
    bottom: -0.55rem;
    left: 0;
    height: 1px;
    background: var(--color-accent);
    content: "";
    transform: scaleX(0);
    transform-origin: center;
    transition: transform var(--duration-fast) var(--ease-out);
  }

  nav a:hover,
  nav a:focus-visible {
    color: var(--color-paper-50);
  }

  nav a:hover::after,
  nav a:focus-visible::after {
    transform: scaleX(1);
  }

  .totoro-button {
    justify-self: end;
  }

  @media (max-width: 1120px) {
    .header-inner {
      grid-template-columns: 1fr auto;
    }

    nav {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .header-inner {
      min-height: 4.25rem;
    }

    .wordmark-main {
      font-size: 0.78rem;
    }

    .wordmark-sub {
      font-size: 0.42rem;
    }
  }
</style>
