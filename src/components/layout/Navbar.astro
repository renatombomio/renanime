---
import MobileMenu from "../navigation/MobileMenu";

interface Props { variant?: "default" | "ghibli"; }

const { variant = "default" } = Astro.props;

const links = [
  { label: "Inicio", href: "/" },
  { label: "Favoritos", href: "/favorites/" },
  { label: "Colección", href: "/collection/" },
  { label: "Géneros", href: "/genres/" },
  { label: "Buscar", href: "/search/" },
  { label: "Pendientes", href: "/pending/" },
  { label: "Próximamente", href: "/coming-soon/" },
  { label: "El secreto de Ren", href: "/ghibli/" }
 ];

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<header class:list={["site-header", variant === "ghibli" && "site-header--ghibli"]}>
  <div class="header-inner">
    <a class="brand" href="/" aria-label="Inicio de Renanime">
      <span class="brand-accent">Ren</span>anime
    </a>

    <nav class="desktop-nav" aria-label="Navegación principal">
      <ul>
        {links.map((link) => (
          <li><a href={link.href} aria-current={currentPath === (link.href.replace(/\/$/, "") || "/") ? "page" : undefined}>{link.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="mobile-menu">
      <MobileMenu variant={variant} client:load />
    </div>
  </div>
</header>

<div class="ghibli-transition" aria-hidden="true">
  <div class="ghibli-transition-wash"></div>
  <div class="ghibli-transition-wind wind-one"></div>
  <div class="ghibli-transition-wind wind-two"></div>
  <div class="ghibli-transition-leaves">
    <span class="leaf leaf-01"></span><span class="leaf leaf-02"></span><span class="leaf leaf-03"></span>
    <span class="leaf leaf-04"></span><span class="leaf leaf-05"></span><span class="leaf leaf-06"></span>
    <span class="leaf leaf-07"></span><span class="leaf leaf-08"></span><span class="leaf leaf-09"></span>
    <span class="leaf leaf-10"></span><span class="leaf leaf-11"></span><span class="leaf leaf-12"></span>
    <span class="leaf leaf-13"></span><span class="leaf leaf-14"></span><span class="leaf leaf-15"></span>
    <span class="leaf leaf-16"></span><span class="leaf leaf-17"></span><span class="leaf leaf-18"></span>
    <span class="leaf leaf-19"></span><span class="leaf leaf-20"></span><span class="leaf leaf-21"></span><span class="leaf leaf-22"></span><span class="leaf leaf-23"></span><span class="leaf leaf-24"></span><span class="leaf leaf-25"></span><span class="leaf leaf-26"></span><span class="leaf leaf-27"></span><span class="leaf leaf-28"></span><span class="leaf leaf-29"></span><span class="leaf leaf-30"></span><span class="leaf leaf-31"></span><span class="leaf leaf-32"></span><span class="leaf leaf-33"></span><span class="leaf leaf-34"></span><span class="leaf leaf-35"></span><span class="leaf leaf-36"></span>
  </div>
  <span class="ghibli-transition-caption">El secreto de Ren</span>
</div>

<script is:inline>
  (() => {
    const targetPath = "/ghibli/";
    const overlay = document.querySelector(".ghibli-transition");
    if (!overlay) return;

    const currentPath = window.location.pathname.replace(/\/$/, "") || "/";
    const hasTransition = sessionStorage.getItem("renanime-ghibli-transition") === "1";

    if (currentPath === "/ghibli" && hasTransition) {
      sessionStorage.removeItem("renanime-ghibli-transition");
      document.documentElement.classList.add("ghibli-transition-pending");
      overlay.classList.add("ghibli-transition--reveal");
      window.setTimeout(() => document.documentElement.classList.remove("ghibli-transition-pending"), 1200);
    }

    document.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      const link = target.closest('a[href="/ghibli/"]');
      if (!link || currentPath === "/ghibli") return;

      event.preventDefault();
      sessionStorage.setItem("renanime-ghibli-transition", "1");
      overlay.classList.add("ghibli-transition--cover");

      window.setTimeout(() => {
        window.location.href = targetPath;
      }, 1900);
    });
  })();
</script>

<style>
  html.ghibli-transition-pending .ghibli-shell {
    visibility: hidden;
  }

  html.ghibli-transition-pending .ghibli-transition {
    visibility: visible;
  }

  .site-header {
    position: fixed;
    top: 0;
    z-index: 50;
    width: 100%;
    height: 88px;
    background: #050505;
    border-bottom: 1px solid rgba(245, 242, 236, 0.1);
  }

  .header-inner {
    width: min(calc(100% - 96px), 1440px);
    height: 100%;
    margin: 0 auto;
    display: flex;
    align-items: center;
  }

  .brand {
    flex: 0 0 auto;
    color: #f5f2ec;
    font-family: var(--font-heading);
    font-size: 23px;
    font-weight: 600;
    letter-spacing: 0.045em;
    line-height: 1;
    white-space: nowrap;
    transition: opacity 180ms ease, color 180ms ease;
  }

  .brand-accent {
    color: #a48a68;
  }

  .brand:hover,
  .brand:focus-visible {
    color: #ffffff;
  }

  .brand:hover .brand-accent,
  .brand:focus-visible .brand-accent {
    color: #c2ae91;
  }

  .desktop-nav {
    margin-left: auto;
  }

  .desktop-nav ul {
    display: flex;
    align-items: center;
    gap: clamp(22px, 2.25vw, 36px);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .desktop-nav a {
    position: relative;
    display: inline-block;
    padding: 10px 0;
    color: #8f8a82;
    font-family: var(--font-meta);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.075em;
    line-height: 1;
    text-transform: uppercase;
    white-space: nowrap;
    transition: color 180ms ease, transform 180ms ease;
  }

  .desktop-nav a::after {
    position: absolute;
    right: 0;
    bottom: 1px;
    left: 0;
    height: 1px;
    background: #a48a68;
    content: "";
    transform: scaleX(0);
    transform-origin: center;
    transition: transform 220ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .desktop-nav a:hover,
  .desktop-nav a:focus-visible {
    color: #f5f2ec;
    transform: translateY(-1px);
  }

  .desktop-nav a:hover::after,
  .desktop-nav a:focus-visible::after {
    transform: scaleX(1);
  }

  .site-header--ghibli {
    background: rgba(255, 255, 255, 0.94);
    border-bottom-color: rgba(25, 54, 47, 0.12);
    backdrop-filter: blur(10px);
  }

  .site-header--ghibli .brand { color: var(--ghibli-ink, #19362f); }
  .site-header--ghibli .brand-accent { color: var(--ghibli-blue, #18528a); }
  .site-header--ghibli .brand:hover,
  .site-header--ghibli .brand:focus-visible { color: var(--ghibli-blue, #18528a); }
  .site-header--ghibli .brand:hover .brand-accent,
  .site-header--ghibli .brand:focus-visible .brand-accent { color: var(--ghibli-coral, #f45164); }
  .site-header--ghibli .desktop-nav a { color: #527066; }
  .site-header--ghibli .desktop-nav a:hover,
  .site-header--ghibli .desktop-nav a:focus-visible { color: var(--ghibli-blue, #18528a); }
  .site-header--ghibli .desktop-nav a::after { background: var(--ghibli-coral, #f45164); }

  .ghibli-transition{position:fixed;inset:0;z-index:9999;overflow:hidden;pointer-events:none;visibility:hidden;background:#DCEFF1}
  .ghibli-transition-wash{position:absolute;inset:-20%;background:linear-gradient(120deg,#0B798B 0%,#18528A 52%,#DCEFF1 100%);transform:translateX(-110%);opacity:.82}
  .ghibli-transition-leaves{position:absolute;inset:-12%;overflow:hidden}
  .leaf{position:absolute;width:clamp(24px,2.9vw,52px);aspect-ratio:1.85;border-radius:90% 8% 90% 8%;background:#91CC57;box-shadow:inset -2px -2px 0 rgba(25,54,47,.12),0 5px 14px rgba(25,54,47,.08);will-change:transform,opacity}
  .leaf:nth-child(3n){background:#86BE50}.leaf:nth-child(4n){background:#7CAE49}.leaf:nth-child(5n){background:#91CC57}
  .leaf::after{position:absolute;left:8%;top:50%;width:84%;height:2px;border-radius:999px;background:rgba(54,91,43,.42);content:"";transform:rotate(-14deg);transform-origin:left center}
  .ghibli-transition-caption{position:absolute;left:50%;top:50%;color:#fff;font:400 clamp(1.8rem,4vw,4rem)/1 var(--ghibli-display,Georgia,serif);letter-spacing:-.04em;transform:translate(-50%,20px)}
  .mobile-menu {
    display: none;
    margin-left: auto;
  }

  @media (max-width: 1120px) {
    .site-header {
      height: 74px;
    }

    .header-inner {
      width: calc(100% - 40px);
    }

    .desktop-nav {
      display: none;
    }

    .mobile-menu {
      display: flex;
      align-items: center;
      margin-left: auto;
    }
  }

  @media (max-width: 520px) {
    .site-header {
      height: 68px;
    }

    .header-inner {
      width: calc(100% - 32px);
    }

    .brand {
      font-size: 20px;
    }
  }
</style>
