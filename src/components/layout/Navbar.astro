---
import Container from "../ui/Container.astro";
import Divider from "../ui/Divider.astro";
import TotoroButton from "../navigation/TotoroButton.astro";
import MobileMenu from "../navigation/MobileMenu";

const links = [
  { label: "Inicio", href: "/" },
  { label: "Favoritos", href: "/#favorites" },
  { label: "Colección", href: "/collection/" },
  { label: "Géneros", href: "/#genres" },
  { label: "Buscar", href: "/search/" },
  { label: "Pendientes", href: "/pending/" },
  { label: "Próximamente", href: "/coming-soon/" }
];
---

<header class="site-header">
  <Container class="header-inner">
    <a class="brand" href="/" aria-label="Renanime — Inicio">
      <span class="brand-mark" aria-hidden="true">RA</span>
    </a>

    <nav aria-label="Navegación principal">
      <ul>
        {links.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="mobile-menu"><MobileMenu client:load /></div>
    <TotoroButton />
  </Container>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    background: rgba(9, 9, 9, 0.84);
    border-bottom: 1px solid var(--color-border);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
  }

  .header-inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    min-height: 4.25rem;
    gap: var(--space-6);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    justify-self: start;
    width: fit-content;
  }

  .mobile-menu {\n    display: none;\n  }\n\n  .brand-mark {
    display: grid;
    width: 2rem;
    height: 2rem;
    place-items: center;
    border: 1px solid var(--color-border-strong);
    color: var(--color-paper-50);
    font-family: var(--font-body);
    font-size: 0.66rem;
    font-weight: var(--weight-semibold);
    letter-spacing: 0.08em;
    line-height: 1;
  }

  nav {
    justify-self: center;
  }

  nav ul {
    display: flex;
    align-items: center;
    gap: clamp(0.9rem, 1.8vw, 1.6rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    position: relative;
    color: var(--color-muted-400);
    font-family: var(--font-meta);
    font-size: 0.58rem;
    font-weight: var(--weight-medium);
    letter-spacing: 0.1em;
    line-height: 1;
    text-transform: uppercase;
    white-space: nowrap;
  }

  nav a::after {
    position: absolute;
    right: 0;
    bottom: -0.55rem;
    left: 0;
    height: 1px;
    background: var(--color-accent);
    content: "";
    transform: scaleX(0);
    transform-origin: center;
    transition: transform var(--duration-fast) var(--ease-out);
  }

  nav a:hover,
  nav a:focus-visible {
    color: var(--color-paper-50);
  }

  nav a:hover::after,
  nav a:focus-visible::after {
    transform: scaleX(1);
  }

  :global(.totoro-button) {
    justify-self: end;
  }

  @media (max-width: 1120px) {
    .header-inner {
      grid-template-columns: 1fr auto auto;
    }

    nav {
      display: none;
    }
  }

  @media (max-width: 1120px) {\n  .mobile-menu {\n    display: block;\n  }\n}\n\n@media (max-width: 640px) {
    .header-inner {
      min-height: 3.75rem;
    }

    .brand {
      gap: 0.55rem;
    }

    .brand-mark {
      width: 1.8rem;
      height: 1.8rem;
      font-size: 0.6rem;
    }

    .brand-name {
      font-size: 0.62rem;
    }
  }
</style>
