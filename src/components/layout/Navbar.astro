---
import MobileMenu from "../navigation/MobileMenu";

const links = [
  { label: "Inicio", href: "/" },
  { label: "Favoritos", href: "/#favorites" },
  { label: "Colección", href: "/collection/" },
  { label: "Géneros", href: "/#genres" },
  { label: "Buscar", href: "/search/" },
  { label: "Pendientes", href: "/pending/" },
  { label: "Próximamente", href: "/coming-soon/" },
  { label: "El secreto de Ren", href: "/ghibli/" }
];
---

<header class="site-header">
  <div class="header-inner">
    <a class="brand" href="/" aria-label="Inicio de Renanime">
      <span class="brand-r">R</span><span>A</span>
    </a>

    <nav aria-label="Navegación principal">
      <ul>
        {links.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="mobile-menu">
      <MobileMenu client:load />
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    width: 100%;
    height: 96px;
    background: #050505;
    border-bottom: 1px solid rgba(245, 242, 236, 0.1);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.28);
  }

  .header-inner {
    width: min(100% - 144px, 1440px);
    height: 100%;
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: 0;
  }

  .brand {
    flex: 0 0 180px;
    display: inline-flex;
    align-items: baseline;
    color: #f5f2ec;
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
    font-size: 18px;
    font-weight: 500;
    letter-spacing: 0.12em;
    line-height: 1;
  }

  .brand-r {
    color: #a48a68;
  }

  nav {
    flex: 1 1 auto;
  }

  nav ul {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 30px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    position: relative;
    display: inline-block;
    color: #8f8a82;
    font-family: "SFMono-Regular", Consolas, monospace;
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.075em;
    line-height: 1;
    text-transform: uppercase;
    white-space: nowrap;
    transition: color 180ms ease;
  }

  nav a::after {
    position: absolute;
    right: 0;
    bottom: -10px;
    left: 0;
    height: 1px;
    background: #a48a68;
    content: "";
    transform: scaleX(0);
    transition: transform 180ms ease;
  }

  nav a:hover,
  nav a:focus-visible {
    color: #f5f2ec;
  }

  nav a:hover::after,
  nav a:focus-visible::after {
    transform: scaleX(1);
  }

  .mobile-menu {
    display: none;
    flex: 0 0 180px;
    justify-content: flex-end;
  }

  @media (max-width: 1120px) {
    .site-header {
      height: 76px;
    }

    .header-inner {
      width: min(100% - 48px, 960px);
    }

    nav {
      display: none;
    }

    .mobile-menu {
      display: flex;
    }
  }

  @media (max-width: 520px) {
    .site-header {
      height: 68px;
    }

    .header-inner {
      width: calc(100% - 40px);
    }

    .brand {
      flex-basis: 64px;
      font-size: 16px;
    }

    .mobile-menu {
      flex-basis: 64px;
    }
  }
</style>
