---
import MobileMenu from "../navigation/MobileMenu";

const links = [
  { label: "Inicio", href: "/" },
  { label: "Favoritos", href: "/#favorites" },
  { label: "Colección", href: "/collection/" },
  { label: "Géneros", href: "/#genres" },
  { label: "Buscar", href: "/search/" },
  { label: "Pendientes", href: "/pending/" },
  { label: "Próximamente", href: "/coming-soon/" },
  { label: "El secreto de Ren", href: "/ghibli/" }
];
---

<header class="site-header">
  <div class="header-inner">
    <a class="brand" href="/" aria-label="Inicio de Renanime">
      <span class="brand-accent">Ren</span>anime
    </a>

    <nav class="desktop-nav" aria-label="Navegación principal">
      <ul>
        {links.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="mobile-menu">
      <MobileMenu client:load />
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    width: 100%;
    height: 80px;
    background: #050505;
    border-bottom: 1px solid rgba(245, 242, 236, 0.1);
  }

  .header-inner {
    width: min(calc(100% - 80px), 1440px);
    height: 100%;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .brand {
    flex: 0 0 auto;
    color: #f5f2ec;
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
    font-size: 18px;
    font-weight: 500;
    letter-spacing: 0.08em;
    line-height: 1;
    white-space: nowrap;
  }

  .brand-accent {
    color: #a48a68;
  }

  .desktop-nav {
    flex: 0 1 auto;
  }

  .desktop-nav ul {
    display: flex;
    align-items: center;
    gap: clamp(18px, 2vw, 32px);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .desktop-nav a {
    position: relative;
    display: inline-block;
    color: #8f8a82;
    font-family: "SFMono-Regular", Consolas, monospace;
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.075em;
    line-height: 1;
    text-transform: uppercase;
    white-space: nowrap;
    transition: color 180ms ease;
  }

  .desktop-nav a::after {
    position: absolute;
    right: 0;
    bottom: -9px;
    left: 0;
    height: 1px;
    background: #a48a68;
    content: "";
    transform: scaleX(0);
    transition: transform 180ms ease;
  }

  .desktop-nav a:hover,
  .desktop-nav a:focus-visible {
    color: #f5f2ec;
  }

  .desktop-nav a:hover::after,
  .desktop-nav a:focus-visible::after {
    transform: scaleX(1);
  }

  .mobile-menu {
    display: none;
  }

  @media (max-width: 1120px) {
    .site-header {
      height: 72px;
    }

    .header-inner {
      width: calc(100% - 48px);
    }

    .desktop-nav {
      display: none;
    }

    .mobile-menu {
      display: block;
    }
  }

  @media (max-width: 520px) {
    .site-header {
      height: 68px;
    }

    .header-inner {
      width: calc(100% - 32px);
    }

    .brand {
      font-size: 16px;
    }
  }
</style>
