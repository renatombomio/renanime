---
import MobileMenu from "../navigation/MobileMenu";

interface Props { variant?: "default" | "ghibli"; }

const { variant = "default" } = Astro.props;

const links = [
  { label: "Inicio", href: "/" },
  { label: "Colección de Ren", href: "/ren-collection/" },
  { label: "Favoritos de Ren", href: "/favorites/" },
  { label: "Géneros de Ren", href: "/genres/" },
  { label: "Buscar", href: "/search/" },
  { label: "Mi lista", href: "/pending/" },
  { label: "Mi colección", href: "/collection/" },
  { label: "Mi perfil", href: "/profile/" },
  { label: "El secreto de Ren", href: "/ghibli/" }
];

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<header class:list={["site-header", variant === "ghibli" && "site-header--ghibli"]}>
  <div class="header-inner">
    <a class="brand" href="/" aria-label="Inicio de Renanime">
      <span class="brand-accent">Ren</span>anime
    </a>

    <nav class="desktop-nav" aria-label="Navegación principal">
      <ul>
        {links.map((link) => (
          <li><a href={link.href} aria-current={currentPath === (link.href.replace(/\/$/, "") || "/") ? "page" : undefined}>{link.label}</a></li>
        ))}
      </ul>
    </nav>

    <button class="language-toggle" type="button" data-language-toggle aria-label="Switch language to English" title="Switch to English">ES · EN</button>

    <div class="mobile-menu">
      <MobileMenu variant={variant} client:load />
    </div>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 50;
    width: 100%;
    height: 88px;
    background: #050505;
    border-bottom: 1px solid rgba(245, 242, 236, 0.1);
  }

  .header-inner {
    width: min(calc(100% - 96px), 1440px);
    height: 100%;
    margin: 0 auto;
    display: flex;
    align-items: center;
  }

  .brand {
    flex: 0 0 auto;
    color: #f5f2ec;
    font-family: var(--font-heading);
    font-size: 23px;
    font-weight: 600;
    letter-spacing: 0.045em;
    line-height: 1;
    white-space: nowrap;
    transition: opacity 180ms ease, color 180ms ease;
  }

  .brand-accent {
    color: #ec4899;
  }

  .brand:hover,
  .brand:focus-visible {
    color: #ffffff;
  }

  .brand:hover .brand-accent,
  .brand:focus-visible .brand-accent {
    color: #ec4899;
  }

  .desktop-nav {
    margin-left: auto;
  }

  .desktop-nav ul {
    display: flex;
    align-items: center;
    gap: clamp(22px, 2.25vw, 36px);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .desktop-nav a {
    position: relative;
    display: inline-block;
    padding: 10px 0;
    color: #8f8a82;
    font-family: var(--font-meta);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.075em;
    line-height: 1;
    text-transform: uppercase;
    white-space: nowrap;
    transition: color 180ms ease, transform 180ms ease;
  }

  .desktop-nav a::after {
    position: absolute;
    right: 0;
    bottom: 1px;
    left: 0;
    height: 1px;
    background: #a48a68;
    content: "";
    transform: scaleX(0);
    transform-origin: center;
    transition: transform 220ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .desktop-nav a:hover,
  .desktop-nav a:focus-visible,
  .desktop-nav a[aria-current="page"] {
    color: #f5f2ec;
    transform: translateY(-1px);
  }

  .desktop-nav a:hover::after,
  .desktop-nav a:focus-visible::after,
  .desktop-nav a[aria-current="page"]::after {
    transform: scaleX(1);
  }

  .site-header--ghibli {
    background: rgba(255, 255, 255, 0.94);
    border-bottom-color: rgba(25, 54, 47, 0.12);
    backdrop-filter: blur(10px);
  }

  .site-header--ghibli .brand { color: var(--ghibli-ink, #19362f); }
  .site-header--ghibli .brand-accent { color: var(--ghibli-blue, #18528a); }
  .site-header--ghibli .brand:hover,
  .site-header--ghibli .brand:focus-visible { color: var(--ghibli-blue, #18528a); }
  .site-header--ghibli .brand:hover .brand-accent,
  .site-header--ghibli .brand:focus-visible .brand-accent { color: var(--ghibli-coral, #f45164); }
  .site-header--ghibli .desktop-nav a { color: #527066; }
  .site-header--ghibli .desktop-nav a:hover,
  .site-header--ghibli .desktop-nav a:focus-visible { color: var(--ghibli-blue, #18528a); }
  .site-header--ghibli .desktop-nav a::after { background: var(--ghibli-coral, #f45164); }

  .language-toggle {
    flex: 0 0 auto;
    margin-left: clamp(1rem, 2vw, 1.75rem);
    padding: 0.55rem 0.65rem;
    border: 1px solid rgba(245, 242, 236, 0.24);
    border-radius: 999px;
    background: transparent;
    color: #f5f2ec;
    font-family: var(--font-meta);
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    cursor: pointer;
    white-space: nowrap;
  }

  .language-toggle:hover,
  .language-toggle:focus-visible {
    border-color: #ec4899;
    outline-color: #ec4899;
  }

  .site-header--ghibli .language-toggle {
    color: var(--ghibli-ink, #19362f);
    border-color: rgba(25, 54, 47, 0.25);
  }

  .site-header--ghibli .language-toggle:hover,
  .site-header--ghibli .language-toggle:focus-visible {
    border-color: var(--ghibli-coral, #f45164);
    outline-color: var(--ghibli-coral, #f45164);
  }

  .mobile-menu {
    display: none;
    margin-left: auto;
    flex: 0 0 auto;
  }

  @media (max-width: 1120px) {
    .site-header {
      height: 74px;
    }

    .header-inner {
      width: calc(100% - 40px);
    }

    .desktop-nav {
      display: none;
    }

    .language-toggle {
      margin-left: auto;
      margin-right: 0.65rem;
    }

    .mobile-menu {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      margin-left: 0;
    }
  }

  @media (max-width: 520px) {
    .site-header {
      height: 68px;
    }

    .header-inner {
      width: calc(100% - 32px);
    }

    .brand {
      font-size: 20px;
    }
  }
</style>