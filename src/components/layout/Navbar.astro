---
import Container from "../ui/Container.astro";
import MobileMenu from "../navigation/MobileMenu";

const links = [
  { label: "Inicio", href: "/" },
  { label: "Favoritos", href: "/#favorites" },
  { label: "Colección", href: "/collection/" },
  { label: "Géneros", href: "/#genres" },
  { label: "Buscar", href: "/search/" },
  { label: "Pendientes", href: "/pending/" },
  { label: "Próximamente", href: "/coming-soon/" },
  { label: "El secreto de Ren", href: "/ghibli/" }
];
---

<header class="site-header">
  <Container class="header-inner">
    <a class="brand" href="/" aria-label="Inicio de Renanime">
      <span class="brand-r">R</span><span>A</span>
    </a>

    <nav aria-label="Navegación principal">
      <ul>
        {links.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="mobile-menu">
      <MobileMenu client:load />
    </div>
  </Container>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    background: #050505;
    border-bottom: 1px solid rgba(245, 242, 236, 0.14);
    box-shadow: 0 10px 34px rgba(0, 0, 0, 0.3);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(20px);
  }

  .header-inner {
    display: grid;
    grid-template-columns: 8rem minmax(0, 1fr) 8rem;
    align-items: center;
    min-height: 6rem;
    padding-block: 1.25rem;
    gap: 2rem;
  }

  .brand {
    display: inline-flex;
    align-items: baseline;
    justify-self: start;
    width: fit-content;
    color: var(--color-paper-50);
    font-family: var(--font-body);
    font-size: 1.15rem;
    font-weight: var(--weight-medium);
    letter-spacing: 0.12em;
    line-height: 1;
  }

  .brand-r {
    color: var(--color-accent);
  }

  nav {
    justify-self: center;
    min-width: 0;
  }

  nav ul {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(1.25rem, 2vw, 2.1rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    position: relative;
    color: var(--color-muted-400);
    font-family: var(--font-meta);
    font-size: 0.62rem;
    font-weight: var(--weight-medium);
    letter-spacing: 0.075em;
    line-height: 1;
    text-transform: uppercase;
    white-space: nowrap;
    transition: color var(--duration-fast) var(--ease-out);
  }

  nav a::after {
    position: absolute;
    right: 0;
    bottom: -0.75rem;
    left: 0;
    height: 1px;
    background: var(--color-accent);
    content: "";
    transform: scaleX(0);
    transform-origin: center;
    transition: transform var(--duration-fast) var(--ease-out);
  }

  nav a:hover,
  nav a:focus-visible {
    color: var(--color-paper-50);
  }

  nav a:hover::after,
  nav a:focus-visible::after {
    transform: scaleX(1);
  }

  .mobile-menu {
    display: none;
    justify-self: end;
  }

  @media (max-width: 1120px) {
    .header-inner {
      grid-template-columns: 1fr auto;
      min-height: 4.75rem;
      padding-block: 0.85rem;
    }

    nav {
      display: none;
    }

    .mobile-menu {
      display: block;
    }
  }

  @media (max-width: 520px) {
    .header-inner {
      min-height: 4.25rem;
    }

    .brand {
      font-size: 1rem;
    }
  }
</style>
