---
import Container from "../ui/Container.astro";
import MobileMenu from "../navigation/MobileMenu";

const links = [
  { label: "Inicio", href: "/" },
  { label: "Favoritos", href: "/#favorites" },
  { label: "Colección", href: "/collection/" },
  { label: "Géneros", href: "/#genres" },
  { label: "Buscar", href: "/search/" },
  { label: "Pendientes", href: "/pending/" },
  { label: "Próximamente", href: "/coming-soon/" },
  { label: "El secreto de Ren", href: "/ghibli/" }
];
---

<header class="site-header">
  <Container class="header-inner">
    <a class="brand" href="/" aria-label="Inicio">
      <span aria-hidden="true">RA</span>
    </a>

    <nav aria-label="Navegación principal">
      <ul>
        {links.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
    </nav>


    <div class="mobile-menu">
      <MobileMenu client:load />
    </div>
  </Container>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    background: rgba(9, 9, 9, 0.9);
    border-bottom: 1px solid var(--color-border);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
  }

  .header-inner {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    min-height: 4.5rem;
    padding-block: 0.75rem;
    gap: clamp(1.5rem, 4vw, 4rem);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    color: var(--color-paper-50);
    font-family: var(--font-body);
    font-size: 0.78rem;
    font-weight: var(--weight-medium);
    letter-spacing: 0.02em;
    line-height: 1;
  }

  nav {
    justify-self: center;
    min-width: 0;
  }

  nav ul {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(0.8rem, 1.7vw, 1.5rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    position: relative;
    color: var(--color-muted-400);
    font-family: var(--font-meta);
    font-size: 0.58rem;
    font-weight: var(--weight-medium);
    letter-spacing: 0.1em;
    line-height: 1;
    text-transform: uppercase;
    white-space: nowrap;
  }

  nav a::after {
    position: absolute;
    right: 0;
    bottom: -0.45rem;
    left: 0;
    height: 1px;
    background: var(--color-accent);
    content: "";
    transform: scaleX(0);
    transform-origin: center;
    transition: transform var(--duration-fast) var(--ease-out);
  }

  nav a:hover,
  nav a:focus-visible {
    color: var(--color-paper-50);
  }

  nav a:hover::after,
  nav a:focus-visible::after {
    transform: scaleX(1);
  }


  .mobile-menu {
    display: none;
  }

  @media (max-width: 1120px) {
    .header-inner {
      grid-template-columns: auto auto;
      justify-content: space-between;
      min-height: 4.25rem;
      padding-block: 0.65rem;
      gap: 1rem;
    }

    nav {
      display: none;
    }

    .mobile-menu {
      display: block;
    }
  }

  @media (max-width: 520px) {  }
</style>
