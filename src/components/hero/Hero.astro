---
import HeroCarousel, { type HeroSlide } from "./HeroCarousel";
import { heroSlides } from "../../data/hero";
import { anilistProvider } from "../../lib/api/anilist";

const slides: HeroSlide[] = [];

for (const config of heroSlides) {
  try {
    const anime = await anilistProvider.getById(config.anilistId);

    if (anime) {
      slides.push({
        id: config.id,
        title: anime.metadata.title,
        year: anime.metadata.year,
        format: anime.metadata.format,
        banner: anime.metadata.images.banner,
        cover: anime.metadata.images.cover,
        eyebrow: config.eyebrow,
        note: config.note,
      });
    }
  } catch {
    // The hero stays usable if AniList is temporarily unavailable.
  }
}
---

<HeroCarousel client:load slides={slides} />

<style>
  :global(.hero) {
    position: relative;
    overflow: hidden;
    background: var(--color-ink-950);
  }

  :global(.hero-media) {
    position: absolute;
    inset: 0;
    z-index: 1;
    overflow: hidden;
    background: var(--color-ink-950);
  }

  :global(.hero-video) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  :global(.hero-inner) {
    position: relative;
    z-index: 3;
    display: flex;
    width: min(calc(100% - (var(--gutter) * 2)), var(--container-max));
    min-height: min(68vh, 52rem);
    margin-inline: auto;
    padding-block: clamp(4rem, 7vw, 6rem) clamp(2rem, 4vw, 3rem);
    flex-direction: column;
    justify-content: space-between;
  }

  :global(.hero-title) {
    position: absolute;
    top: 50%;
    left: 50%;
    width: min(100% - 2rem, 58rem);
    margin: 0;
    transform: translate(-50%, -50%);
    text-align: center;
  }

  :global(.hero-kicker) {
    margin: 0;
    color: var(--color-paper-50);
    font-family: var(--font-body);
    font-size: clamp(3.25rem, 6.5vw, 6.25rem);
    font-weight: 600;
    letter-spacing: 0.02em;
    text-shadow: 0 2px 18px rgba(0, 0, 0, 0.45);
  }

  :global(.hero-accent) {
    color: var(--color-accent);
  }

  :global(.hero-title h1) {
    margin: 0.25rem 0 0;
    color: var(--color-paper-50);
    font-family: "Comico", var(--font-body);
    font-size: clamp(3rem, 4.5vw, 4.75rem);
    font-weight: 400;
    letter-spacing: -0.045em;
    line-height: 0.92;
    text-shadow: 0 3px 24px rgba(0, 0, 0, 0.45);
  }

  :global(.hero-copy) {
    margin: 2rem 0 0;
    color: var(--color-paper-200);
    font-size: var(--text-lg);
    line-height: 1.45;
    text-align: center;
    text-shadow: 0 2px 14px rgba(0, 0, 0, 0.45);
  }

  :global(.hero-controls) {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
  }

  :global(.hero-progress) {
    display: flex;
    gap: 0.75rem;
  }

  :global(.hero-progress button) {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    border: 1px solid rgba(245, 242, 236, 0.4);
    border-radius: 999px;
    background: rgba(9, 9, 9, 0.18);
    color: var(--color-paper-200);
    font-family: var(--font-meta);
    font-size: 0.58rem;
    cursor: pointer;
    backdrop-filter: blur(6px);
  }

  :global(.hero-progress button.is-active) {
    border-color: var(--color-paper-50);
    background: var(--color-paper-50);
    color: var(--color-ink-950);
  }

  :global(.hero-scroll) {
    margin: 0;
    color: var(--color-paper-200);
    font-family: var(--font-meta);
    font-size: 0.58rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.45);
  }

  @media (max-width: 720px) {
    :global(.hero) {
      min-height: 74svh;
    }

    :global(.hero-media) {
      position: absolute;
      inset: 0;
    }

    :global(.hero-video) {
      object-fit: cover;
      object-position: center;
    }

    :global(.hero-inner) {
      width: 100%;
      min-height: 74svh;
      padding: 5rem var(--gutter) 2.5rem;
    }

    :global(.hero-title) {
      position: absolute !important;
      top: 50%;
      left: 50%;
      right: auto;
      bottom: auto;
      width: calc(100% - (var(--gutter) * 2));
      margin: 0;
      transform: translate(-50%, -50%);
      text-align: center;
    }

    :global(.hero-kicker) {
      font-size: 3rem;
    }

    :global(.hero-title h1) {
      font-size: clamp(3.5rem, 15vw, 4.75rem);
    }

    :global(.hero-copy) {
      margin-top: 1.5rem;
      font-size: 0.95rem;
    }
  }
</style>
