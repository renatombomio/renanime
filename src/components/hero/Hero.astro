---
import HeroCarousel, { type HeroSlide } from "./HeroCarousel";
import { heroSlides } from "../../data/hero";
import { anilistProvider } from "../../lib/api/anilist";

interface Props {
  kicker?: string;
  title?: string;
  copy?: string;
  videoSrc?: string;
  variant?: "default" | "ghibli";
}

const {
  kicker = "Renanime's",
  title = "Gallery.",
  copy = "Anime a través de mis ojos.\nEste es mi regalo para ti.",
  videoSrc = "/videos/hero.mp4",
  variant = "default",
} = Astro.props;

const slides: HeroSlide[] = (
  await Promise.all(
    heroSlides.map(async (config) => {
      try {
        const anime = await anilistProvider.getById(config.anilistId);
        if (!anime) return null;
        return {
          id: String(config.anilistId),
          title: anime.metadata.title,
          year: anime.metadata.year,
          format: anime.metadata.format,
          banner: anime.metadata.images.banner,
          cover: anime.metadata.images.cover,
          eyebrow: config.eyebrow,
          note: config.note,
        };
      } catch {
        return null;
      }
    }),
  )
).filter((slide): slide is HeroSlide => slide !== null);
---

<HeroCarousel client:load slides={slides} kicker={kicker} title={title} copy={copy} videoSrc={videoSrc} variant={variant} />

<style>
  :global(.hero) {
    --hero-parallax-x: 0px;
    --hero-parallax-y: 0px;
    position: relative;
    min-height: calc(100svh - 88px);
    overflow: hidden;
    isolation: isolate;
    background: var(--color-ink-950);
  }

  :global(.hero-slides),
  :global(.hero-slide),
  :global(.hero-image),
  :global(.hero-media-wash),
  :global(.hero-video-wrap),
  :global(.hero-video) {
    position: absolute;
    inset: 0;
  }

  :global(.hero-slides) {
    z-index: -5;
    overflow: hidden;
  }

  :global(.hero-slide) {
    opacity: 0;
    visibility: hidden;
    transition: opacity var(--duration-crossfade) var(--ease-in-out), visibility var(--duration-crossfade);
  }

  :global(.hero-slide.is-active) {
    opacity: 1;
    visibility: visible;
  }

  :global(.hero-image) {
    width: calc(100% + 24px);
    height: calc(100% + 24px);
    max-width: none;
    object-fit: cover;
    object-position: center;
    transform: translate3d(var(--hero-parallax-x), var(--hero-parallax-y), 0) scale(1.035);
    filter: saturate(.86) contrast(1.02);
    transition: transform 900ms var(--ease-out), filter var(--duration-crossfade) var(--ease-in-out);
  }

  :global(.hero-slide.is-active .hero-image) {
    filter: saturate(1) contrast(1.04);
  }

  :global(.hero-media-wash) {
    z-index: -3;
    background:
      linear-gradient(90deg, rgba(9,9,9,.96) 0%, rgba(9,9,9,.64) 38%, rgba(9,9,9,.18) 72%, rgba(9,9,9,.52) 100%),
      linear-gradient(180deg, rgba(9,9,9,.15) 0%, rgba(9,9,9,.18) 48%, rgba(9,9,9,.9) 100%);
    pointer-events: none;
  }

  :global(.hero-video-wrap) {
    z-index: -2;
    overflow: hidden;
    opacity: .13;
    mix-blend-mode: screen;
    pointer-events: none;
  }

  :global(.hero-video) {
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: center;
    filter: grayscale(1) contrast(1.2);
  }

  :global(.hero-inner) {
    position: relative;
    z-index: 2;
    display: flex;
    width: min(calc(100% - (var(--gutter) * 2)), var(--container-max));
    min-height: calc(100svh - 88px);
    margin-inline: auto;
    padding-block: clamp(2rem, 5vw, 4rem) clamp(2rem, 4vw, 3rem);
    flex-direction: column;
    justify-content: space-between;
  }

  :global(.hero-brand) {
    max-width: 32rem;
  }

  :global(.hero-kicker) {
    margin: 0;
    color: var(--color-paper-50);
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 5vw, 5.25rem);
    font-weight: var(--weight-semibold);
    letter-spacing: .01em;
    line-height: .92;
    text-shadow: 0 2px 18px rgba(0,0,0,.45);
  }

  :global(.hero-accent) {
    color: var(--color-accent-soft);
  }

  :global(.hero-brand h1) {
    margin: .35rem 0 0;
    color: var(--color-paper-50);
    font-family: var(--font-heading);
    font-size: clamp(2.75rem, 4vw, 4.5rem);
    font-weight: var(--weight-regular);
    letter-spacing: var(--tracking-heading);
    line-height: .9;
    text-shadow: 0 3px 24px rgba(0,0,0,.45);
  }

  :global(.hero-copy) {
    margin: 1.35rem 0 0;
    color: var(--color-paper-200);
    font-family: var(--font-body);
    font-size: var(--text-base);
    line-height: 1.45;
    text-shadow: 0 2px 14px rgba(0,0,0,.45);
  }

  :global(.hero-slide-content) {
    display: grid;
    grid-template-columns: minmax(0, 32rem) auto;
    align-items: end;
    gap: 2rem;
  }

  :global(.hero-slide-copy) {
    max-width: 32rem;
  }

  :global(.hero-eyebrow) {
    display: block;
    margin-bottom: .75rem;
    color: var(--color-paper-200);
    font: 500 var(--text-xs)/1 var(--font-meta);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  :global(.hero-slide-copy h2) {
    margin: 0;
    color: var(--color-paper-50);
    font-family: var(--font-heading);
    font-size: clamp(2.2rem, 5vw, 5rem);
    font-weight: var(--weight-regular);
    letter-spacing: var(--tracking-tight);
    line-height: .92;
    text-wrap: balance;
    text-shadow: 0 3px 24px rgba(0,0,0,.5);
  }

  :global(.hero-meta) {
    display: flex;
    gap: .75rem;
    margin-top: 1rem;
    color: var(--color-paper-200);
    font: 500 .62rem/1 var(--font-meta);
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  :global(.hero-meta span + span)::before {
    margin-right: .75rem;
    color: var(--color-muted-400);
    content: "·";
  }

  :global(.hero-slide-copy > p) {
    max-width: 30rem;
    margin: 1rem 0 0;
    color: var(--color-paper-200);
    font-size: .95rem;
    line-height: 1.5;
  }

  :global(.hero-cta) {
    display: inline-flex;
    align-items: center;
    gap: .65rem;
    margin-top: 1.25rem;
    padding: .75rem 1rem;
    border: 1px solid rgba(245,242,236,.34);
    background: rgba(9,9,9,.18);
    color: var(--color-paper-50);
    font: 500 .62rem/1 var(--font-meta);
    letter-spacing: .1em;
    text-transform: uppercase;
    backdrop-filter: blur(10px);
    transition: background var(--duration-fast) var(--ease-out), color var(--duration-fast) var(--ease-out), border-color var(--duration-fast) var(--ease-out);
  }

  :global(.hero-cta:hover) {
    border-color: var(--color-paper-50);
    background: var(--color-paper-50);
    color: var(--color-ink-950);
  }

  :global(.hero-controls) {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 2rem;
  }

  :global(.hero-progress) {
    display: flex;
    gap: .5rem;
  }

  :global(.hero-progress button) {
    position: relative;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    border: 1px solid rgba(245,242,236,.28);
    border-radius: var(--radius-pill);
    background: rgba(9,9,9,.2);
    color: var(--color-paper-200);
    font: 500 .55rem/1 var(--font-meta);
    cursor: pointer;
    backdrop-filter: blur(8px);
    transition: background var(--duration-fast) var(--ease-out), color var(--duration-fast) var(--ease-out), border-color var(--duration-fast) var(--ease-out), transform var(--duration-fast) var(--ease-out);
  }

  :global(.hero-progress button:hover) {
    transform: translateY(-2px);
    border-color: var(--color-paper-50);
    color: var(--color-paper-50);
  }

  :global(.hero-progress button.is-active) {
    border-color: var(--color-paper-50);
    background: var(--color-paper-50);
    color: var(--color-ink-950);
  }

  :global(.hero-scroll) {
    color: var(--color-paper-200);
    font: 500 .58rem/1 var(--font-meta);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    text-shadow: 0 2px 10px rgba(0,0,0,.45);
  }

  :global(.hero-fallback) {
    display: grid;
    min-height: inherit;
    place-content: center;
    padding: var(--gutter);
    text-align: center;
  }

  :global(.hero-fallback p) {
    margin: 0;
    color: var(--color-paper-50);
    font-size: clamp(2.5rem, 6vw, 6rem);
  }

  :global(.hero-fallback h1) {
    margin: .25rem 0 1rem;
    font-size: clamp(2.5rem, 5vw, 5rem);
  }

  @media (max-width: 1120px) {
    :global(.hero), :global(.hero-inner) { min-height: calc(100svh - 74px); }
  }

  @media (max-width: 720px) {
    :global(.hero), :global(.hero-inner) {
      min-height: calc(100svh - 68px);
    }

    :global(.hero) {
      min-height: 0;
    }

    :global(.hero-inner) {
      width: 100%;
      min-height: 0;
      height: min(46rem, calc(100svh - 68px));
      padding: 1.5rem var(--gutter) 1.5rem;
    }

    :global(.hero-image) {
      width: 100%;
      height: 100%;
      transform: none;
      object-position: center;
    }

    :global(.hero-media-wash) {
      background:
        linear-gradient(180deg, rgba(9,9,9,.25) 0%, rgba(9,9,9,.12) 25%, rgba(9,9,9,.7) 62%, rgba(9,9,9,.96) 100%);
    }

    :global(.hero-video-wrap) {
      opacity: .08;
    }

    :global(.hero-brand) {
      max-width: 20rem;
    }

    :global(.hero-kicker) {
      font-size: clamp(2.35rem, 11vw, 3.4rem);
    }

    :global(.hero-brand h1) {
      font-size: clamp(2.8rem, 14vw, 4.2rem);
    }

    :global(.hero-copy) {
      max-width: 17rem;
      margin-top: .9rem;
      font-size: .82rem;
    }

    :global(.hero-slide-content) {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }

    :global(.hero-slide-copy) {
      max-width: 100%;
    }

    :global(.hero-slide-copy h2) {
      font-size: clamp(2rem, 11vw, 3.5rem);
    }

    :global(.hero-slide-copy > p) {
      max-width: 19rem;
      font-size: .82rem;
    }

    :global(.hero-controls) {
      justify-content: space-between;
      gap: 1rem;
    }

    :global(.hero-progress button) {
      width: 2.2rem;
      height: 2.2rem;
    }

    :global(.hero-scroll) {
      font-size: .5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.hero-slide),
    :global(.hero-image),
    :global(.hero-progress button),
    :global(.hero-cta) {
      transition: none;
    }

    :global(.hero-image) {
      transform: none;
    }
  }
</style>
