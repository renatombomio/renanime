---
import HeroCarousel, { type HeroSlide } from "./HeroCarousel";
import { heroSlides } from "../../data/hero";
import { anilistProvider } from "../../lib/api/anilist";

const slides: HeroSlide[] = [];

for (const config of heroSlides) {
  try {
    const anime = await anilistProvider.getById(config.anilistId);

    if (anime) {
      slides.push({
        id: config.id,
        title: anime.metadata.title,
        year: anime.metadata.year,
        format: anime.metadata.format,
        banner: anime.metadata.images.banner,
        cover: anime.metadata.images.cover,
        eyebrow: config.eyebrow,
        note: config.note,
      });
    }
  } catch {
    // The hero stays usable if AniList is temporarily unavailable.
  }
}
---

<HeroCarousel client:load slides={slides} />

<style>
  :global(.hero) {
    position: relative;
    overflow: hidden;
    background: var(--color-ink-950);
  }

  :global(.hero-media) {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  :global(.hero-image) {
    position: absolute;
    inset: 0;
    background-position: center;
    background-repeat: no-repeat;
    background-size: contain;
    will-change: transform, opacity;
  }

  :global(.hero-vignette),
  :global(.hero-grain) {
    display: none;
  }

  :global(.hero-inner) {
    position: relative;
    z-index: 3;
    display: flex;
    width: min(calc(100% - (var(--gutter) * 2)), var(--container-max));
    min-height: min(70vw, calc(100svh - 88px));
    margin-inline: auto;
    padding-block: clamp(4rem, 7vw, 6rem) clamp(2rem, 4vw, 3rem);
    flex-direction: column;
    justify-content: space-between;
  }

  :global(.hero-title) {
    max-width: 42rem;
    margin-top: auto;
    padding-top: 0;
  }

  :global(.hero-kicker) {
    margin: 0;
    color: var(--color-paper-50);
    font-family: var(--font-body);
    font-size: clamp(1.5rem, 3vw, 2.5rem);
    font-weight: 600;
    letter-spacing: 0.02em;
    text-shadow: 0 2px 18px rgba(0, 0, 0, 0.45);
  }

  :global(.hero-accent) {
    color: var(--color-accent);
  }

  :global(.hero-title h1) {
    margin: 0.25rem 0 0;
    color: var(--color-paper-50);
    font-family: "Comico", var(--font-body);
    font-size: clamp(4.5rem, 12vw, 10rem);
    font-weight: 400;
    letter-spacing: -0.045em;
    line-height: 0.8;
    text-shadow: 0 3px 24px rgba(0, 0, 0, 0.45);
  }

  :global(.hero-copy) {
    margin: 2rem 0 0;
    color: var(--color-paper-200);
    font-size: var(--text-lg);
    line-height: 1.45;
    text-shadow: 0 2px 14px rgba(0, 0, 0, 0.45);
  }

  :global(.hero-controls) {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
  }

  :global(.hero-progress) {
    display: flex;
    gap: 0.75rem;
  }

  :global(.hero-progress button) {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    border: 1px solid rgba(245, 242, 236, 0.4);
    border-radius: 999px;
    background: rgba(9, 9, 9, 0.18);
    color: var(--color-paper-200);
    font-family: var(--font-meta);
    font-size: 0.58rem;
    cursor: pointer;
    backdrop-filter: blur(6px);
  }

  :global(.hero-progress button.is-active) {
    border-color: var(--color-paper-50);
    background: var(--color-paper-50);
    color: var(--color-ink-950);
  }

  :global(.hero-scroll) {
    margin: 0;
    color: var(--color-paper-200);
    font-family: var(--font-meta);
    font-size: 0.58rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.45);
  }

  @media (max-width: 720px) {
    :global(.hero) {
      background: var(--color-ink-950);
    }

    :global(.hero-media) {
      position: relative;
      aspect-ratio: 16 / 9;
    }

    :global(.hero-image) {
      background-size: contain;
    }

    :global(.hero-inner) {
      width: 100%;
      min-height: auto;
      padding: 2.5rem var(--gutter) 2rem;
    }

    :global(.hero-title) {
      position: static !important;
      margin-top: 0;
    }

    :global(.hero-kicker) {
      font-size: 1.35rem;
    }

    :global(.hero-title h1) {
      font-size: clamp(4rem, 19vw, 6.5rem);
    }

    :global(.hero-copy) {
      margin-top: 1.5rem;
      font-size: 0.95rem;
    }

    :global(.hero-controls) {
      margin-top: 3rem;
      align-items: center;
    }

    :global(.hero-scroll) {
      display: none;
    }
  }
</style>
